# proxmox-node-rebuild settings: KEY=value, read and never sourced.
# Copy to /etc/proxmox-node-rebuild/settings.env, root-owned, mode 600.

# The Proxmox API: hosts tried in order, and a file with the token (mode 600):
#   PVE_API_TOKEN_ID=rebuild@pve!manager
#   PVE_API_TOKEN_SECRET=<the secret Proxmox showed once>
PVE_API_HOSTS="pve-a.example.net pve-b.example.net"
PVE_API_PORT=8006
PVE_TOKEN_FILE=/etc/proxmox-node-rebuild/token.env
# The CA the API's certificate is checked against; empty is the system's store.
PVE_CA_FILE=

# What a new VM is made from and where it goes. The template is found by its
# name, case aside; * fits anything, and exactly one template may fit. The pool
# is what the token's rights are granted on: it can touch nothing outside it.
PVE_TEMPLATE_NAME=ubuntu-template*
PVE_STORAGE=vm-storage
PVE_POOL=node-rebuild
# The Proxmox node the clone lands on; empty is the template's own.
PVE_TARGET_NODE=

# The VM's size; empty keeps the template's.
VM_CORES=1
VM_MEMORY_MB=2048

# cloud-init for the temporary address: the restore installs packages and
# needs a resolver until the node's own network takes over.
NAMESERVER=192.0.2.53
SEARCHDOMAIN=example.net

# One block per cluster, by the cluster's ID upper-cased, `-` and `.` as `_`.
CLUSTER_ALPHA_BRIDGE=vmbr10
CLUSTER_ALPHA_GATEWAY=192.0.2.1
CLUSTER_ALPHA_TEMPORARY_ADDRESS=192.0.2.29/24
CLUSTER_ALPHA_TEST_ADDRESS=192.0.2.29/24

CLUSTER_BETA_BRIDGE=vmbr50
CLUSTER_BETA_GATEWAY=198.51.100.1
CLUSTER_BETA_TEMPORARY_ADDRESS=198.51.100.29/24
CLUSTER_BETA_TEST_ADDRESS=198.51.100.29/24

# One block per node, by its name in the cluster, the same way: the cluster it
# belongs to, and the VMID a rebuild gets (it must be free: the lost VM removed,
# or --vmid).
NODE_LB_01_CLUSTER=alpha
NODE_LB_01_VMID=801
NODE_LB_02_CLUSTER=alpha
NODE_LB_02_VMID=802

# --test: this VMID, the cluster's TEST_ADDRESS, and this VIP, which no
# cluster uses. keepalived stays masked on a test VM.
TEST_VMID=899
TEST_VIP=203.0.113.254/32
