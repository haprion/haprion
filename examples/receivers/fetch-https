#!/bin/sh
#
# For a receiver registered with `--transport https`: an address whitelist and
# a password of its own, both required. The password was shown once when the
# secret was made; it is kept in NETRC (mode 600), so it is on no command line:
#
#   machine manager.example.net login 192.0.2.40 password <password>
#
# The manager's certificate is verified against a CA file: without that, an
# address whitelist protects the manager from strangers and does nothing at all
# for this host. CA is either the CA that issued the interface's certificate,
# or the interface's own certificate saved once from
# https://<manager>/certdist/manager-ui.pem (the receivers page shows how).
#
set -eu

URL=${URL:-https://manager.example.net/certdist/192.0.2.40}
CA=${CA:-/etc/ssl/certs/internal-root.pem}
TARGET=${TARGET:-/etc/ssl/haproxy}
CERTIFICATE=${CERTIFICATE:-app.example.net}
RELOAD=${RELOAD:-systemctl reload nginx}
NETRC=${NETRC:-/root/.certfetch.netrc}

staging=$(mktemp -d)
trap 'rm -rf -- "$staging"' EXIT INT TERM

for name in fullchain.pem privkey.pem; do
    curl --fail --silent --show-error --netrc-file "$NETRC" --cacert "$CA" \
        --output "${staging}/${name}" "${URL}/${CERTIFICATE}/${name}"
done

certificate_key=$(openssl x509 -in "${staging}/fullchain.pem" -pubkey -noout)
private_key=$(openssl pkey -in "${staging}/privkey.pem" -pubout)
[ "$certificate_key" = "$private_key" ] || {
    echo "fetch-https: the key does not belong to the certificate; not installed" >&2
    exit 1
}

changed=0
for name in fullchain.pem privkey.pem; do
    if ! cmp -s "${staging}/${name}" "${TARGET}/${name}"; then
        install -o root -g root -m 600 "${staging}/${name}" "${TARGET}/${name}"
        changed=1
    fi
done

[ "$changed" -eq 1 ] || exit 0
chmod 644 "${TARGET}/fullchain.pem"
$RELOAD
