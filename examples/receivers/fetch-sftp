#!/bin/sh
#
# The same, over sftp. For a receiver registered with `--transport sftp`.
#
# The manager chroots this account into its own directory, so `/` on the far
# side is one directory per certificate and there is nothing else to reach.
# The server is started with -R, so every write is refused before it is tried.
#
set -eu

MANAGER=${MANAGER:-manager.example.net}
IDENTITY=${IDENTITY:-/etc/ssl/haproxy/id_ed25519}
ACCOUNT=${ACCOUNT:-crx-lb-03}
CERTIFICATE=${CERTIFICATE:-lb-03.example.net}
TARGET=${TARGET:-/etc/ssl/haproxy}
RELOAD=${RELOAD:-systemctl reload haproxy}

PENDING=${PENDING:-${TARGET}/.reload-pending}

staging=$(mktemp -d)
trap 'rm -rf -- "$staging"; rm -f "${TARGET}/fullchain.pem.new" "${TARGET}/privkey.pem.new"' EXIT INT TERM

# -b - reads the commands from stdin as a batch: no prompt, the first command
# that fails aborts the rest, and the exit status says so. Without -b, sftp
# reads stdin as if typed and reports success whatever the gets did.
sftp -q -b - -i "$IDENTITY" -o IdentitiesOnly=yes "${ACCOUNT}@${MANAGER}" <<SFTP
lcd ${staging}
get /${CERTIFICATE}/fullchain.pem
get /${CERTIFICATE}/privkey.pem
bye
SFTP

[ -s "${staging}/fullchain.pem" ] && [ -s "${staging}/privkey.pem" ] || {
    echo "fetch-sftp: the pair is incomplete; leaving the installed one alone" >&2
    exit 1
}

certificate_key=$(openssl x509 -in "${staging}/fullchain.pem" -pubkey -noout)
private_key=$(openssl pkey -in "${staging}/privkey.pem" -pubout)
[ "$certificate_key" = "$private_key" ] || {
    echo "fetch-sftp: the key does not belong to the certificate; not installed" >&2
    exit 1
}

changed=0
for name in fullchain.pem privkey.pem; do
    cmp -s "${staging}/${name}" "${TARGET}/${name}" || changed=1
done

#
# The marker is written before the first file is replaced and removed once the
# reload has succeeded. A reload that failed leaves it, and the next run reloads
# even though the files are by then identical: otherwise the service would keep
# the old certificate until someone noticed.
#
[ "$changed" -eq 1 ] || [ -e "$PENDING" ] || exit 0

if [ "$changed" -eq 1 ]; then
    : > "$PENDING"
    # Both under temporary names first, so the service never meets one new file
    # beside one old one for longer than the two renames take.
    for name in fullchain.pem privkey.pem; do
        install -o root -g root -m 600 "${staging}/${name}" "${TARGET}/${name}.new"
    done
    chmod 644 "${TARGET}/fullchain.pem.new"
    mv "${TARGET}/privkey.pem.new" "${TARGET}/privkey.pem"
    mv "${TARGET}/fullchain.pem.new" "${TARGET}/fullchain.pem"
fi

$RELOAD
rm -f "$PENDING"
