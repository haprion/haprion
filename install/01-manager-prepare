#!/bin/bash
#
# Step 1 of 5 - management host: group, directories, repositories.
#
# Creates the read-only configuration group, the directory trees, and one Git
# repository per cluster. Writes no configuration and contacts no node.
#
# Safe to run again: everything it does is checked before it is done.
#
#     sudo ./01-manager-prepare [answers.env]
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=lib.sh
source ./lib.sh

need_root
load_answers "${1:-}"
require_vars CONFIG_ROOT PUBLISH_ROOT VALIDATION_ROOT CLUSTER_FILE

for path in "$CONFIG_ROOT" "$PUBLISH_ROOT" "$VALIDATION_ROOT" "$CLUSTER_FILE" \
            ${CERTIFICATE_ROOT:+"$CERTIFICATE_ROOT"} ${RECEIVER_ROOT:+"$RECEIVER_ROOT"}; do
    valid_abs_path "$path" || die "not an absolute path without '..': ${path}"
done

step "Accounts and groups"
apply_sysusers sysusers/haprion.conf

#
# The accounts a NODE authenticates to when it fetches. They are reached only by
# a key carrying a forced rrsync command, so like the node-side accounts they
# need a real login shell: sshd runs a forced command through it.
#
step "Pull accounts"

ensure_pull_account() {
    local user="$1" purpose="$2"
    id -u "$user" >/dev/null 2>&1 || die "${user} does not exist; sysusers/haprion.conf makes it"
    log "  ok       ${user}  (${purpose})"
    ensure_forced_home "$user" "empty - step 4 prints what goes here"
}

command -v rrsync >/dev/null \
    || warn "rrsync is not installed. It is what restricts a node to reading one
  tree, and without it the pull accounts have no safe forced command."

ensure_pull_account "$PULL_USER" "nodes fetch published releases"
ensure_pull_account "$CERT_PULL_USER" "nodes fetch certificates"

#
# 0750 root:<group> for the config trees: the group reads and traverses, and
# writes nothing. Publishing is a write into root-owned history and goes through
# a helper, which is the whole reason the group can be read-only.
#
# The published tree is the exception, and getting it wrong is not theoretical:
# giving it to the config group instead of the pull account locks the NODES out
# of the only tree they are supposed to read, and deploy stops working while
# every permission still looks deliberate.
#
step "Runtime directory"
#
# /run/haprion, at every boot: the worker's sandbox names it before any helper
# has created it (install/tmpfiles/haprion.conf says why).
#
install_file /etc/tmpfiles.d/haprion.conf root:root 644 "$(cat tmpfiles/haprion.conf)"
systemd-tmpfiles --create /etc/tmpfiles.d/haprion.conf
log "  ok       /run/haprion"

step "Directory trees"
ensure_dir "$(dirname "$CLUSTER_FILE")" "root:${CONFIG_GROUP}" 750
ensure_dir "$CONFIG_ROOT"     "root:${CONFIG_GROUP}" 750
ensure_dir "$PUBLISH_ROOT"    "root:${PULL_USER}"    750
ensure_dir "$VALIDATION_ROOT" "root:root"            750
ensure_dir "${VALIDATION_ROOT}/certs" "root:root"    700

#
# Where the certificate flows publish: the tree the nodes fetch certificates
# from, read by the certificate pull account, and the receivers' tree beside
# it. Their parent is made only when missing - it may be the operator's.
#
for root in ${CERTIFICATE_ROOT:+"$CERTIFICATE_ROOT"} ${RECEIVER_ROOT:+"$RECEIVER_ROOT"}; do
    [[ -d "$(dirname "$root")" ]] || install -d -o root -g root -m 755 "$(dirname "$root")"
done
[[ -z "${CERTIFICATE_ROOT:-}" ]] || ensure_dir "$CERTIFICATE_ROOT" "root:${CERT_PULL_USER}" 750
[[ -z "${RECEIVER_ROOT:-}" ]] || ensure_dir "$RECEIVER_ROOT" "root:root" 755

step "Per-cluster repositories and release areas"
for cluster in $(each_cluster); do
    log "cluster ${cluster}"

    bare="${CONFIG_ROOT}/${cluster}.git"
    work="${CONFIG_ROOT}/${cluster}"

    #
    # Bare history plus a linked worktree. The worktree is what an operator
    # edits; the history is authoritative and is never edited by hand. They are
    # held together by a path reference in each direction, so restoring only one
    # of them breaks the link - `git worktree repair` is the fix.
    #
    if [[ -d "${bare}/refs" ]]; then
        log "  ok       ${bare}"
    else
        git init --bare --initial-branch=main "$bare" >/dev/null
        log "  created  ${bare}"
    fi
    chown -R "root:${CONFIG_GROUP}" "$bare"
    chmod -R g-w,o-rwx "$bare"

    if [[ -e "${work}/.git" ]]; then
        log "  ok       ${work}"
    else
        #
        # A worktree needs a commit to attach to. An empty repository gets one,
        # with the layout every cluster uses and a .gitignore, so the first real
        # change is a diff rather than an import.
        #
        if ! git -C "$bare" rev-parse --verify HEAD >/dev/null 2>&1; then
            #
            # The network description gets a `vips` table with one `main`
            # row: a table that exists is a table the interface can edit. The
            # name `main` is what the code falls back to for a cluster that
            # never named its addresses.
            #
            seed_vip="$(cluster_value VIP "$cluster")"
            seed_source="$(cluster_value SOURCE "$cluster")"
            seed="$(mktemp -d)"
            #
            # The layout, the handwritten files and the network description
            # come from the engine, the same files Create cluster commits:
            # one template, not a copy here that drifts from it (Fas 18
            # finding 53). An operator's sudoedit policy names files by exact
            # path, so the policy in step 2 can only name files this wrote.
            #
            "$CLUSTER_CONFIG" --seed "$seed" \
                ${seed_vip:+--vip "$seed_vip"} ${seed_source:+--source "$seed_source"} \
                || fail "the layout of cluster ${cluster} could not be written" \
                        "haprion-cluster-config --seed did not finish; its own words are above" \
                        "check that the CLI release is installed (section 2 of docs/install.md)"

            git -C "$seed" init --initial-branch=main >/dev/null
            git -C "$seed" add -A
            #
            # The identity versions are recorded under, kept in the repository:
            # a publish refuses one without it. The same as Create cluster's
            # (cluster_definition.REPOSITORY_IDENTITY).
            #
            git -C "$bare" config user.name haprion
            git -C "$bare" config user.email haprion@localhost
            git -C "$seed" -c user.name=haprion -c user.email=haprion@localhost \
                commit -m "Cluster ${cluster} created" >/dev/null
            git -C "$seed" push --quiet "$bare" main
            rm -rf "$seed"
            log "  seeded   ${bare} with the initial layout"
        fi
        git -C "$bare" worktree add "$work" main >/dev/null
        log "  created  ${work}"
    fi

    #
    # `worktree add` recreates files as root:root and the directories have no
    # setgid bit, so ownership has to be set explicitly afterwards. Measured,
    # not assumed - it caught us once.
    #
    chown -R "root:${CONFIG_GROUP}" "$work"
    find "$work" -type d -exec chmod 750 {} +
    find "$work" -type f -exec chmod 640 {} +

    ensure_dir "${PUBLISH_ROOT}/${cluster}" "root:${PULL_USER}" 750
    ensure_dir "${PUBLISH_ROOT}/${cluster}/releases" "root:${PULL_USER}" 750
done

step "Git safe.directory"
#
# Explicit per-repository entries. A wildcard would make every repository on the
# host trusted by root, which is exactly what this is protecting against.
#
for cluster in $(each_cluster); do
    for repo in "${CONFIG_ROOT}/${cluster}.git" "${CONFIG_ROOT}/${cluster}"; do
        if git config --global --get-all safe.directory 2>/dev/null | grep -qxF "$repo"; then
            log "  ok       ${repo}"
        else
            git config --global --add safe.directory "$repo"
            log "  added    ${repo}"
        fi
    done
done

echo
#
# Validates a dns listener's configuration before it is published (B249).
#
step "dnsdist"
ensure_dnsdist mask

#
# The validator: every candidate is checked with this host's `haproxy -c`.
#
step "HAProxy"
ensure_haproxy

step "System bus"
ensure_system_bus

log "step 1 done"
echo
echo "Next: ./02-manager-config${1:+ $1}"
