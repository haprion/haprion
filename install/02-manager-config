#!/bin/bash
#
# Step 2 of 5 - management host: runtime policy, cluster definitions, validation
# certificate.
#
# Renders the two configuration files from the answers file, so what the code
# reads and what you reviewed cannot drift apart, and creates the validation-only
# certificate if it is missing.
#
#     sudo ./02-manager-config [answers.env]
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=lib.sh
source ./lib.sh

need_root
load_answers "${1:-}"
require_vars CONFIG_ROOT PUBLISH_ROOT VALIDATION_ROOT CLUSTER_FILE KEY_DIR \
             CONFIG_DEPLOY_KEY

POLICY_FILE="/etc/haprion/runtime-policy.yaml"

step "Cluster definitions"

clusters_yaml="$(render_cluster_file)"

#
# Written once. After that the file is the record: nodes are added and removed
# through haprion-node and the interface's Nodes card (B211), and fields this
# step does not render (address_prefix, vips, sources ...) are edited by hand.
# Rendering it again from the answers file would drop all of that, so a
# second run keeps it unless REWRITE_CLUSTER_FILE=yes asks for the answers'
# version - the replaced file is kept beside it either way.
#
if [[ -f "$CLUSTER_FILE" && "${REWRITE_CLUSTER_FILE:-}" != yes ]]; then
    log "  kept     ${CLUSTER_FILE}  (REWRITE_CLUSTER_FILE=yes renders it from the answers)"
else
    install_file "$CLUSTER_FILE" "root:${CONFIG_GROUP}" 640 "$clusters_yaml"
fi

step "Runtime policy"

#
# The outer security boundary. It names the roots every cluster path must stay
# inside; the reader rejects unknown fields, is strict about ownership and mode,
# and refuses a symlink.
#
if [[ -n "${CERTIFICATE_ROOT:-}" ]]; then
    require_vars CERT_DEPLOY_KEY CERTIFICATE_REGISTRY
    valid_abs_path "$CERTIFICATE_REGISTRY" || die "not an absolute path without '..': ${CERTIFICATE_REGISTRY}"
fi
if [[ -n "${BACKUP_ROOT:-}" ]]; then
    require_vars NODE_BACKUP_KEY
    valid_abs_path "$BACKUP_ROOT" || die "not an absolute path without '..': ${BACKUP_ROOT}"
    ensure_dir "$BACKUP_ROOT" "root:root" 700
fi
policy="$(render_policy)"

ensure_dir "$(dirname "$POLICY_FILE")" "root:root" 755
#
# Written once, like the cluster file. A running installation's policy holds
# what no answer renders - ndes, a DNS key added by rotation, an operator's own
# edits - and rendering it again would drop them, which stops every
# certificate flow without an error until one is asked for.
#
if [[ -f "$POLICY_FILE" && "${REWRITE_POLICY:-}" != yes ]]; then
    log "  kept     ${POLICY_FILE}  (REWRITE_POLICY=yes renders it from the answers, and drops what they do not hold)"
else
    install_file "$POLICY_FILE" "root:root" 644 "$policy"
fi

if [[ -n "${BACKUP_ROOT:-}" ]]; then
    backup_service="[Unit]
Description=Haprion node state backup for cluster %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/haprion/current/bin/haprion-state-backup -c %i
User=root
Group=root
UMask=0077
TimeoutStartSec=12min
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=${BACKUP_ROOT} /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native"
    install_file /etc/systemd/system/haprion-state-backup@.service root:root 644 "$backup_service"
    backup_timer="[Unit]
Description=Schedule Haprion node state backup for cluster %i

[Timer]
# A timer without a calendar is a unit systemd refuses to load, and it says so
# in the journal every time anything asks. The default is never armed on its
# own: an instance stays disabled until an administrator sets its schedule,
# which writes a drop-in that replaces this line.
OnCalendar=*-*-* 05:00:00
Unit=haprion-state-backup@%i.service
# No RandomizedDelaySec: the instances of one manager serialise on a lock
# already, and the time an administrator set is the time the page promises.
Persistent=yes
AccuracySec=1min"
    backup_timer+="

[Install]
WantedBy=timers.target"
    install_file /etc/systemd/system/haprion-state-backup@.timer root:root 644 "$backup_timer"
    systemctl daemon-reload
fi

#
# The certificate registry, empty, when the policy names one that is not there
# yet. Never rewritten: from here on the certificate flows own it.
#
if [[ -n "${CERTIFICATE_ROOT:-}" ]]; then
    step "Certificate registry"
    ensure_dir "$(dirname "$CERTIFICATE_REGISTRY")" "root:${CONFIG_GROUP}" 750
    if [[ -f "$CERTIFICATE_REGISTRY" ]]; then
        log "  ok       ${CERTIFICATE_REGISTRY}"
    else
        install_file "$CERTIFICATE_REGISTRY" "root:${CONFIG_GROUP}" 640 "$(render_certificate_registry)"
    fi
fi

step "Validation certificate"

#
# Candidate validation runs a real `haproxy -c`, so any configuration that names
# a certificate needs certificate material present while it runs. This one is
# self-signed, root-only, never deployed, and never leaves this host. It exists
# so the real private key is not readable by the validating path.
#
cert="${VALIDATION_ROOT}/certs/validation.pem"
if [[ -f "$cert" ]]; then
    log "  ok       ${cert}"
else
    command -v openssl >/dev/null || die "openssl is needed to create the validation certificate"
    tmp="$(mktemp -d)"
    openssl req -x509 -newkey rsa:2048 -nodes -days 36500 \
        -keyout "${tmp}/key.pem" -out "${tmp}/cert.pem" \
        -subj "/CN=haprion-validation" >/dev/null 2>&1
    cat "${tmp}/cert.pem" "${tmp}/key.pem" > "$cert"
    rm -rf "$tmp"
    chown root:root "$cert"
    chmod 600 "$cert"
    log "  created  ${cert}"
fi

step "Operator editing policy"

#
# `sudoedit` and nothing else. The configuration repositories are root-owned
# and group-readable, so an operator can read them without a rule; editing is
# what needs one, and making the trees group-writable instead would hand every
# member of the group a way to change what the nodes load.
#
# Named by exact path, never by wildcard: a rule ending in a directory would
# cover files nobody has reviewed, including ones added later. The price is
# that a new handwritten fragment needs a line here before it can be edited,
# which is deliberate - the list is the review.
#
# Only the two files step 1 seeds. `sudoedit` CREATES a file it does not find,
# so a rule may only name a path that exists: naming one that does not is a
# standing way to add a root-owned file to a directory HAProxy loads.
#
EDIT_POLICY=/etc/sudoers.d/haprion-config-edit
if [[ -z "${CONFIG_EDITORS:-}" ]]; then
    log "  skipped  CONFIG_EDITORS is empty - no operator may edit core/ or manual/"
    log "           Set it in the answers file and run this step again."
elif [[ -f "$EDIT_POLICY" ]]; then
    #
    # Written once, like the cluster file. After that Create cluster and
    # Remove cluster keep its paths (B302), so a rerun renders only the
    # editors' line - rendering the paths from CLUSTERS would take away the
    # rule for every cluster created in the interface.
    #
    editors="$(printf '%s' "$CONFIG_EDITORS" | tr -s ' ' ',')"
    sudoers_staging="$(mktemp)"
    sed "s/^User_Alias HAPROXY_EDITORS = .*/User_Alias HAPROXY_EDITORS = ${editors}/" \
        "$EDIT_POLICY" > "$sudoers_staging"
    if ! visudo -cqf "$sudoers_staging"; then
        rm -f "$sudoers_staging"
        die "the editing policy with the new editors does not parse; nothing was installed"
    fi
    install_file "$EDIT_POLICY" root:root 440 "$(cat "$sudoers_staging")"
    rm -f "$sudoers_staging"
    log "            editors: ${editors}  (paths kept; the cluster flows own them)"
else
    editors="$(printf '%s' "$CONFIG_EDITORS" | tr -s ' ' ',')"
    entries=()
    for cluster in $(each_cluster); do
        for relative in core/haproxy.cfg manual/reservations.yaml; do
            path="${CONFIG_ROOT}/${cluster}/${relative}"
            [[ -f "$path" ]] || die "expected ${path}; run ./01-manager-prepare first"
            entries+=("$path")
        done
    done
    sudoers_staging="$(mktemp)"
    render_edit_policy "$editors" "${entries[@]}" > "$sudoers_staging"

    #
    # Checked before it is installed, never after. A sudoers file that does not
    # parse can lock every rule on the host out, this one included.
    #
    if ! visudo -cqf "$sudoers_staging"; then
        rm -f "$sudoers_staging"
        die "the rendered editing policy does not parse; nothing was installed"
    fi
    install -o root -g root -m 440 "$sudoers_staging" "$EDIT_POLICY"
    rm -f "$sudoers_staging"
    log "  installed ${EDIT_POLICY}  (visudo accepted it)"
    log "            editors: ${editors}"
fi

echo
log "step 2 done"
echo
echo "Next: ./03-manager-keys${1:+ $1}"
