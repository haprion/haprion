#!/bin/bash
#
# Step 2 of 5 - management host: runtime policy, cluster definitions, validation
# certificate.
#
# Renders the two configuration files from the answers file, so what the code
# reads and what you reviewed cannot drift apart, and creates the validation-only
# certificate if it is missing.
#
#     sudo ./02-manager-config answers.env
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=lib.sh
source ./lib.sh

need_root
load_answers "${1:-}"
require_vars CONFIG_ROOT PUBLISH_ROOT VALIDATION_ROOT CLUSTER_FILE CLUSTERS KEY_DIR \
             CONFIG_DEPLOY_KEY

POLICY_FILE="/etc/haprion/runtime-policy.yaml"

step "Cluster definitions"

#
# Built as text rather than with a YAML library: this script runs before the
# application is necessarily installed, and adding a Python dependency to step 2
# would mean the installation could not repair itself.
#
clusters_yaml="# Cluster definitions. Rendered by install/02-manager-config.
#
# Every path here must stay inside the roots named in runtime-policy.yaml. The
# code refuses any path that escapes its root, so this file cannot widen the
# boundary - only use it.

schema_version: 1

clusters:"

for cluster in $(each_cluster); do
    nodes="$(cluster_value NODES "$cluster")"
    [[ -n "$nodes" ]] || die "NODES_${cluster} is not set"
    node_path="$(cluster_value NODE_PATH "$cluster")"
    [[ -n "$node_path" ]] || die "NODE_PATH_${cluster} is not set"
    vip="$(cluster_value VIP "$cluster")"
    cert_ids="$(cluster_value CERTIFICATE_IDS "$cluster")"
    default_cert="$(cluster_value DEFAULT_CERTIFICATE "$cluster")"

    display="$(tr '[:lower:]' '[:upper:]' <<<"${cluster:0:1}")${cluster:1}"

    clusters_yaml+="
  ${cluster}:
    display_name: ${display}"
    [[ -n "$vip" ]] && clusters_yaml+="
    vip: ${vip}"
    clusters_yaml+="
    config_path: ${CONFIG_ROOT}/${cluster}
    publish_path: ${PUBLISH_ROOT}/${cluster}
    node_path: ${node_path}
    nodes:"

    for pair in $nodes; do
        name="$(node_name "$pair")"
        host="$(node_host "$pair")"
        [[ "$name" != "$host" ]] || die "NODES_${cluster} entry '${pair}' is not name:hostname"
        clusters_yaml+="
      - name: ${name}
        mgmt_host: ${host}"
    done

    clusters_yaml+="
    validation_certs: ${VALIDATION_ROOT}/certs"

    if [[ -n "$cert_ids" ]]; then
        clusters_yaml+="
    certificate_ids:"
        for id in $cert_ids; do
            clusters_yaml+="
      - ${id}"
        done
        [[ -n "$default_cert" ]] && clusters_yaml+="
    default_certificate: ${default_cert}"
    fi
done

#
# Written once. After that the file is the record: nodes are added and removed
# through haprion-node and the interface's Nodes card (B211), and fields this
# step does not render (address_prefix, vips, sources ...) are edited by hand.
# Rendering it again from the answers file would drop all of that, so a
# second run keeps it unless REWRITE_CLUSTER_FILE=yes asks for the answers'
# version - the replaced file is kept beside it either way.
#
if [[ -f "$CLUSTER_FILE" && "${REWRITE_CLUSTER_FILE:-}" != yes ]]; then
    log "  kept     ${CLUSTER_FILE}  (REWRITE_CLUSTER_FILE=yes renders it from the answers)"
else
    install_file "$CLUSTER_FILE" "root:${CONFIG_GROUP}" 640 "$clusters_yaml"
fi

step "Runtime policy"

#
# The outer security boundary. It names the roots every cluster path must stay
# inside; the reader rejects unknown fields, is strict about ownership and mode,
# and refuses a symlink.
#
policy="# Runtime policy. Rendered by install/02-manager-config.
#
# This is the outer path boundary, not a convenience file. Paths in
# ${CLUSTER_FILE}
# are refused if they fall outside the roots named here.
#
# Requirements the code enforces: root-owned, a regular file, not group- or
# world-writable, at most 1 MiB, schema_version exactly 1.

schema_version: 1

cluster_file: ${CLUSTER_FILE}
config_root: ${CONFIG_ROOT}
publish_root: ${PUBLISH_ROOT}
validation_certs_root: ${VALIDATION_ROOT}

deploy_identity:
  key: \"${KEY_DIR}/${CONFIG_DEPLOY_KEY}\""

if [[ -n "${CERTIFICATE_ROOT:-}" ]]; then
    require_vars CERT_DEPLOY_KEY
    policy+="

# Central certificate distribution. Shared with whatever issues certificates,
# which is why certificate deploy syncs only what a cluster references.
certificate_root: ${CERTIFICATE_ROOT}

# A separate identity: a key that can push configuration must not be able to
# push certificates.
cert_deploy_identity:
  key: \"${KEY_DIR}/${CERT_DEPLOY_KEY}\""
fi

#
# The keys step 3 makes, named here so that the commands find them. Until
# 2026-10-09 this step wrote neither status_identity nor probe_identity, and
# `haprion-status` - which refuses to run without the first - did not work on a
# manager built from these scripts until the lines were added by hand.
#
if [[ -n "${NODE_STATUS_KEY:-}" ]]; then
    policy+="

# Reads node status and nothing else; haprion-deploy reads with it too.
status_identity:
  key: \"${KEY_DIR}/${NODE_STATUS_KEY}\""
fi

if [[ -n "${NODE_PROBE_KEY:-}" ]]; then
    policy+="

# Asks a node to try a health check; the same account as status, its own key.
probe_identity:
  key: \"${KEY_DIR}/${NODE_PROBE_KEY}\""
fi

if [[ -n "${SERVER_STATE_KEY:-}" ]]; then
    policy+="

# Drain, maintenance and ready per server (B263); the trigger account, its own key.
server_state_identity:
  key: \"${KEY_DIR}/${SERVER_STATE_KEY}\""
fi

if [[ -n "${BACKUP_ROOT:-}" ]]; then
    require_vars NODE_BACKUP_KEY
    valid_abs_path "$BACKUP_ROOT" || die "not an absolute path without '..': ${BACKUP_ROOT}"
    ensure_dir "$BACKUP_ROOT" "root:root" 700
    policy+="

# Node state archives contain password hashes and private SSH keys. A separate
# forced-command identity fetches them, and only root can traverse this root.
backup_root: ${BACKUP_ROOT}
backup_identity:
  key: \"${KEY_DIR}/${NODE_BACKUP_KEY}\""
fi

ensure_dir "$(dirname "$POLICY_FILE")" "root:root" 755
#
# Written once, like the cluster file. A running installation's policy holds
# blocks no answer renders - the certificate registry, acme, ndes - and
# rendering it again would drop them, which stops every certificate flow
# without an error until one is asked for.
#
if [[ -f "$POLICY_FILE" && "${REWRITE_POLICY:-}" != yes ]]; then
    log "  kept     ${POLICY_FILE}  (REWRITE_POLICY=yes renders it from the answers, and drops what they do not hold)"
else
    install_file "$POLICY_FILE" "root:root" 644 "$policy"
fi

if [[ -n "${BACKUP_ROOT:-}" ]]; then
    backup_service="[Unit]
Description=Haprion node state backup for cluster %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/haprion/current/bin/haprion-state-backup -c %i
User=root
Group=root
UMask=0077
TimeoutStartSec=12min
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadWritePaths=${BACKUP_ROOT} /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native"
    install_file /etc/systemd/system/haprion-state-backup@.service root:root 644 "$backup_service"
    backup_timer="[Unit]
Description=Schedule Haprion node state backup for cluster %i

[Timer]
# A timer without a calendar is a unit systemd refuses to load, and it says so
# in the journal every time anything asks. The default is never armed on its
# own: an instance stays disabled until an administrator sets its schedule,
# which writes a drop-in that replaces this line.
OnCalendar=*-*-* 05:00:00
Unit=haprion-state-backup@%i.service
# No RandomizedDelaySec: the instances of one manager serialise on a lock
# already, and the time an administrator set is the time the page promises.
Persistent=yes
AccuracySec=1min"
    backup_timer+="

[Install]
WantedBy=timers.target"
    install_file /etc/systemd/system/haprion-state-backup@.timer root:root 644 "$backup_timer"
    systemctl daemon-reload
fi

step "Validation certificate"

#
# Candidate validation runs a real `haproxy -c`, so any configuration that names
# a certificate needs certificate material present while it runs. This one is
# self-signed, root-only, never deployed, and never leaves this host. It exists
# so the real private key is not readable by the validating path.
#
cert="${VALIDATION_ROOT}/certs/validation.pem"
if [[ -f "$cert" ]]; then
    log "  ok       ${cert}"
else
    command -v openssl >/dev/null || die "openssl is needed to create the validation certificate"
    tmp="$(mktemp -d)"
    openssl req -x509 -newkey rsa:2048 -nodes -days 36500 \
        -keyout "${tmp}/key.pem" -out "${tmp}/cert.pem" \
        -subj "/CN=haprion-validation" >/dev/null 2>&1
    cat "${tmp}/cert.pem" "${tmp}/key.pem" > "$cert"
    rm -rf "$tmp"
    chown root:root "$cert"
    chmod 600 "$cert"
    log "  created  ${cert}"
fi

step "Operator editing policy"

#
# `sudoedit` and nothing else. The configuration repositories are root-owned
# and group-readable, so an operator can read them without a rule; editing is
# what needs one, and making the trees group-writable instead would hand every
# member of the group a way to change what the nodes load.
#
# Named by exact path, never by wildcard: a rule ending in a directory would
# cover files nobody has reviewed, including ones added later. The price is
# that a new handwritten fragment needs a line here before it can be edited,
# which is deliberate - the list is the review.
#
# Only the two files step 1 seeds. `sudoedit` CREATES a file it does not find,
# so a rule may only name a path that exists: naming one that does not is a
# standing way to add a root-owned file to a directory HAProxy loads.
#
if [[ -z "${CONFIG_EDITORS:-}" ]]; then
    log "  skipped  CONFIG_EDITORS is empty - no operator may edit core/ or manual/"
    log "           Set it in the answers file and run this step again."
else
    editors="$(printf '%s' "$CONFIG_EDITORS" | tr -s ' ' ',')"
    entries=()
    for cluster in $CLUSTERS; do
        for relative in core/haproxy.cfg manual/reservations.yaml; do
            path="${CONFIG_ROOT}/${cluster}/${relative}"
            [[ -f "$path" ]] || die "expected ${path}; run ./01-manager-prepare first"
            entries+=("    sudoedit ${path}")
        done
    done
    last=$(( ${#entries[@]} - 1 ))

    sudoers_staging="$(mktemp)"
    {
        echo "# Installed by install/02-manager-config. Do not edit by hand."
        echo "#"
        echo "# Editing the handwritten configuration without a root shell."
        echo "#"
        echo "# Every path is named in full. Adding a handwritten fragment means"
        echo "# adding a line here first; REMOVING one means removing its line in"
        echo "# the same change, because sudoedit creates a file it does not find."
        echo "#"
        echo "User_Alias HAPROXY_EDITORS = ${editors}"
        echo
        #
        # Every continued line needs its own trailing backslash, and the last
        # entry must not have one - which is also why a rule is removed by
        # rewriting the whole alias rather than by deleting its line.
        #
        echo "Cmnd_Alias HAPROXY_EDIT = \\"
        for i in "${!entries[@]}"; do
            if (( i < last )); then
                printf '%s, \\\n' "${entries[$i]}"
            else
                printf '%s\n' "${entries[$i]}"
            fi
        done
        echo
        echo "HAPROXY_EDITORS ALL = (root) HAPROXY_EDIT"
    } > "$sudoers_staging"

    #
    # Checked before it is installed, never after. A sudoers file that does not
    # parse can lock every rule on the host out, this one included.
    #
    if ! visudo -cqf "$sudoers_staging"; then
        rm -f "$sudoers_staging"
        die "the rendered editing policy does not parse; nothing was installed"
    fi
    install -o root -g root -m 440 "$sudoers_staging" /etc/sudoers.d/haprion-config-edit
    rm -f "$sudoers_staging"
    log "  installed /etc/sudoers.d/haprion-config-edit  (visudo accepted it)"
    log "            editors: ${editors}"
fi

echo
log "step 2 done"
echo
echo "Next: ./03-manager-keys answers.env"
