#!/bin/bash
#
# Step 3 of 5 - management host: SSH identities, and the lines to install on the
# nodes.
#
# Generates the three management key pairs if they are missing, then prints the
# exact authorized_keys lines for each node. The printing is deliberate: the
# management host cannot write to a node - every management identity is a forced
# command that can ask a node to pull and nothing else - so the public keys get
# there by your hand, over your own login.
#
#     sudo ./03-manager-keys [answers.env]
#     sudo ./03-manager-keys [answers.env] > keys.txt   # to paste from later
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=lib.sh
source ./lib.sh

need_root
load_answers "${1:-}"
require_vars KEY_DIR CONFIG_DEPLOY_KEY NODE_STATUS_KEY

step "Key pairs"

ensure_dir "$KEY_DIR" "root:root" 700

#
# One key, one job. A key that can push configuration must not be able to push
# certificates, and neither may read status. That separation is only real if the
# node side gives each key its own forced command, which step 5 does.
#
generate_key() {
    local name="$1" comment="$2" path="${KEY_DIR}/$1"
    if [[ -f "$path" ]]; then
        log "  ok       ${path}"
        return
    fi
    ssh-keygen -t ed25519 -N "" -C "$comment" -f "$path" >/dev/null
    chown root:root "$path" "${path}.pub"
    chmod 600 "$path"
    chmod 644 "${path}.pub"
    log "  created  ${path}"
}

generate_key "$CONFIG_DEPLOY_KEY" "haprion config deploy"
generate_key "$NODE_STATUS_KEY"   "haprion node status"
[[ -n "${CERT_DEPLOY_KEY:-}" ]] && generate_key "$CERT_DEPLOY_KEY" "haprion cert deploy"
#
# Optional, like the certificate key: an installation that does not want the
# interface asking nodes to try a health check simply names no key, and the
# probe reports itself as unavailable instead of failing anything else.
#
[[ -n "${NODE_PROBE_KEY:-}" ]] && generate_key "$NODE_PROBE_KEY" "haprion health probe"
# Optional too (Fas 20, B263): without it the interface offers no drain,
# maintenance or ready, and nothing else changes.
[[ -n "${SERVER_STATE_KEY:-}" ]] && generate_key "$SERVER_STATE_KEY" "haprion server state"
if [[ -n "${BACKUP_ROOT:-}" ]]; then
    require_vars NODE_BACKUP_KEY BACKUP_USER
    generate_key "$NODE_BACKUP_KEY" "haprion node state backup"
fi

#
# Adding a node pins its host key in root's known_hosts (B211); the change
# edits the file and refuses to start without it (Fas 18 finding 28). Made
# empty here, before the first node, and left alone after.
#
ROOT_KNOWN_HOSTS="/root/.ssh/known_hosts"
ensure_dir "${ROOT_KNOWN_HOSTS%/*}" root:root 700
if [[ -f "$ROOT_KNOWN_HOSTS" ]]; then
    log "  ok       ${ROOT_KNOWN_HOSTS}"
else
    install -o root -g root -m 644 /dev/null "$ROOT_KNOWN_HOSTS"
    log "  created  ${ROOT_KNOWN_HOSTS}  (empty - adding a node pins its host key here)"
fi

step "The manager's keys, for each node's answers file"

pub() { cut -d' ' -f1,2 < "${KEY_DIR}/$1.pub"; }

#
# One table (lib.sh, B317) says which node account each key reaches and the
# forced command it runs there; step 4 writes the lines from these answers.
# A node a manager joins itself, with the block its package prints, needs
# none of this: the manager hands the same keys over.
#
cat <<'INTRO'
A node joined from the interface (Settings - Create cluster or Add node) needs
none of the lines below: the manager hands them over itself.

For a node prepared by hand with 04-node-prepare, put these lines in its answers
file. Step 4 writes each key with `restrict` and its own forced command, and the
management host's host key into root's known_hosts.

INTRO
for purpose_line in "${NODE_KEY_PURPOSES[@]}"; do
    read -r purpose manager_var _ <<<"$purpose_line"
    [[ -n "${!manager_var:-}" && -f "${KEY_DIR}/${!manager_var}.pub" ]] || continue
    [[ "$purpose" != BACKUP || -n "${BACKUP_ROOT:-}" ]] || continue
    echo "${purpose}_PUBKEY=\"$(pub "${!manager_var}")\""
done
HOST_KEY_FILE="${HOST_KEY_FILE:-/etc/ssh/ssh_host_ed25519_key.pub}"
if [[ -r "$HOST_KEY_FILE" ]]; then
    echo "MANAGER_HOST_KEY=\"$(cut -d' ' -f1,2 < "$HOST_KEY_FILE")\""
else
    warn "${HOST_KEY_FILE} is missing: the nodes accept this host's key once by hand"
fi

echo
log "step 3 done"
echo
echo "Next, on each node prepared by hand:"
echo "  sudo /usr/share/haprion-node/install/04-node-prepare answers.env <cluster-id>"
