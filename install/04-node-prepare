#!/bin/bash
#
# Step 4 of 5 - run this ON EACH NODE, not on the management host.
#
# Creates the node service accounts, the HAProxy release layout, the sudo rules
# the forced commands need, and installs the node-side scripts from install/node.
#
# Copy this repository's install directory to the node, or run it from a checkout
# there. It contacts nothing and downloads nothing.
#
#     sudo ./04-node-prepare answers.env <cluster-id>
#
# The cluster ID is needed because node status reports it and because the sudo
# rule for status names it exactly.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=lib.sh
source ./lib.sh

need_root
load_answers "${1:-}"
CLUSTER="${2:-}"
[[ -n "$CLUSTER" ]] || die "usage: $(basename "$0") <answers-file> <cluster-id>"
valid_id "$CLUSTER" || die "invalid cluster id: ${CLUSTER}"
require_vars TRIGGER_USER STATUS_USER BACKUP_USER LOGREAD_USER PULL_USER MANAGER_HOST \
             NODE_CONFIG_PULL_KEY PUBLISH_ROOT
valid_id "$LOGREAD_USER" || die "invalid traffic log reader account: ${LOGREAD_USER}"
for existing_role in "$TRIGGER_USER" "$STATUS_USER" "$BACKUP_USER"; do
    [[ "$LOGREAD_USER" != "$existing_role" ]] \
        || die "LOGREAD_USER must be distinct from the other node service accounts"
done
if id -u "$LOGREAD_USER" >/dev/null 2>&1; then
    IFS=: read -r _ _ logread_uid _ _ logread_home logread_shell \
        < <(getent passwd "$LOGREAD_USER")
    [[ "$logread_uid" != 0 && "$logread_home" == "/home/${LOGREAD_USER}" \
        && "$logread_shell" == "/bin/bash" ]] \
        || die "existing LOGREAD_USER is not the account created by this installer"
fi
#
# The account rsyslog writes files as, which must own the traffic log's
# directory. Ubuntu drops to `syslog` ($PrivDropToUser in rsyslog.conf);
# Debian 13 has no such line and no such account and writes as root
# (measured 2026-09-24). Read from rsyslog's own configuration, the main file
# first and its drop-ins after, the last setting winning - the same function
# in 04-node-prepare and haproxy-traffic-log-enable, held together by a test.
#
rsyslog_writer() {
    local config="${RSYSLOG_CONFIG:-/etc/rsyslog.conf}" dropins="${RSYSLOG_DROPINS:-/etc/rsyslog.d}"
    local sources=() found
    [[ -f "$config" ]] && sources+=("$config")
    for found in "$dropins"/*.conf; do
        [[ -f "$found" ]] && sources+=("$found")
    done
    found=""
    if ((${#sources[@]})); then
        # shellcheck disable=SC2016  # the literal dollar sign is the directive being matched
        found="$(sed -nE \
            -e '/^[[:space:]]*#/d' \
            -e 's/^[[:space:]]*\$PrivDropToUser[[:space:]]+([^[:space:]#]+).*/\1/Ip' \
            -e 's/.*privdrop\.user\.name[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/Ip' \
            "${sources[@]}" | tail -n 1)"
    fi
    echo "${found:-root}"
}
command -v rsyslogd >/dev/null || die "rsyslog is not installed; install rsyslog first"
RSYSLOG_WRITER="$(rsyslog_writer)"
getent passwd "$RSYSLOG_WRITER" >/dev/null \
    || die "rsyslog writes as '${RSYSLOG_WRITER}', which does not exist; reinstall rsyslog"

SBIN="/usr/local/sbin"
NODE_CONF="/etc/haproxy-manager/node.conf"
LOGREAD_GROUP="haproxy-logread"
TRAFFIC_LOG_ROOT="/var/log/haproxy-manager"
# The engine package's LogNamespace=, read by haproxy-traffic-log-read.
WAF_JOURNAL_NAMESPACE="haproxy-waf"

SCRIPTS=(
    haproxy-pull-deploy
    haproxy-cert-pull
    haproxy-cert-remove
    haproxy-cert-trigger
    haproxy-node-status
    haproxy-health-probe
    haproxy-keepalived-state
    haproxy-state-export
    haproxy-traffic-log-read
    haproxy-traffic-log-enable
    haproxy-traffic-log-prune
    haproxy-server-state
    haproxy-server-state-trigger
)
# Unchanged. This level says whether the manager and a node may speak to each
# other; the traffic chain is opt-in and adds no operation the manager calls on
# a node that has not enabled it. Raising it here would mark every node in the
# fleet incompatible for a feature none of them was asked to run. The same
# holds for `cert-remove`: a node without the verb answers "unknown request"
# and the manager reports the copy as kept, so an older node is behind, not
# incompatible. And for the WAF engine (B231): a node whose status reports no
# `waf_engine` is one the manager does not offer the engine on.
NODE_API=1

step "Service accounts"

#
# System accounts with a home directory only so authorized_keys has somewhere to
# live, and with a real shell - which looks wrong and is not.
#
# sshd runs a forced command through the account's login shell. Give these
# accounts /usr/sbin/nologin and every forced command stops working: the node
# refuses configuration pulls, certificate pulls and status requests, and the
# only symptom is the nologin message where output was expected.
#
# What constrains these accounts is not the shell. It is that each key carries
# `restrict` and its own forced command, so a session cannot run anything else.
# Where sudo is needed, its rules name exact absolute commands; the traffic-log
# reader needs and receives no sudo rule. None of the accounts has a password.
#
# The account owns nothing in its own home. sshd accepts an authorized_keys
# owned by root as readily as one owned by the account, and a file the account
# cannot write is the difference between a forced command and a suggestion.
# The same goes for the home directory itself - an account that owns it could
# replace .ssh wholesale - and for the shell's dotfiles: Debian's bash sources
# ~/.bashrc for a command it runs on behalf of sshd, so a .bashrc the account
# could write would run before the forced command does. No dotfiles are created,
# and any left by an earlier installation become root's.
#
ensure_account() {
    local user="$1"
    local home="/home/${user}"
    if id -u "$user" >/dev/null 2>&1; then
        log "  ok       ${user}"
    else
        useradd --system --home-dir "$home" --shell /bin/bash "$user"
        passwd --lock "$user" >/dev/null
        log "  created  ${user}"
    fi
    ensure_dir "$home" root:root 755
    local entry
    while IFS= read -r -d '' entry; do
        chown root:root "$entry"
        log "  claimed  ${entry}  (now root's; the account owns nothing in its home)"
    done < <(find "$home" -mindepth 1 -maxdepth 1 ! -name .ssh ! -user root -print0)
    ensure_dir "${home}/.ssh" root:root 755
    local keys="${home}/.ssh/authorized_keys"
    if [[ ! -f "$keys" ]]; then
        install -o root -g root -m 644 /dev/null "$keys"
        log "  created  ${keys}  (empty - paste the lines from step 3)"
    else
        chown root:root "$keys"
        chmod 644 "$keys"
        log "  ok       ${keys}"
    fi
}

ensure_account "$TRIGGER_USER"
#
# The server state key's line (Fas 20, B263), written from the answers file
# rather than pasted by hand: a public key is no secret, and this still runs
# only under the operator's own sudo on the node - the manager gains no way to
# write here. Its own forced command and `restrict`, like every other key; a
# line already there for the same command is replaced, so rotating the key
# does not leave the old one able to ask.
#
if [[ -n "${SERVER_STATE_PUBKEY:-}" ]]; then
    [[ "$SERVER_STATE_PUBKEY" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+=*$ ]] \
        || die "SERVER_STATE_PUBKEY must be one ssh-ed25519 public key (type and key, no comment)"
    keys="/home/${TRIGGER_USER}/.ssh/authorized_keys"
    forced="command=\"${SBIN}/haproxy-server-state-trigger\""
    line="restrict,${forced} ${SERVER_STATE_PUBKEY}"
    if grep -qxF "$line" "$keys"; then
        log "  ok       server state key in ${keys}"
    else
        tmp="$(mktemp)"
        grep -vF "$forced" "$keys" > "$tmp" || true
        printf '%s\n' "$line" >> "$tmp"
        install -o root -g root -m 644 "$tmp" "$keys"
        rm -f "$tmp"
        log "  written  server state key in ${keys}"
    fi
fi
ensure_account "$STATUS_USER"
ensure_account "$BACKUP_USER"
ensure_group "$LOGREAD_GROUP"
explicit_members="$(getent group "$LOGREAD_GROUP" | cut -d: -f4)"
for member in ${explicit_members//,/ }; do
    [[ "$member" == "$LOGREAD_USER" ]] \
        || die "${LOGREAD_GROUP} already grants traffic-log access to ${member}"
done
ensure_account "$LOGREAD_USER"
usermod -a -G "$LOGREAD_GROUP" "$LOGREAD_USER"
#
# 2750, not 750. rsyslog drops to syslog:syslog before it opens a log file, so
# it cannot chown one into a group it is not a member of. The set-group-id bit
# makes every traffic file inherit haproxy-logread on creation, which is what
# lets the reader account read it - without widening the syslog account.
#
ensure_dir "$TRAFFIC_LOG_ROOT" "${RSYSLOG_WRITER}:${LOGREAD_GROUP}" 2750
log "  member    ${LOGREAD_USER} -> ${LOGREAD_GROUP}"
#
# The WAF engine logs into a journal namespace of its own (its package, from
# revision 2), and the reader reads it there. The same group is granted read on
# that namespace's directory, and its default entry is what each journal file
# journald later creates inherits - so the reader sees the engine's lines and
# nothing else in the journal. Written the way systemd grants its own journal
# (tmpfiles.d/systemd.conf), which needs no acl package. Measured on a node
# (26-10-03): read whole, read after rotation, system journal still refused.
#
WAF_JOURNAL_TMPFILES="/etc/tmpfiles.d/haproxy-manager-waf.conf"
install_file "$WAF_JOURNAL_TMPFILES" root:root 644 "# Installed by install/04-node-prepare.
d /var/log/journal/%m.${WAF_JOURNAL_NAMESPACE} 2755 root systemd-journal -
a+ /var/log/journal/%m.${WAF_JOURNAL_NAMESPACE} - - - - d:group:${LOGREAD_GROUP}:r-x,group:${LOGREAD_GROUP}:r-x"
systemd-tmpfiles --create "$WAF_JOURNAL_TMPFILES"
log "  applied  ${WAF_JOURNAL_TMPFILES}"

step "HAProxy release layout"

#
# A deploy never edits the running configuration. It builds a new immutable
# release directory, swaps `current` atomically, validates again through exactly
# the paths systemd uses, and only then reloads. These symlinks are what make
# that swap a single atomic operation instead of a file copy.
#
# HAProxy, deploy, status and backup read releases as root. Keeping this root
# non-world-traversable prevents forced-command accounts from reading the live
# configuration merely because files inside an immutable release are 0644.
ensure_dir /etc/haproxy/releases root:root 750
ensure_dir /etc/haproxy/certs    root:root 750
#
# The one exception is the WAF engine. Its package runs it as a DynamicUser,
# which is in no group, so /etc/haproxy/waf - a link through the release - was
# out of its reach: the first deploy with WAF rules failed on a node with
# "Permission denied" (26-10-03). A group of its own, with no members, may pass
# through the releases directory and not list it; the engine is given the
# group in a drop-in, not in its package, which knows nothing of this
# installation's accounts. Every other account is still kept out. The access
# entry is written the way the journal's above is, and `chmod 750` from
# ensure_dir leaves its execute bit standing (the mask stays r-x).
#
WAF_ENGINE_GROUP="haproxy-waf"
ensure_group "$WAF_ENGINE_GROUP"
[[ -z "$(getent group "$WAF_ENGINE_GROUP" | cut -d: -f4)" ]] \
    || die "${WAF_ENGINE_GROUP} has members; only the WAF engine may pass through /etc/haproxy/releases"
WAF_ENGINE_TMPFILES="/etc/tmpfiles.d/haproxy-manager-waf-engine.conf"
install_file "$WAF_ENGINE_TMPFILES" root:root 644 "# Installed by install/04-node-prepare.
a+ /etc/haproxy/releases - - - - group:${WAF_ENGINE_GROUP}:--x"
systemd-tmpfiles --create "$WAF_ENGINE_TMPFILES"
log "  applied  ${WAF_ENGINE_TMPFILES}"
WAF_ENGINE_DROPIN="/etc/systemd/system/coraza-spoa.service.d/haproxy-manager.conf"
ensure_dir "${WAF_ENGINE_DROPIN%/*}" root:root 755
install_file "$WAF_ENGINE_DROPIN" root:root 644 "# Installed by install/04-node-prepare.
[Service]
SupplementaryGroups=${WAF_ENGINE_GROUP}"
systemctl daemon-reload
log "  applied  ${WAF_ENGINE_DROPIN}"
#
# dnsdist, which serves a cluster's dns listeners (B249), the same way: its
# package runs it as `_dnsdist`, which the drop-in gives a member-less group
# of its own that may pass through the releases directory. The drop-in also
# points it at the release's file - the package's unit looks for dnsdist.yml,
# and with no configuration at all restarts forever (measured 26-10-06) - and
# lets it start only when a release carries one, so installing the package
# below starts nothing. Whether it runs is the deploy's decision, as the WAF
# engine's is.
#
DNS_GROUP="haproxy-dns"
ensure_group "$DNS_GROUP"
[[ -z "$(getent group "$DNS_GROUP" | cut -d: -f4)" ]] \
    || die "${DNS_GROUP} has members; only dnsdist may pass through /etc/haproxy/releases"
DNS_TMPFILES="/etc/tmpfiles.d/haproxy-manager-dns.conf"
install_file "$DNS_TMPFILES" root:root 644 "# Installed by install/04-node-prepare.
a+ /etc/haproxy/releases - - - - group:${DNS_GROUP}:--x"
systemd-tmpfiles --create "$DNS_TMPFILES"
log "  applied  ${DNS_TMPFILES}"
DNS_DROPIN="/etc/systemd/system/dnsdist.service.d/haproxy-manager.conf"
ensure_dir "${DNS_DROPIN%/*}" root:root 755
install_file "$DNS_DROPIN" root:root 644 "# Installed by install/04-node-prepare.
[Unit]
ConditionPathExists=/etc/haproxy/dns/dnsdist.conf

[Service]
SupplementaryGroups=${DNS_GROUP}
ExecStartPre=
ExecStartPre=/usr/bin/dnsdist --check-config -C /etc/haproxy/dns/dnsdist.conf
ExecStart=
ExecStart=/usr/bin/dnsdist --supervised --disable-syslog -C /etc/haproxy/dns/dnsdist.conf"
systemctl daemon-reload
log "  applied  ${DNS_DROPIN}"
#
# A server kept in drain or maintenance stays there when HAProxy starts (Fas 20,
# B263): the drop-in puts the node's kept states back once HAProxy is ready.
# `-` in front, so a state that cannot be set never stops HAProxy from running -
# the helper logs it, and the status shows the server as it really is. Reloads
# are covered by the deploy and certificate scripts calling the helper.
#
SERVER_STATE_DIR="/var/lib/haproxy-manager"
ensure_dir "$SERVER_STATE_DIR" root:root 700
HAPROXY_DROPIN="/etc/systemd/system/haproxy.service.d/haproxy-manager-server-state.conf"
ensure_dir "${HAPROXY_DROPIN%/*}" root:root 755
install_file "$HAPROXY_DROPIN" root:root 644 "# Installed by install/04-node-prepare.
[Service]
ExecStartPost=-${SBIN}/haproxy-server-state reapply"
systemctl daemon-reload
log "  applied  ${HAPROXY_DROPIN}"
# /run/lock is a distribution-owned shared directory, normally mode 1777.
# The deploy helpers own their root-created lock files, not this directory.
[[ -d /run/lock ]] || die "/run/lock is missing"
log "  present  /run/lock  (system-owned; permissions left unchanged)"

if [[ ! -e /etc/haproxy/current ]]; then
    empty="/etc/haproxy/releases/00000000-000000"
    ensure_dir "$empty" root:root 755
    ensure_dir "${empty}/conf.d" root:root 755
    ensure_dir "${empty}/maps" root:root 755
    [[ -f "${empty}/haproxy.cfg" ]] || install -m 644 /dev/null "${empty}/haproxy.cfg"
    ln -s "$empty" /etc/haproxy/current
    log "  created  /etc/haproxy/current -> ${empty}"
else
    log "  ok       /etc/haproxy/current"
fi

link_into_current() {
    local name="$1" path="/etc/haproxy/$1"
    if [[ -L "$path" ]]; then
        log "  ok       ${path}"
        return
    fi
    if [[ -e "$path" ]]; then
        warn "${path} exists and is not a symlink - not touching it"
        warn "  move it aside, then run this step again"
        return
    fi
    ln -s "current/${name}" "$path"
    log "  created  ${path} -> current/${name}"
}

link_into_current haproxy.cfg
link_into_current conf.d
link_into_current maps
link_into_current waf
link_into_current dns

step "dnsdist"
ensure_dnsdist

step "IPVS for syslog objects"

#
# keepalived programs the kernel's IPVS table itself (B256); ipvsadm is only
# how the node's status reads the counters. Its own service is masked first:
# Debian's package enables it, and it restores and clears the table at boot
# and shutdown - a second owner of what keepalived holds (lab, 26-10-07).
#
systemctl mask --quiet ipvsadm.service
log "  masked   ipvsadm.service (keepalived owns the IPVS table)"
DEBIAN_FRONTEND=noninteractive apt-get "${APT_WAIT[@]}" install -y -q ipvsadm >/dev/null \
    || die "ipvsadm: the package could not be installed"
log "  ok       $(/usr/sbin/ipvsadm --version 2>/dev/null | head -n 1)"

step "Node scripts"

missing=0
for script in "${SCRIPTS[@]}"; do
    if [[ ! -f "node/${script}" ]]; then
        warn "node/${script} is not in this checkout"
        missing=1
    fi
done
[[ $missing -eq 0 ]] || die "node scripts are missing - see docs/user-manual.md, 'What is still missing'"

for script in "${SCRIPTS[@]}"; do
    target="${SBIN}/${script}"
    if [[ -f "$target" ]] && cmp -s "node/${script}" "$target"; then
        chown root:root "$target"
        chmod 755 "$target"
        log "  ok       ${target}"
        prune_replaced "$target"
        continue
    fi
    [[ -f "$target" ]] && cp -a "$target" "${target}.replaced-$(date +%Y%m%d-%H%M%S)"
    install -o root -g root -m 755 "node/${script}" "$target"
    log "  installed ${target}"
    prune_replaced "$target"
done

#
# A compatibility level says whether two independently released components may
# speak to each other. The hashes say whether this particular installation still
# contains the bundle that declared that level. Keeping both avoids the two bad
# shortcuts: requiring every harmless edit to be deployed everywhere, or trusting
# a version marker beside scripts somebody later changed by hand.
#
node_installation="$(/usr/bin/python3 - "$NODE_API" "${SCRIPTS[@]}" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

scripts = {}
for name in sys.argv[2:]:
    scripts[name] = hashlib.sha256((Path("node") / name).read_bytes()).hexdigest()
print(
    json.dumps(
        {"schema_version": 1, "node_api": int(sys.argv[1]), "scripts": scripts},
        sort_keys=True,
    )
)
PY
)"
install_file /etc/haproxy-manager/node-installation.json root:root 644 "$node_installation"
log "  recorded node API ${NODE_API} and ${#SCRIPTS[@]} script digests"

step "Node configuration"

#
# One root-owned file holds everything environment-specific the node scripts
# need. Before this existed, the same script was maintained in three variants
# that differed only in the publication path - which is exactly the kind of drift
# that survives for years because each copy looks correct on its own.
#
#
# node.conf is sourced as root, so every extra path is held to the pattern the
# state export applies to it: nothing that could quote, expand or glob.
#
EXTRA_PATH_PATTERN='^/[A-Za-z0-9._@+/-]+$'
read -r -a extra_paths <<<"${EXTRA_BACKUP_PATHS:-}"
for extra in "${extra_paths[@]}"; do
    [[ "$extra" =~ $EXTRA_PATH_PATTERN && "${extra}/" != *"/../"* && "${extra}/" != *"/./"* \
       && "$extra" != *"//"* && "$extra" != "/" ]] \
        || die "EXTRA_BACKUP_PATHS holds an unusable path: ${extra}"
done
EXTRA_BACKUP_PATHS="${extra_paths[*]}"

node_path="$(cluster_value NODE_PATH "$CLUSTER")"
[[ -n "$node_path" ]] || die "NODE_PATH_${CLUSTER} is not set in the answers file"

[[ -z "${CERT_PULL_USER:-}" ]] || require_vars NODE_CERT_PULL_KEY
node_conf="$(render_node_conf "$CLUSTER" "$node_path" "$LOGREAD_GROUP")"

ensure_dir "$(dirname "$NODE_CONF")" root:root 755
install_file "$NODE_CONF" root:root 600 "$node_conf"

step "Sudo rules"

#
# One rule per command, each naming one absolute path. The forced commands run
# with `sudo -n`, so a mismatch fails immediately instead of trying to prompt for
# a password down a connection that has no terminal.
#
# The certificate rule allows arguments, and that is deliberate: the argument is
# a list of certificate IDs, and sudoers cannot express "a list of validated
# IDs" more strongly than a wildcard would. The real gate is validation in two
# places - unprivileged in haproxy-cert-trigger, then again in the root helper.
# The server state rule is the same shape (Fas 20, B263): the verb `set` is
# fixed, the GUID and the state behind it are validated by
# haproxy-server-state-trigger and again by the helper.
#
sudoers="# Installed by install/04-node-prepare. Do not edit by hand.
#
# One rule per forced command. Each is an exact absolute path, and none of them
# grants a shell, an interpreter, an editor or environment preservation.

${TRIGGER_USER} ALL=(root) NOPASSWD: ${SBIN}/haproxy-pull-deploy
${TRIGGER_USER} ALL=(root) NOPASSWD: ${SBIN}/haproxy-cert-pull
${TRIGGER_USER} ALL=(root) NOPASSWD: ${SBIN}/haproxy-cert-remove
${TRIGGER_USER} ALL=(root) NOPASSWD: ${SBIN}/haproxy-server-state set *
${STATUS_USER} ALL=(root) NOPASSWD: ${SBIN}/haproxy-node-status -c ${CLUSTER} --json
${BACKUP_USER} ALL=(root) NOPASSWD: ${SBIN}/haproxy-state-export"

tmp="$(mktemp)"
printf '%s\n' "$sudoers" > "$tmp"
visudo -cqf "$tmp" || { rm -f "$tmp"; die "generated sudoers file is invalid - nothing installed"; }
install -o root -g root -m 440 "$tmp" /etc/sudoers.d/haproxy-node
rm -f "$tmp"
log "  installed /etc/sudoers.d/haproxy-node"

step "HAProxy baseline"

#
# Both nodes run HAProxy continuously; the virtual address decides which one
# traffic reaches. That only works if the node NOT holding the address can still
# bind it - otherwise HAProxy fails to start there, and the pair is a single node
# with a spare that has never been proven to work.
#
sysctl_file="/etc/sysctl.d/60-haproxy.conf"
sysctl_content="# Installed by install/04-node-prepare.
#
# Let HAProxy bind the virtual address on the node that does not currently own
# it. Without this the standby node cannot start, and the failover it exists for
# has never been exercised.
net.ipv4.ip_nonlocal_bind = 1"

install_file "$sysctl_file" root:root 644 "$sysctl_content"
if [[ "$(sysctl -n net.ipv4.ip_nonlocal_bind)" != "1" ]]; then
    sysctl -q -w net.ipv4.ip_nonlocal_bind=1
    log "  applied  net.ipv4.ip_nonlocal_bind=1"
else
    log "  ok       net.ipv4.ip_nonlocal_bind=1"
fi

if systemctl is-enabled haproxy >/dev/null 2>&1; then
    log "  ok       haproxy is enabled"
else
    warn "haproxy is not enabled on this node. This project manages HAProxy;"
    warn "  it does not install it. Install and enable it before deploying."
fi

step "Keepalived"

#
# Three things are checked rather than written. Keepalived configuration carries
# addresses, interfaces and a shared secret that this script has no business
# guessing - but getting these wrong does not fail loudly, it just quietly makes
# a deploy unsafe, so silence is not an option either.
#
KA_CONF="/etc/keepalived/keepalived.conf"

if [[ ! -f "$KA_CONF" ]]; then
    if [[ -n "$(cluster_value VIP "$CLUSTER")" ]]; then
        warn "cluster ${CLUSTER} has a virtual address but keepalived is not"
        warn "  configured on this node. See docs/user-manual.md, 'HAProxy and keepalived baseline'"
        warn "  for the configuration this project assumes, and why."
    else
        log "  skipped  cluster ${CLUSTER} has no virtual address"
    fi
else
    if grep -q haproxy-keepalived-state "$KA_CONF"; then
        log "  ok       notify lines present"
    else
        warn "keepalived does not notify the state helper. Add to the vrrp_instance:"
        echo
        echo "    notify_master \"${SBIN}/haproxy-keepalived-state MASTER\""
        echo "    notify_backup \"${SBIN}/haproxy-keepalived-state BACKUP\""
        echo "    notify_fault  \"${SBIN}/haproxy-keepalived-state FAULT\""
        echo
        warn "  Without them the management host cannot tell which node owns the"
        warn "  address. A rollout then cannot deploy the owner last, which is the"
        warn "  one thing keeping a bad configuration off the live node."
    fi

    if grep -qE '^\s*state\s+MASTER' "$KA_CONF"; then
        warn "this node is configured as state MASTER."
        warn "  Every node should be BACKUP with nopreempt, so a node that comes"
        warn "  back after a failure does not take live traffic from the others."
    else
        log "  ok       not configured as MASTER"
    fi

    if grep -qE '^\s*nopreempt' "$KA_CONF"; then
        log "  ok       nopreempt is set"
    else
        warn "nopreempt is not set. A recovered node will take the address back,"
        warn "  moving live traffic for no reason - typically mid-rebuild."
    fi

    #
    # The syslog objects' file, read by keepalived only from the top level -
    # the reading `haproxy-pull-deploy` and `haproxy-node-status` make. Written
    # by a person, as the address list's include is: a deploy installs the
    # file and reloads only once keepalived.conf includes it.
    #
    KA_IPVS="/etc/keepalived/ipvs.conf"
    if awk -v wanted="$KA_IPVS" '
        { sub(/[#!].*/, ""); words = split($0, word, " ") }
        depth == 0 && words == 2 && word[1] == "include" && word[2] == wanted { found = 1 }
        { depth += gsub(/\{/, "{") - gsub(/\}/, "}") }
        END { exit !found }
    ' "$KA_CONF"; then
        log "  ok       ${KA_IPVS} is included"
    else
        warn "keepalived.conf does not include ${KA_IPVS} at its top level."
        warn "  Syslog objects are not offered on this cluster until every node does."
        warn "  After a deploy has installed the file, add this line at the end of"
        warn "  keepalived.conf - outside every block - one node at a time:"
        echo
        echo "include ${KA_IPVS}"
        echo
    fi

    #
    # A clean reload does not necessarily produce a VRRP transition, so the file
    # can be missing on a freshly provisioned node that is otherwise correct.
    #
    if [[ -f /run/haproxy/keepalived.state ]]; then
        log "  ok       state file present  ($(cat /run/haproxy/keepalived.state))"
    else
        warn "/run/haproxy/keepalived.state does not exist yet. A config reload"
        warn "  does not always produce a state transition - force one by"
        warn "  restarting keepalived on this node once."
    fi
fi

step "Keys this node fetches with"

#
# Generated here, on the node, and never anywhere else: a private key that a
# node authenticates with has no reason to exist on the management host, and
# copying one there would make the management host able to impersonate a node.
#
# The public halves are printed for the operator to paste on the management
# host, which is the mirror image of step 3 - and manual for the same reason.
#
generate_pull_key() {
    local path="$1" comment="$2"
    if [[ -f "$path" ]]; then
        log "  ok       ${path}"
        return
    fi
    install -o root -g root -m 700 -d "$(dirname "$path")"
    ssh-keygen -t ed25519 -N "" -C "$comment" -f "$path" >/dev/null
    chown root:root "$path" "${path}.pub"
    chmod 600 "$path"
    chmod 644 "${path}.pub"
    log "  created  ${path}"
}

generate_pull_key "$NODE_CONFIG_PULL_KEY" "haproxy-manager config pull"
[[ -n "${NODE_CERT_PULL_KEY:-}" ]] \
    && generate_pull_key "$NODE_CERT_PULL_KEY" "haproxy-manager cert pull"

step "Enrollment block"

#
# Everything the management host needs to know about this node, on one line:
# its name and cluster, the name it suggests being reached at, its host key
# and the public halves of the two fetch keys (B211). The same JSON and the
# same encoding as `node_enrollment.render` on the manager, which a test holds
# together - the manager reads this block, and refuses one it cannot.
#
# Copying it from this console is the trust: the manager takes the host key
# from here rather than asking the network who this node is.
#
HOST_KEY_FILE="${HOST_KEY_FILE:-/etc/ssh/ssh_host_ed25519_key.pub}"
[[ -r "$HOST_KEY_FILE" ]] || die "${HOST_KEY_FILE} is missing; sshd has no ed25519 host key"
ENROLLMENT_BLOCK="$(/usr/bin/python3 - "$CLUSTER" "$(hostname)" "$(hostname -f)" \
    "$HOST_KEY_FILE" "${NODE_CONFIG_PULL_KEY}.pub" "${NODE_CERT_PULL_KEY:+${NODE_CERT_PULL_KEY}.pub}" <<'PY'
import base64
import json
import sys

cluster, name, host, host_key, config_key, cert_key = sys.argv[1:7]


def public(path):
    return " ".join(open(path, encoding="utf-8").read().split()[:2])


document = {
    "cluster": cluster,
    "name": name,
    "host": host,
    "host_key": public(host_key),
    "config_pull_key": public(config_key),
}
if cert_key:
    document["cert_pull_key"] = public(cert_key)
encoded = base64.urlsafe_b64encode(json.dumps(document, separators=(",", ":")).encode())
print("haproxy-node-v1:" + encoded.decode())
PY
)"

echo
log "step 4 done on this node"

cat <<INTRO

Two things left, both on machines this node cannot write to.

1. On THIS node: paste the authorized_keys lines printed by step 3. The file is
   root's, as is the whole home; edit it with sudo.

2. On the MANAGEMENT host: paste this block into the cluster's Nodes card under
   Settings, or give it to  sudo haproxy-node add -c ${CLUSTER} --host <name>
   on stdin. The manager then asks this node for its status, and takes the
   change back if the node does not answer as itself.

${ENROLLMENT_BLOCK}

   Host key: $(ssh-keygen -lf "$HOST_KEY_FILE" | cut -d' ' -f2)

Where the runtime policy names no pull_account, add these lines by hand instead.
rrsync is what limits each key to reading one tree - without it the forced
command is a full rsync, which is a shell in all but name.

INTRO

pub() { cut -d' ' -f1,2 < "$1"; }

echo "  /home/${PULL_USER}/.ssh/authorized_keys    (owner ${PULL_USER}, mode 600)"
echo
echo "restrict,command=\"rrsync -ro ${PUBLISH_ROOT}\" $(pub "${NODE_CONFIG_PULL_KEY}.pub")"
echo
if [[ -n "${NODE_CERT_PULL_KEY:-}" && -n "${CERT_PULL_USER:-}" && -n "${CERTIFICATE_ROOT:-}" ]]; then
    echo "  /home/${CERT_PULL_USER}/.ssh/authorized_keys   (owner ${CERT_PULL_USER}, mode 600)"
    echo
    echo "restrict,command=\"rrsync -ro ${CERTIFICATE_ROOT}\" $(pub "${NODE_CERT_PULL_KEY}.pub")"
    echo
fi

cat <<'OUTRO'
One line per NODE, not one per cluster: each node has its own key, so a node
that is rebuilt or compromised is revoked on its own.

Accept the management host's host key once from this node, as root, or the first
fetch fails on an unknown host:

  ssh -o StrictHostKeyChecking=ask <management-host> true

When every node is done, back on the management host:
  ./05-verify answers.env
OUTRO
