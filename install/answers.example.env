# Answers file for the installation, optional.
#
# Without one, haprion-setup and every step use the defaults in defaults.sh,
# and the values below ARE those defaults where it has one. Copy this file
# only to choose differently, keep the lines you change, and pass it:
#
#     sudo haprion-setup --answers answers.env
#     sudo ./01-manager-prepare answers.env       # or to one step
#
# Nothing is prompted for. A line that is absent takes its default; a line
# that sets a value to nothing keeps it empty, which is how an installation
# says "no backups" or "no certificate distribution".

# --- Where things live on the management host -------------------------------
#
# Only two paths are fixed by the software: /etc/haprion/runtime-policy.yaml
# (where the code looks unless told otherwise) and /opt/haprion (where
# releases are installed). Everything here is your choice.

CONFIG_ROOT=/srv/haprion/config
PUBLISH_ROOT=/srv/haprion/published
VALIDATION_ROOT=/srv/haprion/validation
CLUSTER_FILE=/etc/haprion/registry/clusters.yaml

# Root-only node state archives written by the management host. Leave empty if
# this installation does not take node backups.
BACKUP_ROOT=/srv/haprion/state-backups

# Central certificate distribution: a directory of deployable PEM files, the
# nodes' certificate source, filled by the certificate flows or by whatever
# else issues your certificates. Leave empty for an installation that deploys
# no certificates; the registry and receivers below then go with it.
CERTIFICATE_ROOT=/srv/certdist/haproxy
# Which certificates exist and where each one goes. Written by the certificate
# flows; created empty by step 2.
CERTIFICATE_REGISTRY=/etc/haprion/registry/certificates.yaml
# Where certificates for machines other than the nodes are published.
RECEIVER_ROOT=/srv/certdist/receivers

# --- Accounts ---------------------------------------------------------------
#
# The project's own accounts, groups and database are not answers: their names
# are fixed (install/accounts.sh), and the installation creates them. What is
# left here is about your machines.

# Local accounts on the NODES that a state backup should capture, beyond the
# service accounts. Operator logins belong here: a rebuilt node with
# no way to log in is not a restored node.
#
# Space-separated. Leave empty if the service accounts are all there is.
OPERATOR_ACCOUNTS=""

# Accounts on the MANAGEMENT HOST that may edit the handwritten configuration -
# core/haproxy.cfg and manual/reservations.yaml - with `sudoedit`. Step 2 renders
# the policy from this and installs it as /etc/sudoers.d/haprion-config-edit.
#
# Space-separated. Leave empty to install no editing policy at all; the
# repositories stay readable either way, and step 2 says it skipped this.
#
# Every path is named in full, so adding a handwritten fragment later means
# adding its line to that file - and removing the fragment means removing the
# line in the same change. `sudoedit` creates a file it does not find, so a rule
# for a path that no longer exists is a way to add a root-owned file to a
# directory HAProxy loads.
CONFIG_EDITORS=""

# Groups a state backup should capture in addition to the accounts' own groups.
# The ones that decide what an operator can do after a restore.
EXTRA_BACKUP_GROUPS=""

# Files of your own on the NODES that a state backup should carry besides the
# product's state - a local kernel option, a site drop-in. Absolute paths,
# space-separated; letters, digits and . _ @ + - / only. Each must exist on
# every node that gets this answers file: a listed path that is missing fails
# that node's backup rather than being skipped.
#
# Leave empty to carry nothing extra.
EXTRA_BACKUP_PATHS=""

# The node-side keys those accounts accept. Made on each NODE, in root's .ssh,
# by 04-node-prepare or the node package, never here; the paths are what the
# node's step writes.
NODE_CONFIG_PULL_KEY=/root/.ssh/id_ed25519_config_pull
NODE_CERT_PULL_KEY=/root/.ssh/id_ed25519_cert_pull

# --- Keys -------------------------------------------------------------------
#
# Separate identities, one job each, so a key that can push configuration cannot
# push certificates or read status, and only the probe key can make a node open
# a connection to an address it is given. Root-owned; no application identity
# can read them.
#
# The probe key is optional: leave it empty and the interface's "Test health
# check" button reports itself unavailable, while everything else works as before.
KEY_DIR=/root/.ssh
CONFIG_DEPLOY_KEY=id_ed25519_config_deploy
CERT_DEPLOY_KEY=id_ed25519_cert_deploy
NODE_STATUS_KEY=id_ed25519_node_status
NODE_PROBE_KEY=id_ed25519_node_probe
NODE_BACKUP_KEY=id_ed25519_node_backup
# Drain, maintenance and ready per server. Optional, like the probe key.
SERVER_STATE_KEY=id_ed25519_server_state
# The public half, one line, as 03-manager-keys prints it. On the nodes:
# 04-node-prepare writes its authorized_keys line from this.
SERVER_STATE_PUBKEY=

# --- Clusters ---------------------------------------------------------------
#
# Clusters are created in the interface - the first by the Dashboard's guide,
# more under Settings - Create cluster - and nothing below is needed for that. The lines here are for an installation
# that names its clusters up front instead; they are read once, when step 2
# first writes the cluster file.
#
# The management host, as a node reaches it by name. Read by 04-node-prepare
# on each node, and needed there: it has no default.
#MANAGER_HOST=mgr.example.com

# Space-separated cluster IDs. Lowercase, and what you will type as -c <id>.
# Default: none.
#CLUSTERS="alpha beta"

# Two clusters is the recommended shape, not the maximum: one carrying
# internal services and one carrying what faces a DMZ, so that a mistake in
# one cannot reach the other. A single cluster works, and so do more. The
# IDs below are placeholders - name them after what they carry.
#
# Traffic logging is not an answers-file switch.  It is enabled independently
# in each cluster's root-owned clusters.yaml entry with `traffic_logging: true`.
# That generator change reaches the nodes at the next publication of an actual
# object change; changing clusters.yaml by itself does not publish anything.
#
# One NODES_<cluster>, one VIP_<cluster> and one SOURCE_<cluster> per cluster
# above.
#
# NODES_<cluster> is a space-separated list of name:management-hostname pairs.
# The name is what appears in output; the hostname is how the management host
# reaches it.
#
# VIP_<cluster> is the virtual address keepalived moves between the nodes, and
# the address deploy checks ownership of. Every cluster has one.
#
# SOURCE_<cluster> is the address backends connect out from - what a NetScaler
# calls a SNIP. Optional: without it HAProxy leaves from whatever address the
# routing table picks, which is the right answer on a host with one network.
# It must sit in the SAME keepalived virtual_ipaddress block as the VIP, since
# only the node holding an address receives the replies sent to it.

#NODES_alpha="node-a:node-a.example.com node-b:node-b.example.com"
#VIP_alpha=192.0.2.10
#SOURCE_alpha=192.0.2.15

#NODES_beta="node-c:node-c.example.com node-d:node-d.example.com"
#VIP_beta=198.51.100.10
#SOURCE_beta=198.51.100.15

# The subdirectory under a cluster's published tree that its nodes fetch from.
# One short token per cluster; without a line, the cluster's ID - the same
# default as Create cluster's form.
#NODE_PATH_alpha=a
#NODE_PATH_beta=b

# Certificate IDs each cluster references, space-separated, and which one is the
# default. Both may be empty until you deploy certificates.
#CERTIFICATE_IDS_alpha="example.com"
#DEFAULT_CERTIFICATE_alpha=example.com

#CERTIFICATE_IDS_beta="example.com"
#DEFAULT_CERTIFICATE_beta=example.com

# --- The web platform -------------------------------------------------------
#
# Only needed for the platform installation under install/platform/. The CLI
# installs and runs without any of this.

# The name the web interface answers to, and that nginx's certificate is made
# for until a real one is chosen under Settings. It must resolve to this
# machine. Default: hostname -f.
#SERVER_NAME=mgr.example.com

# Reverse proxies in front of the interface whose X-Forwarded-For is believed.
# Addresses or networks, space-separated. Default: none.
TRUSTED_PROXIES=""

# The platform's places are fixed (install/accounts.sh): releases under
# /opt/haprion-ui, ui.toml and its secrets under /etc/haprion, dumps and the
# traffic-log mirror under /var/lib/haprion-ui. A volume of its own is mounted
# at that last path, not configured here (user manual, "Where the data lives").

# Whether this platform's web account may ask for a health probe.
#
# `yes` installs a root-owned socket, group _haprion-web, answered by the probe
# helper. It is not a sudo rule: the web unit forbids gaining privilege at all,
# so the request travels to the privilege instead of the other way round.
#
# It is what the form's *Test health check* asks. `no` leaves it out, and the
# interface then says the probe is unavailable.
PROBE_SOCKET=yes

# The uv that platform step 14 builds the certbot environment with - a
# deployment fact about this machine, answered once here. An environment
# variable of the same name still wins, for the one-off case of testing a
# different version.
#UV_BIN=/opt/tools/uv/bin/uv
