# Answers file for the installation scripts.
#
# Copy to answers.env, edit, and pass to each script:
#
#     sudo ./01-manager-prepare answers.env
#
# Nothing is prompted for. Everything an installation needs to decide is in this
# one file, so a second installation can be identical to the first, and so a
# review of what is about to happen is a review of one file.
#
# Every value below is an example. None of them are required.

# --- Where things live on the management host -------------------------------
#
# Only two paths are fixed by the software: /etc/haproxy-manager/runtime-policy.yaml
# (where the code looks unless told otherwise) and /opt/haproxy-mgmt (where
# releases are installed). Everything here is your choice.

CONFIG_ROOT=/srv/haproxy-manager/config
PUBLISH_ROOT=/srv/haproxy-manager/published
VALIDATION_ROOT=/srv/haproxy-manager/validation
CLUSTER_FILE=/srv/haproxy-manager/clusters.yaml

# Central certificate distribution. This is an interface the project consumes:
# a directory of deployable PEM files, filled by whatever issues your
# certificates. Leave empty if you are not deploying certificates yet.
CERTIFICATE_ROOT=/srv/certificates/haproxy

# --- Accounts ---------------------------------------------------------------
#
# The read-only configuration group on the management host. Only the worker
# joins it; web and poller do not.
CONFIG_GROUP=haproxy-config

# Node-side service accounts, as they will be created on every node. Each has
# exactly one job and is reached by exactly one key.
TRIGGER_USER=svc-trigger
STATUS_USER=svc-status
BACKUP_USER=svc-backup
LOGREAD_USER=svc-logread

# The accounts on the MANAGEMENT host that nodes authenticate to when they fetch
# things. Each is restricted to a read-only rsync of one tree: PULL_USER the
# published releases, CERT_PULL_USER the certificate distribution directory.
# Separate accounts, because a node that may read configuration has no business
# reading certificates it was not asked for.
PULL_USER=svc-pull
CERT_PULL_USER=svc-cert-pull

# Local accounts on the NODES that a state backup should capture, beyond the
# three service accounts above. Operator logins belong here: a rebuilt node with
# no way to log in is not a restored node.
#
# Space-separated. Leave empty if the service accounts are all there is.
OPERATOR_ACCOUNTS="admin"

# Accounts on the MANAGEMENT HOST that may edit the handwritten configuration -
# core/haproxy.cfg and manual/reservations.yaml - with `sudoedit`. Step 2 renders
# the policy from this and installs it as /etc/sudoers.d/haproxy-config-edit.
#
# Space-separated. Leave empty to install no editing policy at all; the
# repositories stay readable either way, and step 2 says it skipped this.
#
# Every path is named in full, so adding a handwritten fragment later means
# adding its line to that file - and removing the fragment means removing the
# line in the same change. `sudoedit` creates a file it does not find, so a rule
# for a path that no longer exists is a way to add a root-owned file to a
# directory HAProxy loads.
CONFIG_EDITORS="admin"

# Groups a state backup should capture in addition to the accounts' own groups.
# The ones that decide what an operator can do after a restore.
EXTRA_BACKUP_GROUPS="adm sudo"

# The node-side keys those accounts accept. These live on each NODE, in root's
# .ssh, and are created when the node is built - not by these scripts.
NODE_CONFIG_PULL_KEY=/root/.ssh/id_ed25519_config_pull
NODE_CERT_PULL_KEY=/root/.ssh/id_ed25519_cert_pull

# --- Keys -------------------------------------------------------------------
#
# Four separate identities, so a key that can push configuration cannot push
# certificates, neither can read status, and none of them can make a node open a
# connection somewhere. Root-owned; no application identity can read them.
#
# The probe key is optional: leave it empty and the interface's "Test health"
# button reports itself unavailable, while everything else works as before.
KEY_DIR=/root/.ssh
CONFIG_DEPLOY_KEY=id_ed25519_config_deploy
CERT_DEPLOY_KEY=id_ed25519_cert_deploy
NODE_STATUS_KEY=id_ed25519_node_status
NODE_PROBE_KEY=id_ed25519_node_probe

# --- Clusters ---------------------------------------------------------------
#
# The management host, as a node reaches it by name.
MANAGER_HOST=mgr

# Space-separated cluster IDs. Lowercase, and what you will type as -c <id>.
CLUSTERS="alpha beta"

# Two clusters is the recommended shape, not the maximum: one carrying
# internal services and one carrying what faces a DMZ, so that a mistake in
# one cannot reach the other. A single cluster works, and so do more. The
# IDs below are placeholders - name them after what they carry.
#
# One NODES_<cluster>, one VIP_<cluster> and one SOURCE_<cluster> per cluster
# above.
#
# NODES_<cluster> is a space-separated list of name:management-hostname pairs.
# The name is what appears in output; the hostname is how the management host
# reaches it.
#
# VIP_<cluster> is the virtual address keepalived moves between the nodes, and
# the address deploy checks ownership of. Leave empty if the cluster has none.
#
# SOURCE_<cluster> is the address backends connect out from - what a NetScaler
# calls a SNIP. Optional: without it HAProxy leaves from whatever address the
# routing table picks, which is the right answer on a host with one network.
# It must sit in the SAME keepalived virtual_ipaddress block as the VIP, since
# only the node holding an address receives the replies sent to it.

NODES_alpha="node-a:node-a.example.com node-b:node-b.example.com"
VIP_alpha=192.0.2.10
SOURCE_alpha=192.0.2.15

NODES_beta="node-c:node-c.example.com node-d:node-d.example.com"
VIP_beta=198.51.100.10
SOURCE_beta=198.51.100.15

# The subdirectory under a cluster's published tree that its nodes fetch from.
# One short token per cluster.
NODE_PATH_alpha=a
NODE_PATH_beta=b

# Certificate IDs each cluster references, space-separated, and which one is the
# default. Both may be empty until you deploy certificates.
CERTIFICATE_IDS_alpha="example.com"
DEFAULT_CERTIFICATE_alpha=example.com

CERTIFICATE_IDS_beta="example.com"
DEFAULT_CERTIFICATE_beta=example.com

# --- The web platform -------------------------------------------------------
#
# Only needed for the platform installation under install/platform/. The CLI
# installs and runs without any of this.

# Where the application is installed. Releases live under releases/ and are
# switched atomically; config, secrets and data sit beside them so they survive
# a release being replaced or rolled back.
PLATFORM_ROOT=/apps/haproxy-manager

# The read-only group the three services use to reach configuration. A shared
# GROUP, not a shared user: one identity for web, worker and poller would make a
# web intrusion equal to deploy rights.
PLATFORM_GROUP=haproxy-ui

# The three service accounts, each running exactly one service. They are created
# by the sysusers fragment, not by these scripts.
WEB_USER=haproxy-ui-web
WORKER_USER=haproxy-ui-worker
POLLER_USER=haproxy-ui-poller

# Whether this platform's web account may ask for a health probe.
#
# `yes` installs a root-owned socket, group WEB_USER, answered by the probe
# helper. It is not a sudo rule: the web unit forbids gaining privilege at all,
# so the request travels to the privilege instead of the other way round.
#
# Leave it `no` on a development platform. The socket reaches the real nodes,
# and a development platform is built not to.
PROBE_SOCKET=no

# The database, and the roles the services connect as. Each service has its own
# role with its own grants; none of them owns a table or may run migrations.
DB_NAME=haproxy_ui
DB_MIGRATION_ROLE=haproxy-ui-migrate

# The two build tools, named here rather than typed on the command line every
# time. Both are deployment facts about this machine - where uv is unpacked,
# where the development environment lives - and every other deployment fact in
# this installation is answered once, in this file.
#
# Neither belongs to a release. uv builds one, and alembic is deliberately absent
# from every release: it is a development dependency and releases are built with
# --no-dev, so a running service cannot alter the schema it reads.
#
# An environment variable of the same name still wins, for the one-off case of
# testing a different version.
UV_BIN=/opt/tools/uv/bin/uv
ALEMBIC_BIN=/srv/haproxy-manager-dev/venv-ui/bin/alembic
