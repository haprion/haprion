#!/bin/bash
#
# Takes a node installed under the project's earlier name over to Haprion's
# (B266): accounts, groups, directories, forced commands and the files the
# earlier steps wrote. Run by 04-node-prepare, never on its own:
#
#     before   at the start of step 4, before the accounts are made
#     finish   at its end, once the new files are in place
#
# On a node without the earlier installation both phases say so and do
# nothing. Each change is checked before it is made, so a run cut short is
# finished by the next one. Nothing is deleted that holds data: directories
# move, and an account keeps its UID, its groups their GIDs - so every file
# owned by one, and every ACL naming one, stays right.
#
# HAProxy is not restarted and keepalived is not reloaded. keepalived's notify
# lines are rewritten for its next start, and until then the old command path
# is a link to the new one.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=lib.sh
source ./lib.sh

need_root
phase="${1:-}"
[[ "$phase" == before || "$phase" == finish ]] || die "usage: $(basename "$0") before|finish"

OLD_SBIN=/usr/local/sbin
OLD_SCRIPTS=(
    pull-deploy cert-pull cert-remove cert-trigger node-status health-probe keepalived-state
    state-export traffic-log-read traffic-log-enable traffic-log-prune server-state
    server-state-trigger
)
# Earlier name -> fixed name (accounts.sh). The traffic-log reader was an
# answer then; it is read from the group that granted it, below.
OLD_ACCOUNTS=(
    "haproxy-trigger:${TRIGGER_USER}"
    "haproxy-status:${STATUS_USER}"
    "haproxy-backup:${BACKUP_USER}"
)
OLD_GROUPS=(
    "haproxy-logread:${LOGS_GROUP}"
    "haproxy-waf:${WAF_GROUP}"
    "haproxy-dns:${DNS_GROUP}"
)
OLD_FILES=(
    /etc/sudoers.d/haproxy-node
    /etc/tmpfiles.d/haproxy-manager-waf.conf
    /etc/tmpfiles.d/haproxy-manager-waf-engine.conf
    /etc/tmpfiles.d/haproxy-manager-dns.conf
    /etc/systemd/system/coraza-spoa.service.d/haproxy-manager.conf
    /etc/systemd/system/dnsdist.service.d/haproxy-manager.conf
    /etc/systemd/system/haproxy.service.d/haproxy-manager-server-state.conf
)
OLD_TRAFFIC_RULE=/etc/rsyslog.d/48-haproxy-manager-traffic.conf
OLD_APPARMOR=/etc/apparmor.d/rsyslog.d/haproxy-manager-traffic
OLD_PRUNE=haproxy-traffic-log-prune
KA_CONF=/etc/keepalived/keepalived.conf
#
# Set by `before` when the node's traffic log was switched on, read by
# `finish`, which switches the new route on in its place.
#
TRAFFIC_MARKER=/var/lib/haprion/.migrated-traffic-log

#
# Any one of them: a run cut short leaves some, and the next run finishes it.
#
legacy() {
    local path
    for path in /etc/haproxy-manager /var/lib/haproxy-manager /var/log/haproxy-manager \
                "${OLD_SBIN}/haproxy-pull-deploy" "$OLD_TRAFFIC_RULE" "${OLD_FILES[@]}"; do
        [[ ! -e "$path" ]] || return 0
    done
    id -u haproxy-trigger >/dev/null 2>&1 || getent group haproxy-logread >/dev/null
}

#
# A directory moved whole when the new one does not exist yet; merged entry by
# entry when it does - an entry present in both is a conflict, and stops.
#
move_dir() {
    local old="$1" new="$2" entry
    [[ -d "$old" ]] || return 0
    if [[ ! -e "$new" ]]; then
        mv -T "$old" "$new"
        log "  moved    ${old} -> ${new}"
        return 0
    fi
    while IFS= read -r -d '' entry; do
        [[ ! -e "${new}/${entry##*/}" ]] || die "${entry} and ${new}/${entry##*/} both exist; resolve by hand"
        mv "$entry" "${new}/"
    done < <(find "$old" -mindepth 1 -maxdepth 1 -print0)
    rmdir "$old"
    log "  merged   ${old} into ${new}"
}

rename_account() {
    local old="$1" new="$2"
    if ! id -u "$old" >/dev/null 2>&1; then
        if id -u "$new" >/dev/null 2>&1; then log "  ok       ${new}"; else log "  absent   ${old}"; fi
        return 0
    fi
    ! id -u "$new" >/dev/null 2>&1 || die "both ${old} and ${new} exist; resolve by hand"
    #
    # usermod refuses an account with a running process. The manager's own
    # services are stopped while it migrates, so nothing should be connected
    # as this account; if something is, the step stops and says what.
    #
    ! pgrep -u "$old" >/dev/null \
        || die "${old} has running processes ($(pgrep -u "$old" -d, )); stop what connects as it and rerun"
    usermod -l "$new" "$old"
    if getent group "$old" >/dev/null && ! getent group "$new" >/dev/null; then
        groupmod -n "$new" "$old"
    fi
    if [[ -d "/home/${old}" && ! -e "/home/${new}" ]]; then
        usermod -d "/home/${new}" -m "$new"
    else
        usermod -d "/home/${new}" "$new"
    fi
    log "  renamed  ${old} -> ${new}  (uid $(id -u "$new"))"
}

rename_group() {
    local old="$1" new="$2"
    if ! getent group "$old" >/dev/null; then
        log "  ok       ${new}"
        return 0
    fi
    ! getent group "$new" >/dev/null || die "both groups ${old} and ${new} exist; resolve by hand"
    groupmod -n "$new" "$old"
    log "  renamed  group ${old} -> ${new}"
}

#
# The forced commands the manager's keys run, now under /usr/sbin and by their
# new names; the status command no longer names its cluster, which node.conf
# holds (B266). The keys themselves are unchanged.
#
rewrite_keys() {
    local keys="/home/$1/.ssh/authorized_keys"
    [[ -f "$keys" ]] || return 0
    grep -q "${OLD_SBIN}/haproxy-" "$keys" || { log "  ok       ${keys}"; return 0; }
    cp -a "$keys" "${keys}.pre-haprion"
    sed -i -E \
        -e "s#${OLD_SBIN}/haproxy-node-status -c [A-Za-z0-9_-]+ --json#/usr/sbin/haprion-node-status --json#g" \
        -e "s#${OLD_SBIN}/haproxy-#/usr/sbin/haprion-#g" \
        "$keys"
    log "  rewrote  ${keys}  (copy: ${keys}.pre-haprion)"
}

before() {
    if ! legacy; then
        log "  none     no earlier installation on this node"
        return 0
    fi

    step "Earlier installation: the traffic log route"
    #
    # Off before its directory moves: rsyslog would otherwise create the old
    # directory again with the next day's file. HAProxy's lines go to the
    # distribution's own log meanwhile, and `finish` switches the new route on.
    #
    if systemctl cat "${OLD_PRUNE}.timer" >/dev/null 2>&1; then
        systemctl disable --now --quiet "${OLD_PRUNE}.timer" || true
        rm -f "/etc/systemd/system/${OLD_PRUNE}.timer" "/etc/systemd/system/${OLD_PRUNE}.service"
        log "  removed  ${OLD_PRUNE}.timer"
    fi
    if [[ -f "$OLD_TRAFFIC_RULE" ]]; then
        ensure_dir /var/lib/haprion root:root 700
        touch "$TRAFFIC_MARKER"
        rm -f "$OLD_TRAFFIC_RULE" "$OLD_APPARMOR"
        if [[ -x /usr/lib/rsyslog/reload-apparmor-profile ]]; then
            /usr/lib/rsyslog/reload-apparmor-profile || warn "the rsyslog AppArmor profile did not reload"
        fi
        systemctl restart rsyslog
        log "  off      ${OLD_TRAFFIC_RULE}  (switched on again under the new name at the end)"
    else
        log "  ok       the traffic log route was not on"
    fi

    step "Earlier installation: accounts and groups"
    local pair members reader=""
    if getent group haproxy-logread >/dev/null; then
        members="$(getent group haproxy-logread | cut -d: -f4)"
        [[ "$members" != *,* ]] || die "haproxy-logread has more than one member (${members}); resolve by hand"
        reader="$members"
    fi
    for pair in "${OLD_ACCOUNTS[@]}"; do
        rename_account "${pair%%:*}" "${pair##*:}"
    done
    [[ -z "$reader" ]] || rename_account "$reader" "$LOGREAD_USER"
    for pair in "${OLD_GROUPS[@]}"; do
        rename_group "${pair%%:*}" "${pair##*:}"
    done
    for pair in "$TRIGGER_USER" "$STATUS_USER" "$BACKUP_USER" "$LOGREAD_USER"; do
        rewrite_keys "$pair"
    done

    step "Earlier installation: directories"
    move_dir /etc/haproxy-manager /etc/haprion
    move_dir /var/lib/haproxy-manager /var/lib/haprion
    move_dir /var/log/haproxy-manager /var/log/haprion
    local marker
    for marker in pull-deploy.pending cert-pull.pending; do
        [[ ! -e "/run/haproxy-${marker}" ]] || mv "/run/haproxy-${marker}" "/run/haprion-${marker}"
    done
    [[ ! -e /run/haproxy-manager-server-state.unapplied ]] \
        || mv /run/haproxy-manager-server-state.unapplied /run/haprion-server-state.unapplied

    step "Earlier installation: commands, rules and drop-ins"
    local script file
    for script in "${OLD_SCRIPTS[@]}"; do
        file="${OLD_SBIN}/haproxy-${script}"
        [[ -e "$file" || -L "$file" ]] || continue
        rm -f "$file"
        log "  removed  ${file}"
    done
    for file in "${OLD_FILES[@]}"; do
        [[ -e "$file" ]] || continue
        rm -f "$file"
        log "  removed  ${file}"
    done
    systemctl daemon-reload

    step "Earlier installation: keepalived"
    if [[ -f "$KA_CONF" ]] && grep -q "${OLD_SBIN}/haproxy-keepalived-state" "$KA_CONF"; then
        cp -a "$KA_CONF" "${KA_CONF}.pre-haprion"
        sed -i "s#${OLD_SBIN}/haproxy-keepalived-state#/usr/sbin/haprion-keepalived-state#g" "$KA_CONF"
        log "  rewrote  notify lines in ${KA_CONF}  (copy: ${KA_CONF}.pre-haprion)"
        #
        # The running keepalived still holds the old path and calls it on its
        # next transition. Not reloaded here, so a node in service keeps its
        # address; the link answers until keepalived next starts, and can go then.
        #
        ln -sfn /usr/sbin/haprion-keepalived-state "${OLD_SBIN}/haproxy-keepalived-state"
        log "  linked   ${OLD_SBIN}/haproxy-keepalived-state -> /usr/sbin/haprion-keepalived-state"
        log "           (remove it after keepalived has restarted)"
    else
        log "  ok       no notify line names the earlier path"
    fi
}

finish() {
    if [[ -f "$TRAFFIC_MARKER" ]]; then
        step "Earlier installation: the traffic log route, again"
        /usr/sbin/haprion-traffic-log-enable
        rm -f "$TRAFFIC_MARKER"
    fi
}

"$phase"
