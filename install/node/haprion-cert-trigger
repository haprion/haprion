#!/bin/bash
#
# The forced command for the certificate trigger key.
#
# Runs unprivileged, as the trigger account. Its whole job is to turn the
# client's requested command into a validated argument list and hand that to the
# root helper - the escalation happens after the validation, not before it, so
# root never parses anything a client sent.
#
# The root helper validates the same IDs again. That is deliberate: this wrapper
# protects against a leaked trigger key, and the re-validation protects against
# this wrapper being replaced or bypassed. Neither is redundant with the other.
#
# Why the arguments arrive this way at all: the client cannot run its own
# command - `command=` in authorized_keys sees to that - so the request lands in
# SSH_ORIGINAL_COMMAND, which is read here, while it is still unprivileged data
# in an unprivileged process. The root helper never sees the variable: sudo's
# env_reset strips it, and opening env_keep for it would let client-controlled
# data into root's environment.
#

set -Eeuo pipefail

PULL_HELPER="/usr/sbin/haprion-cert-pull"
REMOVE_HELPER="/usr/sbin/haprion-cert-remove"
MAX_CERTIFICATES=32

# The same pattern the manager validates cluster configuration with. No path
# separators, so an ID cannot name a file outside the distribution directory.
ID_PATTERN='^[a-z0-9][a-z0-9._-]{0,254}$'

fail() {
    echo "ERROR: $*" >&2
    exit 64
}

request="${SSH_ORIGINAL_COMMAND:-}"

[[ -n "$request" ]] || fail "no certificate request was sent"

# Word splitting is what is wanted here, and only here.
read -r -a parts <<< "$request"

#
# Two verbs, two root helpers, and nothing else. `cert-remove` arrived with
# B139; a manager that sends it to a node without this line is answered with
# the "unknown request" below and reports the copy as kept.
#
#
# The CA files a cluster's pools verify against (B276) go through the same two
# helpers with `--authority`: they live in a directory of their own, and are
# fetched from one.
#
FLAGS=()
case "${parts[0]:-}" in
    cert-pull) HELPER="$PULL_HELPER" ;;
    cert-remove) HELPER="$REMOVE_HELPER" ;;
    ca-pull) HELPER="$PULL_HELPER"; FLAGS=(--authority) ;;
    ca-remove) HELPER="$REMOVE_HELPER"; FLAGS=(--authority) ;;
    *) fail "unknown request: ${parts[0]:-<empty>}" ;;
esac

ids=("${parts[@]:1}")

(( ${#ids[@]} > 0 )) || fail "no certificate IDs were requested"
(( ${#ids[@]} <= MAX_CERTIFICATES )) || fail "too many certificate IDs requested"

for id in "${ids[@]}"; do
    [[ "$id" =~ $ID_PATTERN ]] || fail "invalid certificate ID"
done

exec sudo -n "$HELPER" "${FLAGS[@]}" "${ids[@]}"
