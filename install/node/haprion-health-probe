#!/usr/bin/env python3
#
# The forced command for the health probe key.
#
# One question, asked from this node: would a health check reach these servers?
# The answer is worth having from here and nowhere else - the node is what
# connects to a pool, from the address the object leaves from, through whatever
# stands between the two. A probe run on the management host proves a path
# nobody's traffic takes.
#
# Runs unprivileged, as the account the key logs in as. Opening an outbound
# connection needs no privilege, and neither does reading which addresses this
# node currently carries.
#
# An object with a source address is only answerable from the node that holds
# that address. In an active/passive pair the address lives on one node at a
# time, and the other would bind it - `ip_nonlocal_bind` lets that succeed - and
# then fail the route lookup with ENETUNREACH. That reads as a pool that cannot
# be reached, which is the wrong thing to tell somebody: the pool is fine, this
# node simply is not where the question can be asked. So the address is checked
# first and the node says which it is, rather than producing a failure that has
# to be interpreted.
#
# Everything arrives as JSON on stdin and is refused unless it is exactly what
# this expects. The key can do nothing else - `command=` in authorized_keys sees
# to that - so this file is the whole surface, and it treats every field as
# something a client chose.

from __future__ import annotations

import contextlib
import ipaddress
import json
import os
import re
import socket
import ssl
import subprocess
import sys
import time
from concurrent.futures import ThreadPoolExecutor
from typing import IO, Any, NoReturn


def _digits(text: str, limit: int = 18) -> bool:
    """One to `limit` ASCII digits; `isdigit()` alone passes `²`, which `int()` refuses.

    The engine's `haprion.digits.is_digits`, which a node script cannot import.
    """
    return 0 < len(text) <= limit and text.isascii() and text.isdigit()


SCHEMA_VERSION = 1

# A request is small. The cap stops a client from making this read forever.
MAX_REQUEST_BYTES = 64 * 1024

# One object's pool, not a scan. A cluster's pools are small, and a probe that
# accepted hundreds of targets would be a port scanner with an SSH key.
MAX_TARGETS = 20

# Bounded on both ends. Too short reports a healthy server as unreachable; too
# long lets one request hold this connection open far past any usefulness.
MIN_TIMEOUT_MS = 100
MAX_TIMEOUT_MS = 5000
DEFAULT_TIMEOUT_MS = 2000

HOST = re.compile(r"^[A-Za-z0-9]([A-Za-z0-9._-]{0,253}[A-Za-z0-9])?$")
PATH = re.compile(r"^/[!-~]{0,1023}$")
HEADER_VALUE = re.compile(r"^[!-~]([ -~]{0,253}[!-~])?$")
#
# A pool verified against one of the cluster's own CAs (B276) names it, and the
# manager sends that CA with the request: this runs unprivileged and cannot read
# the node's copy, which sits beside the private keys (26-10-12). The engine's
# CERTIFICATE_ID; a bundle is a root and an intermediate or two.
#
CA_ID = re.compile(r"^[a-z0-9][a-z0-9._-]{0,254}$")
MAX_AUTHORITIES = 8
MAX_AUTHORITY_BYTES = 16 * 1024
#
# Assembled rather than written out: a literal PEM header in a tracked file is
# what the repository's secret scanner exists to catch (as haprion-node-status).
#
CERTIFICATE_OPENING = "-" * 5 + "BEGIN CERTIFICATE" + "-" * 5


class Refused(Exception):
    """The request was not something this is willing to act on."""


def refuse(message: str) -> NoReturn:
    raise Refused(message)


def text(
    payload: dict[str, Any],
    key: str,
    pattern: re.Pattern[str],
    *,
    required: bool = True,
    default: str = "",
) -> str:
    value = payload.get(key, default)
    if value is None or value == "":
        if required:
            refuse(f"{key} is required")
        return ""
    if not isinstance(value, str) or not pattern.fullmatch(value):
        refuse(f"{key} is not usable")
    return value


def port_of(payload: dict[str, Any], key: str) -> int:
    value = payload.get(key)
    if not isinstance(value, int) or isinstance(value, bool) or not 1 <= value <= 65535:
        refuse(f"{key} must be a port number")
    return value


def flag(payload: dict[str, Any], key: str) -> bool:
    value = payload.get(key, False)
    if not isinstance(value, bool):
        refuse(f"{key} must be true or false")
    return value


#
# A dns check's question (B253), held to the object model's own rules: a name
# of labels, and one of the types a check may ask.
#
DNS_NAME = re.compile(
    r"^(?=.{1,254}$)(?:[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?\.)*"
    r"[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?\.?$"
)
DNS_TYPES = {"A": 1, "NS": 2, "SOA": 6, "MX": 15, "TXT": 16, "AAAA": 28}
RCODES = {0: "NOERROR", 1: "FORMERR", 2: "SERVFAIL", 3: "NXDOMAIN", 4: "NOTIMP", 5: "REFUSED"}


def dns_question(entry: dict[str, Any]) -> dict[str, str]:
    """The question and the address it is asked of, refused unless each is exactly that."""

    name = entry.get("query_name")
    if not isinstance(name, str) or not DNS_NAME.fullmatch(name):
        refuse("a target's query_name is not a DNS name")
    kind = entry.get("query_type")
    if kind not in DNS_TYPES:
        refuse(f"a target's query_type must be one of: {', '.join(DNS_TYPES)}")
    address = entry.get("address")
    #
    # A string first: `ip_address` takes a number too, and a number reached
    # `":" in` below as a traceback rather than a refusal (26-10-18).
    #
    try:
        if not isinstance(address, str):
            raise ValueError(address)
        ipaddress.ip_address(address)
    except ValueError:
        refuse("a dns target's address must be an IP address")
    return {"query_name": name, "query_type": kind, "address": address}


def server_host(entry: dict[str, Any]) -> str:
    """A server's name, or its address - IPv6 too, which the name rule does not take."""

    host = entry.get("host")
    if not isinstance(host, str):
        return text(entry, "host", HOST)
    try:
        ipaddress.ip_address(host)
    except ValueError:
        return text(entry, "host", HOST)
    return host


def udp_receiver(entry: dict[str, Any]) -> str:
    """A udp check's receiver: an address, as keepalived and IPVS take it (Fas 19b B5)."""

    host = entry.get("host")
    try:
        if not isinstance(host, str):
            raise ValueError(host)
        ipaddress.ip_address(host)
    except ValueError:
        refuse("a udp target's host must be an IP address")
    return host


def read_request(stream: IO[bytes]) -> dict[str, Any]:
    raw = stream.read(MAX_REQUEST_BYTES + 1)
    if len(raw) > MAX_REQUEST_BYTES:
        refuse("the request is too large")
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        refuse("the request is not JSON")
    if not isinstance(payload, dict):
        refuse("the request is not an object")
    if payload.get("schema_version") != SCHEMA_VERSION:
        refuse(f"schema_version must be {SCHEMA_VERSION}")

    timeout = payload.get("timeout_ms", DEFAULT_TIMEOUT_MS)
    if not isinstance(timeout, int) or isinstance(timeout, bool):
        refuse("timeout_ms must be a number of milliseconds")
    timeout = max(MIN_TIMEOUT_MS, min(MAX_TIMEOUT_MS, timeout))

    #
    # The address the object leaves from, when it names one. Refused rather
    # than ignored if it is not an address this node can bind: a probe that
    # quietly left from a different address would answer a question nobody
    # asked, and the whole point of asking here is which path is taken.
    #
    # Absent is `None`, and never the empty string. The two say the same thing
    # to every reader below - no source was named - but only one of them is a
    # value `bind` would take, and an empty address binds every interface.
    # Keeping it out of the field means no path through this file can carry one
    # to the socket.
    #
    source = payload.get("source")
    if source is not None and not isinstance(source, str):
        refuse("source must be an address")
    if not source:
        source = None
    #
    # Checked as an address here, and not only where it is used. `holds` keeps
    # anything unbindable away from `bind` by comparing it with the node's own
    # addresses, so nothing reaches the socket - but this was the one field in
    # the request with no format of its own, in a function whose whole claim is
    # that every field has one. A refusal that names the field beats a request
    # that travels and answers "not here".
    #
    if source:
        try:
            ipaddress.ip_address(source)
        except ValueError:
            refuse("source must be an IP address")

    def min_version_of(entry: dict[str, Any]) -> str:
        """Which floor this target asks for, refusing anything not on the list.

        Absent is the default rather than an error: a manager older than this
        field sends none, and a probe that refused the whole request over it
        would take a working path away to gain nothing.
        """

        asked = entry.get("min_version")
        if asked is None:
            return DEFAULT_MIN_VERSION
        if not isinstance(asked, str) or asked not in MIN_VERSIONS:
            refuse(f"a target's min_version must be one of: {', '.join(MIN_VERSIONS)}")
        return asked

    targets = payload.get("targets")
    if not isinstance(targets, list) or not targets:
        refuse("targets must be a non-empty list")
    if len(targets) > MAX_TARGETS:
        refuse(f"at most {MAX_TARGETS} targets may be probed at once")

    authorities = payload.get("authorities", {})
    if not isinstance(authorities, dict) or len(authorities) > MAX_AUTHORITIES:
        refuse("authorities must be an object of at most 8 CAs")
    for name, pem in authorities.items():
        if not CA_ID.fullmatch(name):
            refuse("an authority's id is not usable")
        if (
            not isinstance(pem, str)
            or len(pem) > MAX_AUTHORITY_BYTES
            or "PRIVATE KEY" in pem
            or CERTIFICATE_OPENING not in pem
        ):
            refuse(f"the authority {name} is not a certificate bundle")

    read: list[dict[str, Any]] = []
    for entry in targets:
        if not isinstance(entry, dict):
            refuse("a target is not an object")
        kind = entry.get("type")
        if kind not in ("tcp", "http", "dns", "udp"):
            refuse("a target's type must be tcp, http, dns or udp")
        read.append(
            {
                "host": udp_receiver(entry) if kind == "udp" else server_host(entry),
                "port": port_of(entry, "port"),
                "type": kind,
                "tls": flag(entry, "tls"),
                "verify": flag(entry, "verify"),
                "path": text(entry, "path", PATH, required=False, default="/") or "/",
                "host_header": text(entry, "host_header", HOST, required=False),
                "min_version": min_version_of(entry),
                "ca": text(entry, "ca", CA_ID, required=False),
                **(dns_question(entry) if kind == "dns" else {}),
            }
        )
    for target in read:
        if target["ca"] and target["ca"] not in authorities:
            refuse(f"the CA {target['ca']} was named but not sent")
        target["ca_pem"] = authorities.get(target["ca"], "") if target["ca"] else ""
    return {"timeout_ms": timeout, "source": source, "targets": read}


#
# Fixed argv, and nothing from the request reaches it. `ip` is asked rather than
# the address being bound as a test, because `ip_nonlocal_bind` makes binding a
# foreign address succeed - the very thing that made this ambiguous.
#
IP_COMMANDS = ("/usr/sbin/ip", "/sbin/ip", "/usr/bin/ip", "/bin/ip")
ADDRESS_ARGUMENTS = ("-4", "-o", "addr", "show")
ADDRESS_LINE = re.compile(r"\binet\s+([0-9.]+)/")


def local_addresses() -> set[str] | None:
    """Every IPv4 address this node carries right now, secondaries included.

    Empty when `ip` cannot be run at all. An empty set would make every source
    look foreign, so the caller treats "could not tell" as "do not refuse" - a
    node that cannot answer this question must not turn into a node that
    silently declines to probe.
    """

    binary = next((path for path in IP_COMMANDS if os.path.exists(path)), "")
    if not binary:
        return None
    try:
        completed = subprocess.run(  # noqa: S603 - fixed argv, nothing from the request
            [binary, *ADDRESS_ARGUMENTS],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if completed.returncode != 0:
        return None
    return {match.group(1) for match in ADDRESS_LINE.finditer(completed.stdout)}


#
# What a target may ask to be reached over. The names are the ones the object
# model uses, so a policy and a probe cannot come to mean different things by
# the same word; `tls_policy.BACKEND_MIN_VERSION` is the other half.
#
# TLS 1.0 is deliberately absent. The lowest an object may choose is 1.1, and a
# probe that could go lower than the configuration would answer a question
# nobody can act on.
#
MIN_VERSIONS = {
    "TLSv1.1": ssl.TLSVersion.TLSv1_1,
    "TLSv1.2": ssl.TLSVersion.TLSv1_2,
    "TLSv1.3": ssl.TLSVersion.TLSv1_3,
}
DEFAULT_MIN_VERSION = "TLSv1.2"


def holds(source: str | None, addresses: set[str] | None) -> bool:
    """Whether this node can answer for an object leaving from `source`.

    No source is every node's question. A source this node carries is its
    question too. Anything else belongs to whichever node holds the address.
    """

    if not source:
        return True
    if addresses is None:
        return True
    return source in addresses


def connect(target: dict[str, Any], timeout: float, source: str | None) -> socket.socket:
    """One connection, and the reason it failed if it did."""

    #
    # IPv6 when the server is an IPv6 address (review 26-10-08, F5); a name is
    # looked up as IPv4, as before.
    #
    family = socket.AF_INET6 if ":" in target["host"] else socket.AF_INET
    sock = socket.socket(family, socket.SOCK_STREAM)
    sock.settimeout(timeout)
    if source:
        #
        # Port 0: the address is what is being chosen, never the port. Binding
        # a port here would collide with itself on a second probe.
        #
        sock.bind((source, 0))
    sock.connect((target["host"], target["port"]))
    if not target["tls"]:
        return sock

    #
    # Against the pool's own CA when it has one, and that CA alone - what
    # HAProxy's `ca-file` trusts. The node's store would refuse an internal CA
    # that the node's check accepts (26-10-12).
    #
    authority = target["ca_pem"] if target["verify"] and target["ca_pem"] else None
    context = ssl.create_default_context(cadata=authority)
    #
    # Said rather than inherited. `create_default_context` leaves the floor to
    # whatever OpenSSL on the node happens to be built with, so the same probe
    # against the same pool could negotiate differently on two nodes and the
    # answer would describe the node rather than the backend.
    #
    # The floor is the object's, not this script's. HAProxy will reach the pool
    # under the policy the object names, and a probe holding a floor of its own
    # would refuse a backend HAProxy accepts - reporting a healthy pool as
    # broken, which is worse than not asking. TLS 1.2 when nothing says
    # otherwise, which is what a manager too old to send the field means.
    #
    context.minimum_version = MIN_VERSIONS[target["min_version"]]
    if context.minimum_version < ssl.TLSVersion.TLSv1_2:
        #
        # OpenSSL's security level is the second gate and refuses the old
        # versions whatever the minimum says. HAProxy's own `server` line pays
        # the same price for the same reach, so the probe pays it too - and only
        # for the target that asked, never for the rest of the request.
        #
        context.set_ciphers("DEFAULT@SECLEVEL=0")
    #
    # The handshake HAProxy's own check makes, and no other. Where the pool is
    # verified the check names the server (`check-sni`, B413) and HAProxy
    # holds the certificate to that name - "Server presented an SSL
    # certificate different from the expected one", measured on 3.4.7 on
    # 2026-10-31 - so this does both. Elsewhere it sends no name and checks
    # none, as the node does. The Host header is never the name: this sent it
    # as SNI until 2026-09-30, and a backend could then answer here and still
    # be marked down on the node - the one kind of answer a probe must not give.
    #
    if not target["verify"]:
        context.check_hostname = False
        context.verify_mode = ssl.CERT_NONE
        return context.wrap_socket(sock)
    return context.wrap_socket(sock, server_hostname=target["host"])


def http_status(
    stream: socket.socket, target: dict[str, Any], timeout: float, deadline: float
) -> int | None:
    """The status line of a GET, and nothing else that came back.

    The body is not read and never reported. This runs on a proxy node with a
    key somebody else holds, and a probe that returned what a backend said
    would be a way to read pages through it.
    """

    host = target["host_header"] or (
        f"[{target['host']}]" if ":" in target["host"] else target["host"]
    )
    request = (
        f"GET {target['path']} HTTP/1.1\r\n"
        f"Host: {host}\r\n"
        "User-Agent: haprion-health-probe\r\n"
        "Connection: close\r\n"
        "Accept: */*\r\n"
        "\r\n"
    )
    stream.sendall(request.encode("ascii"))
    stream.settimeout(timeout)

    line = b""
    while b"\r\n" not in line and len(line) < 256:
        #
        # Each recv has the timeout; the line as a whole has the deadline, or
        # a server sending a byte at a time would hold the probe for minutes.
        #
        if time.monotonic() > deadline:
            raise TimeoutError
        chunk = stream.recv(64)
        if not chunk:
            break
        line += chunk
    parts = line.split(b"\r\n", 1)[0].decode("latin-1").split(" ")
    if len(parts) < 2 or not _digits(parts[1]):
        return None
    return int(parts[1])


def dns_ask(target: dict[str, Any], timeout: float, source: str | None) -> tuple[int, str | None]:
    """One question, as dnsdist's health check asks it, and the answer's code.

    dnsdist 2.1 (`dnsdist-healthchecks.cc`): a query with RD set and no EDNS,
    over UDP, class IN; the answer counts when its ID matches, QR is set, the
    question comes back unchanged and the code is not SERVFAIL - NXDOMAIN and
    REFUSED count, since no object asks `mustResolve`. Anything else is a
    sentence. The answer's records are never read or returned.
    """

    query_id = int.from_bytes(os.urandom(2), "big")
    labels = [label for label in target["query_name"].rstrip(".").split(".") if label]
    question = b"".join(bytes([len(label)]) + label.encode("ascii") for label in labels) + b"\0"
    question += DNS_TYPES[target["query_type"]].to_bytes(2, "big") + (1).to_bytes(2, "big")
    header = query_id.to_bytes(2, "big") + (0x0100).to_bytes(2, "big") + (1).to_bytes(2, "big")
    header += bytes(6)
    family = socket.AF_INET6 if ":" in target["address"] else socket.AF_INET
    sock = socket.socket(family, socket.SOCK_DGRAM)
    try:
        sock.settimeout(timeout)
        if source:
            sock.bind((source, 0))
        sock.sendto(header + question, (target["address"], target["port"]))
        while True:
            answer, _sender = sock.recvfrom(4096)
            if len(answer) >= 12 and int.from_bytes(answer[:2], "big") == query_id:
                break
    finally:
        sock.close()
    flags = int.from_bytes(answer[2:4], "big")
    rcode = flags & 0x0F
    if not flags & 0x8000:
        return rcode, "the answer is not a response"
    if answer[12 : 12 + len(question)].lower() != question.lower():
        return rcode, "the answer is about another question"
    if rcode == 2:
        return rcode, "answered SERVFAIL"
    return rcode, None


def udp_refused(target: dict[str, Any], timeout: float, source: str | None) -> str | None:
    """Whether the receiver's host says nothing listens there, as keepalived's `UDP_CHECK` asks.

    One empty datagram from this node's own address, and then a wait for the
    ICMP error that a closed port or a host that is gone sends back, which the
    kernel reports on the connected socket (Fas 19b B5). Silence is not
    refusal, and keepalived counts it as up; so does this, and the page says
    what that cannot tell apart - a receiver from a path that drops the
    datagram. An answer of any kind counts as up too: something listens.

    Empty, so a receiver that does take it has no message to store.
    """

    family = socket.AF_INET6 if ":" in target["host"] else socket.AF_INET
    sock = socket.socket(family, socket.SOCK_DGRAM)
    try:
        sock.settimeout(timeout)
        if source:
            sock.bind((source, 0))
        sock.connect((target["host"], target["port"]))
        sock.send(b"")
        try:
            sock.recv(1)
        except TimeoutError:
            return None
        except ConnectionRefusedError:
            return "refused: nothing listens on the port"
        return None
    finally:
        sock.close()


def probe(target: dict[str, Any], timeout_ms: int, source: str | None) -> dict[str, Any]:
    timeout = timeout_ms / 1000
    started = time.monotonic()
    #
    # One timeout each for the connection, the TLS handshake and the answer:
    # the most one target may take, whatever it does (review 2026-09-28).
    #
    deadline = started + 3 * timeout
    result: dict[str, Any] = {
        "host": target["host"],
        "port": target["port"],
        "ok": False,
        "status": None,
        "error": None,
        "ms": 0,
    }
    stream: socket.socket | None = None
    try:
        if target["type"] == "udp":
            problem = udp_refused(target, timeout, source)
            result["ok"] = problem is None
            result["error"] = problem
            result["ms"] = int((time.monotonic() - started) * 1000)
            return result
        if target["type"] == "dns":
            rcode, problem = dns_ask(target, timeout, source)
            result["status"] = rcode
            result["ok"] = problem is None
            result["error"] = problem
            result["ms"] = int((time.monotonic() - started) * 1000)
            return result
        stream = connect(target, timeout, source)
        if target["type"] == "http":
            status = http_status(stream, target, timeout, deadline)
            result["status"] = status
            #
            # The same range HAProxy's own default expects. A 500 is a server
            # that answered and is not usable, which is the distinction the
            # check exists to make.
            #
            result["ok"] = status is not None and 200 <= status <= 399
            if status is None:
                result["error"] = "no HTTP status was returned"
            elif not result["ok"]:
                result["error"] = f"answered {status}"
        else:
            result["ok"] = True
    except ssl.SSLError as error:
        result["error"] = f"TLS failed: {error.reason or error}"
    except TimeoutError:
        result["error"] = f"no answer within {timeout_ms} ms"
    except OSError as error:
        result["error"] = error.strerror or str(error)
    finally:
        if stream is not None:
            with contextlib.suppress(OSError):
                stream.close()
    result["ms"] = int((time.monotonic() - started) * 1000)
    return result


def main(
    argv: list[str] | None = None, stdin: IO[bytes] | None = None, stdout: IO[str] | None = None
) -> int:
    argv = sys.argv[1:] if argv is None else argv
    stdin = stdin or sys.stdin.buffer
    stdout = stdout or sys.stdout

    #
    # No arguments. The key is forced to this command, and anything after it
    # arrives in SSH_ORIGINAL_COMMAND rather than here - but a copy of this
    # script run by hand with arguments is a different request from the one
    # that was reviewed, so it is refused rather than ignored.
    #
    try:
        if argv:
            refuse("this command takes no arguments")
        request = read_request(stdin)
    except Refused as refusal:
        json.dump(
            {"schema_version": SCHEMA_VERSION, "ok": False, "error": str(refusal), "results": []},
            stdout,
            separators=(",", ":"),
            sort_keys=True,
        )
        stdout.write("\n")
        return 64

    #
    # Asked before anything is attempted. A node that does not hold the source
    # answers that it does not, and probes nothing: every result it could
    # produce would describe the binding rather than the pool.
    #
    source_held = holds(request["source"], local_addresses())
    #
    # All targets at once, as HAProxy checks its servers: one after the other,
    # twenty that do not answer took 40 s at the default timeout and 100 s at
    # the most, past the manager's 30 s for the whole node, and the answer was
    # lost exactly when every server was down (review 2026-09-28). Now a node
    # answers in about the time of its slowest target, three timeouts at most.
    # The results keep the request's order.
    #
    results: list[dict[str, Any]] = []
    if source_held and request["targets"]:
        with ThreadPoolExecutor(max_workers=len(request["targets"])) as pool:
            results = list(
                pool.map(
                    lambda target: probe(target, request["timeout_ms"], request["source"]),
                    request["targets"],
                )
            )
    json.dump(
        {
            "schema_version": SCHEMA_VERSION,
            "ok": True,
            "node": socket.gethostname(),
            #
            # The empty string, not `null`: the answer's shape has not changed
            # with the value the request now carries internally.
            #
            "source": request["source"] or "",
            "source_held": source_held,
            "error": None,
            "results": results,
        },
        stdout,
        separators=(",", ":"),
        sort_keys=True,
    )
    stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
