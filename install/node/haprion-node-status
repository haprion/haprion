keepalived_active = service_active("keepalived")

keepalived_state = read_keepalived_state()

ip_nonlocal_bind: bool | None
try:
    ip_nonlocal_bind = Path("/proc/sys/net/ipv4/ip_nonlocal_bind").read_text().strip() == "1"
except Exception:
