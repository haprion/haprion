def read_installation() -> dict[str, Any]:
    """The installed node package's declared API, version and whether its bytes still match.

    The metadata is written by 04-node-prepare from the same source files it
    installs. The status command recomputes every digest: a copied marker beside
    hand-edited scripts is therefore not accepted as a current installation.
    """

    def installed_scripts(
        expected_scripts: dict[str, str] | None = None,
    ) -> tuple[bool, dict[str, Any]]:
        scripts: dict[str, Any] = {}
        all_current = expected_scripts is not None
        for name in NODE_SCRIPTS:
            try:
                installed = hashlib.sha256((SBIN / name).read_bytes()).hexdigest()
            except Exception:
                installed = None
            expected: str | None = (
                expected_scripts.get(name) if expected_scripts is not None else None
            )
            current = expected is not None and installed == expected
            all_current = all_current and current
            scripts[name] = {
                "expected_sha256": expected,
                "installed_sha256": installed,
                "current": current,
            }
        return all_current, scripts

    try:
        if NODE_INSTALLATION.stat().st_size > MAX_INSTALLATION_BYTES:
            raise ValueError("installation metadata is too large")
        document = json.loads(NODE_INSTALLATION.read_text(encoding="utf-8"))
        if (
            not isinstance(document, dict)
            or document.get("schema_version") != 1
            or type(document.get("node_api")) is not int
            or document["node_api"] < 1
            or not isinstance(document.get("scripts"), dict)
            or set(document["scripts"]) != set(NODE_SCRIPTS)
        ):
            raise ValueError("invalid installation metadata")

        for name, expected in document["scripts"].items():
            if (
                not isinstance(name, str)
                or not re.fullmatch(r"haprion-[a-z0-9-]+", name)
                or not isinstance(expected, str)
                or not SHA256.fullmatch(expected)
            ):
                raise ValueError("invalid script metadata")
        all_current, scripts = installed_scripts(document["scripts"])
        reading: dict[str, Any] = {
            "node_api": document["node_api"],
            "scripts_current": all_current,
            "scripts": scripts,
        }
    except Exception:
        _, scripts = installed_scripts()
        reading = {"node_api": None, "scripts_current": False, "scripts": scripts}
    #
    # Read outside the metadata's `try`: an error reading dpkg is not a node
    # without compatibility metadata (review 26-10-29).
    #
    version, configured = package_state(NODE_PACKAGE)
    reading["version"] = version
    if version is not None:
        reading["configured"] = configured
    return reading


def step_digest(directory: Path) -> str:
    """`step_digest` in node-installation.sh, held to it by a test: sha256sum's
    line for every regular file under the directory, in byte order, digested."""

    lines = b""
    for path in sorted(
        (path for path in directory.rglob("*") if path.is_file() and not path.is_symlink()),
        key=lambda path: str(path.relative_to(directory)).encode(),
    ):
        name = "./" + str(path.relative_to(directory))
        lines += f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {name}\n".encode()
    return hashlib.sha256(lines).hexdigest()


def read_preparation() -> dict[str, bool] | None:
    """Whether the step this package brings is the one that last ran here (B363).

    An upgrade replaces the step and runs nothing; `apt upgrade` says so, but a
    node upgraded unattended is read by nobody. So the status says it, and
    the manager lists the node until `haprion-node-prepare` has run. A node
    with no record has not run this package's step. null when it cannot be read.
    """

    try:
        recorded = (
            NODE_PREPARED.read_text(encoding="ascii").strip() if NODE_PREPARED.exists() else None
        )
        return {"current": recorded is not None and recorded == step_digest(NODE_STEP)}
    except (OSError, ValueError):
        return None


def run(*argv: str) -> subprocess.CompletedProcess[str]:
    #
    # Every caller passes an absolute binary and this script's own names and
    # paths - never anything read from the manager or from a request.
    #
    # Decoded with replacement: another local account's process name can be any
    # bytes (`ss` prints it), and strict decoding stopped the whole status.
    #
    return subprocess.run(  # noqa: S603
        argv, capture_output=True, text=True, errors="replace", check=False
    )


def service_active(name: str) -> bool:
    r = run("/usr/bin/systemctl", "is-active", name)
    return r.returncode == 0 and r.stdout.strip() == "active"


#
# Ports another program holds on every address of this node, which are then
# held on the VIP too: an object there cannot bind them, and the publish says
# so before a deploy fails on it (26-10-15: Checkmk's agent on 0.0.0.0:6556).
# HAProxy's are the publish's own to keep apart. One bound to an interface
# (`0.0.0.0%eth0`) holds the VIP's port as well when the VIP is on it.
#
WILDCARD_LOCAL = re.compile(r"^(?:0\.0\.0\.0|\*|\[::\])(?:%[\w.-]+)?:(\d+)$")
WILDCARD_PROGRAM = re.compile(r'\(\("([^"]+)"')


def parse_wildcard_listeners(text: str) -> list[dict[str, Any]]:
    """`ss -Hlntup` as [{protocol, port, program}], once per protocol and port."""

    found: dict[tuple[str, int], str | None] = {}
    for line in text.splitlines():
        fields = line.split()
        if len(fields) < 5 or fields[0] not in ("tcp", "udp"):
            continue
        local = WILDCARD_LOCAL.match(fields[4])
        if local is None:
            continue
        named = WILDCARD_PROGRAM.search(fields[6]) if len(fields) > 6 else None
        program = named.group(1)[:64] if named else None
        if program == "haproxy":
            continue
        found.setdefault((fields[0], int(local.group(1))), program)
    return [
        {"protocol": protocol, "port": port, "program": program}
        for (protocol, port), program in sorted(found.items())
    ]


def read_wildcard_listeners() -> list[dict[str, Any]] | None:
    """The ports other programs hold on every address, or None if `ss` gave nothing to read."""

    result = run("/usr/bin/ss", "-Hlntup")
    if result.returncode != 0:
        return None
    return parse_wildcard_listeners(result.stdout)


def wildcard_summary(listeners: list[dict[str, Any]] | None) -> str:
    if listeners is None:
        return "unknown (ss could not be read)"
    if not listeners:
        return "nothing but HAProxy"
    return ", ".join(
        f"{entry['port']}/{entry['protocol']} {entry['program'] or 'unnamed'}"
        for entry in listeners
    )


