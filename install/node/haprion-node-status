#
# dpkg's `want eflag status`, read for the status alone (review 26-10-29, A06):
# a package held to update one node at a time is `hold ok installed`, and was
# reported as not installed. Unpacked or half-configured - a postinst that
# failed - is that version's files, not yet configured.
#
CONFIGURED_STATES = frozenset({"installed", "triggers-awaited", "triggers-pending"})
UNCONFIGURED_STATES = frozenset({"half-installed", "unpacked", "half-configured"})


def package_state(package: str) -> tuple[str | None, bool]:
    """The package's version and whether dpkg configured it; (None, True) when it is not there."""

    r = run("/usr/bin/dpkg-query", "-W", "-f=${Status}\t${Version}", package)
    status, _, version = r.stdout.partition("\t")
    words = status.split()
    state = words[-1] if r.returncode == 0 and len(words) == 3 else ""
    shown = version.strip()[:64] or None
    if state in CONFIGURED_STATES:
        return shown, True
    if state in UNCONFIGURED_STATES:
        return shown, False
    return None, True


def package_version(package: str) -> str | None:
    """The version of a package dpkg configured; None for one it did not, or one not there."""

    version, configured = package_state(package)
    return version if configured else None


