#
# The syslog objects' IPVS virtual servers (Fas 19b, B256): a file the release
# carries, the deploy installs as /etc/keepalived/ipvs.conf, and a person
# includes at the top level of keepalived.conf - the address list's three
# measurements - and the kernel's counters per virtual server and receiver.
# keepalived takes a receiver its check failed out of the table, so one the
# release names and the kernel does not hold is down.
#
KEEPALIVED_IPVS = Path("/etc/keepalived/ipvs.conf")
PUBLISHED_IPVS = Path("/etc/haproxy/current/keepalived/ipvs.conf")
IPVSADM = Path("/usr/sbin/ipvsadm")
MAX_IPVS_ROWS = 500
IPVS_PROTOCOLS = {"TCP": "tcp", "UDP": "udp", "SCTP": "sctp"}


def top_level_include(text: str, path: Path) -> bool:
    """Whether keepalived.conf includes `path` outside every block.

    keepalived reads `virtual_server` only at the top level; the same line
    inside a `vrrp_instance` is a different and broken configuration. Comments
    start with `#` or `!`, as keepalived's own reader takes them.
    """

    depth = 0
    for line in text.splitlines():
        content = re.split(r"[#!]", line, maxsplit=1)[0]
        if depth == 0 and content.split() == ["include", str(path)]:
            return True
        depth += content.count("{") - content.count("}")
    return False


def ipvs_endpoint(text: str) -> tuple[str, int] | None:
    """`192.0.2.1:514` or `[2001:db8::1]:514`, as ipvsadm -n prints one."""

    host, _, port = text.rpartition(":")
    if not host or not _digits(port):
        return None
    return host.strip("[]"), int(port)


def parse_ipvs_stats(text: str) -> list[dict[str, Any]]:
    """`ipvsadm -Ln --stats --exact` as virtual servers and their receivers.

    The shape is ipvsadm 1.31's own (`print_service_entry`): a service line is
    the protocol, the address and port, and five counters - connections,
    packets and bytes in and out - and each receiver below it is `->`, its
    address and port, and the same five. `--exact` prints every counter as a
    whole number. Messages travel one way, so in is what counts. A firewall
    mark service has no address and is passed over.
    """

    services: list[dict[str, Any]] = []
    current: dict[str, Any] | None = None
    for line in text.splitlines():
        fields = line.split()
        readable = len(fields) == 7 and all(_digits(value, 20) for value in fields[2:])
        endpoint = ipvs_endpoint(fields[1]) if readable else None
        if endpoint is None:
            #
            # A service line that cannot be read ends the one before it, so
            # its receivers are never counted under somebody else's service.
            #
            if fields and fields[0] != "->":
                current = None
            continue
        address, port = endpoint
        packets, data = int(fields[3]), int(fields[5])
        if fields[0] in IPVS_PROTOCOLS:
            if len(services) >= MAX_IPVS_ROWS:
                break
            current = {
                "protocol": IPVS_PROTOCOLS[fields[0]],
                "address": address,
                "port": port,
                "packets": packets,
                "bytes": data,
                "receivers": [],
            }
            services.append(current)
        elif fields[0] == "->" and current is not None:
            if len(current["receivers"]) < MAX_IPVS_ROWS:
                current["receivers"].append(
                    {"address": address, "port": port, "packets": packets, "bytes": data}
                )
    return services


def ipvs_summary(ipvs: dict[str, Any]) -> str:
    """The IPVS file in one line, in the address list's order of questions."""

    if ipvs["published"] is False:
        return "none published by this release"
    if ipvs["published_sha256"] is None or ipvs["installed_sha256"] is None:
        return "published, not installed" if ipvs["installed"] is False else "UNKNOWN"
    if ipvs["published_sha256"] != ipvs["installed_sha256"]:
        return "installed file differs from the release"
    if ipvs["included"] is not True:
        return "installed, not included at the top of keepalived.conf"
    if ipvs["services"] is None:
        return "in use, not counted (ipvsadm missing or failed)"
    return "installed and in use"


IPVS_NAMES = re.compile(r"^# object (\S+), pool (\S+)$")
IPVS_BLOCK = re.compile(r"^\s*(virtual_server|real_server)\s+(\S+)\s+(\d+)\s*\{")


def ipvs_key(address: str, port: int) -> tuple[str, int] | None:
    try:
        return str(ipaddress.ip_address(address.strip("[]"))), port
    except ValueError:
        return None


IpvsKey = tuple[str, int]


def ipvs_names(text: str) -> dict[IpvsKey, tuple[str, str, list[IpvsKey]]]:
    """The installed file's names: (address, port) -> (object, pool, receivers in order).

    The generator writes `# object <name>, pool <pool>` above each virtual
    server (`ipvs_config.NAMES`); the receivers are the pool's servers in the
    order written, `s1` first. A virtual server without the line is not ours
    to name.
    """

    names: dict[IpvsKey, tuple[str, str, list[IpvsKey]]] = {}
    pending: tuple[str, str] | None = None
    current: list[IpvsKey] | None = None
    for line in text.splitlines():
        named = IPVS_NAMES.match(line.strip())
        if named:
            pending = (named.group(1), named.group(2))
            continue
        block = IPVS_BLOCK.match(line)
        if not block:
            continue
        kind, address, port = block.group(1), block.group(2), int(block.group(3))
        key = ipvs_key(address, port)
        if kind == "virtual_server":
            current = None
            if pending is not None and key is not None:
                current = []
                names[key] = (pending[0], pending[1], current)
            pending = None
        elif current is not None and key is not None:
            current.append(key)
    return names


def name_ipvs(
    services: list[dict[str, Any]], names: dict[IpvsKey, tuple[str, str, list[IpvsKey]]]
) -> list[dict[str, Any]]:
    """The kernel's services under the objects and pools the installed file names.

    Each named service lists every receiver the file gives it, `s1` first: UP
    with its counters when the kernel holds it, DOWN with none when keepalived
    took it out after a failed check. A service the file does not name is
    reported as the kernel holds it, with no names.
    """

    named: list[dict[str, Any]] = []
    for service in services:
        entry: dict[str, Any] = dict(service, object=None, pool=None)
        key = ipvs_key(service["address"], service["port"])
        found = None if key is None else names.get(key)
        held = {
            ipvs_key(receiver["address"], receiver["port"]): receiver
            for receiver in service["receivers"]
        }
        if found is None or service["protocol"] != "udp":
            entry["receivers"] = [
                dict(receiver, server=None, status="UP") for receiver in service["receivers"]
            ]
            named.append(entry)
            continue
        entry["object"], entry["pool"], order = found
        receivers: list[dict[str, Any]] = []
        for index, key in enumerate(order):
            receiver = held.pop(key, None)
            receivers.append(
                {
                    "address": key[0],
                    "port": key[1],
                    "server": f"s{index + 1}",
                    "status": "DOWN" if receiver is None else "UP",
                    "packets": None if receiver is None else receiver["packets"],
                    "bytes": None if receiver is None else receiver["bytes"],
                }
            )
        receivers.extend(dict(receiver, server=None, status="UP") for receiver in held.values())
        entry["receivers"] = receivers
        named.append(entry)
    return named


def virtual_servers(text: str) -> int:
    """How many virtual servers a generated file holds: each begins a line of its own."""

    return sum(1 for line in text.splitlines() if line.startswith("virtual_server "))


def read_ipvs() -> dict[str, Any]:
    published, published_digest = address_list(PUBLISHED_IPVS)
    installed, installed_digest = address_list(KEEPALIVED_IPVS)
    text = read_config(KEEPALIVED_CONFIG)
    present = IPVSADM.is_file()
    services: list[dict[str, Any]] | None = None
    if present:
        r = run(str(IPVSADM), "-Ln", "--stats", "--exact")
        #
        # null when ipvsadm could not be asked, so a table that could not be
        # read is never reported as one holding nothing.
        #
        services = parse_ipvs_stats(r.stdout) if r.returncode == 0 else None
    installed_text = read_config(KEEPALIVED_IPVS) if installed else None
    #
    # How many virtual servers the release asks for. With the include missing,
    # a file that holds some is syslog objects forwarded nowhere, while one
    # that holds none is how the file arrives (review 26-10-08, F1).
    #
    published_text = read_config(PUBLISHED_IPVS) if published else None
    published_servers = None if published_text is None else virtual_servers(published_text)
    if services is not None:
        services = name_ipvs(services, ipvs_names(installed_text or ""))
    return {
        "ipvsadm": present,
        "published": published,
        "published_sha256": published_digest,
        "published_servers": published_servers,
        "installed": installed,
        "installed_sha256": installed_digest,
        "included": None if text is None else top_level_include(text, KEEPALIVED_IPVS),
        "services": services,
    }


#
# rsyslog's forwarding to the cluster's external receivers (B286, B289): the
# file the deploy put in place names them, and impstats writes their queues
# once a minute, each line `<ctime>: {json}`. Counters are per minute
# (resetCounters on), so what was dropped is summed over the last hour; a
# queue's size is a gauge, its part in memory and its part on disk added up.
# A receiver that is away shows as a queue that grows - rsyslog's own
# `suspended` stays 0 while omfwd retries (measured 26-10-12).
#
RSYSLOG_FORWARD = Path("/etc/rsyslog.d/haprion/forward.conf")
PUBLISHED_FORWARD = Path("/etc/haproxy/current/rsyslog/forward.conf")
RSYSLOG_STATS = Path("/var/log/haprion/rsyslog-stats.json")
FORWARD_ACTION = re.compile(r'^\s*name="haprion-([a-z][a-z0-9-]{0,23})"\s*$', re.MULTILINE)
STATS_LINE = re.compile(r"^([A-Z][a-z]{2} [A-Z][a-z]{2} +\d{1,2} \d\d:\d\d:\d\d \d{4}): (\{.*\})$")
FORWARD_WINDOW_SECONDS = 3600
MAX_STATS_READ = 2 * 1024 * 1024
#
# Why a receiver is not reached is in rsyslog's own lines in the journal, not in
# its statistics: `cannot connect to <address>:<port> (took 0.00 seconds):
# Connection refused` at once, `... (took 133.34 seconds): Connection timed out`
# behind a firewall that drops, each line twice, and `action 'haprion-<name>'
# resumed` when it gets through (rsyslog 8.2512 on a node, 26-10-12). The
# newest failure counts until the receiver resumed or rsyslog started again;
# one older than ten minutes is no longer news. A failed connect is retried
# every ten seconds, or as long as the connect takes, so half an hour of
# rsyslog's lines holds the answer.
#
FORWARD_ACTION_BLOCK = re.compile(r'action\(type="omfwd"(.*?)\)', re.DOTALL)
FORWARD_PARAMETER = re.compile(r'([A-Za-z][\w.]*)="([^"]*)"')
CONNECT_FAILED = re.compile(
    r"^(?:rsyslogd: )?cannot connect to (\S+:\d+) \(took [\d.]+ seconds\): ([^\[\x00-\x1f]{1,80}?)\s*(?:\[|$)"
)
RECEIVER_RESUMED = re.compile(
    r"^action 'haprion-([a-z][a-z0-9-]{0,23})' resumed \(module 'builtin:omfwd'\)"
)
RSYSLOG_STARTED = re.compile(r'^\[origin software="rsyslogd" .*\] start$')
FORWARD_ERROR_WINDOW = "-30min"
FORWARD_ERROR_FRESH_SECONDS = 600
MAX_JOURNAL_LINES = 4000


def read_rsyslog_journal() -> list[tuple[float, str]]:
    """rsyslog's own lines of the last half hour, oldest first: [(epoch seconds, message)].

    The identifier alone is whatever the sender wrote, and any local account can
    write `logger -t rsyslogd ...`. The unit is set by journald from the sender's
    cgroup, so a line a person wrote does not become a receiver's reason.
    """

    try:
        result = subprocess.run(  # noqa: S603 - fixed arguments
            [
                "/usr/bin/journalctl",
                "--identifier=rsyslogd",
                "_SYSTEMD_UNIT=rsyslog.service",
                f"--since={FORWARD_ERROR_WINDOW}",
                f"--lines={MAX_JOURNAL_LINES}",
                "--output=json",
                "--output-fields=MESSAGE",
                "--no-pager",
                "--quiet",
            ],
            capture_output=True,
            text=True,
            errors="replace",
            check=False,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    lines: list[tuple[float, str]] = []
    for raw in result.stdout.splitlines():
        try:
            entry = json.loads(raw)
            stamp = int(entry["__REALTIME_TIMESTAMP"]) / 1_000_000
            message = entry["MESSAGE"]
        except (ValueError, KeyError, TypeError):
            continue
        if isinstance(message, str):
            lines.append((stamp, message))
    return lines


def _forward_addresses(text: str) -> dict[str, str]:
    """Each receiver's `<address>:<port>` as forward.conf names it."""

    addresses: dict[str, str] = {}
    for block in FORWARD_ACTION_BLOCK.findall(text):
        parameters = dict(FORWARD_PARAMETER.findall(block))
        name = parameters.get("name", "")
        if name.startswith("haprion-") and parameters.get("target") and parameters.get("port"):
            addresses[name[len("haprion-") :]] = f"{parameters['target']}:{parameters['port']}"
    return addresses


def _forward_errors(
    addresses: dict[str, str], lines: list[tuple[float, str]], moment: float
) -> dict[str, dict[str, Any]]:
    """The newest failure per receiver that has not resumed since, while still fresh."""

    failed: dict[str, tuple[float, str]] = {}
    cleared: dict[str, float] = {}
    started: float | None = None
    for stamp, message in lines:
        if RSYSLOG_STARTED.match(message):
            started = stamp
            continue
        resumed = RECEIVER_RESUMED.match(message)
        if resumed:
            cleared[resumed.group(1)] = stamp
            continue
        connect = CONNECT_FAILED.match(message)
        if connect:
            failed[connect.group(1)] = (stamp, connect.group(2).strip())
    errors: dict[str, dict[str, Any]] = {}
    for name, address in addresses.items():
        if address not in failed:
            continue
        stamp, reason = failed[address]
        if stamp <= max(cleared.get(name, 0), started or 0):
            continue
        if moment - stamp > FORWARD_ERROR_FRESH_SECONDS:
            continue
        errors[name] = {"reason": reason, "age_sec": max(0, int(moment - stamp))}
    return errors


def _stats_tail() -> list[str]:
    with RSYSLOG_STATS.open("rb") as handle:
        handle.seek(0, os.SEEK_END)
        size = handle.tell()
        handle.seek(max(0, size - MAX_STATS_READ))
        data = handle.read(MAX_STATS_READ)
    lines = data.decode("utf-8", errors="replace").splitlines()
    return lines[1:] if size > MAX_STATS_READ else lines


def read_log_forwarding(
    now: float | None = None, journal: list[tuple[float, str]] | None = None
) -> dict[str, Any] | None:
    """Each external receiver's queue on this node; null when it forwards nowhere."""

    try:
        text = RSYSLOG_FORWARD.read_text()
    except FileNotFoundError:
        return None
    except (OSError, UnicodeError):
        text = ""
    names = FORWARD_ACTION.findall(text)
    if not names:
        return None
    moment = time.time() if now is None else now
    queued: dict[str, int | None] = dict.fromkeys(names)
    dropped = dict.fromkeys(names, 0)
    newest: float | None = None
    try:
        lines = _stats_tail()
    except OSError:
        lines = []
    readings: list[tuple[float, dict[str, Any]]] = []
    for line in lines:
        match = STATS_LINE.match(line)
        if not match:
            continue
        try:
            stamp = time.mktime(
                time.strptime(" ".join(match.group(1).split()), "%a %b %d %H:%M:%S %Y")
            )
            body = json.loads(match.group(2))
        except (ValueError, OverflowError):
            continue
        if isinstance(body, dict):
            readings.append((stamp, body))
    if readings:
        newest = max(stamp for stamp, _ in readings)
    for stamp, body in readings:
        label = body.get("name")
        if not isinstance(label, str) or not label.startswith("haprion-"):
            continue
        base, _, part = label.partition(" ")
        name = base[len("haprion-") :]
        if name not in queued or part not in ("queue", "queue[DA]"):
            continue
        if moment - stamp <= FORWARD_WINDOW_SECONDS:
            for key in ("discarded.full", "discarded.nf"):
                value = body.get(key)
                if isinstance(value, int) and value > 0:
                    dropped[name] += value
        size = body.get("size")
        if stamp == newest and isinstance(size, int) and size >= 0:
            queued[name] = (queued[name] or 0) + size
    addresses = _forward_addresses(text)
    errors = (
        _forward_errors(addresses, read_rsyslog_journal() if journal is None else journal, moment)
        if addresses
        else {}
    )
    receivers: list[dict[str, Any]] = []
    for name in sorted(names):
        receiver: dict[str, Any] = {
            "name": name,
            "queued": queued[name],
            "dropped_last_hour": dropped[name],
        }
        if name in errors:
            receiver["last_error"] = errors[name]
        receivers.append(receiver)
    return {
        "stats_age_sec": None if newest is None else max(0, int(moment - newest)),
        "receivers": receivers,
    }


def read_server_state_unapplied() -> dict[str, str] | None:
    """Kept states HAProxy does not hold, by server GUID: {} for none, None when unreadable."""

    try:
        data = json.loads(SERVER_STATE_UNAPPLIED.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        return None
    servers = data.get("servers") if isinstance(data, dict) else None
    if not isinstance(servers, dict):
        return None
    return {
        guid: state
        for guid, state in sorted(servers.items())[:MAX_STAT_ROWS]
        if isinstance(guid, str) and SERVER_GUID.fullmatch(guid) and state in ("drain", "maint")
    }


#
# What the dashboard shows as a node's CPU and memory (B239). Counters, not a
# percentage: CPU use is a rate, and a rate needs two readings. The poller
# keeps the previous one and works out the share between them, so nothing here
# waits to measure. Memory is what the kernel says a new process could have
# without swapping - `available` in `free`, not `free`, which leaves out the
# cache the kernel gives back on demand. Each part is `null` when it cannot be
# read, so an unreadable figure is never shown as zero.
#
def read_resources() -> dict[str, Any]:
    cpu: dict[str, int] | None = None
    try:
        fields = Path("/proc/stat").read_text().splitlines()[0].split()
        if fields[0] == "cpu":
            # user nice system idle iowait irq softirq steal; guest time is
            # already counted in user and nice.
            ticks = [int(value) for value in fields[1:9]]
            cpu = {"total": sum(ticks), "idle": ticks[3] + ticks[4]}
    except (OSError, ValueError, IndexError):
        cpu = None
    memory: dict[str, int] | None = None
    try:
        values: dict[str, int] = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            name, _, rest = line.partition(":")
            if name in ("MemTotal", "MemAvailable"):
                values[name] = int(rest.split()[0])
        if len(values) == 2:
            memory = {"total_kb": values["MemTotal"], "available_kb": values["MemAvailable"]}
    except (OSError, ValueError, IndexError):
        memory = None
    try:
        load: float | None = float(Path("/proc/loadavg").read_text().split()[0])
    except (OSError, ValueError, IndexError):
        load = None
    return {"cpu": cpu, "memory": memory, "load": load, "cpus": os.cpu_count()}


def memory_summary(memory: dict[str, int] | None) -> str:
    if not memory or not memory["total_kb"]:
        return "unknown"
    total = memory["total_kb"]
    used = total - memory["available_kb"]
    return f"{round(100 * used / total)} % used ({used // 1024} of {total // 1024} MB)"


#
# A directive and its argument, with the trailing comment keepalived allows.
# The comment is why these are not `\s*$`: the configuration this project ships
# writes `interface eth0  # CHANGE`, and a pattern that insists on the end of
# the line reads that as no interface at all - which reports no VIP owner and
# blocks every deploy, without saying why.
#
INTERFACE = re.compile(r"^\s*interface\s+(\S+)\s*(?:#.*)?$", re.MULTILINE)
INCLUDE = re.compile(r"^include\s+(\S+)\s*(?:#.*)?$")
ADDRESS = re.compile(r"^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)(?:/\d+)?")
VIP_BLOCK = re.compile(r"virtual_ipaddress\s*\{(.*?)\}", re.DOTALL)

# One include deep is what this project's own layout uses. Deeper is not
# followed, and an address that cannot be found is reported as unknown rather
# than guessed at.
MAX_INCLUDE_DEPTH = 1
MAX_KEEPALIVED_BYTES = 1024 * 1024


def read_config(path: Path) -> str | None:
    try:
        if path.stat().st_size > MAX_KEEPALIVED_BYTES:
            return None
        return path.read_text(encoding="utf-8")
    except Exception:
        return None


def first_address(block: str, base: Path, depth: int = 0) -> str | None:
    """The first address a virtual_ipaddress block puts on the interface.

    Follows an `include`, because since the address list became a generated
    file the block on a managed node holds exactly one line:

        virtual_ipaddress {
            include /etc/keepalived/addresses.conf
        }

    Reading only the block would then find no address, and this node would
    report that it does not know whether it owns the VIP - which is not a
    cosmetic answer: a deploy refuses to run without a known owner.
    """

    for line in block.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue

        include = INCLUDE.match(line)
        if include:
            if depth >= MAX_INCLUDE_DEPTH:
                continue
            path = Path(include.group(1))
            if not path.is_absolute():
                path = base / path
            text = read_config(path)
            if text is None:
                continue
            address = first_address(text, path.parent, depth + 1)
            if address:
                return address
            continue

        match = ADDRESS.match(line)
        if match:
            return match.group(1)

    return None


def parse_keepalived() -> tuple[str | None, str | None]:
    text = read_config(KEEPALIVED_CONFIG)
    if text is None:
        return None, None

    interface_match = INTERFACE.search(text)
    interface = interface_match.group(1) if interface_match else None

    vip = None
    vip_block = VIP_BLOCK.search(text)
    if vip_block:
        vip = first_address(vip_block.group(1), KEEPALIVED_CONFIG.parent)

    return interface, vip


def owns_vip(interface: str | None, vip: str | None) -> bool | None:
    if not interface or not vip:
        return None

    r = run(
        "/usr/sbin/ip",
        "-j",
        "-4",
        "addr",
        "show",
        "dev",
        interface,
    )

    if r.returncode != 0:
        return None

    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None

    for iface in data:
        for addr in iface.get("addr_info", []):
            if addr.get("family") == "inet" and addr.get("local") == vip:
                return True

    return False


#
# The first line of a keepalived.conf the product wrote (B313); the deploy and
# the generator use the same line, and a test holds the three together.
#
KEEPALIVED_MARK = "# Written by Haprion - a deploy replaces this file."


def keepalived_configured() -> str | None:
    """Who wrote keepalived.conf: `product`, `operator`, or `missing` when there is none.

    None when it is there and cannot be read: an unreadable file is not a
    missing one, and the manager reads `missing` as "this node cannot hold the
    address through keepalived".
    """

    if not KEEPALIVED_CONFIG.exists():
        return "missing"
    try:
        with KEEPALIVED_CONFIG.open(encoding="utf-8") as handle:
            first = handle.readline().rstrip("\n")
    except (OSError, UnicodeDecodeError):
        return None
    return "product" if first == KEEPALIVED_MARK else "operator"


def carried_addresses() -> list[str] | None:
    """Every IPv4 address on this node, whatever put it there; None when `ip` cannot say.

    Read so the manager can tell whether a node without keepalived holds the
    cluster's address all the same: the node does not know the address then -
    it is named in keepalived.conf - and the manager does.
    """

    r = run("/usr/sbin/ip", "-j", "-4", "addr", "show")
    if r.returncode != 0:
        return None
    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None
    return sorted(
        {
            addr["local"]
            for iface in data
            for addr in iface.get("addr_info", [])
            if addr.get("family") == "inet" and isinstance(addr.get("local"), str)
        }
    )


def address_list(path: Path) -> tuple[bool | None, str | None]:
    """One address file as (present, digest). Two facts, told apart on purpose.

    `present` False means the file is not there; a digest of None with
    `present` True means it is there and could not be read or was too large.
    The manager needs the difference: a release that publishes no address list
    is not managing addresses from here at all, while one whose list cannot be
    read is a question nobody has answered yet.
    """

    try:
        if not path.is_file():
            return False, None
        if path.stat().st_size > MAX_KEEPALIVED_BYTES:
            return True, None
        return True, hashlib.sha256(path.read_bytes()).hexdigest()
    except Exception:
        return None, None


def read_addresses() -> dict[str, Any]:
    """The keepalived address list as three measurements, not as a verdict.

    The release carries the list, the node installs it, and keepalived.conf
    includes it - three states that a single release hash cannot tell apart.
    A deploy that activated the configuration and failed to activate the
    addresses leaves the new hash in place with the old list restored, so the
    hash alone reports that node as current. See B57 and the deploy matrix.

    The include is reported and not compared: putting the line into
    keepalived.conf is one deliberate step by a person, one node at a time, and
    `haprion-pull-deploy` exits 0 when it is absent. It is a fact the reader
    needs, not a target a deploy can reach.
    """

    published, published_digest = address_list(PUBLISHED_ADDRESSES)
    installed, installed_digest = address_list(KEEPALIVED_ADDRESSES)

    text = read_config(KEEPALIVED_CONFIG)
    included = None if text is None else str(KEEPALIVED_ADDRESSES) in text

    return {
        "published": published,
        "published_sha256": published_digest,
        "installed": installed,
        "installed_sha256": installed_digest,
        "included": included,
    }


def address_summary(addresses: dict[str, Any]) -> str:
    """The address list in one line, for the person standing at the node.

    Facts in the same order the deploy cares about them: does the release
    publish a list, does the node carry that exact list, and is it in use.
    """

    if addresses["published"] is False:
        return "none published by this release"
    if addresses["published_sha256"] is None or addresses["installed_sha256"] is None:
        if addresses["installed"] is False:
            return "published, not installed"
        return "UNKNOWN"
    if addresses["published_sha256"] != addresses["installed_sha256"]:
        return "installed list differs from the release"
    if addresses["included"] is False:
        return "installed, not included in keepalived.conf"
    if addresses["included"] is None:
        return "installed, include unknown"
    return "installed and in use"


def read_forward_file() -> dict[str, Any]:
    """The release's log forwarding against the one rsyslog reads, as two measurements.

    `haprion-pull-deploy` installs the forwarding after the reload and puts the
    previous file back when rsyslog refuses it, so a node can run the new
    release hash with the old receivers (review 26-10-13, A1). Unlike the
    address list, a release without the file is an instruction: the deploy
    removes the installed one, so absent on both sides is the current state.
    """

    published, published_digest = address_list(PUBLISHED_FORWARD)
    installed, installed_digest = address_list(RSYSLOG_FORWARD)
    return {
        "published": published,
        "published_sha256": published_digest,
        "installed": installed,
        "installed_sha256": installed_digest,
    }


def forward_file_summary(forward: dict[str, Any]) -> str:
    """The forwarding file in one line, for the person standing at the node."""

    if forward["published"] is False:
        if forward["installed"] is False:
            return "none published by this release"
        return "installed, but this release forwards nowhere" if forward["installed"] else "UNKNOWN"
    if forward["published_sha256"] is None:
        return "UNKNOWN"
    if forward["installed_sha256"] is None:
        return "published, not installed" if forward["installed"] is False else "UNKNOWN"
    if forward["published_sha256"] != forward["installed_sha256"]:
        return "installed file differs from the release"
    return "installed"


def runtime_info() -> tuple[bool, dict[str, Any]]:
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(RUNTIME_SOCKET)
        sock.sendall(b"show info\n")

        chunks: list[bytes] = []
        while True:
            data = sock.recv(65536)
            if not data:
                break
            chunks.append(data)

        sock.close()

        text = b"".join(chunks).decode("utf-8", errors="replace")

        info: dict[str, str] = {}
        for line in text.splitlines():
            if ":" not in line:
                continue
            key, value = line.split(":", 1)
            info[key.strip()] = value.strip()

        return True, {
            "version": info.get("Version"),
            "uptime_sec": (
                int(info["Uptime_sec"]) if _digits(info.get("Uptime_sec", "")) else None
            ),
            "shared_counters": shared_counters(
                int(info["Pid"]) if _digits(info.get("Pid", "")) else None,
                running_release_file(),
            ),
        }

    except Exception:
        return False, {
            "version": None,
            "uptime_sec": None,
            "shared_counters": None,
        }


#
# Whether the worker answering keeps its counters in the file `shm-stats-file`
# names, so that they carry over a reload (N3, 2026-10-09). A reload starts
# `Uptime_sec` from nought either way, and only this tells the metrics whether
# the counters started again with it.
#
# Read from what is, not from what was asked for: the path the running
# release's `global` names, and whether that worker has exactly that file
# mapped shared. HAProxy opens it as root before the chroot, so the path is
# the host's; a relative one is the master's working directory, which systemd
# makes `/`. None when either cannot be read - unknown, not no.
#
SHM_STATS_FILE = re.compile(r"^\s*shm-stats-file\s+(\S+)\s*(?:#.*)?$")


#
# The traffic stream (B403, review 2026-10-30-igen, R3). Once step 4 of this
# version has run, the node's rsyslog keeps a traffic line only when it came in
# on HAProxy's own socket. A release published by an older manager - or one a
# revert put back - still logs the stream to /dev/log, and every record of it
# is then dropped on this node until the cluster is published again. The other
# way round, a release that logs to the socket protects nothing while the day
# file's rule is still one from before: that rule takes the traffic tag from
# any local account. The node says what it has; the manager says what that
# means (`cluster_status.traffic_stream_problem`, `traffic_stream_unguarded`).
#
CURRENT_CONFIG = Path("/etc/haproxy/current")
TRAFFIC_RULE = Path("/etc/rsyslog.d/48-haprion-traffic.conf")
TRAFFIC_SOCKET = Path("/var/lib/haproxy/dev/haprion-traffic")
TRAFFIC_SOCKET_LINK = Path("/var/lib/haproxy/var/lib/haproxy/dev/haprion-traffic")
#
# A rule keeps only HAProxy's lines when a condition, not a comment, asks for
# the mark: the day file's rule and the forwarding rule each open with one.
#
TRAFFIC_MARK_CONDITION = re.compile(
    r'^[ \t]*if[ \t]*\(.*\$!haprion!origin[ \t]*==[ \t]*"haproxy"', re.MULTILINE
)
TRAFFIC_LOG_LINE = re.compile(
    r"^[ \t]*log[ \t]+(\S+)[ \t].*\bprofile[ \t]+mgd-traffic-json\b", re.MULTILINE
)


def _text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def marked_only(path: Path) -> bool | None:
    """Whether an rsyslog rule keeps only lines that came in on HAProxy's socket; None when absent."""

    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except FileNotFoundError:
        return None
    except OSError:
        return False
    return TRAFFIC_MARK_CONDITION.search(text) is not None


def read_traffic_stream() -> dict[str, Any] | None:
    """Where the release logs the traffic stream and whether rsyslog here takes it; null for none.

    `to_socket`: every structured `log` line names HAProxy's own socket.
    `marked_only`: the day file's or the forwarding rule keeps only a line
    that came in there - so a stream logged elsewhere is dropped by it.
    `day_rule_marked_only` and `forward_marked_only`: each of the two rules on
    its own, null when it is not there. A day-file rule from before B403 takes
    a line under the traffic tag from any local account, whatever the release
    says; step 4 writes the current one (B403, measured on a node 2026-10-30).
    `socket`: the socket is there for HAProxy alone and HAProxy's chroot
    reaches it through the link step 4 makes, as `haprion-pull-deploy` checks
    before it takes a release.
    """

    files = [CURRENT_CONFIG / "haproxy.cfg", *sorted((CURRENT_CONFIG / "conf.d").glob("*.cfg"))]
    targets = [found for path in files for found in TRAFFIC_LOG_LINE.findall(_text(path))]
    if not targets:
        return None
    try:
        held = TRAFFIC_SOCKET.lstat()
        owner = f"{TRAFFIC_SOCKET.owner()}:{TRAFFIC_SOCKET.group()}"
        ready = (
            S_ISSOCK(held.st_mode)
            and owner == "haproxy:haproxy"
            and held.st_mode & 0o777 == 0o660
            and TRAFFIC_SOCKET_LINK.resolve(strict=True) == TRAFFIC_SOCKET.resolve(strict=True)
        )
    except (OSError, KeyError):
        ready = False
    day_rule = marked_only(TRAFFIC_RULE)
    forward = marked_only(RSYSLOG_FORWARD)
    return {
        "to_socket": all(target == str(TRAFFIC_SOCKET) for target in targets),
        "marked_only": day_rule is True or forward is True,
        "day_rule_marked_only": day_rule,
        "forward_marked_only": forward,
        "socket": ready,
    }


def traffic_stream_summary(stream: dict[str, Any] | None) -> str:
    """The traffic stream in one line, for the person standing at the node."""

    if stream is None:
        return "not logged by this release"
    if stream["to_socket"]:
        if not stream["socket"]:
            return "DROPPED: HAProxy's socket is missing"
        if stream["day_rule_marked_only"] is False:
            return (
                "to HAProxy's socket; the day file's rule also takes lines from other"
                " accounts: run  sudo haprion-node-prepare"
            )
        return "to HAProxy's socket"
    if stream["marked_only"]:
        return "DROPPED: the release logs to /dev/log; publish the cluster again"
    return "to /dev/log"


def shm_stats_path(config_text: str) -> str | None:
    section = None
    for line in config_text.splitlines():
        if line[:1] and not line[:1].isspace() and not line.startswith("#"):
            section = line.split()[0]
            continue
        if section == "global":
            found = SHM_STATS_FILE.match(line)
            if found:
                return str(Path("/") / found.group(1))
    return None


def shared_counters(
    pid: int | None, release: Path | None, proc: Path = Path("/proc")
) -> bool | None:
    if pid is None or release is None:
        return None
    try:
        config_text = (release.parent / "haproxy.cfg").read_text(encoding="utf-8")
        path = shm_stats_path(config_text)
        if path is None:
            return False
        maps = (proc / str(pid) / "maps").read_text(encoding="utf-8", errors="replace")
    except Exception:
        return None
    for line in maps.splitlines():
        fields = line.split(maxsplit=5)
        if len(fields) == 6 and fields[1] == "rw-s" and fields[5] == path:
            return True
    return False


#
# A pool's own row and one row per server, plus one row per frontend, from the
# same socket `show info` already uses. This is HAProxy's own verdict - the
# checks it has actually been running against the servers it was told about -
# which is a different and more truthful answer than anything that probes from
# somewhere else once.
#
# The CSV header names the columns rather than the positions being counted:
# `show stat` has grown columns between versions, and a fixed index is a field
# that quietly becomes another field after an upgrade.
#
MAX_STAT_ROWS = 500
#
# The sections holding an object's dynamic blocking tables (B271): backends with
# no servers that carry no traffic, so not pools. Named by the generator's
# `block_tables`, in the `mgd-` space no pool may take.
#
BLOCK_TABLE = re.compile(r"^mgd-.+-dynblock(-rate)?$")

#
# Why the frontends are reported at all, when they carry no health check: a
# backend with three green servers and a frontend that never received the
# request look identical from the server rows alone. That was measured, not
# imagined - a site answered 503 with all three servers UP, and the only thing
# that said which listener had answered was a counter per frontend. See B89.
#
# Why the counters keep HAProxy's own column names. A renamed counter is a
# counter nobody can look up: `stot` and `hrsp_5xx` are searchable in
# `configuration.txt`, `sessions_total` and `responses_5xx` are searchable
# nowhere. The two fields below that *are* renamed carry a unit that HAProxy's
# name does not state, which is a different thing from a translation.
#
# One list for both kinds of row rather than two. `show stat` leaves a column
# empty where it does not apply - a frontend has no `econ`, a server no
# `req_tot` - and `value` already answers None for an empty cell. Two hand-kept
# lists would be two things to keep in step for no gain.
#
COUNTER_COLUMNS = (
    "scur",
    "stot",
    "bin",
    "bout",
    "req_tot",
    "qcur",
    "ereq",
    "econ",
    "eresp",
    "dreq",
    "dresp",
    "wretr",
    "wredis",
    "hrsp_2xx",
    "hrsp_3xx",
    "hrsp_4xx",
    "hrsp_5xx",
)


def parse_stat(text: str) -> dict[str, Any] | None:
    """`show stat` output as frontends and pool members, or None if unreadable.

    Kept apart from the socket so it can be run against captured output. The
    reading and the parsing failing for the same reason - a node that answered
    nothing and a node that answered something unparseable - are both None
    here, because neither is a node with no listeners.
    """

    lines = [line for line in text.splitlines() if line.strip()]
    if not lines or not lines[0].startswith("#"):
        return None

    columns = [name.strip() for name in lines[0].lstrip("# ").split(",")]

    def value(row: list[str], name: str) -> str | None:
        try:
            found = row[columns.index(name)].strip()
        except (ValueError, IndexError):
            return None
        return found or None

    def number(row: list[str], name: str) -> int | None:
        found = value(row, name)
        return int(found) if found is not None and _digits(found) else None

    def counters(row: list[str]) -> dict[str, int | None]:
        return {name: number(row, name) for name in COUNTER_COLUMNS}

    frontends: list[dict[str, Any]] = []
    servers: list[dict[str, Any]] = []
    for line in lines[1 : MAX_STAT_ROWS + 1]:
        row = line.split(",")
        pool = value(row, "pxname")
        member = value(row, "svname")
        if pool is None or member is None or BLOCK_TABLE.match(pool):
            continue
        if member == "FRONTEND":
            frontends.append(
                {
                    "frontend": pool,
                    "status": value(row, "status"),
                    "counters": counters(row),
                }
            )
            continue
        servers.append(
            {
                "backend": pool,
                "server": member,
                "status": value(row, "status"),
                "check_status": value(row, "check_status"),
                "check_code": value(row, "check_code"),
                "check_duration_ms": number(row, "check_duration"),
                "last_change_sec": number(row, "lastchg"),
                "counters": counters(row),
            }
        )

    return {"frontends": frontends, "servers": servers}


#
# Drain and maintenance as somebody set them (Fas 20, B263), from `show servers
# state`. `show stat` cannot say it: a drained server whose check fails reads
# DOWN there, the drain gone from sight (measured on 3.4.6, 26-10-09). The
# admin column is a set of flags; only the two the runtime command sets are
# read - forced maintenance 0x01 and forced drain 0x08. Maintenance clears a
# drain, so a server is never both. Maintenance for any other reason (a failed
# name resolution, a tracked server) is HAProxy's verdict, and `status` already
# says it.
#
FORCED_MAINT = 0x01
FORCED_DRAIN = 0x08


def parse_servers_state(text: str) -> dict[tuple[str, str], dict[str, str]] | None:
    """`show servers state` as each member's admin state, or None.

    Keyed by pool and member, as `show stat` names them. Unreadable output is
    None, which leaves every member's admin state unknown rather than ready.
    """

    lines = [line for line in text.splitlines() if line.strip()]
    header = next((line for line in lines if line.startswith("#")), None)
    if header is None:
        return None
    columns = header.lstrip("# ").split()
    try:
        pool, member, admin = (
            columns.index(name) for name in ("be_name", "srv_name", "srv_admin_state")
        )
    except ValueError:
        return None

    found: dict[tuple[str, str], dict[str, str]] = {}
    rows = [line.split() for line in lines if not line.startswith("#")]
    for row in rows[: MAX_STAT_ROWS + 1]:
        if len(row) != len(columns) or not _digits(row[admin]):
            continue
        flags = int(row[admin])
        found[(row[pool], row[member])] = {
            "admin": (
                "maint" if flags & FORCED_MAINT else "drain" if flags & FORCED_DRAIN else "ready"
            ),
        }
    return found


def with_admin_state(
    stat: dict[str, Any] | None, states: dict[tuple[str, str], dict[str, str]] | None
) -> dict[str, Any] | None:
    """Each member of a `show stat` reading with its admin state.

    Null where `show servers state` could not be read or did not name the
    member: unknown, which is not the same answer as ready.
    """

    if stat is None:
        return None
    for entry in stat["servers"]:
        known = (states or {}).get((entry["backend"], entry["server"]), {})
        entry["admin"] = known.get("admin")
    return stat


def ask_runtime(
    command: str, path: str = RUNTIME_SOCKET, max_lines: int | None = None
) -> str | None:
    """One command on a runtime socket, its answer as text, or None.

    `max_lines` stops reading once that many lines have arrived: a table's
    listing is as long as the table, and only its beginning is reported.
    """

    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(path)
        sock.sendall(command.encode() + b"\n")

        chunks: list[bytes] = []
        lines = 0
        while True:
            data = sock.recv(65536)
            if not data:
                break
            chunks.append(data)
            lines += data.count(b"\n")
            if max_lines is not None and lines > max_lines:
                break

        sock.close()
        return b"".join(chunks).decode("utf-8", errors="replace")
    except Exception:
        return None


#
# Dynamic blocking (B271): each object's blocked table, by the generator's name
# (`generate.block_tables`), and its entries as 3.4.6 writes them (measured
# 26-10-10):
#   # table: mgd-shop-dynblock, type: ipv6, size:1048576, used:2
#   0x...: key=::ffff:192.0.2.7 use=0 exp=1793254 shard=0 gpc0=0
# Every entry is a block, `exp` its milliseconds left. The count is the
# table's own; the addresses listed stop at MAX_BLOCKED_LISTED per object.
#
BLOCKED_TABLE = re.compile(
    r"^# table: mgd-([a-z][a-z0-9_-]{0,39})-dynblock, type: \S+, size:\d+, used:(\d+)$"
)
BLOCKED_ENTRY = re.compile(r"^0x[0-9a-f]+: key=(\S+) .*\bexp=(\d+)\b")
MAX_BLOCKED_LISTED = 100
MAX_BLOCKED_OBJECTS = 500


def parse_blocked_tables(text: str) -> dict[str, int]:
    """`show table` as {object: blocked count}, for the objects with dynamic blocking."""

    found: dict[str, int] = {}
    for line in text.splitlines():
        match = BLOCKED_TABLE.match(line.strip())
        if match is not None and len(found) < MAX_BLOCKED_OBJECTS:
            found[match.group(1)] = int(match.group(2))
    return found


def parse_blocked_entries(text: str) -> list[dict[str, Any]]:
    """One table's entries as [{address, expires_in_ms}], an IPv4 address written plainly."""

    entries: list[dict[str, Any]] = []
    for line in text.splitlines():
        match = BLOCKED_ENTRY.match(line.strip())
        if match is None:
            continue
        try:
            address: ipaddress.IPv4Address | ipaddress.IPv6Address = ipaddress.ip_address(
                match.group(1)
            )
        except ValueError:
            continue
        if isinstance(address, ipaddress.IPv6Address) and address.ipv4_mapped:
            address = address.ipv4_mapped
        entries.append({"address": str(address), "expires_in_ms": int(match.group(2))})
        if len(entries) == MAX_BLOCKED_LISTED:
            break
    return entries


def read_blocked() -> dict[str, dict[str, Any]] | None:
    """{object: {count, addresses}} for every object with dynamic blocking; None if unasked."""

    text = ask_runtime("show table", ADMIN_SOCKET)
    if text is None:
        return None
    blocked: dict[str, dict[str, Any]] = {}
    for name, count in parse_blocked_tables(text).items():
        addresses: list[dict[str, Any]] = []
        if count:
            listing = ask_runtime(
                f"show table mgd-{name}-dynblock", ADMIN_SOCKET, MAX_BLOCKED_LISTED + 1
            )
            addresses = parse_blocked_entries(listing or "")
        blocked[name] = {"count": count, "addresses": addresses}
    return blocked


#
# One `show peers` line per peer, as 3.4.6 writes it (measured 26-10-10):
#   0x...: id=node-b(remote,active) addr=192.0.2.2:10000 app_state=RUNNING ... last_status=ESTA ...
# The local peer's own line is skipped; it is what a reload hands the tables
# over through, not a connection to anybody.
#
PEER_LINE = re.compile(
    r"^\s*0x[0-9a-f]+: id=([^\s(]+)\(remote,(active|inactive)\) addr=(\S+) .*last_status=(\S+)"
)


def parse_peers(text: str) -> list[dict[str, Any]]:
    """The other nodes this one shares tables with, and whether each is connected."""

    peers: list[dict[str, Any]] = []
    for line in text.splitlines():
        match = PEER_LINE.match(line)
        if match is None:
            continue
        name, state, address, status = match.groups()
        peers.append(
            {
                "name": name[:253],
                "address": address[:64],
                "connected": state == "active" and status == "ESTA",
            }
        )
    return peers[:8]


def read_peers() -> list[dict[str, Any]] | None:
    """[] when this node shares nothing, None when HAProxy could not be asked."""

    text = ask_runtime("show peers")
    return None if text is None else parse_peers(text)


def runtime_stat() -> dict[str, Any] | None:
    text = ask_runtime("show stat")
    if text is None:
        return None
    states = ask_runtime("show servers state")
    return with_admin_state(
        parse_stat(text), None if states is None else parse_servers_state(states)
    )


def running_release_file() -> Path | None:
    """The RELEASE file of the configuration HAProxy runs, or None when unknown.

    `current`'s, unless `haprion-pull-deploy` switched the link and has not
    reloaded yet (review 2026-10-03, F2): its marker's first line then names
    the release HAProxy still runs, and that one is reported, so the manager
    sees the node as behind and the deploy it offers finishes the reload. A
    marker that cannot be read, or names anything but a release directory,
    reports nothing: this cannot tell what is in service.
    """

    if not CONFIG_PENDING.exists():
        return CURRENT_RELEASE
    try:
        named = CONFIG_PENDING.read_text(encoding="utf-8").splitlines()[0].strip()
    except Exception:
        return None
    running = Path(named)
    if running.parent != RELEASES or not running.name or running.name.startswith("."):
        return None
    return running / "RELEASE"


def read_release() -> dict[str, str | bool | None]:
    result: dict[str, str | bool | None] = {
        "version": None,
        "hash": None,
        "timestamp": None,
        "cluster": None,
        "complete": not DEPLOY_INCOMPLETE.exists(),
    }

    release_file = running_release_file()
    if release_file is None or not release_file.is_file():
        return result

    try:
        for line in release_file.read_text(encoding="utf-8").splitlines():
            if "=" not in line:
                continue

            key, value = line.split("=", 1)
            key = key.strip().lower()
            value = value.strip()

            if key in result and key != "complete":
                result[key] = value

    #
    # A release file that cannot be read says nothing about the release; the
    # fields stay None, which is how the manager reads "unknown".
    #
    except (OSError, ValueError):
        return result

    return result


def leaf_fingerprint(text: str) -> str | None:
    """SHA-256 of the first certificate in the file, lowercase hex.

    The definition is identical to the manager's on purpose - the two values are
    compared against each other, so a difference in what is hashed would make
    every comparison meaningless.

    The leaf's DER bytes, not the file: a published PEM is the private key
    concatenated with the full chain, so hashing the file would change the
    answer whenever the key encoding or the bundled intermediates changed,
    without the certificate this node serves changing at all. The private key is
    never hashed and never leaves this function.

    First block rather than last, because a chain is written leaf-first. Taking
    the last would fingerprint the CA and make every node look identical.
    """

    match = CERTIFICATE_BLOCK.search(text)
    if match is None:
        return None

    try:
        der = base64.b64decode("".join(match.group(1).split()), validate=True)
    except Exception:
        return None

    if not der:
        return None

    return hashlib.sha256(der).hexdigest()


def bundle_fingerprint(text: str) -> str | None:
    """SHA-256 over every certificate block's DER bytes, in file order (B276).

    The manager's definition of a CA file's identity, repeated here because
    the two are compared: a root added behind the first changes it.
    """

    digest = hashlib.sha256()
    found = False
    for match in CERTIFICATE_BLOCK.finditer(text):
        try:
            der = base64.b64decode("".join(match.group(1).split()), validate=True)
        except Exception:
            return None
        if not der:
            return None
        digest.update(der)
        found = True
    return digest.hexdigest() if found else None


AUTHORITY_PENDING = Path("/run/haprion-ca-pull.pending")


def read_authorities() -> list[dict[str, Any]]:
    """The CA files this node carries for its pools (B276), by bundle fingerprint.

    Like the certificates: one installed but not yet read by HAProxy is left
    out, and so is one that cannot be read.
    """

    entries: list[dict[str, Any]] = []
    pending: set[str] = set()
    if AUTHORITY_PENDING.exists():
        try:
            pending = set(AUTHORITY_PENDING.read_text(encoding="ascii").split())
        except Exception:
            return entries
    try:
        paths = sorted((CERTS_DIR / "ca").glob("*.pem"))
    except Exception:
        return entries
    for path in paths:
        try:
            if not path.is_file() or path.stat().st_size > MAX_CERTIFICATE_BYTES:
                continue
            fingerprint = bundle_fingerprint(path.read_text(encoding="ascii", errors="strict"))
        except (OSError, ValueError):
            continue
        identifier = path.name[: -len(".pem")]
        if fingerprint is None or identifier in pending:
            continue
        entries.append({"id": identifier, "fingerprint_sha256": fingerprint})
    return entries


def certificate_valid(path: Path) -> bool:
    """Is it in its validity window right now? Measured, not assumed."""

    return (
        run("/usr/bin/openssl", "x509", "-in", str(path), "-noout", "-checkend", "0").returncode
        == 0
    )


def read_certificates() -> list[dict[str, Any]]:
    """What this node is carrying, by identity only.

    Deliberately not enriched with subject, SANs or provenance. Whether a
    certificate is ACME-renewed or static is knowable where certbot lives, not
    on a node that only sees a file, so this reports what it can measure and
    cert-list reports the rest. That is the `carried_certificate` contract.

    A file that cannot be read or does not parse is left out rather than
    reported as present with an unknown fingerprint: a certificate nobody could
    identify must not be able to satisfy a comparison.
    """

    entries: list[dict[str, Any]] = []

    #
    # A certificate `haprion-cert-pull` installed but never got HAProxy to read
    # is on disk and not in service. Its file says nothing about what clients
    # are given, so it is left out like one that cannot be read - and the
    # manager then sees the node as behind on it, and the deploy it offers is
    # the run that finishes the reload. A marker that cannot be read leaves
    # every certificate out: this cannot tell which are in service.
    #
    pending: set[str] = set()
    if CERT_PENDING.exists():
        try:
            pending = set(CERT_PENDING.read_text(encoding="ascii").split())
        except Exception:
            return entries

    try:
        paths = sorted(CERTS_DIR.glob("*.pem"))
    except Exception:
        return entries

    for path in paths:
        try:
            if not path.is_file():
                continue
            if path.stat().st_size > MAX_CERTIFICATE_BYTES:
                continue
            text = path.read_text(encoding="ascii", errors="strict")
            fingerprint = leaf_fingerprint(text)
            chain = bundle_fingerprint(text)
        #
        # A file that cannot be read, or is not ASCII, is not a certificate
        # this node can report on; the others still are.
        #
        except (OSError, ValueError):
            continue

        if fingerprint is None or chain is None or path.name[: -len(".pem")] in pending:
            continue

        entries.append(
            {
                "id": path.name[: -len(".pem")],
                "fingerprint_sha256": fingerprint,
                "chain_sha256": chain,
                "valid": certificate_valid(path),
            }
        )

    return entries


def read_validation() -> dict[str, Any]:
    if not VALIDATION_STATE.is_file():
        return {
            "valid": None,
            "validated_at": None,
        }

    try:
        data = json.loads(VALIDATION_STATE.read_text(encoding="utf-8"))
        return {
            "valid": data.get("valid"),
            "validated_at": data.get("validated_at"),
        }
    except Exception:
        return {
            "valid": None,
            "validated_at": None,
        }


def read_keepalived_state() -> str | None:
    """What haprion-keepalived-state last wrote, or None.

    /run/haproxy belongs to the haproxy group, so the name may be a link put
    there. This runs as root and sends what it reads to the manager: a link, or
    anything but a regular file of this user's own, is not followed and not read
    (review 26-10-30, E5 and R3).
    """
    try:
        descriptor = os.open(KEEPALIVED_STATE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    try:
        found = os.fstat(descriptor)
        if not S_ISREG(found.st_mode) or found.st_uid != os.geteuid():
            return None
        return os.read(descriptor, 64).decode("utf-8").strip()
    except (OSError, ValueError):
        return None
    finally:
        os.close(descriptor)


def read_cluster() -> str | None:
    """The cluster this node was installed into, as 04-node-prepare wrote it.

    Read here rather than taken as an argument, so the sudo rule and the forced
    command are the same on every node (B266). The manager compares it with the
    cluster it asked about when it connects (the node's enrollment), which
    catches a node installed into the wrong one; the status reading is guarded
    by the node's host key.
    """
    try:
        lines = NODE_CONF.read_text(encoding="utf-8").splitlines()
    except (OSError, ValueError):
        return None
    for line in lines:
        found = CLUSTER_LINE.fullmatch(line.strip())
        if found:
            return found.group(1)
    return None


