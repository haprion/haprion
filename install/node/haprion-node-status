#
# Where dnsdist serves its counters: loopback, no key, written by the
# generator (`dnsdist_config.STATS_PORT`; a test holds the two equal).
#
DNS_METRICS = "http://127.0.0.1:9521/metrics"
MAX_DNS_METRICS_BYTES = 4 * 1024 * 1024
MAX_DNS_ROWS = 500
DNS_SAMPLE = re.compile(r"^([a-z_]+)(?:\{(.*)\})? ([0-9.eE+-]+)$")
DNS_LABEL = re.compile(r'([a-z_]+)="([^"\\]*)"')


def parse_dns_metrics(text: str) -> dict[str, Any] | None:
    """dnsdist's `/metrics` as the cluster's dns pools and their servers.

    Everything is counted under the pool's name, the way the generator names
    it (`dnsdist_config`): the rule `<pool>` counts every query reaching the
    object's listener, `<pool>/tcp` those over TCP and `<pool>/refused` those
    refused for `allow_from`; a server is `<pool>/s<n>`. A pool's answered
    queries are its servers' responses added up - the rules count what came
    in, the servers what went out and came back.

    No latency: dnsdist's is a running average that starts at nought with every
    start, and nothing read it (26-10-06, B253). Its exporter carries it to
    whoever scrapes dnsdist. None for text that is not dnsdist's.
    """

    rules: dict[str, int] = {}
    servers: dict[tuple[str, str], dict[str, float]] = {}
    uptime: int | None = None
    seen = False
    for line in text.splitlines()[: MAX_DNS_ROWS * 64]:
        found = DNS_SAMPLE.match(line.strip())
        if found is None:
            continue
        metric, labels, raw = found.groups()
        try:
            value = float(raw)
        except ValueError:
            continue
        if metric == "dnsdist_uptime":
            seen = True
            uptime = int(value) if value >= 0 else None
            continue
        named = dict(DNS_LABEL.findall(labels or ""))
        if metric == "dnsdist_rule_hits" and "id" in named:
            rules[named["id"]] = int(value)
            continue
        server = named.get("server", "")
        pool, slash, member = server.partition("/")
        if not metric.startswith("dnsdist_server_") or not slash or not pool or not member:
            continue
        field = metric.removeprefix("dnsdist_server_")
        if field in ("queries", "responses", "status"):
            servers.setdefault((pool, member), {})[field] = value
    if not seen:
        return None

    pools: dict[str, dict[str, int]] = {}
    for name, hits in rules.items():
        pool, slash, part = name.partition("/")
        if not slash:
            pools.setdefault(name, {})["queries"] = hits
        elif part in ("tcp", "refused"):
            pools.setdefault(pool, {})[part] = hits
    rows: list[dict[str, Any]] = []
    for (pool, member), member_found in sorted(servers.items())[:MAX_DNS_ROWS]:
        rows.append(
            {
                "pool": pool,
                "server": member,
                "status": None
                if "status" not in member_found
                else ("UP" if member_found["status"] else "DOWN"),
                "queries": None if "queries" not in member_found else int(member_found["queries"]),
                "answered": None
                if "responses" not in member_found
                else int(member_found["responses"]),
            }
        )
    #
    # A pool is one with servers. A rule without a name gets a UUID, which can
    # look like a pool's name; no server is ever named after one.
    #
    served = {row["pool"] for row in rows}
    listed: list[dict[str, Any]] = []
    for pool, counted in sorted(pools.items())[:MAX_DNS_ROWS]:
        if "queries" not in counted or pool not in served:
            continue
        answers = [row["answered"] for row in rows if row["pool"] == pool]
        listed.append(
            {
                "pool": pool,
                "queries": counted["queries"],
                "tcp_queries": counted.get("tcp"),
                #
                # No rule is a pool without `allow_from`, which refuses
                # nobody - zero, not unknown.
                #
                "refused": counted.get("refused", 0),
                "answered": None if None in answers else sum(answers),
            }
        )
    return {"uptime_sec": uptime, "pools": listed, "servers": rows}


def dns_counters() -> dict[str, Any] | None:
    try:
        #
        # No proxy, whatever the environment says: the counters are on loopback.
        #
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
        with opener.open(DNS_METRICS, timeout=2.0) as response:
            text = response.read(MAX_DNS_METRICS_BYTES + 1)
    except Exception:
        return None
    if len(text) > MAX_DNS_METRICS_BYTES:
        return None
    return parse_dns_metrics(text.decode("utf-8", errors="replace"))


