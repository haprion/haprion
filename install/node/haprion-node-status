def _digits(text: str, limit: int = 18) -> bool:
    """One to `limit` ASCII digits; `isdigit()` alone passes `²`, which `int()` refuses.

    The engine's `haprion.digits.is_digits`, which a node script cannot import.
    """
    return 0 < len(text) <= limit and text.isascii() and text.isdigit()


