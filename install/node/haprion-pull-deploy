#!/bin/bash

set -Eeuo pipefail

#
# Everything environment-specific comes from one root-owned file, rendered at
# install time. Nothing about this node's cluster, its management host or its
# accounts is compiled in - that is what let three hand-maintained variants of
# this script collapse into one.
#
NODE_CONF="/etc/haprion/node.conf"

[[ -r "$NODE_CONF" ]] || {
    echo "ERROR: ${NODE_CONF} is missing. Run install/04-node-prepare." >&2
    exit 78
}
# shellcheck source=/dev/null
source "$NODE_CONF"

for required in MANAGER CONFIG_PULL_USER CONFIG_PULL_KEY CONFIG_REMOTE_PATH; do
    [[ -n "${!required:-}" ]] || {
        echo "ERROR: ${required} is not set in ${NODE_CONF}" >&2
        exit 78
    }
done

REMOTE_USER="$CONFIG_PULL_USER"
REMOTE_PATH="$CONFIG_REMOTE_PATH"
SSH_KEY="$CONFIG_PULL_KEY"

HAPROXY_DIR="/etc/haproxy"
#
# Every reload goes through the server state helper (Fas 20, B263): it reloads,
# waits for the new worker and puts back any server kept in drain or
# maintenance. A plain `systemctl reload haproxy` would quietly send traffic
# to a server somebody took out.
#
SERVER_STATE="/usr/sbin/haprion-server-state"
RELEASE_DIR="${HAPROXY_DIR}/releases"
CURRENT="${HAPROXY_DIR}/current"
#
# A release `current` points at but HAProxy has not loaded (review 2026-10-03,
# F2). Written before the link is switched and removed once HAProxy has
# reloaded: a run stopped in between leaves it, `haprion-node-status` then
# reports the release HAProxy still runs - the first line - and the next run,
# which finds nothing new to fetch, finishes the reload instead of calling the
# node done. In /run on purpose, as the certificate marker: a reboot empties
# it, and a rebooted HAProxy read `current` from disk.
#
PENDING="/run/haprion-pull-deploy.pending"

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*"
}

# Prevent two deploys from running at the same time
exec 9>/run/lock/haprion-deploy.lock
if ! flock -n 9; then
    log "ERROR: Another HAProxy deploy is already running."
    exit 1
fi

STAGE="$(mktemp -d -t haproxy-stage.XXXXXX)"
VALIDATE="$(mktemp -d -t haproxy-validate.XXXXXX)"

cleanup() {
    rm -rf "$STAGE" "$VALIDATE"
}
trap cleanup EXIT

#
# The addresses this node must carry, which travel in the same release as the
# configuration that binds them. Decision B57: the application owns the address
# list and nothing else in keepalived.conf - priority, virtual_router_id,
# authentication, unicast peers and the notify scripts are written by a person
# and are what decide who owns an address.
#
KEEPALIVED_CONF="/etc/keepalived/keepalived.conf"
KEEPALIVED_ADDRESSES="/etc/keepalived/addresses.conf"
#
# The syslog objects' IPVS virtual servers (Fas 19b, B256), beside it and by
# the same rules. Included at the top level of keepalived.conf rather than
# inside the vrrp_instance, since that is where keepalived reads a
# virtual_server.
#
KEEPALIVED_IPVS="/etc/keepalived/ipvs.conf"

#
# Whether keepalived.conf includes a file. The address list is included inside
# virtual_ipaddress, so any line naming it is the include; the IPVS file only
# counts at the top level, outside every block, with keepalived's comments (`#`
# and `!`) left out - the reading `haprion-node-status` reports.
#
keepalived_includes_anywhere() {
    [[ -f "$KEEPALIVED_CONF" ]] && grep -q "$1" "$KEEPALIVED_CONF"
}

keepalived_includes_at_top() {
    [[ -f "$KEEPALIVED_CONF" ]] || return 1
    awk -v wanted="$1" '
        { sub(/[#!].*/, ""); words = split($0, word, " ") }
        depth == 0 && words == 2 && word[1] == "include" && word[2] == wanted { found = 1 }
        { depth += gsub(/\{/, "{") - gsub(/\}/, "}") }
        END { exit !found }
    ' "$KEEPALIVED_CONF"
}

#
# keepalived's files from the release, in two steps (review 26-10-08, R3):
# each file is staged - installed, with what it replaced kept aside - and then
# everything staged is activated together, with one configuration test and
# one reload, or put back together. A release that changes both the address
# list and the IPVS file (a VIP and the syslog object on it) is then one reload
# and never half of one: before, each file was tested and reloaded on its own,
# and a refusal of the second left the first live.
#
STAGED_WHAT=()
STAGED_INSTALLED=()
STAGED_BACKUP=()
STAGED_READ=0
#
# Set when this run installed keepalived.conf itself (B313): keepalived is
# then started if it is not running, where a list or IPVS file alone waits for
# it to start.
#
STAGED_CONF=0

#
# The product's keepalived.conf (B313), for a cluster it created: the release
# carries one per node, `keepalived/node-<name>.conf`, and this node installs
# its own. Only over a file that starts with the product's line, or where there
# is none - a keepalived.conf a person wrote is theirs, and stays. Its first
# line is `keepalived_conf.MARK`; a test holds the two together.
#
KEEPALIVED_MARK="# Written by Haprion - a deploy replaces this file."
KEEPALIVED_INTERFACE_FROM_NODE="@INTERFACE@"

stage_keepalived_conf() {
    local published rendered own interface backup

    published="${CURRENT}/keepalived/node-$(hostname).conf"

    [[ -f "$published" ]] || return 0
    if [[ -f "$KEEPALIVED_CONF" ]] \
        && [[ "$(head -n 1 "$KEEPALIVED_CONF")" != "$KEEPALIVED_MARK" ]]; then
        log "keepalived: ${KEEPALIVED_CONF} was written by a person; left as it is."
        return 0
    fi
    #
    # The interface, where the cluster file names none: the one that carries
    # this node's own address, which the file names as unicast_src_ip.
    #
    rendered="$(cat "$published")"
    if [[ "$rendered" == *"$KEEPALIVED_INTERFACE_FROM_NODE"* ]]; then
        own="$(awk '$1 == "unicast_src_ip" { print $2; exit }' "$published")"
        interface="$(ip -o -4 addr show | awk -v own="$own" '{ split($4, a, "/"); if (a[1] == own) { print $2; exit } }')"
        if [[ -z "$interface" ]]; then
            log "ERROR: keepalived: no interface carries this node's address ${own:-(none named)}."
            return 1
        fi
        rendered="${rendered//"$KEEPALIVED_INTERFACE_FROM_NODE"/$interface}"
    fi
    if [[ -f "$KEEPALIVED_CONF" ]] && [[ "$(cat "$KEEPALIVED_CONF")" == "$rendered" ]]; then
        return 0
    fi
    log "keepalived: the configuration changed."
    backup=""
    if [[ -f "$KEEPALIVED_CONF" ]]; then
        backup="${KEEPALIVED_CONF}.rollback"
        cp -a "$KEEPALIVED_CONF" "$backup"
    fi
    install -d -o root -g root -m 755 "${KEEPALIVED_CONF%/*}"
    printf '%s\n' "$rendered" > "${KEEPALIVED_CONF}.new"
    chmod 644 "${KEEPALIVED_CONF}.new"
    mv -f "${KEEPALIVED_CONF}.new" "$KEEPALIVED_CONF"
    STAGED_WHAT+=("configuration")
    STAGED_INSTALLED+=("$KEEPALIVED_CONF")
    STAGED_BACKUP+=("$backup")
    STAGED_READ=1
    STAGED_CONF=1
}

#
# $1 the release's file, $2 where it is installed, $3 what it is called in the
# log, $4 the test for the include.
#
stage_keepalived_file() {
    local published="$1" installed="$2" what="$3" includes="$4"
    local backup

    #
    # A cluster whose repository predates the file publishes none, and a
    # release without one is not a release that empties the node's: an absent
    # file means "not managed from here", never "nothing".
    #
    [[ -f "$published" ]] || return 0
    if [[ -f "$installed" ]] && cmp -s "$published" "$installed"; then
        return 0
    fi

    #
    # The file is installed whether or not keepalived reads it yet, and that
    # order is deliberate. The include line cannot be added to keepalived.conf
    # before the file exists - keepalived would be pointed at something absent
    # - and the file cannot arrive if installing it requires the include. So
    # the deploy delivers the file first, inert, and a person adds the include
    # afterwards as one deliberate step on one node at a time.
    #
    log "keepalived: the ${what} changed."
    backup=""
    if [[ -f "$installed" ]]; then
        backup="${installed}.rollback"
        cp -a "$installed" "$backup"
    fi
    install -o root -g root -m 644 "$published" "$installed"

    if ! "$includes" "$installed"; then
        log "keepalived: ${KEEPALIVED_CONF} does not include ${installed}."
        log "keepalived: the ${what} is installed but NOT in use on this node."
        [[ -z "$backup" ]] || rm -f "$backup"
        return 0
    fi
    STAGED_WHAT+=("$what")
    STAGED_INSTALLED+=("$installed")
    STAGED_BACKUP+=("$backup")
    STAGED_READ=1
}

#
# Everything staged, at once. Reload ONLY on exit 0, and this is the whole
# reason the test is here. keepalived skips an address it cannot parse at
# runtime and carries on - "skipping IP" in its log - so a reload after a
# failed test turns a mistyped address into a VIP that silently never appears.
# A refusal is visible; a missing address is not.
#
activate_keepalived() {
    local index what

    if (( ! STAGED_READ )); then
        return 0
    fi
    what="$(IFS=,; echo "${STAGED_WHAT[*]}")"
    what="${what//,/ and }"
    if keepalived --config-test -f "$KEEPALIVED_CONF"; then
        #
        # Nothing to reload when keepalived is not running - masked on a node
        # restored in test mode, not yet started on a node restored to a new
        # VM (both measured 26-10-13): the files are installed, tested, and
        # what keepalived reads when it starts. A reload there fails, and the
        # deploy used to put the files back and fail with it.
        #
        if ! systemctl is-active --quiet keepalived; then
            #
            # Except when this run wrote keepalived.conf (B313): nothing else
            # starts it, and an address list nobody serves is a VIP that
            # never appears. Not on a masked unit, which is a node someone
            # took out on purpose (a restore in test mode).
            #
            if (( STAGED_CONF )) && [[ "$(systemctl is-enabled keepalived 2>/dev/null)" != masked ]]; then
                log "keepalived: configuration test passed. Starting..."
                if systemctl start keepalived; then
                    log "keepalived: ${what} active."
                    for index in "${!STAGED_INSTALLED[@]}"; do
                        [[ -z "${STAGED_BACKUP[index]}" ]] || rm -f "${STAGED_BACKUP[index]}"
                    done
                    return 0
                fi
                log "ERROR: keepalived did not start."
                systemctl stop keepalived 2>/dev/null || true
            else
                log "keepalived: not running; the ${what} is installed and read when it starts."
                for index in "${!STAGED_INSTALLED[@]}"; do
                    [[ -z "${STAGED_BACKUP[index]}" ]] || rm -f "${STAGED_BACKUP[index]}"
                done
                return 0
            fi
        else
            log "keepalived: configuration test passed. Reloading..."
            if systemctl reload keepalived; then
                log "keepalived: ${what} active."
                for index in "${!STAGED_INSTALLED[@]}"; do
                    [[ -z "${STAGED_BACKUP[index]}" ]] || rm -f "${STAGED_BACKUP[index]}"
                done
                return 0
            fi
            log "ERROR: keepalived reload failed."
        fi
    else
        log "ERROR: keepalived rejected the published ${what}."
    fi

    for index in "${!STAGED_INSTALLED[@]}"; do
        if [[ -n "${STAGED_BACKUP[index]}" ]]; then
            mv -f "${STAGED_BACKUP[index]}" "${STAGED_INSTALLED[index]}"
            log "keepalived: previous ${STAGED_WHAT[index]} restored. keepalived was NOT reloaded."
        else
            rm -f "${STAGED_INSTALLED[index]}"
            log "keepalived: the published ${STAGED_WHAT[index]} was removed again."
        fi
    done
    return 1
}

stage_keepalived_addresses() {
    stage_keepalived_file "${CURRENT}/keepalived/addresses.conf" "$KEEPALIVED_ADDRESSES" \
        "address list" keepalived_includes_anywhere
}

sync_keepalived_addresses() {
    stage_keepalived_addresses
    activate_keepalived
}

#
# A release whose IPVS file holds virtual servers is one this node cannot
# serve until keepalived.conf includes the file (review 26-10-08, F1): the
# file would be installed inert and the syslog objects forwarded nowhere,
# while the deploy said it succeeded. Refused instead, as a dns listener is
# on a node without dnsdist. A file without virtual servers is every
# cluster's - one with no syslog object - and is installed inert as before,
# which is how the file arrives before a person adds the include.
#
ipvs_unreadable() {
    local file="$1"
    [[ -f "$file" ]] || return 1
    grep -q '^virtual_server ' "$file" || return 1
    ! keepalived_includes_at_top "$KEEPALIVED_IPVS"
}

refuse_unread_ipvs() {
    log "ERROR: the release carries syslog objects, but ${KEEPALIVED_CONF} does not include"
    log "ERROR: ${KEEPALIVED_IPVS} at its top level, so nothing would forward them."
    log "ERROR: add 'include ${KEEPALIVED_IPVS}' to ${KEEPALIVED_CONF} (docs/install.md), then deploy again."
}

validate_ipvs_candidate() {
    if ipvs_unreadable "${1}/keepalived/ipvs.conf"; then
        refuse_unread_ipvs
        return 1
    fi
}

stage_keepalived_ipvs() {
    if ipvs_unreadable "${CURRENT}/keepalived/ipvs.conf"; then
        refuse_unread_ipvs
        return 1
    fi
    stage_keepalived_file "${CURRENT}/keepalived/ipvs.conf" "$KEEPALIVED_IPVS" \
        "IPVS file" keepalived_includes_at_top
}

sync_keepalived_ipvs() {
    stage_keepalived_ipvs || return 1
    activate_keepalived
}

#
# Both files, staged and then activated together (R3): one test, one reload,
# or both put back. An IPVS file keepalived would not read is refused before
# anything is staged, so the address list does not go live without it.
#
sync_keepalived() {
    if ipvs_unreadable "${CURRENT}/keepalived/ipvs.conf"; then
        refuse_unread_ipvs
        return 1
    fi
    #
    # The configuration first: the list and the IPVS file are staged only when
    # keepalived.conf includes them, and on a new node it is this file that
    # does.
    #
    stage_keepalived_conf || return 1
    stage_keepalived_addresses
    stage_keepalived_ipvs
    activate_keepalived
}

#
# The WAF engine (Fas 21, B229-B232). It is a package a person installs, and it
# reads rules only a release provides: a release with `waf/` turns it on, a
# release without one turns it off. Coraza re-reads its rules on SIGHUP and,
# when they do not compile, keeps the previous ones and says so only in its
# log - so the candidate is compiled with -validate before anything changes,
# and a reload counts only once the engine has said it took the new rules.
#
WAF_ENGINE="/usr/sbin/coraza-spoa"
WAF_UNIT="coraza-spoa.service"
WAF_WAIT_SECONDS=10

validate_waf_candidate() {
    local candidate="$1"

    [[ -e "${candidate}/waf" ]] || return 0
    if [[ ! -x "$WAF_ENGINE" ]]; then
        #
        # Refused rather than deployed without it: HAProxy would accept the
        # configuration and then send every request to an engine that is not
        # there, which is the object's on_engine_error for every request.
        #
        log "ERROR: the release carries WAF rules, but the WAF engine is not installed on this node."
        log "ERROR: install the haprion-coraza-spoa package, then deploy again."
        return 1
    fi
    log "Validating candidate WAF rules..."
    if ! "$WAF_ENGINE" -validate -config "${candidate}/waf/coraza.yaml"; then
        log "ERROR: the WAF engine rejected the candidate rules. The existing config is left untouched."
        return 1
    fi
    log "Candidate WAF rules OK."
}

waf_listening() {
    local bind port
    #
    # The generator writes `bind: 127.0.0.1:<port>` and nothing else on that
    # line; a value this does not read as a port is a release this node
    # cannot confirm, and is treated as not listening.
    #
    bind="$(sed -n 's/^bind:[[:space:]]*//p' "${CURRENT}/waf/coraza.yaml" | head -n 1)"
    port="${bind##*:}"
    [[ "$port" =~ ^[0-9]{1,5}$ ]] || return 1
    #
    # The engine's own listener, not any: something else holding the port
    # would read as an engine that started while the engine itself failed to
    # bind. `-p` names the process, which needs root - as this script runs.
    #
    ss -Hltnp "sport = :${port}" | grep -q '"coraza-spoa"'
}

#
# The engine's own lines. From package revision 2 the unit logs into a journal
# namespace of its own (its matches carry whole request fields, longer than the
# system journal and rsyslog keep whole); the unit says which, so this reads
# the right journal under either package revision.
#
waf_journal() {
    local namespace
    namespace="$(systemctl show -P LogNamespace "$WAF_UNIT" 2>/dev/null || true)"
    if [[ -n "$namespace" ]]; then
        journalctl --namespace="$namespace" -u "$WAF_UNIT" "$@"
    else
        journalctl -u "$WAF_UNIT" "$@"
    fi
}

#
# Whether two releases give the engine different rules: their `waf/`, file by
# file (review 26-10-08, R5). Neither having one is no difference; one having
# it is. The engine is reloaded only when this says so - an http change that
# leaves the rules alone used to reload them on every deploy.
#
waf_differs() {
    local old="$1/waf" new="$2/waf"
    [[ -d "$old" || -d "$new" ]] || return 1
    [[ -d "$old" && -d "$new" ]] || return 0
    ! diff -qr "$old" "$new" >/dev/null
}

#
# The releases a node keeps (review 26-10-08, R4): the newest KEEP_RELEASES,
# and always the one `current` names, the one HAProxy ran before this deploy
# and the one an interrupted run left behind - whatever their age. Run only
# after a deploy that completed, so a failed one never removes the release it
# fell back to. The names are the deploy's time, so they sort as they were made;
# anything else in the directory is left alone. The configuration a release
# carries is read when HAProxy, the engine or dnsdist loads it; nothing reads
# a superseded one afterwards.
#
KEEP_RELEASES=10

prune_releases() {
    local kept current entry count=0
    current="$(readlink -f "$CURRENT")"
    while IFS= read -r entry; do
        count=$((count + 1))
        (( count > KEEP_RELEASES )) || continue
        for kept in "$current" "$OLD_RELEASE" "$RUNNING"; do
            [[ "$entry" != "$kept" ]] || continue 2
        done
        rm -rf -- "$entry"
        log "pruned ${entry}"
    done < <(find "$RELEASE_DIR" -mindepth 1 -maxdepth 1 -type d \
        -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}' | sort -r)
}

sync_waf_engine() {
    local changed="$1" cursor lines waited

    if [[ ! -f "${CURRENT}/waf/coraza.yaml" ]]; then
        if systemctl is-enabled --quiet "$WAF_UNIT" 2>/dev/null \
            || systemctl is-active --quiet "$WAF_UNIT" 2>/dev/null; then
            log "WAF: the release carries no rules. Stopping the engine."
            if ! systemctl disable --quiet --now "$WAF_UNIT"; then
                log "ERROR: the WAF engine could not be stopped."
                return 1
            fi
        fi
        return 0
    fi

    if ! systemctl is-active --quiet "$WAF_UNIT"; then
        log "WAF: starting the engine."
        if ! systemctl enable --quiet --now "$WAF_UNIT"; then
            log "ERROR: the WAF engine could not be started."
            return 1
        fi
        for (( waited = 0; waited < WAF_WAIT_SECONDS * 5; waited++ )); do
            if waf_listening; then
                log "WAF: engine listening."
                return 0
            fi
            sleep 0.2
        done
        log "ERROR: the WAF engine did not start listening within ${WAF_WAIT_SECONDS}s."
        return 1
    fi

    # Running but not enabled is a node that would lose its engine at reboot.
    systemctl is-enabled --quiet "$WAF_UNIT" || systemctl enable --quiet "$WAF_UNIT"
    (( changed )) || return 0

    #
    # Only what the engine logs after this point counts: the cursor is the
    # journal's own position, so an earlier reload's line - even one within
    # the same second - is never read as this one's answer.
    #
    cursor="$(waf_journal -n 0 --show-cursor --no-pager | sed -n 's/^-- cursor: //p')"
    log "WAF: reloading the engine's rules."
    if ! systemctl reload "$WAF_UNIT"; then
        log "ERROR: the WAF engine could not be signalled."
        return 1
    fi
    for (( waited = 0; waited < WAF_WAIT_SECONDS * 5; waited++ )); do
        if [[ -n "$cursor" ]]; then
            lines="$(waf_journal --after-cursor "$cursor" -o cat --no-pager)"
        else
            lines="$(waf_journal -n 20 -o cat --no-pager)"
        fi
        if grep -q 'Configuration successfully reloaded' <<<"$lines"; then
            log "WAF: engine took the new rules."
            return 0
        fi
        if grep -q 'Failed to reload configuration' <<<"$lines"; then
            log "ERROR: the WAF engine refused the new rules and kept the previous ones."
            return 1
        fi
        sleep 0.2
    done
    log "ERROR: the WAF engine did not confirm the new rules within ${WAF_WAIT_SECONDS}s."
    return 1
}

#
# dnsdist, which serves the cluster's dns listeners (Fas 19, B249). Installed
# by 04-node-prepare with a drop-in that points it at /etc/haproxy/dns; a
# release with `dns/` turns it on and one without turns it off, as `waf/` does
# the WAF engine. dnsdist reads its file only when it starts, so a changed
# file is a restart - and only a changed file: the restart drops the queries
# in flight, which their clients ask again.
#
DNSDIST="/usr/bin/dnsdist"
DNS_UNIT="dnsdist.service"
DNS_DROPIN="/etc/systemd/system/dnsdist.service.d/haprion.conf"
DNS_WAIT_SECONDS=10

validate_dns_candidate() {
    local candidate="$1" output

    [[ -e "${candidate}/dns" ]] || return 0
    if [[ ! -x "$DNSDIST" || ! -f "$DNS_DROPIN" ]]; then
        log "ERROR: the release carries a dns listener, but this node is not prepared for one."
        log "ERROR: run 04-node-prepare (tools/install-node-package does), then deploy again."
        return 1
    fi
    log "Validating candidate dns listener..."
    #
    # A key dnsdist does not know is ignored with a warning and exit 0
    # (measured on 2.1.2), so a warning refuses as an error does.
    #
    if ! output="$("$DNSDIST" --check-config -C "${candidate}/dns/dnsdist.conf" 2>&1)" \
        || grep -q -e 'prio="Warning"' -e 'prio="Error"' <<<"$output"; then
        printf '%s\n' "$output"
        log "ERROR: dnsdist rejected the candidate dns listener. The existing config is left untouched."
        return 1
    fi
    log "Candidate dns listener OK."
}

dns_listening() {
    local endpoint port
    #
    # Every listener the file names, by its port; dnsdist's own process must
    # hold each one for UDP. A port held by something else reads as not
    # listening, so a dnsdist that failed to bind is never taken for one that
    # did.
    #
    while read -r endpoint; do
        port="${endpoint##*:}"
        [[ "$port" =~ ^[0-9]{1,5}$ ]] || return 1
        ss -Hlunp "sport = :${port}" | grep -q '"dnsdist"' || return 1
    done < <(sed -n 's/^\(setLocal\|addLocal\)("\([^"]*\)")$/\2/p' "${CURRENT}/dns/dnsdist.conf")
}

sync_dns_listener() {
    local other="$1" waited

    if [[ ! -f "${CURRENT}/dns/dnsdist.conf" ]]; then
        if systemctl is-enabled --quiet "$DNS_UNIT" 2>/dev/null \
            || systemctl is-active --quiet "$DNS_UNIT" 2>/dev/null; then
            log "DNS: the release carries no dns listener. Stopping dnsdist."
            if ! systemctl disable --quiet --now "$DNS_UNIT"; then
                log "ERROR: dnsdist could not be stopped."
                return 1
            fi
        fi
        return 0
    fi

    if ! systemctl is-active --quiet "$DNS_UNIT"; then
        log "DNS: starting dnsdist."
        systemctl enable --quiet --now "$DNS_UNIT" || { log "ERROR: dnsdist could not be started."; return 1; }
    elif ! cmp -s "${other}/dns/dnsdist.conf" "${CURRENT}/dns/dnsdist.conf"; then
        log "DNS: restarting dnsdist with the new listener."
        systemctl restart "$DNS_UNIT" || { log "ERROR: dnsdist could not be restarted."; return 1; }
    else
        # Running but not enabled is a node that would lose its listener at reboot.
        systemctl is-enabled --quiet "$DNS_UNIT" || systemctl enable --quiet "$DNS_UNIT"
        return 0
    fi
    systemctl is-enabled --quiet "$DNS_UNIT" || systemctl enable --quiet "$DNS_UNIT"
    for (( waited = 0; waited < DNS_WAIT_SECONDS * 5; waited++ )); do
        if systemctl is-active --quiet "$DNS_UNIT" && dns_listening; then
            log "DNS: dnsdist listening."
            return 0
        fi
        sleep 0.2
    done
    log "ERROR: dnsdist did not start listening within ${DNS_WAIT_SECONDS}s."
    return 1
}

#
# rsyslog, which sends the traffic log to the cluster's external receivers
# with a queue on disk (B286). Prepared by 04-node-prepare: a fixed
# 47-haprion-forward.conf includes the file below when it is there. A release
# with `rsyslog/` puts it there and one without takes it away. The file is
# copied rather than linked: rsyslogd's AppArmor profile lets it read
# /etc/rsyslog.d and not the releases (measured 26-10-12). rsyslog reads its
# configuration only when it starts, so a changed file is a restart - and
# only a changed file; the queues are kept on disk across it.
#
RSYSLOGD="/usr/sbin/rsyslogd"
RSYSLOG_UNIT="rsyslog.service"
RSYSLOG_FORWARD_RULE="/etc/rsyslog.d/47-haprion-forward.conf"
RSYSLOG_FORWARD_DIR="/etc/rsyslog.d/haprion"
RSYSLOG_FORWARD="${RSYSLOG_FORWARD_DIR}/forward.conf"

validate_rsyslog_candidate() {
    local candidate="$1" check copy output status

    [[ -e "${candidate}/rsyslog" ]] || return 0
    if [[ ! -x "$RSYSLOGD" || ! -f "$RSYSLOG_FORWARD_RULE" || ! -d "$RSYSLOG_FORWARD_DIR" ]]; then
        log "ERROR: the release sends the traffic log to receivers, but this node is not prepared for it."
        log "ERROR: run 04-node-prepare (tools/install-node-package does), then deploy again."
        return 1
    fi
    log "Validating candidate log forwarding..."
    #
    # On its own, where rsyslogd may read it. The whole system configuration
    # is checked again when the file is put in place.
    #
    copy="${RSYSLOG_FORWARD_DIR}/.candidate-$$.conf"
    check="${RSYSLOG_FORWARD_DIR}/.check-$$.conf"
    install -m 644 "${candidate}/rsyslog/forward.conf" "$copy"
    printf 'include(file="%s")\n' "$copy" > "$check"
    status=0
    output="$("$RSYSLOGD" -N1 -f "$check" 2>&1)" || status=$?
    rm -f "$copy" "$check"
    if (( status != 0 )); then
        printf '%s\n' "$output"
        log "ERROR: rsyslog rejected the candidate log forwarding. The existing config is left untouched."
        return 1
    fi
    log "Candidate log forwarding OK."
}

sync_rsyslog_forward() {
    local wanted="${CURRENT}/rsyslog/forward.conf" kept="${RSYSLOG_FORWARD}.rollback" output

    if [[ -f "$wanted" ]]; then
        cmp -s "$wanted" "$RSYSLOG_FORWARD" 2>/dev/null && return 0
        log "Log forwarding: installing the receivers of this release."
    else
        [[ -e "$RSYSLOG_FORWARD" ]] || return 0
        log "Log forwarding: the release sends the traffic log nowhere. Removing it."
    fi
    rm -f "$kept"
    [[ -e "$RSYSLOG_FORWARD" ]] && cp -a "$RSYSLOG_FORWARD" "$kept"
    if [[ -f "$wanted" ]]; then
        install -m 644 "$wanted" "${RSYSLOG_FORWARD}.new"
        mv -f "${RSYSLOG_FORWARD}.new" "$RSYSLOG_FORWARD"
    else
        rm -f "$RSYSLOG_FORWARD"
    fi
    #
    # The whole configuration as rsyslog will read it, and the previous file
    # back if it is refused or does not start: a node that logged nothing
    # locally would be worse than one that forwards to the old receivers.
    #
    if ! output="$("$RSYSLOGD" -N1 2>&1)" || ! systemctl restart "$RSYSLOG_UNIT"; then
        printf '%s\n' "$output"
        log "ERROR: rsyslog did not take the new log forwarding. Putting the previous one back."
        if [[ -e "$kept" ]]; then
            mv -f "$kept" "$RSYSLOG_FORWARD"
        else
            rm -f "$RSYSLOG_FORWARD"
        fi
        systemctl restart "$RSYSLOG_UNIT" || log "ERROR: rsyslog could not be restarted with the previous file either."
        return 1
    fi
    rm -f "$kept"
    log "Log forwarding: rsyslog restarted."
}

OLD_RELEASE="$(readlink -f "$CURRENT")"
#
# The release HAProxy is running: `current`, unless an earlier run switched the
# link and never reloaded, when it is the one that run left in the marker.
#
RUNNING="$OLD_RELEASE"
WAS_PENDING=0
if [[ -s "$PENDING" ]]; then
    RUNNING="$(head -n 1 "$PENDING")"
    WAS_PENDING=1
fi

mark_pending() {
    printf '%s\n%s\n' "$RUNNING" "$1" > "${PENDING}.new"
    mv -f "${PENDING}.new" "$PENDING"
}

#
# `current` was put back on OLD_RELEASE. HAProxy runs it again if a reload
# succeeded, or if it never left it; otherwise the marker says what it runs.
#
settle_pending() {
    if [[ "$RUNNING" == "$OLD_RELEASE" ]]; then
        rm -f "$PENDING"
    else
        mark_pending "$OLD_RELEASE"
    fi
}

log "Fetching published configuration from ${MANAGER}..."

#
# Bounded in time (review 2026-10-03, I3): a connection that goes silent ends
# the run within a minute or two instead of holding the deploy lock for ever.
#
rsync -a --delete --timeout=120 \
    -e "ssh -i ${SSH_KEY} -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4" \
    "${REMOTE_USER}@${MANAGER}:${REMOTE_PATH}" \
    "${STAGE}/"

# Basic sanity checks
if [[ ! -f "${STAGE}/haproxy.cfg" ]]; then
    log "ERROR: haproxy.cfg is missing from the fetched configuration."
    exit 1
fi

if [[ ! -d "${STAGE}/conf.d" ]]; then
    log "ERROR: conf.d is missing from the fetched configuration."
    exit 1
fi

if [[ ! -d "${STAGE}/maps" ]]; then
    log "ERROR: maps is missing from the fetched configuration."
    exit 1
fi

#
# A node removed from its cluster (B319, Fas 18 finding 73). The manager
# publishes the cluster without it and asks it for this one last deploy before
# its keys go. Left running, its keepalived kept the old peers; once the nodes
# that stayed had their new list they stopped hearing it, and it took the
# cluster's addresses beside them.
#
# Removed means: the release carries the product's keepalived files (B313) and
# none for this node - neither by name nor by the address this node's own
# file sends from, so a renamed host is not mistaken for a removed one - and
# the keepalived.conf here is the product's. A person's keepalived.conf (B57)
# is theirs, and so is what it peers with.
#
# Stopped and disabled, with a marker: the node is no longer this cluster's,
# and a reboot must not bring it back. Added again, the first release that
# names it starts both and takes the marker away.
#
LEFT_MARKER="/etc/haprion/left-cluster"

removed_from_release() {
    local own
    [[ -f "$KEEPALIVED_CONF" ]] || return 1
    [[ "$(head -n 1 "$KEEPALIVED_CONF")" == "$KEEPALIVED_MARK" ]] || return 1
    compgen -G "${STAGE}/keepalived/node-*.conf" >/dev/null || return 1
    [[ ! -f "${STAGE}/keepalived/node-$(hostname).conf" ]] || return 1
    own="$(awk '$1 == "unicast_src_ip" { print $2; exit }' "$KEEPALIVED_CONF")"
    [[ -n "$own" ]] || return 1
    ! awk -v own="$own" '$1 == "unicast_src_ip" && $2 == own { found = 1 } END { exit !found }' \
        "${STAGE}"/keepalived/node-*.conf
}

if removed_from_release; then
    log "This node is not in the published release: it was removed from the cluster."
    if ! systemctl disable --quiet --now keepalived; then
        log "ERROR: keepalived could not be stopped."
        exit 1
    fi
    if ! systemctl disable --quiet --now haproxy; then
        log "ERROR: HAProxy could not be stopped."
        exit 1
    fi
    touch "$LEFT_MARKER"
    log "keepalived and HAProxy stopped, and will not start at boot."
    exit 0
fi

if [[ -e "$LEFT_MARKER" ]]; then
    log "This node is in the published release again: starting HAProxy and keepalived."
    systemctl enable --quiet --now haproxy || { log "ERROR: HAProxy could not be started."; exit 1; }
    systemctl enable --quiet --now keepalived || { log "ERROR: keepalived could not be started."; exit 1; }
    rm -f "$LEFT_MARKER"
fi

# Nothing changed?
if diff -qr "$OLD_RELEASE" "$STAGE" >/dev/null; then
    if [[ -e "$PENDING" ]]; then
        #
        # The files are the ones asked for, but an earlier run was stopped
        # before HAProxy read them. The engine and the reload are the part it
        # never did; validated again through the paths systemd uses.
        #
        log "An earlier run switched to this configuration but never reloaded. Finishing..."
        haproxy -c -f "${HAPROXY_DIR}/haproxy.cfg" -f "${HAPROXY_DIR}/conf.d"
        sync_waf_engine 1
        sync_dns_listener "$RUNNING"
        "$SERVER_STATE" reload
        rm -f "$PENDING"
        sync_keepalived
        sync_rsyslog_forward
        log "Deploy complete."
        prune_releases
        exit 0
    fi
    log "No change. No deploy or reload needed."
    #
    # Except possibly the address list. The release is what changes when an
    # address is added, but the moment the include line is first put into
    # keepalived.conf the published list is already current and this branch is
    # the one taken - so a node prepared for B57 would otherwise stay without
    # its addresses until the next unrelated configuration change.
    #
    # And the engine, which a reboot or a person may have stopped.
    sync_waf_engine 0 || exit 1
    sync_dns_listener "$CURRENT" || exit 1
    sync_keepalived || exit 1
    sync_rsyslog_forward || exit 1
    exit 0
fi

log "New configuration detected."

#
# Validate the candidate.
#
# The configuration uses absolute paths under /etc/haproxy/maps and
# /etc/haproxy/waf - HAProxy's and the WAF engine's own. In the validation copy
# we therefore point those at the candidate's own maps and rules.
#
cp -a "${STAGE}/." "${VALIDATE}/"

while IFS= read -r -d '' file; do
    sed -i \
        -e "s#/etc/haproxy/maps/#${VALIDATE}/maps/#g" \
        -e "s#/etc/haproxy/waf/#${VALIDATE}/waf/#g" \
        "$file"
done < <(
    grep -RIlZ -e '/etc/haproxy/maps/' -e '/etc/haproxy/waf/' \
        --include='*.cfg' --include='*.yaml' --include='*.conf' \
        "$VALIDATE" || true
)

log "Validating candidate configuration..."

if ! haproxy -c \
    -f "${VALIDATE}/haproxy.cfg" \
    -f "${VALIDATE}/conf.d"
then
    log "ERROR: Candidate configuration is invalid. The existing config is left untouched."
    exit 1
fi

log "Candidate configuration OK."

validate_waf_candidate "$VALIDATE" || exit 1
validate_dns_candidate "$VALIDATE" || exit 1
validate_rsyslog_candidate "$VALIDATE" || exit 1
validate_ipvs_candidate "$VALIDATE" || exit 1

#
# Create a new immutable release
#
RELEASE="${RELEASE_DIR}/$(date +%Y%m%d-%H%M%S)"

mkdir -p "$RELEASE"
cp -a "${STAGE}/." "${RELEASE}/"

chown -R root:root "$RELEASE"
#
# `+`, not `\;`: as many paths per chmod as fit, rather than one process per
# file (review 26-10-08, R6; 2 000 files took 2-8 s one by one, 0.01 s so).
#
find "$RELEASE" -type d -exec chmod 755 {} +
find "$RELEASE" -type f -exec chmod 644 {} +

#
# Atomic swap of the current symlink
#
NEW_LINK="${HAPROXY_DIR}/current.new"

mark_pending "$RELEASE"
rm -f "$NEW_LINK"
ln -s "$RELEASE" "$NEW_LINK"
mv -Tf "$NEW_LINK" "$CURRENT"

log "current now points at $(readlink -f "$CURRENT")"

#
# Validate again through exactly the paths systemd uses.
#
if ! haproxy -c \
    -f "${HAPROXY_DIR}/haproxy.cfg" \
    -f "${HAPROXY_DIR}/conf.d"
then
    log "ERROR: Validation after activation failed. Rolling back."

    rm -f "$NEW_LINK"
    ln -s "$OLD_RELEASE" "$NEW_LINK"
    mv -Tf "$NEW_LINK" "$CURRENT"
    settle_pending

    exit 1
fi

#
# The engine before HAProxy: HAProxy must never name an application the
# engine does not know yet. If the engine does not take the rules, nothing has
# been reloaded - put `current` back and return the engine to the old rules.
#
#
# Against the release HAProxy and the engine are running, and always when an
# earlier run was stopped half-way: what the engine read then is not known,
# and a file comparison does not say what a process has loaded.
#
WAF_CHANGED=1
if (( ! WAS_PENDING )) && ! waf_differs "$RUNNING" "$RELEASE"; then
    WAF_CHANGED=0
fi
if ! sync_waf_engine "$WAF_CHANGED"; then
    log "ERROR: the WAF engine did not take the new rules. Rolling back to ${OLD_RELEASE}."

    rm -f "$NEW_LINK"
    ln -s "$OLD_RELEASE" "$NEW_LINK"
    mv -Tf "$NEW_LINK" "$CURRENT"
    settle_pending

    sync_waf_engine 1 || log "ERROR: the WAF engine could not be returned to the previous rules either."

    exit 1
fi

#
# The dns listener, after the engine and before HAProxy, for the engine's
# reason: if dnsdist does not take the new file, nothing has been reloaded.
#
if ! sync_dns_listener "$OLD_RELEASE"; then
    log "ERROR: dnsdist did not take the new dns listener. Rolling back to ${OLD_RELEASE}."

    rm -f "$NEW_LINK"
    ln -s "$OLD_RELEASE" "$NEW_LINK"
    mv -Tf "$NEW_LINK" "$CURRENT"
    settle_pending

    sync_waf_engine 1 || log "ERROR: the WAF engine could not be returned to the previous rules either."
    sync_dns_listener "$RELEASE" || log "ERROR: dnsdist could not be returned to the previous listener either."

    exit 1
fi

#
# Reload
#
log "Reloading HAProxy..."

if "$SERVER_STATE" reload; then
    rm -f "$PENDING"
    #
    # Explicitly, rather than by letting `set -e` end the script: a deploy that
    # activated the configuration and could not activate the addresses is a
    # failure, and it is a different failure from the ones above. HAProxy is
    # live and correct; what is missing is the address it was told to bind.
    #
    if ! sync_keepalived; then
        log "ERROR: the configuration is live, but keepalived's address list or IPVS file is not."
        exit 1
    fi
    #
    # After the reload, as keepalived: HAProxy is live and correct, and a
    # forwarding rsyslog refused is a failure of its own, not one to roll the
    # configuration back for.
    #
    if ! sync_rsyslog_forward; then
        log "ERROR: the configuration is live, but the log forwarding is not."
        exit 1
    fi
    log "Deploy complete."
    prune_releases
else
    log "ERROR: HAProxy reload failed. Rolling back to ${OLD_RELEASE}."

    rm -f "$NEW_LINK"
    ln -s "$OLD_RELEASE" "$NEW_LINK"
    mv -Tf "$NEW_LINK" "$CURRENT"

    # Try to bring HAProxy back to the known-good config
    if "$SERVER_STATE" reload; then
        RUNNING="$OLD_RELEASE"
    fi
    settle_pending
    sync_waf_engine 1 || true
    sync_dns_listener "$RELEASE" || true

    exit 1
fi
