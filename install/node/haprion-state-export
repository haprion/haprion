#!/bin/bash
#
# Collect this node's permanent state and write it to stdout as a gzipped tar.
#
# Run by the backup account through an exact sudo rule, so the management host
# can pull a node's state without holding a login on it. Everything it collects
# is what a rebuild needs to recreate this node exactly: identity, network,
# service configuration, SSH host keys and the local accounts.
#
# It writes to stdout and touches nothing on the node. The archive contains
# password hashes and private SSH keys, so it is stored root-only on the
# management side - see docs/user-manual.md.
#
set -euo pipefail

umask 077

#
# Which local accounts belong to this node is deployment data, not something to
# compile in. The list used to be hardcoded, which meant the script named real
# operator accounts and could not be published - and quietly missed any account
# added after it was written.
#
NODE_CONF="/etc/haprion/node.conf"

[[ -r "$NODE_CONF" ]] || {
    echo "ERROR: ${NODE_CONF} is missing. Run install/04-node-prepare." >&2
    exit 78
}
# shellcheck source=/dev/null
source "$NODE_CONF"

[[ -n "${BACKUP_ACCOUNTS:-}" ]] || {
    echo "ERROR: BACKUP_ACCOUNTS is not set in ${NODE_CONF}" >&2
    exit 78
}
[[ -n "${BACKUP_SERVICE_ACCOUNTS:-}" ]] || {
    echo "ERROR: BACKUP_SERVICE_ACCOUNTS is not set in ${NODE_CONF}. Run install/04-node-prepare." >&2
    exit 78
}

TMPDIR="$(mktemp -d -t haprion-state-export.XXXXXX)"
trap 'rm -rf "$TMPDIR"' EXIT

ROOTFS="$TMPDIR/rootfs"
META="$TMPDIR/meta"

mkdir -p "$ROOTFS" "$META"

copy_path() {
    local src="$1"

    if [[ -e "$src" || -L "$src" ]]; then
        local dst="$ROOTFS$src"
        mkdir -p "$(dirname "$dst")"
        cp -a -- "$src" "$dst"
    fi
}

# ------------------------------------------------------------
# Node-specific configuration
# ------------------------------------------------------------

copy_path /etc/hostname
copy_path /etc/hosts

copy_path /etc/keepalived/keepalived.conf
#
# The address list keepalived.conf includes. Regenerated by a deploy, so a
# restore does not depend on it - but a snapshot of a configuration without the
# file it includes does not say what the node was carrying, and that is the
# question a restore is usually trying to answer.
#
copy_path /etc/keepalived/addresses.conf
#
# The syslog objects' IPVS virtual servers (B256), for the same reason, and
# absent on a node without them.
#
copy_path /etc/keepalived/ipvs.conf
copy_path /etc/default/keepalived

copy_path /etc/netplan

#
# The whole directory rather than one file. A single named file goes missing the
# day someone renames it, and the rename is exactly the change a restore would
# need to reproduce.
#
copy_path /etc/sysctl.d

copy_path /etc/systemd/system/haproxy.service.d

copy_path /etc/default/haproxy

#
# Where HAProxy comes from, not just which packages are installed.
# packages.txt records names; a name resolves to whatever the node's sources
# happen to offer, which after a restore is the distribution's package on a
# different branch. The keyring, the source and the pin are what make the
# answer reproducible, so they belong in the archive with everything else that
# has to come back identical.
#
copy_path /etc/apt/sources.list.d
copy_path /etc/apt/preferences.d
copy_path /etc/apt/keyrings

copy_path /etc/sudoers.d

# What this node believes about itself: its cluster, its management host, and
# the account and key it fetches configuration with.
copy_path /etc/haprion

# ------------------------------------------------------------
# SSH server and this node's SSH identity
# ------------------------------------------------------------

copy_path /etc/ssh/sshd_config
copy_path /etc/ssh/sshd_config.d

for f in /etc/ssh/ssh_host_*; do
    [[ -e "$f" ]] && copy_path "$f"
done

# ------------------------------------------------------------
# SSH state for the accounts that have any
# ------------------------------------------------------------

copy_path /root/.ssh

for user in $BACKUP_ACCOUNTS; do
    if getent passwd "$user" >/dev/null; then
        home="$(getent passwd "$user" | cut -d: -f6)"
        copy_path "$home/.ssh"
    fi
done

# ------------------------------------------------------------
# Local management and recovery scripts
# ------------------------------------------------------------

DR_SCRIPTS=(
    haprion-pull-deploy
    haprion-cert-pull
    haprion-cert-remove
    haprion-cert-trigger
    haprion-node-status
    haprion-health-probe
    haprion-keepalived-state
    haprion-state-export
    haprion-traffic-log-read
    haprion-traffic-log-enable
    haprion-traffic-log-prune
    haprion-server-state
    haprion-server-state-trigger
)
for script in "${DR_SCRIPTS[@]}"; do
    copy_path "/usr/sbin/${script}"
done

# Optional traffic logging is still node state when it is enabled. The day
# files themselves are operational history and deliberately stay out of a DR
# archive; the configuration and retention machinery are what make a rebuilt
# node resume producing them.
copy_path /etc/rsyslog.d/48-haprion-traffic.conf
copy_path /etc/apparmor.d/rsyslog.d/haprion-traffic
copy_path /etc/systemd/system/haprion-traffic-log-prune.service
copy_path /etc/systemd/system/haprion-traffic-log-prune.timer

# The servers this node keeps drained or in maintenance (B263): put back by
# haprion-server-state when HAProxy starts, so a node rebuilt without them
# would send traffic to a server an operator took out. Absent until a state is
# first kept.
copy_path /var/lib/haprion/server-state.json

# The mask is state. Reinstalling a package on a clean node must not silently
# turn a service the appliance deliberately disabled back on.
copy_path /etc/systemd/system/ipvsadm.service

# A finished appliance has cloud-init disabled; its absence is itself a finding.
copy_path /etc/cloud/cloud-init.disabled

# ------------------------------------------------------------
# The operator's own paths
# ------------------------------------------------------------
#
# EXTRA_BACKUP_PATHS in node.conf names files that are the operator's rather
# than the product's - a local kernel option, a site's own drop-in. They go into
# rootfs/ at their own path like everything above and are listed in
# meta/extra-paths.txt, so a restore can tell them from the product's state.
#
# A listed path that is missing, or that holds something a state archive cannot
# carry, fails the export instead of being skipped. The operator asked for it by
# name, and the management side only shows an export's messages when it fails:
# a skipped path would be an archive that quietly lacks it.
#
# The same pattern is checked when 04-node-prepare renders node.conf, which is
# sourced as root - so nothing in a path may quote, expand or glob.
EXTRA_PATH_PATTERN='^/[A-Za-z0-9._@+/-]+$'

copy_extra_paths() {
    local extras=() extra
    read -r -a extras <<<"${EXTRA_BACKUP_PATHS:-}"
    for extra in "${extras[@]}"; do
        if [[ ! "$extra" =~ $EXTRA_PATH_PATTERN || "${extra}/" == *"/../"* \
              || "${extra}/" == *"/./"* || "$extra" == *"//"* || "$extra" == "/" \
              || "$extra" =~ ^/(proc|sys|dev|run)(/|$) ]]; then
            echo "ERROR: EXTRA_BACKUP_PATHS holds an unusable path: ${extra}" >&2
            exit 78
        fi
        if [[ ! -e "$extra" && ! -L "$extra" ]]; then
            echo "ERROR: EXTRA_BACKUP_PATHS names ${extra}, which does not exist on this node" >&2
            exit 78
        fi
        if [[ ! -L "$extra" ]] \
            && find "$extra" ! -type f ! -type d ! -type l -print -quit | grep -q .; then
            echo "ERROR: ${extra} holds a socket, pipe or device, which a state archive cannot carry" >&2
            exit 78
        fi
        #
        # A path may overlap what is already carried - the product's own
        # directory, or a parent of it. `cp -a dir existing-dir` would nest the
        # copy inside itself, so an existing directory is merged into and an
        # existing file is left as the product took it.
        #
        local target="$ROOTFS$extra"
        if [[ -d "$extra" && ! -L "$extra" && -d "$target" && ! -L "$target" ]]; then
            cp -a -- "$extra/." "$target/"
        elif [[ ! -e "$target" && ! -L "$target" ]]; then
            copy_path "$extra"
        fi
    done
    printf '%s\n' "${extras[@]}" | sed '/^$/d' > "$META/extra-paths.txt"
}
copy_extra_paths

# ------------------------------------------------------------
# Metadata
# ------------------------------------------------------------

date --iso-8601=seconds > "$META/backup-created.txt"

hostname | tr '[:upper:]' '[:lower:]' > "$META/hostname.txt"
hostname -f | tr '[:upper:]' '[:lower:]' > "$META/fqdn.txt"

cp /etc/os-release "$META/os-release"

ip -brief address > "$META/ip-addresses.txt"
ip route > "$META/routes.txt"

{
    for user in $BACKUP_ACCOUNTS; do
        if getent passwd "$user" >/dev/null; then
            getent passwd "$user"
        fi
    done
} > "$META/users.txt"

{
    for user in $BACKUP_ACCOUNTS; do
        if getent passwd "$user" >/dev/null; then
            id "$user"
        fi
    done
} > "$META/groups.txt"

{
    for group in $BACKUP_ACCOUNTS ${BACKUP_GROUPS:-}; do
        if getent group "$group" >/dev/null; then
            getent group "$group"
        fi
    done
} | sort -u > "$META/group-definitions.txt"

#
# Password hashes, so a rebuilt node has the same local accounts rather than
# accounts that merely have the same names. This is why the archive is stored
# root-only on the management side.
#
{
    for user in $BACKUP_ACCOUNTS; do
        if getent passwd "$user" >/dev/null; then
            getent shadow "$user" || true
        fi
    done
} > "$META/shadow.txt"

apt-mark showmanual | sort > "$META/packages.txt"

dpkg-query -W -f='${binary:Package}\t${Version}\n' \
    | sort > "$META/package-versions.txt"

{
    for service in haproxy keepalived ssh qemu-guest-agent; do
        echo "[$service]"
        echo "enabled=$(systemctl is-enabled "$service" 2>/dev/null || true)"
        echo "active=$(systemctl is-active "$service" 2>/dev/null || true)"
        echo
    done
} > "$META/services.txt"

# ------------------------------------------------------------
# DR completeness and tamper-evident manifest
# ------------------------------------------------------------

require_path() {
    local path="$1"
    [[ -e "$path" || -L "$path" ]] || {
        echo "ERROR: required DR state is missing: ${path}" >&2
        exit 78
    }
}

REQUIRED_DR_PATHS=(
    /etc/hostname
    /etc/hosts
    /etc/netplan
    /etc/keepalived/keepalived.conf
    /etc/keepalived/addresses.conf
    /etc/default/haproxy
    /etc/sysctl.d/60-haproxy.conf
    /etc/haprion/node.conf
    /etc/haprion/node-installation.json
    /etc/ssh/sshd_config
    /etc/ssh/ssh_host_ed25519_key
    /etc/ssh/ssh_host_ed25519_key.pub
)
for path in "${REQUIRED_DR_PATHS[@]}"; do
    require_path "$path"
done
if ! find /etc/netplan -maxdepth 1 -type f \( -name '*.yaml' -o -name '*.yml' \) -print -quit \
    | grep -q .; then
    echo "ERROR: required DR state is missing: a Netplan YAML file" >&2
    exit 78
fi
for script in "${DR_SCRIPTS[@]}"; do
    require_path "/usr/sbin/${script}"
done
# Forced-command service accounts must carry an authorized key. Operator
# accounts are still captured, but a password-only operator is legitimate and
# must not make every backup fail.
for user in $BACKUP_SERVICE_ACCOUNTS; do
    if getent passwd "$user" >/dev/null; then
        home="$(getent passwd "$user" | cut -d: -f6)"
        require_path "${home}/.ssh/authorized_keys"
    fi
done
require_path "$CONFIG_PULL_KEY"
[[ -z "${CERT_PULL_KEY:-}" ]] || require_path "$CERT_PULL_KEY"

# A restore carries the files, the node package and the engine and key packages
# to the VM in one transfer of at most RESTORE_PAYLOAD_LIMIT bytes
# (restore_agent.MAX_PAYLOAD; a test holds the two together). The packages take
# PACKAGES_RESERVE of it, about twice what they weigh today. An archive whose
# files pass the rest could be taken and listed and never restored, so it is
# refused here, where the operator can still take the large paths out of
# EXTRA_BACKUP_PATHS.
RESTORE_PAYLOAD_LIMIT=$((64 * 1024 * 1024))
PACKAGES_RESERVE=$((24 * 1024 * 1024))
TAR_OVERHEAD=1536

check_restore_limit() {
    local total count largest
    read -r total count < <(
        find "$ROOTFS" -type f -printf '%s\n' | awk '{ s += $1; n++ } END { print s + 0, n + 0 }'
    )
    total=$((total + count * TAR_OVERHEAD))
    if ((total > RESTORE_PAYLOAD_LIMIT - PACKAGES_RESERVE)); then
        largest="$(find "$ROOTFS" -type f -printf '%s %P\n' | sort -rn | head -3 \
            | awk '{ printf "%s%s (%.1f MiB)", sep, "/" $2, $1 / 1048576; sep = ", " }')"
        echo "ERROR: the files would make an archive a restore cannot carry:" \
            "$((total / 1048576)) MiB against $(((RESTORE_PAYLOAD_LIMIT - PACKAGES_RESERVE) / 1048576)) MiB." \
            "The largest are ${largest}. Take large paths out of EXTRA_BACKUP_PATHS in ${NODE_CONF}." >&2
        exit 78
    fi
}
check_restore_limit

# The manifest is the archive's content contract. It records metadata as well
# as bytes: a private key restored world-readable is not the same state merely
# because its checksum matches. It excludes itself and is generated only after
# every other file has reached the staging tree.
/usr/bin/python3 - "$TMPDIR" > "$META/manifest.json" <<'PY'
import hashlib
import json
import os
import stat
import sys
from pathlib import Path

root = Path(sys.argv[1])
entries = []
for tree in (root / "rootfs", root / "meta"):
    for path in sorted(tree.rglob("*")):
        relative = path.relative_to(root).as_posix()
        if relative == "meta/manifest.json":
            continue
        info = path.lstat()
        entry = {
            "path": relative,
            "mode": stat.S_IMODE(info.st_mode),
            "uid": info.st_uid,
            "gid": info.st_gid,
            "type": "other",
        }
        if stat.S_ISREG(info.st_mode):
            digest = hashlib.sha256()
            with path.open("rb") as stream:
                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
                    digest.update(chunk)
            entry.update(type="file", size=info.st_size, sha256=digest.hexdigest())
        elif stat.S_ISDIR(info.st_mode):
            entry["type"] = "directory"
        elif stat.S_ISLNK(info.st_mode):
            entry.update(type="symlink", target=os.readlink(path))
        entries.append(entry)

print(json.dumps({"schema_version": 1, "entries": entries}, sort_keys=True, separators=(",", ":")))
PY

# ------------------------------------------------------------
# Write the backup as a gzipped tar stream on stdout
# ------------------------------------------------------------

# A copied tree can contain hard-linked regular files. The manifest describes
# file contents, not tar's space-saving link representation, so emit every one
# as a regular member and keep validation/restoration semantics identical.
tar --hard-dereference --numeric-owner -C "$TMPDIR" -czf - rootfs meta
