#!/bin/bash
#
# Turn the node's structured traffic log on or off. Run this ON A NODE, as root,
# after 04-node-prepare has created the reader account, the read group and
# /var/log/haprion.
#
#     sudo haprion-traffic-log-enable                # install and activate
#     sudo haprion-traffic-log-enable --disable      # remove and deactivate
#          haprion-traffic-log-enable --print        # show the rsyslog rule only
#          haprion-traffic-log-enable --print-units  # show the retention units
#
# 04-node-prepare runs this when the node has the collector's key; run it by
# hand only to turn the route off (--disable) or on again.
#
set -Eeuo pipefail

LOG_ROOT="/var/log/haprion"
LOG_GROUP="_haprion-logs"
# Ubuntu's 49-haproxy.conf matches every tag starting with "haproxy" and stops.
# A rule installed after it never sees a message - which is exactly how the
# first build failed - so this file has to sort before it.
RSYSLOG_RULE="/etc/rsyslog.d/48-haprion-traffic.conf"
APPARMOR_SNIPPET="/etc/apparmor.d/rsyslog.d/haprion-traffic"
PRUNE_SERVICE="/etc/systemd/system/haprion-traffic-log-prune.service"
PRUNE_TIMER="/etc/systemd/system/haprion-traffic-log-prune.timer"
PRUNE_COMMAND="/usr/sbin/haprion-traffic-log-prune"

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
die()  { echo "ERROR: $*" >&2; exit 1; }

#
# The account rsyslog writes files as, which must own the traffic log's
# directory. Ubuntu drops to `syslog` ($PrivDropToUser in rsyslog.conf);
# Debian 13 has no such line and no such account and writes as root
# (measured 2026-09-24). Read from rsyslog's own configuration, the main file
# first and its drop-ins after, the last setting winning - the same function
# in 04-node-prepare and haprion-traffic-log-enable, held together by a test.
#
rsyslog_writer() {
    local config="${RSYSLOG_CONFIG:-/etc/rsyslog.conf}" dropins="${RSYSLOG_DROPINS:-/etc/rsyslog.d}"
    local sources=() found
    [[ -f "$config" ]] && sources+=("$config")
    for found in "$dropins"/*.conf; do
        [[ -f "$found" ]] && sources+=("$found")
    done
    found=""
    if ((${#sources[@]})); then
        # shellcheck disable=SC2016  # the literal dollar sign is the directive being matched
        found="$(sed -nE \
            -e '/^[[:space:]]*#/d' \
            -e 's/^[[:space:]]*\$PrivDropToUser[[:space:]]+([^[:space:]#]+).*/\1/Ip' \
            -e 's/.*privdrop\.user\.name[[:space:]]*=[[:space:]]*"([^"]+)".*/\1/Ip' \
            "${sources[@]}" | tail -n 1)"
    fi
    echo "${found:-root}"
}

#
# What one hour's file may hold, from the retention pass that keeps the rest of
# the budget: one formula, in the script beside this one (B356).
#
hour_cap() {
    "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/haprion-traffic-log-prune" --hour-cap
}

render_rule() {
    local cap
    cap="$(hour_cap)" || die "cannot measure the traffic log's filesystem"
    [[ "$cap" =~ ^[1-9][0-9]*$ ]] || die "the hour limit is not a number: ${cap}"
    sed "s/@HOUR_CAP@/${cap}/" <<'CONF'
# Installed by haprion-traffic-log-enable. Do not edit by hand.
#
# HAProxy tags this second, opt-in stream "haproxy-traffic"; the ordinary
# httplog stream keeps the tag "haproxy" and is not matched here, so classic
# logging to /var/log/haproxy.log is untouched.
#
# This file must sort before Ubuntu's 49-haproxy.conf, which matches every tag
# starting with "haproxy" and stops. It must also stop the message itself -
# without that, every JSON record would additionally be appended to the classic
# log, doubling the volume of the file an operator reads by hand.
#
# The file is named from the current UTC date and hour, not from the message
# timestamp. The collector treats a finished day as immutable, and only a
# monotonic clock source guarantees that a closed file is never appended to
# after the rollover. An hour is a file of its own so that the size limit
# below stops one hour rather than the rest of the day.

template(name="haprion-traffic-file" type="string"
         string="/var/log/haprion/traffic-%$now-utc%T%$hour-utc%.jsonl")
# Only the message, from its second character. HAProxy already emits one
# complete JSON object per record, and a syslog header in front of it would
# make the file something other than the JSONL the reader and the interface
# parse.
#
# The offset is not arbitrary and `ltrim` is not the answer: this rsyslog
# accepts `ltrim` in a template and then reports `invalid field option` at
# startup while `rsyslogd -N1` still passes, so the option would be silently
# dropped. RFC3164 puts one space between the tag and the payload, and the
# message property keeps it - measured through a real rsyslog on a real Unix
# socket, where `%msg%` produced " {" and this form produced "{".
template(name="haprion-traffic-line" type="string"
         string="%msg:2:$:drop-last-lf%\n")

# Only a JSON record reaches the day file. HAProxy sends more than transaction
# logs to a frontend's log target: a connection that dies before a request -
# an SSL handshake failure, a malformed request - is logged in plain text, and
# "Proxy ... stopped" arrives once per frontend at every reload and is governed
# by no log-profile step at all. Measured on a node: both landed in the JSONL
# file as text and were counted as malformed by the reader. Every such line is
# also written to the classic log through the global target under the tag
# "haproxy", so on this tag it is a duplicate, and dropping it loses nothing.
# The leading space is the RFC3164 separator the template above skips.
#
# Each hour's file stops at a size: a twenty-fourth of the share of this
# filesystem the traffic log may hold, so a day cannot take more than that
# however much arrives. Measured against rsyslog 8.2512: the limit holds on a
# dynamic file name, stops only the file that reached it, survives a restart
# and lets at most one batch past. There is no rotation command, on purpose:
# rsyslog then refuses the write and says so in its own log. The rest of that
# hour is dropped; the hours already written stay.
if ($programname == "haproxy-traffic") then {
    if ($msg startswith " {") then {
        action(type="omfile"
               dynaFile="haprion-traffic-file"
               template="haprion-traffic-line"
               fileCreateMode="0640"
               dirCreateMode="0750"
               createDirs="off"
               rotation.sizeLimit="@HOUR_CAP@")
    }
    stop
}
CONF
}

render_apparmor() {
    cat <<'CONF'
# Installed by haprion-traffic-log-enable.
#
# Ubuntu's shipped rsyslogd profile already allows /var/log/** rw, so this
# grants nothing new today. It is written anyway: the traffic log's dependency
# on that permission is otherwise invisible, and a site that narrows the broad
# wildcard would break the log with no rule naming what it needed.
/var/log/haprion/ r,
/var/log/haprion/traffic-*.jsonl rw,
CONF
}

render_prune_service() {
    cat <<CONF
[Unit]
Description=Delete Haprion traffic log files past their retention window

[Service]
Type=oneshot
ExecStart=${PRUNE_COMMAND}
# Deleting whole day files is all this needs to reach, and everything else on
# the node is made unreachable rather than merely unused.
ProtectSystem=strict
ReadWritePaths=${LOG_ROOT}
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CONF
}

render_prune_timer() {
    cat <<'CONF'
[Unit]
Description=Hourly retention pass over the Haprion traffic log

[Timer]
# Hourly, not daily: the window is whole days, but the space budget (B307) is
# not, and a flood of traffic fills a disk within the day.
OnCalendar=hourly
# A fleet that deletes at the same second is a fleet that does its disk work
# together.
RandomizedDelaySec=10m
# A node that was off over the boundary still prunes on its next boot rather
# than skipping the day silently.
Persistent=true

[Install]
WantedBy=timers.target
CONF
}

if [[ "${1:-}" == "--print" ]]; then
    render_rule
    exit 0
fi
if [[ "${1:-}" == "--print-units" ]]; then
    render_prune_service
    echo "--- timer ---"
    render_prune_timer
    exit 0
fi

[[ $EUID -eq 0 ]] || die "run this with sudo"
command -v rsyslogd >/dev/null || die "rsyslog is not installed on this node"

#
# Validate through the real parser before anything is activated, and put back
# whatever was there when it does not pass. rsyslogd is confined by AppArmor to
# /etc/rsyslog.conf and /etc/rsyslog.d/**, so the file genuinely has to be in
# place to be checked - which is why the restore path exists rather than a
# check in a temporary directory that would prove nothing about this location.
#
restore=""
restore_rule() {
    if [[ -n "$restore" ]]; then
        mv -f "$restore" "$RSYSLOG_RULE"
    else
        rm -f "$RSYSLOG_RULE"
    fi
}

stage_rule() {
    if [[ -f "$RSYSLOG_RULE" ]]; then
        restore="${RSYSLOG_RULE}.previous-$$"
        cp -a "$RSYSLOG_RULE" "$restore"
    fi
}

validate_or_restore() {
    if rsyslogd -N1 >/dev/null 2>&1; then
        return 0
    fi
    restore_rule
    rsyslogd -N1 || die "rsyslog configuration was already broken before this ran"
    die "the generated rule did not pass rsyslogd -N1; the previous state is back"
}

#
# What a restart of rsyslog cost HAProxy's log lines. Where step 4 has systemd
# hold HAProxy's log socket, the lines waited in it; only a node without that
# socket loses the ones sent during the restart (review 2026-10-24: the message
# said they were lost everywhere).
#
restart_note() {
    if systemctl is-active --quiet haprion-haproxy-log.socket 2>/dev/null; then
        log "  rsyslog was restarted; HAProxy's log lines waited in the socket systemd holds"
    else
        log "  rsyslog was restarted; HAProxy cannot buffer log lines during that brief window"
    fi
}

restart_or_restore() {
    if systemctl restart rsyslog; then
        return 0
    fi
    restore_rule
    systemctl restart rsyslog || die "rsyslog will not start even after the rollback"
    die "rsyslog refused to restart with the new rule; the previous state is back"
}

if [[ "${1:-}" == "--disable" ]]; then
    systemctl disable --now haprion-traffic-log-prune.timer >/dev/null 2>&1 || true
    rm -f "$PRUNE_TIMER" "$PRUNE_SERVICE"
    systemctl daemon-reload
    stage_rule
    rm -f "$RSYSLOG_RULE" "$APPARMOR_SNIPPET"
    [[ ! -x /usr/lib/rsyslog/reload-apparmor-profile ]] \
        || /usr/lib/rsyslog/reload-apparmor-profile
    validate_or_restore
    restart_or_restore
    rm -f "$restore"
    log "traffic logging disabled; ${LOG_ROOT} is left in place and no longer pruned"
    restart_note
    exit 0
fi

[[ -z "${1:-}" ]] || die "usage: $(basename "$0") [--disable|--print|--print-units]"

getent group "$LOG_GROUP" >/dev/null \
    || die "group ${LOG_GROUP} is missing; run 04-node-prepare on this node first"
[[ -d "$LOG_ROOT" ]] \
    || die "${LOG_ROOT} is missing; run 04-node-prepare on this node first"

#
# The set-group-id bit is what makes the file readable by the collector at all.
# rsyslog drops to syslog:syslog before it opens anything, so it cannot chown a
# file into a group it is not a member of; inheriting the directory's group is
# the only way that does not require widening the syslog account.
#
owner="$(stat -c '%U:%G %a' "$LOG_ROOT")"
writer="$(rsyslog_writer)"
[[ "$owner" == "${writer}:${LOG_GROUP} 2750" ]] \
    || die "${LOG_ROOT} is ${owner}, expected ${writer}:${LOG_GROUP} 2750; rerun 04-node-prepare"

[[ -x "$PRUNE_COMMAND" ]] \
    || die "${PRUNE_COMMAND} is missing; run 04-node-prepare on this node first"

install -o root -g root -m 755 -d "$(dirname "$APPARMOR_SNIPPET")"
render_apparmor > "${APPARMOR_SNIPPET}.new-$$"
install -o root -g root -m 644 "${APPARMOR_SNIPPET}.new-$$" "$APPARMOR_SNIPPET"
rm -f "${APPARMOR_SNIPPET}.new-$$"
[[ ! -x /usr/lib/rsyslog/reload-apparmor-profile ]] \
    || /usr/lib/rsyslog/reload-apparmor-profile
log "  installed ${APPARMOR_SNIPPET}"

render_prune_service > "${PRUNE_SERVICE}.new-$$"
install -o root -g root -m 644 "${PRUNE_SERVICE}.new-$$" "$PRUNE_SERVICE"
render_prune_timer > "${PRUNE_TIMER}.new-$$"
install -o root -g root -m 644 "${PRUNE_TIMER}.new-$$" "$PRUNE_TIMER"
rm -f "${PRUNE_SERVICE}.new-$$" "${PRUNE_TIMER}.new-$$"
systemctl daemon-reload
systemctl enable --now haprion-traffic-log-prune.timer
log "  installed ${PRUNE_TIMER}"

stage_rule
render_rule > "${RSYSLOG_RULE}.new-$$"
install -o root -g root -m 644 "${RSYSLOG_RULE}.new-$$" "$RSYSLOG_RULE"
rm -f "${RSYSLOG_RULE}.new-$$"
validate_or_restore
restart_or_restore
rm -f "$restore"
log "  installed ${RSYSLOG_RULE}"
log "traffic logging active; records appear in ${LOG_ROOT} once a published"
log "  configuration enables the second log stream for this cluster"
log "  day files are deleted whole after 14 days, never renamed"
restart_note
