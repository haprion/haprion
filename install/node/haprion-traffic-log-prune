#!/usr/bin/python3
"""Delete traffic days older than the retention window, or over their space budget.

Deleting whole files, never renaming one. logrotate would move the file the
collector is reading between two names, and there is no instant at which both
the old and the new name are visible - so a rotation could land exactly where a
fetch is, and the run would silently see an empty file rather than an error.
A finished file is immutable here, and disappears whole.

The window is days, and a flood of requests fills a disk well within it
(security review S05, B307). So the oldest finished days also go, whole, while
the traffic files hold more than SPACE_SHARE of their filesystem or less than
FREE_SHARE of it is free - and each such removal is a warning in the system
log, which the node forwards. Today is never touched: rsyslog is writing it and
the collector reading it. It is bounded where it is written instead (B356):
rsyslog writes each hour to a file of its own and stops that file at
`hour_cap()`, a twenty-fourth of the share, so a day cannot hold more than the
share whatever arrives. `--hour-cap` prints that limit for the rule
haprion-traffic-log-enable writes.
"""

from __future__ import annotations

import os
import re
import stat
import sys
import syslog
from datetime import UTC, date, datetime, timedelta
from pathlib import Path

LOG_ROOT = Path("/var/log/haprion")
# The same window the node reader enforces. A file the reader would refuse to
# serve has no reason to occupy disk, and a file inside the window must never
# be removed while the collector may still ask for it.
RETENTION_DAYS = 14
#
# What the day files may hold: at most this share of their filesystem, and
# never so much that less than FREE_SHARE of it is free.
#
SPACE_SHARE = 0.25
FREE_SHARE = 0.10
HOURS = 24
MIN_HOUR_CAP = 1024 * 1024
#
# A day's files: a whole-day file, as nodes wrote before the hours had files of
# their own, and an hour each. The name sorts in the order they were written.
#
DAY_FILE = re.compile(r"^traffic-([0-9]{4}-[0-9]{2}-[0-9]{2})(?:T([01][0-9]|2[0-3]))?\.jsonl$")


def expired(name: str, today: date) -> bool:
    """True only for a name this tool wrote and a date outside the window."""

    match = DAY_FILE.fullmatch(name)
    if match is None:
        return False
    try:
        day = date.fromisoformat(match.group(1))
    except ValueError:
        return False
    return day < today - timedelta(days=RETENTION_DAYS - 1)


def prune(root: Path, *, today: date | None = None) -> list[str]:
    """Remove expired day files and return what was removed, sorted."""

    when = today or datetime.now(UTC).date()
    removed: list[str] = []
    try:
        #
        # The last hour of a day first: the reader then sees a day that is
        # going as its beginning, or as gone (haprion-traffic-log-read).
        #
        names = sorted(os.listdir(root), reverse=True)
    except FileNotFoundError:
        return removed

    for name in names:
        if not expired(name, when):
            continue
        path = root / name
        #
        # A symlink named like a day file would otherwise delete whatever it
        # points at. Nothing in this chain creates one, which is exactly why an
        # unexpected one must not be followed.
        #
        try:
            if not stat.S_ISREG(os.lstat(path).st_mode):
                continue
            os.unlink(path)
        except OSError:
            continue
        removed.append(name)
    return sorted(removed)


def _capacity(root: Path) -> int:
    """The size of the filesystem the traffic files are written to.

    The directory's own, or the one it will be made on when it is not there
    yet: haprion-traffic-log-enable renders its rule before 04-node-prepare
    has necessarily created it.
    """

    path = root
    while not path.exists() and path != path.parent:
        path = path.parent
    space = os.statvfs(path)
    return space.f_blocks * space.f_frsize


def hour_cap(root: Path) -> int:
    """What one hour's file may hold: a twenty-fourth of the space share.

    Never below MIN_HOUR_CAP: rsyslog reads a limit of 0 as none at all.
    """

    return max(MIN_HOUR_CAP, int(_capacity(root) * SPACE_SHARE) // HOURS)


def over_budget(root: Path, *, today: date | None = None) -> list[str]:
    """Remove the oldest finished days, whole, while the budget is exceeded."""

    when = today or datetime.now(UTC).date()
    removed: list[str] = []
    try:
        names = sorted(os.listdir(root))
        space = os.statvfs(root)
    except (FileNotFoundError, OSError):
        return removed
    capacity = space.f_blocks * space.f_frsize
    free = space.f_bavail * space.f_frsize
    days: dict[str, list[tuple[str, int]]] = {}
    held = 0
    for name in names:
        match = DAY_FILE.fullmatch(name)
        if match is None:
            continue
        try:
            metadata = os.lstat(root / name)
        except OSError:
            continue
        if not stat.S_ISREG(metadata.st_mode):
            continue
        held += metadata.st_size
        if match.group(1) != when.isoformat():
            days.setdefault(match.group(1), []).append((name, metadata.st_size))
    for day in sorted(days):
        if held <= capacity * SPACE_SHARE and free >= capacity * FREE_SHARE:
            break
        for name, size in reversed(days[day]):
            try:
                os.unlink(root / name)
            except OSError:
                continue
            held -= size
            free += size
            removed.append(name)
    return sorted(removed)


def capped(root: Path, *, now: datetime | None = None) -> str | None:
    """The hour just ended, when its file reached the cap and lost what came after.

    The pass runs once an hour, so each hour is looked at once. rsyslog says it
    too, in its own words, the moment it happens.
    """

    hour = (now or datetime.now(UTC)) - timedelta(hours=1)
    name = f"traffic-{hour:%Y-%m-%dT%H}.jsonl"
    try:
        metadata = os.lstat(root / name)
        cap = hour_cap(root)
    except OSError:
        return None
    if not stat.S_ISREG(metadata.st_mode) or metadata.st_size < cap:
        return None
    return name


def _warn(message: str) -> None:
    print(message)
    syslog.syslog(syslog.LOG_WARNING, f"haprion-traffic-log-prune: {message}")


def main(arguments: list[str]) -> int:
    if arguments == ["--hour-cap"]:
        print(hour_cap(LOG_ROOT))
        return 0
    if arguments:
        print("usage: haprion-traffic-log-prune [--hour-cap]", file=sys.stderr)
        return 64
    for name in prune(LOG_ROOT):
        print(f"removed {name}")
    for name in over_budget(LOG_ROOT):
        _warn(f"removed {name} before its time: the traffic log is over its space budget")
    full = capped(LOG_ROOT)
    if full is not None:
        _warn(f"{full} reached its size limit: the rest of that hour's records were not kept")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
