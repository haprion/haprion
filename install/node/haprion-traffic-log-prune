#!/usr/bin/python3
"""Delete traffic day files older than the retention window, or over its space budget.

Deleting whole day files, never renaming one. logrotate would move the file the
collector is reading between two names, and there is no instant at which both
the old and the new name are visible - so a rotation could land exactly where a
fetch is, and the run would silently see an empty file rather than an error.
A finished day file is immutable here, and disappears whole.

The window is days, and a flood of requests fills a disk well within it
(security review S05, B307). So the oldest finished days also go, whole, while
the day files hold more than SPACE_SHARE of their filesystem or less than
FREE_SHARE of it is free - and each such removal is a warning in the system
log, which the node forwards. Today's file is never touched: rsyslog is writing
it and the collector reading it.
"""

from __future__ import annotations

import os
import re
import stat
import syslog
from datetime import UTC, date, datetime, timedelta
from pathlib import Path

LOG_ROOT = Path("/var/log/haprion")
# The same window the node reader enforces. A file the reader would refuse to
# serve has no reason to occupy disk, and a file inside the window must never
# be removed while the collector may still ask for it.
RETENTION_DAYS = 14
#
# What the day files may hold: at most this share of their filesystem, and
# never so much that less than FREE_SHARE of it is free.
#
SPACE_SHARE = 0.25
FREE_SHARE = 0.10
DAY_FILE = re.compile(r"^traffic-([0-9]{4}-[0-9]{2}-[0-9]{2})\.jsonl$")


def expired(name: str, today: date) -> bool:
    """True only for a name this tool wrote and a date outside the window."""

    match = DAY_FILE.fullmatch(name)
    if match is None:
        return False
    try:
        day = date.fromisoformat(match.group(1))
    except ValueError:
        return False
    return day < today - timedelta(days=RETENTION_DAYS - 1)


def prune(root: Path, *, today: date | None = None) -> list[str]:
    """Remove expired day files and return what was removed, sorted."""

    when = today or datetime.now(UTC).date()
    removed: list[str] = []
    try:
        names = sorted(os.listdir(root))
    except FileNotFoundError:
        return removed

    for name in names:
        if not expired(name, when):
            continue
        path = root / name
        #
        # A symlink named like a day file would otherwise delete whatever it
        # points at. Nothing in this chain creates one, which is exactly why an
        # unexpected one must not be followed.
        #
        try:
            if not stat.S_ISREG(os.lstat(path).st_mode):
                continue
            os.unlink(path)
        except OSError:
            continue
        removed.append(name)
    return removed


def over_budget(root: Path, *, today: date | None = None) -> list[str]:
    """Remove the oldest finished day files while the budget is exceeded."""

    when = today or datetime.now(UTC).date()
    removed: list[str] = []
    try:
        names = sorted(os.listdir(root))
        space = os.statvfs(root)
    except (FileNotFoundError, OSError):
        return removed
    capacity = space.f_blocks * space.f_frsize
    free = space.f_bavail * space.f_frsize
    days: list[tuple[str, int]] = []
    held = 0
    for name in names:
        match = DAY_FILE.fullmatch(name)
        if match is None:
            continue
        try:
            metadata = os.lstat(root / name)
        except OSError:
            continue
        if not stat.S_ISREG(metadata.st_mode):
            continue
        held += metadata.st_size
        if match.group(1) != when.isoformat():
            days.append((name, metadata.st_size))
    for name, size in days:
        if held <= capacity * SPACE_SHARE and free >= capacity * FREE_SHARE:
            break
        try:
            os.unlink(root / name)
        except OSError:
            continue
        held -= size
        free += size
        removed.append(name)
    return removed


def main() -> int:
    for name in prune(LOG_ROOT):
        print(f"removed {name}")
    for name in over_budget(LOG_ROOT):
        message = f"removed {name} before its time: the traffic log is over its space budget"
        print(message)
        syslog.syslog(syslog.LOG_WARNING, f"haprion-traffic-log-prune: {message}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
