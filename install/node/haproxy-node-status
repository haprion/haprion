#!/usr/bin/env python3

import argparse
import base64
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
from pathlib import Path

KEEPALIVED_CONFIG = Path("/etc/keepalived/keepalived.conf")
KEEPALIVED_STATE = Path("/run/haproxy/keepalived.state")
RUNTIME_SOCKET = "/run/haproxy/ui-status.sock"
CURRENT_RELEASE = Path("/etc/haproxy/current/RELEASE")
VALIDATION_STATE = Path("/run/haproxy/last-validation.json")
CERTS_DIR = Path("/etc/haproxy/certs")

#
# Assembled rather than written out. A literal PEM header in a file that is
# reviewed alongside the manager repository is exactly what its secret scanner
# exists to catch, and the same construction is used there.
#
PEM = "-" * 5
CERTIFICATE_BLOCK = re.compile(
    PEM + "BEGIN CERTIFICATE" + PEM + "(.+?)" + PEM + "END CERTIFICATE" + PEM,
    re.DOTALL,
)

# A certificate file is small. The cap keeps a wrong path from being read into
# memory by a process running as root.
MAX_CERTIFICATE_BYTES = 1024 * 1024


def run(*argv):
    return subprocess.run(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def service_active(name):
    r = run("/usr/bin/systemctl", "is-active", name)
    return r.returncode == 0 and r.stdout.strip() == "active"


def parse_keepalived():
    try:
        text = KEEPALIVED_CONFIG.read_text(encoding="utf-8")
    except Exception:
        return None, None

    interface_match = re.search(
        r"^\s*interface\s+(\S+)\s*$",
        text,
        re.MULTILINE,
    )

    vip_block = re.search(
        r"virtual_ipaddress\s*\{(.*?)\}",
        text,
        re.DOTALL,
    )

    interface = interface_match.group(1) if interface_match else None
    vip = None

    if vip_block:
        for line in vip_block.group(1).splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue

            match = re.match(
                r"([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)(?:/\d+)?",
                line,
            )
            if match:
                vip = match.group(1)
                break

    return interface, vip


def owns_vip(interface, vip):
    if not interface or not vip:
        return None

    r = run(
        "/usr/sbin/ip",
        "-j",
        "-4",
        "addr",
        "show",
        "dev",
        interface,
    )

    if r.returncode != 0:
        return None

    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None

    for iface in data:
        for addr in iface.get("addr_info", []):
            if addr.get("family") == "inet" and addr.get("local") == vip:
                return True

    return False


def runtime_info():
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(RUNTIME_SOCKET)
        sock.sendall(b"show info\n")

        chunks = []
        while True:
            data = sock.recv(65536)
            if not data:
                break
            chunks.append(data)

        sock.close()

        text = b"".join(chunks).decode("utf-8", errors="replace")

        info = {}
        for line in text.splitlines():
            if ":" not in line:
                continue
            key, value = line.split(":", 1)
            info[key.strip()] = value.strip()

        return True, {
            "version": info.get("Version"),
            "uptime_sec": (
                int(info["Uptime_sec"])
                if info.get("Uptime_sec", "").isdigit()
                else None
            ),
        }

    except Exception:
        return False, {
            "version": None,
            "uptime_sec": None,
        }


def read_release():
    result = {
        "version": None,
        "hash": None,
        "timestamp": None,
        "cluster": None,
    }

    if not CURRENT_RELEASE.is_file():
        return result

    try:
        for line in CURRENT_RELEASE.read_text(encoding="utf-8").splitlines():
            if "=" not in line:
                continue

            key, value = line.split("=", 1)
            key = key.strip().lower()
            value = value.strip()

            if key in result:
                result[key] = value

    except Exception:
        pass

    return result


def leaf_fingerprint(text):
    """SHA-256 of the first certificate in the file, lowercase hex.

    The definition is identical to the manager's on purpose - the two values are
    compared against each other, so a difference in what is hashed would make
    every comparison meaningless.

    The leaf's DER bytes, not the file: a published PEM is the private key
    concatenated with the full chain, so hashing the file would change the
    answer whenever the key encoding or the bundled intermediates changed,
    without the certificate this node serves changing at all. The private key is
    never hashed and never leaves this function.

    First block rather than last, because a chain is written leaf-first. Taking
    the last would fingerprint the CA and make every node look identical.
    """

    match = CERTIFICATE_BLOCK.search(text)
    if match is None:
        return None

    try:
        der = base64.b64decode("".join(match.group(1).split()), validate=True)
    except Exception:
        return None

    if not der:
        return None

    return hashlib.sha256(der).hexdigest()


def certificate_valid(path):
    """Is it in its validity window right now? Measured, not assumed."""

    return run("/usr/bin/openssl", "x509", "-in", str(path), "-noout", "-checkend", "0").returncode == 0


def read_certificates():
    """What this node is carrying, by identity only.

    Deliberately not enriched with subject, SANs or provenance. Whether a
    certificate is ACME-renewed or static is knowable where certbot lives, not
    on a node that only sees a file, so this reports what it can measure and
    cert-list reports the rest. That is the `carried_certificate` contract.

    A file that cannot be read or does not parse is left out rather than
    reported as present with an unknown fingerprint: a certificate nobody could
    identify must not be able to satisfy a comparison.
    """

    entries = []

    try:
        paths = sorted(CERTS_DIR.glob("*.pem"))
    except Exception:
        return entries

    for path in paths:
        try:
            if not path.is_file():
                continue
            if path.stat().st_size > MAX_CERTIFICATE_BYTES:
                continue
            fingerprint = leaf_fingerprint(path.read_text(encoding="ascii", errors="strict"))
        except Exception:
            continue

        if fingerprint is None:
            continue

        entries.append(
            {
                "id": path.name[: -len(".pem")],
                "fingerprint_sha256": fingerprint,
                "valid": certificate_valid(path),
            }
        )

    return entries


def read_validation():
    if not VALIDATION_STATE.is_file():
        return {
            "valid": None,
            "validated_at": None,
        }

    try:
        data = json.loads(VALIDATION_STATE.read_text(encoding="utf-8"))
        return {
            "valid": data.get("valid"),
            "validated_at": data.get("validated_at"),
        }
    except Exception:
        return {
            "valid": None,
            "validated_at": None,
        }


parser = argparse.ArgumentParser()
parser.add_argument("-c", "--cluster", required=True)
parser.add_argument("--json", action="store_true")
args = parser.parse_args()

if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,31}", args.cluster):
    print("ERROR: invalid cluster ID", file=sys.stderr)
    sys.exit(64)

interface, vip = parse_keepalived()
vip_owner = owns_vip(interface, vip)

haproxy_active = service_active("haproxy")
keepalived_active = service_active("keepalived")

try:
    keepalived_state = KEEPALIVED_STATE.read_text(
        encoding="utf-8"
    ).strip()
except Exception:
    keepalived_state = None

try:
    ip_nonlocal_bind = (
        Path("/proc/sys/net/ipv4/ip_nonlocal_bind")
        .read_text()
        .strip()
        == "1"
    )
except Exception:
    ip_nonlocal_bind = None

stats_ok, runtime = runtime_info()
release = read_release()
validation = read_validation()
certificates = read_certificates()

result = {
    "schema_version": 1,
    "node": socket.gethostname(),
    "cluster": args.cluster,
    "haproxy": {
        "active": haproxy_active,
    },
    "keepalived": {
        "active": keepalived_active,
        "state": keepalived_state,
    },
    "vip": {
        "address": vip,
        "interface": interface,
        "owner": vip_owner,
    },
    "ip_nonlocal_bind": ip_nonlocal_bind,
    "release": release,
    "config_validation": validation,
    "stats_ok": stats_ok,
    "runtime": runtime,
    "certificates": certificates,
}

if args.json:
    print(json.dumps(result, separators=(",", ":"), sort_keys=True))
else:
    print(f"Node:              {result['node']}")
    print(f"Cluster:           {result['cluster']}")
    print(f"HAProxy:           {'ACTIVE' if haproxy_active else 'INACTIVE'}")
    print(f"Keepalived:        {'ACTIVE' if keepalived_active else 'INACTIVE'}")
    print(f"Keepalived state:  {keepalived_state or 'UNKNOWN'}")
    print(f"VIP:               {vip or 'UNKNOWN'}")
    print(f"VIP owner:         {vip_owner}")
    print(f"ip_nonlocal_bind:  {ip_nonlocal_bind}")
    print(f"Runtime stats:     {'OK' if stats_ok else 'FAILED'}")

sys.exit(0)
