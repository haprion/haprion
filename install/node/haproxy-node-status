#!/usr/bin/env python3

import argparse
import base64
import hashlib
import json
import os
import re
import socket
import subprocess
import sys
from pathlib import Path

KEEPALIVED_CONFIG = Path("/etc/keepalived/keepalived.conf")
KEEPALIVED_STATE = Path("/run/haproxy/keepalived.state")
KEEPALIVED_ADDRESSES = Path("/etc/keepalived/addresses.conf")
PUBLISHED_ADDRESSES = Path("/etc/haproxy/current/keepalived/addresses.conf")
RUNTIME_SOCKET = "/run/haproxy/ui-status.sock"
CURRENT_RELEASE = Path("/etc/haproxy/current/RELEASE")
VALIDATION_STATE = Path("/run/haproxy/last-validation.json")
CERTS_DIR = Path("/etc/haproxy/certs")
CERT_PENDING = Path("/run/haproxy-cert-pull.pending")
NODE_INSTALLATION = Path("/etc/haproxy-manager/node-installation.json")
SBIN = Path("/usr/local/sbin")
MAX_INSTALLATION_BYTES = 64 * 1024
SHA256 = re.compile(r"^[0-9a-f]{64}$")
NODE_SCRIPTS = (
    "haproxy-pull-deploy",
    "haproxy-cert-pull",
    "haproxy-cert-remove",
    "haproxy-cert-trigger",
    "haproxy-node-status",
    "haproxy-health-probe",
    "haproxy-keepalived-state",
    "haproxy-state-export",
    "haproxy-traffic-log-read",
    "haproxy-traffic-log-enable",
    "haproxy-traffic-log-prune",
)

#
# Assembled rather than written out. A literal PEM header in a file that is
# reviewed alongside the manager repository is exactly what its secret scanner
# exists to catch, and the same construction is used there.
#
PEM = "-" * 5
CERTIFICATE_BLOCK = re.compile(
    PEM + "BEGIN CERTIFICATE" + PEM + "(.+?)" + PEM + "END CERTIFICATE" + PEM,
    re.DOTALL,
)

# A certificate file is small. The cap keeps a wrong path from being read into
# memory by a process running as root.
MAX_CERTIFICATE_BYTES = 1024 * 1024


def read_installation():
    """The installed node bundle's declared API and whether its bytes still match.

    The metadata is written by 04-node-prepare from the same source files it
    installs. The status command recomputes every digest: a copied marker beside
    hand-edited scripts is therefore not accepted as a current installation.
    """

    def installed_scripts(expected_scripts=None):
        scripts = {}
        all_current = expected_scripts is not None
        for name in NODE_SCRIPTS:
            try:
                installed = hashlib.sha256((SBIN / name).read_bytes()).hexdigest()
            except Exception:
                installed = None
            expected = expected_scripts.get(name) if expected_scripts is not None else None
            current = expected is not None and installed == expected
            all_current = all_current and current
            scripts[name] = {
                "expected_sha256": expected,
                "installed_sha256": installed,
                "current": current,
            }
        return all_current, scripts

    try:
        if NODE_INSTALLATION.stat().st_size > MAX_INSTALLATION_BYTES:
            raise ValueError("installation metadata is too large")
        document = json.loads(NODE_INSTALLATION.read_text(encoding="utf-8"))
        if (
            not isinstance(document, dict)
            or document.get("schema_version") != 1
            or type(document.get("node_api")) is not int
            or document["node_api"] < 1
            or not isinstance(document.get("scripts"), dict)
            or set(document["scripts"]) != set(NODE_SCRIPTS)
        ):
            raise ValueError("invalid installation metadata")

        for name, expected in document["scripts"].items():
            if (
                not isinstance(name, str)
                or not re.fullmatch(r"haproxy-[a-z0-9-]+", name)
                or not isinstance(expected, str)
                or not SHA256.fullmatch(expected)
            ):
                raise ValueError("invalid script metadata")
        all_current, scripts = installed_scripts(document["scripts"])
        return {
            "node_api": document["node_api"],
            "scripts_current": all_current,
            "scripts": scripts,
        }
    except Exception:
        _, scripts = installed_scripts()
        return {"node_api": None, "scripts_current": False, "scripts": scripts}


def run(*argv):
    return subprocess.run(
        argv,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def service_active(name):
    r = run("/usr/bin/systemctl", "is-active", name)
    return r.returncode == 0 and r.stdout.strip() == "active"


#
# The WAF engine is a package of its own, installed by a person (B229), and the
# manager offers the engine on an object only when every node of its cluster
# has it (B231). The package's version says which engine; `active` says whether
# a release with rules has started it - off is the normal state without one.
#
WAF_PACKAGE = "haproxy-manager-coraza-spoa"
WAF_UNIT = "coraza-spoa.service"


def read_waf_engine():
    r = run("/usr/bin/dpkg-query", "-W", "-f=${Status}\t${Version}", WAF_PACKAGE)
    status, _, version = r.stdout.partition("\t")
    installed = r.returncode == 0 and status.strip() == "install ok installed"
    return {
        "version": version.strip() if installed else None,
        "active": service_active(WAF_UNIT),
    }


#
# What the dashboard shows as a node's CPU and memory (B239). Counters, not a
# percentage: CPU use is a rate, and a rate needs two readings. The poller
# keeps the previous one and works out the share between them, so nothing here
# waits to measure. Memory is what the kernel says a new process could have
# without swapping - `available` in `free`, not `free`, which leaves out the
# cache the kernel gives back on demand. Each part is `null` when it cannot be
# read, so an unreadable figure is never shown as zero.
#
def read_resources():
    cpu = None
    try:
        fields = Path("/proc/stat").read_text().splitlines()[0].split()
        if fields[0] == "cpu":
            # user nice system idle iowait irq softirq steal; guest time is
            # already counted in user and nice.
            ticks = [int(value) for value in fields[1:9]]
            cpu = {"total": sum(ticks), "idle": ticks[3] + ticks[4]}
    except (OSError, ValueError, IndexError):
        cpu = None
    memory = None
    try:
        values = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            name, _, rest = line.partition(":")
            if name in ("MemTotal", "MemAvailable"):
                values[name] = int(rest.split()[0])
        if len(values) == 2:
            memory = {"total_kb": values["MemTotal"], "available_kb": values["MemAvailable"]}
    except (OSError, ValueError, IndexError):
        memory = None
    try:
        load = float(Path("/proc/loadavg").read_text().split()[0])
    except (OSError, ValueError, IndexError):
        load = None
    return {"cpu": cpu, "memory": memory, "load": load, "cpus": os.cpu_count()}


def memory_summary(memory):
    if not memory or not memory["total_kb"]:
        return "unknown"
    total = memory["total_kb"]
    used = total - memory["available_kb"]
    return f"{round(100 * used / total)} % used ({used // 1024} of {total // 1024} MB)"


#
# A directive and its argument, with the trailing comment keepalived allows.
# The comment is why these are not `\s*$`: the configuration this project ships
# writes `interface eth0  # CHANGE`, and a pattern that insists on the end of
# the line reads that as no interface at all - which reports no VIP owner and
# blocks every deploy, without saying why.
#
INTERFACE = re.compile(r"^\s*interface\s+(\S+)\s*(?:#.*)?$", re.MULTILINE)
INCLUDE = re.compile(r"^include\s+(\S+)\s*(?:#.*)?$")
ADDRESS = re.compile(r"^([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+)(?:/\d+)?")
VIP_BLOCK = re.compile(r"virtual_ipaddress\s*\{(.*?)\}", re.DOTALL)

# One include deep is what this project's own layout uses. Deeper is not
# followed, and an address that cannot be found is reported as unknown rather
# than guessed at.
MAX_INCLUDE_DEPTH = 1
MAX_KEEPALIVED_BYTES = 1024 * 1024


def read_config(path):
    try:
        if path.stat().st_size > MAX_KEEPALIVED_BYTES:
            return None
        return path.read_text(encoding="utf-8")
    except Exception:
        return None


def first_address(block, base, depth=0):
    """The first address a virtual_ipaddress block puts on the interface.

    Follows an `include`, because since the address list became a generated
    file the block on a managed node holds exactly one line:

        virtual_ipaddress {
            include /etc/keepalived/addresses.conf
        }

    Reading only the block would then find no address, and this node would
    report that it does not know whether it owns the VIP - which is not a
    cosmetic answer: a deploy refuses to run without a known owner.
    """

    for line in block.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue

        include = INCLUDE.match(line)
        if include:
            if depth >= MAX_INCLUDE_DEPTH:
                continue
            path = Path(include.group(1))
            if not path.is_absolute():
                path = base / path
            text = read_config(path)
            if text is None:
                continue
            address = first_address(text, path.parent, depth + 1)
            if address:
                return address
            continue

        match = ADDRESS.match(line)
        if match:
            return match.group(1)

    return None


def parse_keepalived():
    text = read_config(KEEPALIVED_CONFIG)
    if text is None:
        return None, None

    interface_match = INTERFACE.search(text)
    interface = interface_match.group(1) if interface_match else None

    vip = None
    vip_block = VIP_BLOCK.search(text)
    if vip_block:
        vip = first_address(vip_block.group(1), KEEPALIVED_CONFIG.parent)

    return interface, vip


def owns_vip(interface, vip):
    if not interface or not vip:
        return None

    r = run(
        "/usr/sbin/ip",
        "-j",
        "-4",
        "addr",
        "show",
        "dev",
        interface,
    )

    if r.returncode != 0:
        return None

    try:
        data = json.loads(r.stdout)
    except json.JSONDecodeError:
        return None

    for iface in data:
        for addr in iface.get("addr_info", []):
            if addr.get("family") == "inet" and addr.get("local") == vip:
                return True

    return False


def address_list(path):
    """One address file as (present, digest). Two facts, told apart on purpose.

    `present` False means the file is not there; a digest of None with
    `present` True means it is there and could not be read or was too large.
    The manager needs the difference: a release that publishes no address list
    is not managing addresses from here at all, while one whose list cannot be
    read is a question nobody has answered yet.
    """

    try:
        if not path.is_file():
            return False, None
        if path.stat().st_size > MAX_KEEPALIVED_BYTES:
            return True, None
        return True, hashlib.sha256(path.read_bytes()).hexdigest()
    except Exception:
        return None, None


def read_addresses():
    """The keepalived address list as three measurements, not as a verdict.

    The release carries the list, the node installs it, and keepalived.conf
    includes it - three states that a single release hash cannot tell apart.
    A deploy that activated the configuration and failed to activate the
    addresses leaves the new hash in place with the old list restored, so the
    hash alone reports that node as current. See B57 and the deploy matrix.

    The include is reported and not compared: putting the line into
    keepalived.conf is one deliberate step by a person, one node at a time, and
    `haproxy-pull-deploy` exits 0 when it is absent. It is a fact the reader
    needs, not a target a deploy can reach.
    """

    published, published_digest = address_list(PUBLISHED_ADDRESSES)
    installed, installed_digest = address_list(KEEPALIVED_ADDRESSES)

    text = read_config(KEEPALIVED_CONFIG)
    included = None if text is None else str(KEEPALIVED_ADDRESSES) in text

    return {
        "published": published,
        "published_sha256": published_digest,
        "installed": installed,
        "installed_sha256": installed_digest,
        "included": included,
    }


def address_summary(addresses):
    """The address list in one line, for the person standing at the node.

    Facts in the same order the deploy cares about them: does the release
    publish a list, does the node carry that exact list, and is it in use.
    """

    if addresses["published"] is False:
        return "none published by this release"
    if addresses["published_sha256"] is None or addresses["installed_sha256"] is None:
        if addresses["installed"] is False:
            return "published, not installed"
        return "UNKNOWN"
    if addresses["published_sha256"] != addresses["installed_sha256"]:
        return "installed list differs from the release"
    if addresses["included"] is False:
        return "installed, not included in keepalived.conf"
    if addresses["included"] is None:
        return "installed, include unknown"
    return "installed and in use"


def runtime_info():
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(RUNTIME_SOCKET)
        sock.sendall(b"show info\n")

        chunks = []
        while True:
            data = sock.recv(65536)
            if not data:
                break
            chunks.append(data)

        sock.close()

        text = b"".join(chunks).decode("utf-8", errors="replace")

        info = {}
        for line in text.splitlines():
            if ":" not in line:
                continue
            key, value = line.split(":", 1)
            info[key.strip()] = value.strip()

        return True, {
            "version": info.get("Version"),
            "uptime_sec": (
                int(info["Uptime_sec"])
                if info.get("Uptime_sec", "").isdigit()
                else None
            ),
        }

    except Exception:
        return False, {
            "version": None,
            "uptime_sec": None,
        }


#
# A pool's own row and one row per server, plus one row per frontend, from the
# same socket `show info` already uses. This is HAProxy's own verdict - the
# checks it has actually been running against the servers it was told about -
# which is a different and more truthful answer than anything that probes from
# somewhere else once.
#
# The CSV header names the columns rather than the positions being counted:
# `show stat` has grown columns between versions, and a fixed index is a field
# that quietly becomes another field after an upgrade.
#
MAX_STAT_ROWS = 500

#
# Why the frontends are reported at all, when they carry no health check: a
# backend with three green servers and a frontend that never received the
# request look identical from the server rows alone. That was measured, not
# imagined - a site answered 503 with all three servers UP, and the only thing
# that said which listener had answered was a counter per frontend. See B89.
#
# Why the counters keep HAProxy's own column names. A renamed counter is a
# counter nobody can look up: `stot` and `hrsp_5xx` are searchable in
# `configuration.txt`, `sessions_total` and `responses_5xx` are searchable
# nowhere. The two fields below that *are* renamed carry a unit that HAProxy's
# name does not state, which is a different thing from a translation.
#
# One list for both kinds of row rather than two. `show stat` leaves a column
# empty where it does not apply - a frontend has no `econ`, a server no
# `req_tot` - and `value` already answers None for an empty cell. Two hand-kept
# lists would be two things to keep in step for no gain.
#
COUNTER_COLUMNS = (
    "scur",
    "stot",
    "bin",
    "bout",
    "req_tot",
    "qcur",
    "ereq",
    "econ",
    "eresp",
    "dreq",
    "dresp",
    "wretr",
    "wredis",
    "hrsp_2xx",
    "hrsp_3xx",
    "hrsp_4xx",
    "hrsp_5xx",
)


def parse_stat(text):
    """`show stat` output as frontends and pool members, or None if unreadable.

    Kept apart from the socket so it can be run against captured output. The
    reading and the parsing failing for the same reason - a node that answered
    nothing and a node that answered something unparseable - are both None
    here, because neither is a node with no listeners.
    """

    lines = [line for line in text.splitlines() if line.strip()]
    if not lines or not lines[0].startswith("#"):
        return None

    columns = [name.strip() for name in lines[0].lstrip("# ").split(",")]

    def value(row, name):
        try:
            found = row[columns.index(name)].strip()
        except (ValueError, IndexError):
            return None
        return found or None

    def number(row, name):
        found = value(row, name)
        return int(found) if found is not None and found.isdigit() else None

    def counters(row):
        return {name: number(row, name) for name in COUNTER_COLUMNS}

    frontends = []
    servers = []
    for line in lines[1 : MAX_STAT_ROWS + 1]:
        row = line.split(",")
        pool = value(row, "pxname")
        member = value(row, "svname")
        if pool is None or member is None:
            continue
        if member == "FRONTEND":
            frontends.append(
                {
                    "frontend": pool,
                    "status": value(row, "status"),
                    "counters": counters(row),
                }
            )
            continue
        servers.append(
            {
                "backend": pool,
                "server": member,
                "status": value(row, "status"),
                "check_status": value(row, "check_status"),
                "check_code": value(row, "check_code"),
                "check_duration_ms": number(row, "check_duration"),
                "last_change_sec": number(row, "lastchg"),
                "counters": counters(row),
            }
        )

    return {"frontends": frontends, "servers": servers}


def runtime_stat():
    try:
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(2.0)
        sock.connect(RUNTIME_SOCKET)
        sock.sendall(b"show stat\n")

        chunks = []
        while True:
            data = sock.recv(65536)
            if not data:
                break
            chunks.append(data)

        sock.close()
        text = b"".join(chunks).decode("utf-8", errors="replace")
    except Exception:
        return None

    return parse_stat(text)


def read_release():
    result = {
        "version": None,
        "hash": None,
        "timestamp": None,
        "cluster": None,
    }

    if not CURRENT_RELEASE.is_file():
        return result

    try:
        for line in CURRENT_RELEASE.read_text(encoding="utf-8").splitlines():
            if "=" not in line:
                continue

            key, value = line.split("=", 1)
            key = key.strip().lower()
            value = value.strip()

            if key in result:
                result[key] = value

    except Exception:
        pass

    return result


def leaf_fingerprint(text):
    """SHA-256 of the first certificate in the file, lowercase hex.

    The definition is identical to the manager's on purpose - the two values are
    compared against each other, so a difference in what is hashed would make
    every comparison meaningless.

    The leaf's DER bytes, not the file: a published PEM is the private key
    concatenated with the full chain, so hashing the file would change the
    answer whenever the key encoding or the bundled intermediates changed,
    without the certificate this node serves changing at all. The private key is
    never hashed and never leaves this function.

    First block rather than last, because a chain is written leaf-first. Taking
    the last would fingerprint the CA and make every node look identical.
    """

    match = CERTIFICATE_BLOCK.search(text)
    if match is None:
        return None

    try:
        der = base64.b64decode("".join(match.group(1).split()), validate=True)
    except Exception:
        return None

    if not der:
        return None

    return hashlib.sha256(der).hexdigest()


def certificate_valid(path):
    """Is it in its validity window right now? Measured, not assumed."""

    return run("/usr/bin/openssl", "x509", "-in", str(path), "-noout", "-checkend", "0").returncode == 0


def read_certificates():
    """What this node is carrying, by identity only.

    Deliberately not enriched with subject, SANs or provenance. Whether a
    certificate is ACME-renewed or static is knowable where certbot lives, not
    on a node that only sees a file, so this reports what it can measure and
    cert-list reports the rest. That is the `carried_certificate` contract.

    A file that cannot be read or does not parse is left out rather than
    reported as present with an unknown fingerprint: a certificate nobody could
    identify must not be able to satisfy a comparison.
    """

    entries = []

    #
    # A certificate `haproxy-cert-pull` installed but never got HAProxy to read
    # is on disk and not in service. Its file says nothing about what clients
    # are given, so it is left out like one that cannot be read - and the
    # manager then sees the node as behind on it, and the deploy it offers is
    # the run that finishes the reload. A marker that cannot be read leaves
    # every certificate out: this cannot tell which are in service.
    #
    pending = set()
    if CERT_PENDING.exists():
        try:
            pending = set(CERT_PENDING.read_text(encoding="ascii").split())
        except Exception:
            return entries

    try:
        paths = sorted(CERTS_DIR.glob("*.pem"))
    except Exception:
        return entries

    for path in paths:
        try:
            if not path.is_file():
                continue
            if path.stat().st_size > MAX_CERTIFICATE_BYTES:
                continue
            fingerprint = leaf_fingerprint(path.read_text(encoding="ascii", errors="strict"))
        except Exception:
            continue

        if fingerprint is None or path.name[: -len(".pem")] in pending:
            continue

        entries.append(
            {
                "id": path.name[: -len(".pem")],
                "fingerprint_sha256": fingerprint,
                "valid": certificate_valid(path),
            }
        )

    return entries


def read_validation():
    if not VALIDATION_STATE.is_file():
        return {
            "valid": None,
            "validated_at": None,
        }

    try:
        data = json.loads(VALIDATION_STATE.read_text(encoding="utf-8"))
        return {
            "valid": data.get("valid"),
            "validated_at": data.get("validated_at"),
        }
    except Exception:
        return {
            "valid": None,
            "validated_at": None,
        }


parser = argparse.ArgumentParser()
parser.add_argument("-c", "--cluster", required=True)
parser.add_argument("--json", action="store_true")
args = parser.parse_args()

if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,31}", args.cluster):
    print("ERROR: invalid cluster ID", file=sys.stderr)
    sys.exit(64)

interface, vip = parse_keepalived()
vip_owner = owns_vip(interface, vip)

haproxy_active = service_active("haproxy")
keepalived_active = service_active("keepalived")

try:
    keepalived_state = KEEPALIVED_STATE.read_text(
        encoding="utf-8"
    ).strip()
except Exception:
    keepalived_state = None

try:
    ip_nonlocal_bind = (
        Path("/proc/sys/net/ipv4/ip_nonlocal_bind")
        .read_text()
        .strip()
        == "1"
    )
except Exception:
    ip_nonlocal_bind = None

stats_ok, runtime = runtime_info()
stat = runtime_stat()
frontends = None if stat is None else stat["frontends"]
servers = None if stat is None else stat["servers"]
release = read_release()
validation = read_validation()
certificates = read_certificates()
addresses = read_addresses()

result = {
    "schema_version": 1,
    "node": socket.gethostname(),
    "cluster": args.cluster,
    "haproxy": {
        "active": haproxy_active,
    },
    "keepalived": {
        "active": keepalived_active,
        "state": keepalived_state,
        "addresses": addresses,
    },
    "vip": {
        "address": vip,
        "interface": interface,
        "owner": vip_owner,
    },
    "ip_nonlocal_bind": ip_nonlocal_bind,
    "release": release,
    "config_validation": validation,
    "stats_ok": stats_ok,
    "runtime": runtime,
    #
    # `null` rather than an empty list when the socket could not be read, so a
    # node that could not be asked is never reported as a node with no servers.
    # The same holds for the listeners.
    #
    "frontends": frontends,
    "servers": servers,
    "certificates": certificates,
    "installation": read_installation(),
    "architecture": os.uname().machine,
    "waf_engine": read_waf_engine(),
    "resources": read_resources(),
}

if args.json:
    print(json.dumps(result, separators=(",", ":"), sort_keys=True))
else:
    print(f"Node:              {result['node']}")
    print(f"Cluster:           {result['cluster']}")
    print(f"HAProxy:           {'ACTIVE' if haproxy_active else 'INACTIVE'}")
    print(f"Keepalived:        {'ACTIVE' if keepalived_active else 'INACTIVE'}")
    print(f"Keepalived state:  {keepalived_state or 'UNKNOWN'}")
    print(f"Addresses:         {address_summary(addresses)}")
    print(f"VIP:               {vip or 'UNKNOWN'}")
    print(f"VIP owner:         {vip_owner}")
    print(f"ip_nonlocal_bind:  {ip_nonlocal_bind}")
    print(f"Runtime stats:     {'OK' if stats_ok else 'FAILED'}")
    resources = result["resources"]
    print(f"Memory:            {memory_summary(resources['memory'])}")
    load = "unknown" if resources["load"] is None else "%.2f" % resources["load"]
    cpus = resources["cpus"]
    count = "1 CPU" if cpus == 1 else f"{cpus or '?'} CPUs"
    print(f"Load:              {load} on {count}, last minute")
    waf = result["waf_engine"]
    print(
        f"WAF engine:        {waf['version'] or 'NOT INSTALLED'}"
        f"{' (ACTIVE)' if waf['active'] else ''}"
    )
    #
    # Requests and 5xx per listener, because that is the pair that says whether
    # a request reached this node at all - the question the removed stats page
    # used to answer for a person standing here. See B90.
    #
    if frontends:
        print("Frontends:")
        for entry in frontends:
            counters = entry["counters"]
            requests = counters["req_tot"]
            failed = counters["hrsp_5xx"]
            print(
                f"  {entry['frontend']}  {entry['status']}"
                f"  req={'-' if requests is None else requests}"
                f"  5xx={'-' if failed is None else failed}"
            )
    if servers:
        print("Servers:")
        for entry in servers:
            check = entry["check_status"] or "-"
            print(f"  {entry['backend']}/{entry['server']}  {entry['status']}  ({check})")

sys.exit(0)
