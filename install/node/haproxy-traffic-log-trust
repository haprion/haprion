#!/bin/bash
# Fetch public trust and configure TLS forwarding of HAProxy HTTP JSON logs.
set -Eeuo pipefail

[[ $EUID -eq 0 ]] || { echo "ERROR: run this with sudo" >&2; exit 1; }
CONF=/etc/haproxy-manager/node.conf
[[ -r "$CONF" ]] || { echo "ERROR: ${CONF} is missing" >&2; exit 78; }
# shellcheck source=/dev/null
source "$CONF"
for name in MANAGER CONFIG_PULL_USER CONFIG_PULL_KEY; do
    [[ -n "${!name:-}" ]] || { echo "ERROR: ${name} is not set in ${CONF}" >&2; exit 78; }
done
TRAFFIC_LOG_CA_REMOTE="${TRAFFIC_LOG_CA_REMOTE:-.haproxy-manager/traffic-log-ca.pem}"
TRAFFIC_LOG_PORT="${TRAFFIC_LOG_PORT:-6514}"
if [[ ! "$TRAFFIC_LOG_PORT" =~ ^[0-9]+$ ]] \
    || (( TRAFFIC_LOG_PORT < 1 || TRAFFIC_LOG_PORT > 65535 )); then
    echo "ERROR: TRAFFIC_LOG_PORT must be an integer between 1 and 65535" >&2
    exit 78
fi
command -v rsyslogd >/dev/null || { echo "ERROR: rsyslog is not installed" >&2; exit 69; }
find /usr/lib -name lmnsd_gtls.so -print -quit 2>/dev/null | grep -q . || {
    echo "ERROR: the rsyslog GnuTLS driver is missing; install rsyslog-gnutls" >&2; exit 69;
}

stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT
rsync -a --chmod=F600 -e "ssh -i ${CONFIG_PULL_KEY} -o BatchMode=yes" \
    "${CONFIG_PULL_USER}@${MANAGER}:${TRAFFIC_LOG_CA_REMOTE}" "$stage/ca.pem"
openssl x509 -in "$stage/ca.pem" -noout -checkend 2592000 >/dev/null || {
    echo "ERROR: traffic-log CA is invalid or expires within 30 days" >&2; exit 65;
}
openssl x509 -in "$stage/ca.pem" -noout -text | grep -q 'CA:TRUE' || {
    echo "ERROR: fetched traffic-log trust file is not a CA certificate" >&2; exit 65;
}
install -o root -g root -m 755 -d /etc/haproxy-manager/traffic-log-tls
install -o root -g root -m 644 "$stage/ca.pem" /etc/haproxy-manager/traffic-log-tls/ca.crt

config="# Installed by haproxy-traffic-log-trust. Query strings have already been
# excluded by HAProxy's log format before this action receives a message.
if (\$programname == \"haproxy\") then {
    action(type=\"omfwd\"
           target=\"${MANAGER}\" port=\"${TRAFFIC_LOG_PORT}\" protocol=\"tcp\"
           StreamDriver=\"gtls\" StreamDriverMode=\"1\"
           StreamDriverAuthMode=\"x509/name\"
           StreamDriverPermittedPeers=\"${MANAGER}\"
           StreamDriver.CAFile=\"/etc/haproxy-manager/traffic-log-tls/ca.crt\"
           queue.type=\"linkedList\" queue.filename=\"haproxy-traffic-forward\"
           queue.saveOnShutdown=\"on\" action.resumeRetryCount=\"-1\")
}"
printf '%s\n' "$config" > "$stage/forward.conf"
install -o root -g root -m 644 "$stage/forward.conf" /etc/rsyslog.d/48-haproxy-manager-forward.conf
# Versions before 2026-09-08 installed this after Ubuntu's terminating
# 49-haproxy.conf and consequently never saw a message.
rm -f /etc/rsyslog.d/51-haproxy-manager-forward.conf
rsyslogd -N1
systemctl restart rsyslog
echo "traffic-log TLS trust and forwarding installed"
