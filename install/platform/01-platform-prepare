#!/bin/bash
#
# Platform step 1 of 2 - the application filesystem and the group that reads it.
#
# Creates the release layout the web application is installed into, the
# directories that survive a release, and the read-only group the services use
# to reach configuration. Touches no database and installs no code.
#
# Safe to run again: everything it does is checked before it is done.
#
#     sudo ./01-platform-prepare ../answers.env
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"

for user in "$WEB_USER" "$WORKER_USER" "$POLLER_USER"; do
    id -u "$user" >/dev/null 2>&1 \
        || die "service account ${user} does not exist. Run ../01-manager-prepare
  first; it applies sysusers/haprion.conf."
done

#
# A shared GROUP, deliberately, where a shared USER would be the mistake. The
# three services read the same configuration, and one identity for all three
# would make a web intrusion equal to worker access - which is deploy rights.
# Group membership grants exactly one thing here: reading the files below.
#
step "Read-only platform group"
ensure_group "$PLATFORM_GROUP"
for user in "$WEB_USER" "$WORKER_USER" "$POLLER_USER"; do
    if id -nG "$user" | tr ' ' '\n' | grep -qxF "$PLATFORM_GROUP"; then
        log "  ok       ${user} in ${PLATFORM_GROUP}"
    else
        usermod -aG "$PLATFORM_GROUP" "$user"
        log "  added    ${user} to ${PLATFORM_GROUP}"
    fi
done

#
# Code, configuration, secrets and data in four places rather than one tree, so
# each sits where Debian puts its kind (B266): a release is replaced wholesale
# and rolled back by pointing `current` elsewhere, and anything that must
# survive that cannot live inside one.
#
step "Directory tree"
ensure_dir "$UI_ROOT"              root:root 755
ensure_dir "${UI_ROOT}/releases"   root:root 755
ensure_dir "$(dirname "$UI_CONFIG")" root:root 755

#
# Nothing under the secrets directory is group-readable. Files here are granted
# to one identity at a time, by that file's own ownership, when there is a
# reason - never by putting the directory within a group's reach and deciding
# later.
#
ensure_dir "$UI_SECRETS"           root:root 700

#
# Traversable, so the web account can reach the traffic-log mirror that step 13
# makes under logs/. The dumps beside it hold every session and every audit
# record in one file, and are read by whatever restores them - a human with
# root - so they are closed by their own mode, not by this directory's.
#
ensure_dir "$UI_DATA"              root:root 755
ensure_dir "${UI_DATA}/dumps"      root:root 700

#
# Written from the example only if it is absent. A configuration file that an
# installation rewrites on every run is one nobody dares edit.
#
step "Configuration"
config="$UI_CONFIG"
if [[ -f "$config" ]]; then
    chown "root:${PLATFORM_GROUP}" "$config"
    chmod 640 "$config"
    log "  ok       ${config}"
else
    #
    # The port is rendered rather than left at the example's value, so a second
    # environment on the same machine does not start life with a configuration
    # that says it listens where the first one already does.
    #
    install -o root -g "$PLATFORM_GROUP" -m 640 /dev/null "$config"
    sed -e "s|^port = 8080$|port = ${WEB_PORT:-8080}|" examples/ui.toml.example > "$config"
    log "  created  ${config}  (from the example - review it)"
fi

step "Release layout"
if [[ -L "${UI_ROOT}/current" ]]; then
    log "  ok       ${UI_ROOT}/current -> $(readlink "${UI_ROOT}/current")"
elif [[ -e "${UI_ROOT}/current" ]]; then
    die "${UI_ROOT}/current exists and is not a symlink"
else
    log "  pending  ${UI_ROOT}/current  (created by the first release install)"
fi

echo
log "platform step 1 done"
echo
echo "Next: sudo ./02-platform-database${1:+ $1}"
