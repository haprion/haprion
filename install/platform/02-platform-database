#!/bin/bash
#
# Platform step 2 of 2 - the database, its roles, and how each one connects.
#
# Creates the database and one login role per service, with no privileges on any
# table. Table grants belong to the migration that creates the table, so a
# column's permissions are versioned with the column.
#
# Safe to run again: everything it does is checked before it is done.
#
#     sudo ./02-platform-database ../answers.env
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
require_vars PLATFORM_ROOT DB_NAME DB_MIGRATION_ROLE WEB_USER WORKER_USER POLLER_USER

#
# Defaulted rather than required: an installation that never says otherwise is
# the production one, and `-e prod` is what the documentation tells people to
# type. A dev platform sets ENVIRONMENT=dev and gets its own account tool
# namespace without any other difference.
#
ENVIRONMENT="${ENVIRONMENT:-prod}"
valid_id "$ENVIRONMENT" || die "ENVIRONMENT must be a short lowercase identifier"

[[ "$DB_NAME" =~ ^[a-z][a-z0-9_]{0,62}$ ]] || die "invalid database name: ${DB_NAME}"

systemctl is-active --quiet postgresql \
    || die "PostgreSQL is not running. Install and start it before this step."

psql_super() { sudo -u postgres psql -v ON_ERROR_STOP=1 -qtAX "$@"; }

#
# Connections come over the local Unix socket and authenticate with peer: the
# kernel states which OS user is on the other end, and PostgreSQL compares that
# name to the role name. No password exists to leak, rotate, or find in a
# process listing - which is why the role names below are exactly the service
# account names.
#
#
# Two layers, and the reason is a repository rule rather than a database one.
#
# The migrations hold the grants - a column's permissions belong beside the
# column - but a migration may not name a service account: account names
# identify a real installation, and this repository is meant to be public. So
# the migrations grant to three group roles with fixed, generic names that are
# part of the software's contract, and this step connects whatever the accounts
# are actually called to them.
#
# It is also the better database design. Adding a second worker later is a
# membership, not a migration.
#
step "Contract roles"
ensure_group_role() {
    local role="$1" purpose="$2"
    if [[ "$(psql_super -c "select 1 from pg_roles where rolname = '${role}'")" != "1" ]]; then
        psql_super -c "create role \"${role}\" with nologin"
        log "  created  ${role}  (${purpose})"
    fi
    psql_super -c "alter role \"${role}\" with nologin nosuperuser nocreatedb
                   nocreaterole noinherit noreplication nobypassrls"
    log "  ok       ${role}  (${purpose})"
}

ensure_group_role app_web    "sessions, audit, and queueing a job"
ensure_group_role app_worker "claims and completes jobs"
ensure_group_role app_poller "writes cached status and metrics"

step "Login roles"
ensure_login_role() {
    local role="$1" contract="$2"
    if [[ "$(psql_super -c "select 1 from pg_roles where rolname = '${role}'")" != "1" ]]; then
        psql_super -c "create role \"${role}\" with login nosuperuser nocreatedb
                       nocreaterole noreplication nobypassrls"
        log "  created  ${role}"
    fi

    #
    # Attributes are set on every run, not only at creation, because "the role
    # exists" is not "the role is correct" - the same distinction ensure_dir
    # makes for directories, and skipping it here cost an afternoon.
    #
    # It cost it in the quietest possible way: a role left NOINHERIT inherits
    # nothing from its contract role, so every negative check passes and the
    # application simply cannot work. A privilege test that only asks what a
    # role must NOT do reads a role with no privileges at all as perfect.
    #
    # INHERIT, with exactly one membership each. Inheritance is what makes the
    # contract role usable without every query starting with SET ROLE; one
    # membership is what keeps "inherits" from meaning "inherits things nobody
    # granted it".
    #
    psql_super -c "alter role \"${role}\" with login inherit nosuperuser nocreatedb
                   nocreaterole noreplication nobypassrls"

    if [[ -n "$contract" ]]; then
        #
        # WITH INHERIT TRUE, stated rather than relied upon. Since PostgreSQL 16
        # a membership carries its own INHERIT setting, and a plain GRANT takes
        # its default from the member role's attribute AS IT WAS WHEN THE GRANT
        # WAS MADE. Altering the role afterwards does not revisit memberships
        # already recorded, so a membership granted while the role was NOINHERIT
        # stays inert however the role is later corrected.
        #
        # The symptom is silence: the catalog shows the grants, the role looks
        # right, and every query fails with "permission denied for table".
        #
        psql_super -c "grant \"${contract}\" to \"${role}\" with inherit true"
        log "  ok       ${role}  (login, inherit, member of ${contract})"
    else
        log "  ok       ${role}  (login, inherit)"
    fi
}

ensure_login_role "$DB_MIGRATION_ROLE" ""
ensure_login_role "$WEB_USER"    app_web
ensure_login_role "$WORKER_USER" app_worker
ensure_login_role "$POLLER_USER" app_poller

step "Database"
if [[ "$(psql_super -c "select 1 from pg_database where datname = '${DB_NAME}'")" == "1" ]]; then
    log "  ok       ${DB_NAME}"
else
    psql_super -c "create database \"${DB_NAME}\" owner \"${DB_MIGRATION_ROLE}\""
    log "  created  ${DB_NAME}  (owner ${DB_MIGRATION_ROLE})"
fi

#
# The application roles own nothing. The migration role owns every object, which
# is what makes "a service process cannot run DDL" true by construction rather
# than by a grant somebody could add later: you cannot drop a table you do not
# own, whatever else you have been given.
#
step "Database-level privileges"
#
# CONNECT goes to the LOGIN roles, not to the contract roles - and that
# distinction is the whole of the isolation between environments.
#
# The contract roles are generic on purpose (B20): grants must not name service
# accounts, because those name a real installation and this repository is meant
# to be public. But generic means shared, and two platforms on one cluster are
# both members of the same app_web. Granting connect there gave every
# development account a way into the production database and back again -
# measured on 2026-08-28 by 08-verify-isolation, which failed in both
# directions.
#
# Column privileges stay where they belong, in the migrations, on the contract
# roles. CONNECT is not a column privilege and was never theirs to hold.
#
psql_super -d "$DB_NAME" <<SQL
revoke all on database "${DB_NAME}" from public;
revoke all on schema public from public;
revoke connect on database "${DB_NAME}" from app_web, app_worker, app_poller;
grant connect on database "${DB_NAME}"
    to "${WEB_USER}", "${WORKER_USER}", "${POLLER_USER}";
grant usage on schema public to app_web, app_worker, app_poller;
alter schema public owner to "${DB_MIGRATION_ROLE}";
SQL
log "  set      connect for this environment's three login roles"
log "  revoked  connect from the shared contract roles"
log "  revoked  everything from PUBLIC"

#
# Peer authentication compares the OS user to the ROLE name, so the three
# services connect with no configuration at all - their accounts are named after
# their roles. The migration role has no OS account by design: migrations are a
# deliberate root action, so root is mapped to it explicitly and nothing else
# can reach it.
#
step "Authentication"
hba="$(sudo -u postgres psql -tAX -c 'show hba_file')"
ident="$(sudo -u postgres psql -tAX -c 'show ident_file')"
marker="# haproxy-manager platform"

#
# Matched on this environment's own line, not on the marker. The marker says
# the file has been touched by this project at some point, which a second
# environment on the same machine satisfies without having any authentication of
# its own - and the step then reports ok while having done nothing. Measured on
# 2026-08-28, installing the development platform beside production.
#
ident_line="haproxy_manager_migration   root   ${DB_MIGRATION_ROLE}"
hba_line="local   ${DB_NAME}   ${DB_MIGRATION_ROLE}   peer   map=haproxy_manager_migration"

if grep -qF "$ident_line" "$ident"; then
    log "  ok       ${ident}  (${DB_MIGRATION_ROLE})"
else
    cp -a "$ident" "${ident}.pre-haproxy-manager-$(date +%Y%m%d)"
    if grep -qF "$marker" "$ident"; then
        printf '%s\n' "$ident_line" >> "$ident"
    else
        printf '\n%s\n%s\n' "$marker" "$ident_line" >> "$ident"
    fi
    log "  added    ${ident}  (root -> ${DB_MIGRATION_ROLE})"
fi

if grep -qF "$hba_line" "$hba"; then
    log "  ok       ${hba}  (${DB_NAME})"
else
    cp -a "$hba" "${hba}.pre-haproxy-manager-$(date +%Y%m%d)"
    #
    # Prepended, not appended: pg_hba is first-match-wins, and the generic
    # `local all all peer` line Ubuntu ships would otherwise match first and
    # refuse root as a role it is not named after.
    #
    tmp="$(mktemp)"
    { printf '%s\n%s\n\n' "$marker" "$hba_line"
      cat "$hba"
    } > "$tmp"
    install -o postgres -g postgres -m 640 "$tmp" "$hba"
    rm -f "$tmp"
    log "  added    ${hba}  (migration role over the local socket)"
fi

systemctl reload postgresql
log "  reloaded postgresql"

#
# A statement that runs forever and a transaction left open are the two ways a
# service pins a connection nobody can reclaim. Set per role and per database,
# so they hold however the service is started and whatever it forgets.
#
# The worker gets a longer statement timeout and the same short idle limit: its
# queries are brief, but it must never hold a transaction open across the CLI
# subprocess, and this makes that a database rule rather than a discipline.
#
step "Per-role limits"
set_limits() {
    psql_super -c "alter role \"$1\" in database \"${DB_NAME}\" set statement_timeout = '$2'"
    psql_super -c "alter role \"$1\" in database \"${DB_NAME}\"
                   set idle_in_transaction_session_timeout = '10s'"
    log "  set      $1  statement_timeout=$2 idle_in_transaction=10s"
}
set_limits "$WEB_USER"    "5s"
set_limits "$WORKER_USER" "15s"
set_limits "$POLLER_USER" "10s"

step "Proving it"
#
# Asserted rather than assumed. Each of these is one of the phase's gate items,
# and each has failed silently somewhere before: a role that cannot connect
# looks identical to an application bug, and a role that can create a table
# looks like nothing at all until the day it does.
#
for role in "$WEB_USER" "$WORKER_USER" "$POLLER_USER"; do
    sudo -u "$role" psql -d "$DB_NAME" -qtAX -c 'select 1' >/dev/null \
        || die "${role} cannot connect to ${DB_NAME}"
    if sudo -u "$role" psql -d "$DB_NAME" -qtAX \
            -c 'create table platform_privilege_probe (id int)' >/dev/null 2>&1; then
        sudo -u postgres psql -d "$DB_NAME" -qtAX \
            -c 'drop table if exists platform_privilege_probe' >/dev/null
        die "${role} can create tables in ${DB_NAME}"
    fi
    log "  ok       ${role} connects and cannot create tables"
done

#
# -U is not optional here, and the reason is worth stating: psql asks for a role
# named after the OS user unless told otherwise, so plain `psql` from root asks
# for a role called "root", which does not exist and should not. The ident map
# does not rename root - it authorises root to *request* this one role.
#
psql -U "$DB_MIGRATION_ROLE" -d "$DB_NAME" -qtAX -c 'select 1' >/dev/null \
    || die "root cannot connect as ${DB_MIGRATION_ROLE}"
log "  ok       root connects as ${DB_MIGRATION_ROLE}, and only root can"

#
# The other half of that claim. A service account must not be able to reach the
# role that owns everything, whatever the map says about root.
#
if sudo -u "$WEB_USER" psql -U "$DB_MIGRATION_ROLE" -d "$DB_NAME" \
        -qtAX -c 'select 1' >/dev/null 2>&1; then
    die "${WEB_USER} can connect as ${DB_MIGRATION_ROLE}"
fi
log "  ok       ${WEB_USER} cannot connect as ${DB_MIGRATION_ROLE}"

echo
step "Naming this environment for the account tool"
#
# haproxy-ui-user is given the database and the role here rather than deriving
# them from the application's configuration. Each environment gets its own
# root-owned file, so `-e prod` cannot be pointed at the dev database - or, in
# the direction that actually matters, the reverse - by an environment variable
# or a working directory.
#
ensure_dir /etc/haproxy-manager root:root 755
install_file "/etc/haproxy-manager/ui-admin-${ENVIRONMENT}.conf" root:root 644 "$(cat <<EOF
# Read by haproxy-ui-user -e ${ENVIRONMENT}. Written by 02-platform-database.
DB_NAME=${DB_NAME}
DB_ROLE=${DB_MIGRATION_ROLE}
DUMP_DIR=${PLATFORM_ROOT}/data/dumps
EOF
)"

log "platform step 2 done"
echo
echo "The database exists and has no tables. The schema arrives as migrations."
