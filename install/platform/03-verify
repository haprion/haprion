    log "  ok       $(echo "$expected_grants" | wc -l) grants, exactly as expected"
else
    fail "the privilege surface is not what the contract says"
    diff <(echo "$expected_grants") <(echo "$actual_grants") || true
fi

#
# The negative half. Each of these has a matching line in the phase gate, and
# each describes a way the separation could be lost without anything looking
# wrong: a role that can edit the audit trail, or write a table it only reads.
#
step "What the roles must not be able to do"
#
# Each probe runs inside a transaction that is rolled back, so a check that
# unexpectedly SUCCEEDS reports the failure without leaving the row it managed
# to write. A verification that dirties the thing it verifies is one nobody runs
# twice.
#
refuse() {
    local user="$1" description="$2" sql="$3"
    #
    # ON_ERROR_STOP is what makes this test mean anything. Without it psql
    # reports a failed statement on stderr and still exits 0, so every refusal
    # below would pass whether or not the database refused.
    #
    if sudo -u "$user" psql -d "$DB_NAME" -qtAX -v ON_ERROR_STOP=1 \
            -c "begin; ${sql}; rollback" >/dev/null 2>&1; then
        fail "${user} ${description}"
    else
        log "  ok       ${user} ${description}"
    fi
}

refuse "$WEB_USER"    "cannot update the audit trail" \
       "update audit_event set action = 'tampered'"
refuse "$WEB_USER"    "cannot delete from the audit trail" \
       "delete from audit_event"
#
# Since 0039 the web writes accounts - name, hash and role on a new one; role,
# disabled and hash on an existing one - and since 0041 it may delete one and
# mark it break-glass (B197). Still no rename, no dates, no change of kind, and
# the unlock and attempt records are append-only.
#
refuse "$WEB_USER"    "cannot turn an account into another kind" \
       "update app_user set source = source"
refuse "$WEB_USER"    "cannot rename an account" \
       "update app_user set username = username || 'x'"
refuse "$WEB_USER"    "cannot set an account's dates" \
       "update app_user set updated_at = now()"
refuse "$WEB_USER"    "cannot remove an unlock" \
       "delete from login_unlock"
refuse "$WEB_USER"    "cannot remove a sign-in attempt" \
       "delete from login_attempt"
#
# Since 0040 the web flips the two feature switches and nothing more: no new
# switch, no removed one, and no date of its own choosing.
#
refuse "$WEB_USER"    "cannot add a feature switch" \
       "insert into feature_switch (name) values ('probe')"
refuse "$WEB_USER"    "cannot remove a feature switch" \
       "delete from feature_switch"
refuse "$WEB_USER"    "cannot set a feature switch's date" \
       "update feature_switch set updated_at = now()"
#
# Since 0041 the web writes the provider's settings; the revision and the date
# are the database's, so a Verify cannot be made to cover a later change. There
# is one provider: none added, none removed. A sign-in in progress can be used
# and not removed or rewritten.
#
refuse "$WEB_USER"    "cannot set the provider's revision" \
       "update oidc_provider set revision = revision"
refuse "$WEB_USER"    "cannot set the provider's date" \
       "update oidc_provider set updated_at = now()"
refuse "$WEB_USER"    "cannot add a provider" \
       "insert into oidc_provider (singleton) values (true)"
refuse "$WEB_USER"    "cannot remove the provider" \
       "delete from oidc_provider"
refuse "$WEB_USER"    "cannot rewrite a sign-in in progress" \
       "update oidc_login set nonce = nonce"
refuse "$WEB_USER"    "cannot remove a sign-in in progress" \
       "delete from oidc_login"
refuse "$WORKER_USER" "cannot read the provider" \
       "select client_id from oidc_provider"
refuse "$POLLER_USER" "cannot read the provider" \
       "select client_id from oidc_provider"
refuse "$WEB_USER"    "cannot backdate a session" \
       "insert into app_session (token_hash, user_id, expires_at, created_at)
        values (repeat('x', 32)::bytea, 1, now(), now())"
refuse "$WORKER_USER" "cannot read the audit trail" \
       "select id from audit_event"
refuse "$POLLER_USER" "cannot read accounts" \
       "select id from app_user"
refuse "$POLLER_USER" "cannot write the audit trail" \
       "insert into audit_event (action) values ('probe')"

#
# The job table is where a web intrusion is bounded. Each of these is a way the
# boundary could be lost while the application still looked correct.
#
refuse "$WEB_USER"    "cannot queue a job as already running" \
       "insert into job (operation, cluster, payload, state)
        values ('deploy', 'alpha', '{}'::jsonb, 'running')"
refuse "$WEB_USER"    "cannot choose a job's request id" \
       "insert into job (operation, cluster, payload, request_id)
        values ('deploy', 'alpha', '{}'::jsonb, gen_random_uuid())"
refuse "$WEB_USER"    "cannot choose a job's payload hash" \
       "insert into job (operation, cluster, payload, payload_hash)
        values ('deploy', 'alpha', '{}'::jsonb, decode('00', 'hex'))"
refuse "$WEB_USER"    "cannot write a job result" \
       "insert into job (operation, cluster, payload, result)
        values ('deploy', 'alpha', '{}'::jsonb, '{}'::jsonb)"
refuse "$WEB_USER"    "cannot grant itself a lease" \
       "insert into job (operation, cluster, payload, lease_until)
        values ('deploy', 'alpha', '{}'::jsonb, now())"
refuse "$WEB_USER"    "cannot update a job row" \
       "update job set state = 'done'"
refuse "$WEB_USER"    "cannot queue an operation outside the allowlist" \
       "insert into job (operation, cluster, payload)
        values ('rm-rf', 'alpha', '{}'::jsonb)"
refuse "$POLLER_USER" "cannot write a job row" \
       "insert into job (operation, cluster, payload)
        values ('deploy', 'alpha', '{}'::jsonb)"
refuse "$POLLER_USER" "cannot read jobs" \
       "select id from job"
#
# The search index (0047, B222) is the one table the poller deletes from: it
# replaces its own derived rows. The web reads it and writes nothing, and the
# poller's delete reaches no other table.
#
refuse "$WEB_USER"    "cannot write the search index" \
       "delete from search_entry"
refuse "$POLLER_USER" "cannot delete a cached reading" \
       "delete from cluster_objects"

#
# The half that keeps the half above honest. Every refusal would also pass if
# the web role could write nothing at all, so the suite has to prove that the
# thing it is bounding actually works - otherwise a broken grant reads as
# perfect security.
#
step "What the roles must be able to do"
allow() {
    local user="$1" description="$2" sql="$3" expected="$4"
    local got
    if ! got="$(sudo -u "$user" psql -d "$DB_NAME" -qtAX -v ON_ERROR_STOP=1 \
                -c "begin; ${sql}; rollback" 2>&1)"; then
        fail "${user} ${description}: ${got}"
        return
    fi
    if [[ -n "$expected" && "$got" != *"$expected"* ]]; then
        fail "${user} ${description}: got '${got}', expected '${expected}'"
        return
    fi
    log "  ok       ${user} ${description}"
}

#
# The row comes back stating what the database decided rather than what the
# caller asked for: pending, a request ID and a creation time none of which the
# web role holds insert on.
#
allow "$WEB_USER" "can queue a keyed job, which the database marks pending" \
      "insert into job (operation, cluster, payload, idempotency_key)
       values ('deploy', 'alpha', '{\"probe\": true}'::jsonb, gen_random_uuid())
       returning state" \
      "pending"

allow "$WEB_USER" "receives a request id it did not choose" \
      "insert into job (operation, cluster, payload, idempotency_key)
       values ('deploy', 'alpha', '{}'::jsonb, gen_random_uuid())
       returning request_id is not null" \
      "t"

allow "$WEB_USER" "receives the database-derived payload hash" \
      "insert into job (operation, cluster, payload, idempotency_key)
       values ('deploy', 'alpha', '{}'::jsonb, gen_random_uuid())
       returning payload_hash is not null" \
      "t"

#
# The account writes 0039 grants, planned against no row: PostgreSQL checks the
# column privileges when it plans, so this proves them without touching an
# account or waking the last-admin trigger.
#
allow "$WEB_USER" "can change an account's role, state and password" \
      "update app_user set role = role, disabled = disabled, password_hash = password_hash
        where false" \
      ""

allow "$WEB_USER" "can delete an account and mark one break-glass" \
      "delete from app_user where false;
       update app_user set break_glass = break_glass, oidc_issuer = oidc_issuer,
              oidc_subject = oidc_subject where false" \
      ""

allow "$WEB_USER" "can write the provider's settings" \
      "update oidc_provider set enabled = enabled, issuer = issuer, client_id = client_id,
              client_secret_sealed = client_secret_sealed, key_id = key_id,
              verified_revision = verified_revision, updated_by = updated_by where false" \
      ""

allow "$WEB_USER" "can start and use a sign-in through the provider" \
      "insert into oidc_login (state, nonce, verifier, mode, pre_session_hash)
       select 'probe', 'probe', 'probe', 'sign_in', '\\x00' where false;
       update oidc_login set used_at = now() where false" \
      ""

allow "$WEB_USER" "can flip a feature switch" \
      "update feature_switch set enabled = enabled, remembered = remembered,
              updated_by = updated_by where false" \
      ""

allow "$WEB_USER" "can record an unlock" \
      "insert into login_unlock (username_normalised, actor)
       select 'probe', 'probe' where false" \
      ""

#
# The claim, exactly as the worker will write it, against however many pending
# jobs there are - usually none. PostgreSQL checks column privileges when it
# plans the statement, not when it finds a row, so this proves the worker may
# write every column the claim touches without needing a row to exist and
# without leaving one behind.
#
allow "$WORKER_USER" "may run the claim as written" \
      "update job set state = 'running',
                      claim_token = gen_random_uuid(),
                      worker_id = 'probe',
                      started_at = statement_timestamp(),
                      lease_until = statement_timestamp() + interval '30 seconds'
        where id = (select id from job
                     where state = 'pending'
                     order by created_at, id
                     limit 1
                       for update skip locked)" \
      ""

allow "$POLLER_USER" "can replace its rows in the search index" \
      "delete from search_entry where cluster = 'alpha' and source = 'objects';
       insert into search_entry (cluster, source, kind, title, value, href)
       values ('alpha', 'objects', 'proxy', 'probe', 'probe', '/') returning kind" \
      "proxy"

#
# The double-clicked button. The first insert succeeds and the second must be
# refused by the partial unique index, so the pair fails as a whole - which is
# what the caller sees as a conflict instead of a second rollout.
#
refuse "$WEB_USER" "cannot queue a second active job for one cluster" \
       "insert into job (operation, cluster, payload)
        values ('deploy', 'alpha', '{}'::jsonb);
        insert into job (operation, cluster, payload)
        values ('deploy', 'alpha', '{}'::jsonb)"

echo
if (( failures )); then
    die "${failures} check(s) failed"
fi
log "platform step 3 done - the database grants exactly what the contract says"
