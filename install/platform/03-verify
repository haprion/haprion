#!/bin/bash
#
# Platform step 3 - check that the database grants what it is supposed to, and
# nothing else.
#
# This is a contract test, and it is deliberately a SECOND description of the
# privilege surface. The migrations are the first: they state what to grant.
# This states what the result must be, and compares it against what the running
# database actually reports. Two descriptions are the point here, where they
# would be a defect anywhere else - a test that derives its expectation from the
# thing it is testing proves nothing.
#
# Read-only. It changes nothing and can be run whenever.
#
# Because it is a second description, it does not follow the first on its own:
# a migration that adds a table or a grant leaves this file stale, and the
# staleness surfaces as a failed install step rather than as a failed test.
# That happened on 2026-09-04 - `cluster_objects` and `proxy_draft` had been in
# the database for days. The lists below therefore belong in the same commit as
# the migration that changes them, written from what the migration grants and
# then checked against the running database, never copied out of this script's
# own diff. Copying the diff back in would make the second description a
# reflection of the first, which is the one thing it must not be.
#
#     sudo ./03-verify <answers-file>
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
require_vars DB_NAME DB_MIGRATION_ROLE WEB_USER WORKER_USER POLLER_USER

run() { psql -U "$DB_MIGRATION_ROLE" -d "$DB_NAME" -qtAX -F $'\t' "$@"; }

failures=0
fail() { echo "  FAIL     $*" >&2; failures=$((failures + 1)); }

step "Tables"
expected_tables=$'alembic_version\napp_session\napp_user\naudit_event\ncluster_backups\ncluster_certificates\ncluster_history\ncluster_inventory\ncluster_network\ncluster_objects\ncluster_status\ndns_provider_profile\njob\nlogin_attempt\nmetric_backend_hour\nmetric_backend_member\nmetric_frontend\nmetric_rollup_state\nndes_provider_profile\nproxy_draft'
#
# Partitions are excluded, and only partitions. They are tables in `pg_tables`
# and there are dozens of them - one per day per metric table, made and dropped
# by the retention command on its own schedule - so listing them here would
# make this check fail every night for the one reason that is not a defect.
# What they must not have is privileges of their own, and that is not waived:
# the column-privilege check below reads every table in the schema, partitions
# included, and a partition carrying a grant would show up there as a row this
# file does not expect.
#
actual_tables="$(run -c "select c.relname from pg_class c
                           join pg_namespace n on n.oid = c.relnamespace
                          where n.nspname = 'public'
                            and c.relkind in ('r', 'p')
                            and not c.relispartition
                          order by 1")"
if [[ "$actual_tables" == "$expected_tables" ]]; then
    log "  ok       $(echo "$actual_tables" | tr '\n' ' ')"
else
    fail "tables differ"
    diff <(echo "$expected_tables") <(echo "$actual_tables") || true
fi

#
# Column by column, grantee by grantee. A grant on a whole table would show up
# here as every column at once, which is exactly the widening this is watching
# for.
#
step "Column privileges"
#
# `metric_listener`, `metric_pool_member` and `metric_pool_hour` are views over
# the renamed metric tables (migration 0023) with the grants the tables had, so
# the UI release before the rename keeps working across the migration and a
# rollback. They are listed until the schema change that drops them.
#
expected_grants=$(cat <<'EOF'
