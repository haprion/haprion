#!/bin/bash
#
# Platform step 4 - install and start the web service.
#
# Needs a release: the unit runs what `current` points at, so activating a
# release and restarting is the whole deployment, and pointing it back and
# restarting is the whole rollback.
#
#     sudo ./04-platform-service <answers-file>
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"

unit_name="${WEB_UNIT%.service}"
unit="/etc/systemd/system/${unit_name}.service"
[[ -L "${UI_ROOT}/current" ]] \
    || die "${UI_ROOT}/current does not exist. Install a release first."

step "Unit"
#
# The examples as they are: the unit holds nothing per installation, and a
# release update installs the same files (refresh-platform-files). The socket
# is the web's only listener, and only root and nginx's group may open it.
#
getent group www-data >/dev/null || die "there is no www-data group for nginx's workers; install nginx (step 01)"
install_file "/etc/systemd/system/${unit_name}.socket" root:root 644 \
    "$(cat examples/haprion-web.socket.example)"
install_file "$unit" root:root 644 "$(cat examples/haprion-web.service.example)"

systemctl daemon-reload
log "  reloaded systemd"

step "Starting"
systemctl enable --quiet "${unit_name}.socket" "${unit_name}.service"
restart_units "${unit_name}.socket" "${unit_name}.service"
log "  started  ${unit_name}.socket ${unit_name}.service"

#
# Asked of the running service rather than assumed from a zero exit. systemd
# reports a unit as active the moment the process is up, which is before it has
# reached its database - and "up but unable to answer" is the state worth
# catching here.
#
step "Proving it answers"
for _ in $(seq 10); do
    if answer="$(curl -fsS --max-time 3 --unix-socket "$WEB_SOCKET" http://localhost/healthz 2>/dev/null)"; then
        log "  ok       ${answer}"
        echo
        log "platform step 4 done"
        exit 0
    fi
    sleep 1
done

systemctl status --no-pager --lines=20 "${unit_name}.service" || true
die "the service did not answer /healthz on ${WEB_SOCKET} within 10 seconds"
