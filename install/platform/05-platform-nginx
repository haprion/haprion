#!/bin/bash
#
# Platform step 5 - terminate HTTPS in front of the web service.
#
#     sudo ./05-platform-nginx <answers-file>
#
# Checks for haprion-tls (the haprion-ui package's), renders the site, and - if no pair is installed yet -
# generates a self-signed one so the UI is encrypted from the first login. The
# session cookie is Secure, so plain HTTP is not a lesser option here; it is a
# non-working one. See B21.
#
# Replacing that certificate later is haprion-tls, not a rerun of this
# script.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
require_vars SERVER_NAME

#
# Defaulted rather than required, so an existing answers file keeps working.
# Point these at an internally issued pair and the self-signed step never runs.
#
TLS_CERT="${TLS_CERT:-/etc/haprion/tls/ui.crt}"
TLS_KEY="${TLS_KEY:-/etc/haprion/tls/ui.key}"

valid_abs_path "$TLS_CERT" || die "TLS_CERT must be an absolute path"
valid_abs_path "$TLS_KEY"  || die "TLS_KEY must be an absolute path"
#
# A reverse proxy in front, whose X-Forwarded-For nginx believes (INSTALLATION
# 4.5). Empty - the default - believes nobody's, as before this existed.
#
TRUSTED_PROXIES="${TRUSTED_PROXIES:-}"
real_ip="$(render_real_ip "$TRUSTED_PROXIES")" || die "TRUSTED_PROXIES is not a list of addresses"

systemctl is-active --quiet "$WEB_UNIT" \
    || die "${WEB_UNIT} is not running; run 04-platform-service first"

#
# The web's socket admits root and the group www-data (haprion-web.socket):
# nginx's workers must be that user, as Ubuntu's and Debian's nginx.conf have
# them, or nginx cannot reach the interface at all.
#
nginx_user="$(sed -n 's/^[[:space:]]*user[[:space:]]\{1,\}\([^[:space:];]\{1,\}\).*/\1/p' /etc/nginx/nginx.conf | head -n 1)"
[[ "$nginx_user" == www-data ]] \
    || die "nginx's workers run as ${nginx_user:-the default user}, and the web's socket admits www-data; set 'user www-data;' in /etc/nginx/nginx.conf"

step "Where the pair lives"
ensure_dir /etc/haprion root:root 755
ensure_dir "$(dirname "$TLS_CERT")" root:root 700
ensure_dir "$(dirname "$TLS_KEY")" root:root 700
install_file /etc/haprion/ui-tls.conf root:root 644 "$(cat <<EOF
# Read by haprion-tls. Written by 05-platform-nginx.
TLS_CERT=${TLS_CERT}
TLS_KEY=${TLS_KEY}
SERVER_NAME=${SERVER_NAME}
EOF
)"

step "The command that owns the certificate"
[[ -x /usr/sbin/haprion-tls ]] || die "/usr/sbin/haprion-tls is missing; install the haprion-ui package"
log "  ok       /usr/sbin/haprion-tls"

#
# The receivers' snippet, included by the site below. Created empty only when
# absent: once haprion-cert-receiver has written it, a rerun of this step must
# not take the receivers with it. nginx refuses a site that includes a file
# which does not exist, which is why the site is not rendered before this.
#
step "Receivers' snippet"
ensure_dir /etc/nginx/snippets root:root 755
if [[ -f /etc/nginx/snippets/haprion-receivers.conf ]]; then
    log "  ok       /etc/nginx/snippets/haprion-receivers.conf"
else
    install_file /etc/nginx/snippets/haprion-receivers.conf root:root 644 \
        "# Written by haprion-cert-receiver from the certificate registry. Empty until the first https receiver."
fi

#
# Written on every run, from the answers file alone: unlike the receivers'
# snippet nothing else writes it, and a proxy taken out of the answers file
# must stop being believed at the next run.
#
step "Trusted proxies"
install_file /etc/nginx/snippets/haprion-real-ip.conf root:root 644 "$real_ip"
if [[ -n "${TRUSTED_PROXIES// /}" ]]; then
    log "  believes X-Forwarded-For from: ${TRUSTED_PROXIES}"
else
    log "  none; every client is known by its own address"
fi

step "Site"
rendered="$(render_site "$SERVER_NAME" "$TLS_CERT" "$TLS_KEY" examples/haprion.nginx.example)"
install_file /etc/nginx/sites-available/haprion root:root 644 "$rendered"

if [[ -L /etc/nginx/sites-enabled/haprion ]]; then
    log "  ok       site enabled"
else
    ln -sf ../sites-available/haprion /etc/nginx/sites-enabled/haprion
    log "  enabled  site"
fi

#
# The packaged default site answers on port 80 for any name, which means it
# answers for this one too whenever the redirect above is not matched first.
# Disabled rather than deleted: it is the distribution's file, not ours.
#
if [[ -e /etc/nginx/sites-enabled/default ]]; then
    rm -f /etc/nginx/sites-enabled/default
    log "  disabled the packaged default site"
else
    log "  ok       default site not enabled"
fi

step "Certificate"
if [[ -f "$TLS_CERT" && -f "$TLS_KEY" ]]; then
    log "  ok       a pair is already installed"
    /usr/sbin/haprion-tls show
    # The public copy the site serves at /certdist/manager-ui.pem, for an
    # installation whose pair predates it; a new pair writes its own.
    /usr/sbin/haprion-tls publish
else
    log "  none installed - generating a self-signed starting point"
    /usr/sbin/haprion-tls self-signed
fi

step "Starting"
nginx -t 2>&1 | sed 's/^/  /'
systemctl enable --quiet nginx
systemctl reload-or-restart nginx
log "  started  nginx"

#
# The negative half, and the reason the private key is root-owned 0600 rather
# than merely "out of the way". Each of these is a line in the phase 4 gate.
#
step "What the app identities must not be able to do"
failed=0
for user in "$WEB_USER" "${WORKER_USER:-}" "${POLLER_USER:-}"; do
    [[ -n "$user" ]] || continue
    if sudo -u "$user" test -r "$TLS_KEY" 2>/dev/null; then
        warn "  FAIL     ${user} can read ${TLS_KEY}"
        failed=1
    else
        log "  ok       ${user} cannot read the private key"
    fi
done
[[ $failed -eq 0 ]] || die "an application identity can read nginx's private key"

#
# Asked over the real listener rather than assumed from a clean config test.
# -k because the starting point is self-signed and this proves the path works,
# not that the certificate is trusted.
#
step "Proving it answers"
for _ in $(seq 10); do
    if answer="$(curl -fsSk --max-time 3 "https://${SERVER_NAME}/healthz" 2>/dev/null)"; then
        log "  ok       ${answer}"
        echo
        log "platform step 5 done"
        exit 0
    fi
    sleep 1
done

systemctl status --no-pager --lines=20 nginx || true
die "https://${SERVER_NAME}/healthz did not answer within 10 seconds"
