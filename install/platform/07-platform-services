#!/bin/bash
#
# Platform step 7 - the worker and the poller.
#
#     sudo ./07-platform-services <answers-file>
#
# Each runs as its own account, and that is the point of the step. A single
# application user would have made a web intrusion equivalent to deploy rights;
# here the web process can queue a job it cannot perform, the worker can perform
# one it cannot invent, and the poller can read what neither of them may write.
#
# The worker starts with management writes off and is provably unable to act.
# That is stronger than not installing it: it is the state a rollback returns
# to, so it has to be a state that runs.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
require_vars PLATFORM_ROOT DB_NAME WEB_USER WORKER_USER POLLER_USER

#
# Units and the sudoers file are named after the accounts, so a second
# environment on the same machine collides with nothing. In production the names
# were already identical.
#
units=("$WORKER_USER" "$POLLER_USER")
sudoers_name="$POLLER_USER"

link="${PLATFORM_ROOT}/current"
[[ -L "$link" ]] || die "${link} does not exist. Install a release first."

render() {
    sed -e "s|/apps/haproxy-manager|${PLATFORM_ROOT}|g" \
        -e "s|haproxy-ui-worker|${WORKER_USER}|g" \
        -e "s|haproxy-ui-poller|${POLLER_USER}|g" \
        "$1"
}

step "The poller's one privilege"
#
# Checked by visudo before it is installed, never after. A sudoers file that
# does not parse takes sudo down for everyone on the machine, including the
# operator who would fix it - so it is validated in a temporary file first and
# only then moved into place.
#
sudoers_staging="$(mktemp)"
sed "s|POLLER_USER|${POLLER_USER}|g" examples/haproxy-ui-poller.sudoers.example \
    > "$sudoers_staging"
if ! visudo -cqf "$sudoers_staging"; then
    rm -f "$sudoers_staging"
    die "the rendered sudoers rule does not parse; nothing was installed"
fi
install -o root -g root -m 440 "$sudoers_staging" "/etc/sudoers.d/${sudoers_name}"
rm -f "$sudoers_staging"
log "  installed /etc/sudoers.d/${sudoers_name}  (visudo accepted it)"

step "The worker's privileges"
#
# Installed here rather than by hand, which is how it was done until 2026-09-03
# and how it fell behind: the file dated from before the objects-publish helper
# existed, so the editor's publish button would have met sudo's refusal on its
# first use. A rule that lives only in an operator's memory drifts from the
# release that needs it.
#
# Rendered, exactly like the poller's rule above it. It was copied verbatim from
# an example that named `haproxy-ui-worker` in every line, while being installed
# as /etc/sudoers.d/${WORKER_USER} - so a platform whose worker is called
# something else got a file visudo accepts and sudo ignores, and every write
# failed pointing at the helper rather than at the rule.
#
sudoers_staging="$(mktemp)"
sed "s|WORKER_USER|${WORKER_USER}|g" examples/haproxy-ui-worker.sudoers.example \
    > "$sudoers_staging"
if ! visudo -cqf "$sudoers_staging"; then
    rm -f "$sudoers_staging"
    die "the worker sudoers rule does not parse; nothing was installed"
fi
install -o root -g root -m 440 "$sudoers_staging" "/etc/sudoers.d/${WORKER_USER}"
rm -f "$sudoers_staging"
log "  installed /etc/sudoers.d/${WORKER_USER}  (visudo accepted it)"

step "The web service's way to the probe"
#
# Not a sudoers rule. The web unit carries NoNewPrivileges=yes, an empty
# capability bounding set and RestrictSUIDSGID=yes, so a setuid sudo there does
# not fail for want of a rule - it fails before it reads sudoers, and it fails
# however the rule is written. A rule installed for that account would grant
# nothing and would read as though the web service could escalate.
#
# So the privilege stays still and the request travels: a root-owned socket,
# group this account, answered by a short-lived instance of the helper that
# takes no arguments and does one thing.
#
# Off unless the answers file asks for it. Handing this socket to a development
# platform's web account would give it the real nodes, which is the one thing
# that platform is built not to have.
#
if [[ "${PROBE_SOCKET:-no}" == "yes" ]]; then
    install_file "/etc/systemd/system/haproxy-probe-helper@.service" root:root 644 \
        "$(cat 'examples/haproxy-probe-helper@.service.example')"
    install_file "/etc/systemd/system/haproxy-probe-helper.socket" root:root 644 \
        "$(sed "s|WEB_USER|${WEB_USER}|g" examples/haproxy-probe-helper.socket.example)"
    systemctl daemon-reload
    systemctl enable --quiet haproxy-probe-helper.socket
    systemctl restart haproxy-probe-helper.socket
    systemctl is-active --quiet haproxy-probe-helper.socket \
        || die "haproxy-probe-helper.socket did not start"
    log "  listening on /run/haproxy-mgmt/probe.sock  (group ${WEB_USER})"
else
    log "  skipped: PROBE_SOCKET is not yes, so this platform cannot probe"
fi

#
# A rule from before the socket existed is worse than no rule: it cannot work,
# and it says in /etc/sudoers.d that this account may become root.
#
if [[ -f "/etc/sudoers.d/${WEB_USER}" ]]; then
    rm -f "/etc/sudoers.d/${WEB_USER}"
    log "  removed /etc/sudoers.d/${WEB_USER}  (a sudo rule this account cannot use)"
fi

#
# Taken before anything is restarted, and read from the database rather than
# from this machine's clock, so the comparison below cannot be thrown off by
# the two disagreeing.
#
started_at="$(sudo -u "$POLLER_USER" psql -d "${DB_NAME}" -qtAX \
    -c "select statement_timestamp()")"

step "Units"
install_file "/etc/systemd/system/${WORKER_USER}.service" root:root 644 \
    "$(render "examples/haproxy-ui-worker.service.example")"
install_file "/etc/systemd/system/${POLLER_USER}.service" root:root 644 \
    "$(render "examples/haproxy-ui-poller.service.example")"
systemctl daemon-reload
log "  reloaded systemd"

step "Starting"
#
# Restarted, not merely enabled. `enable --now` starts a unit that is stopped
# and does nothing to one that is already running - so a rerun after changing a
# unit file leaves the old settings in place while reporting success, which is
# how a sandbox fix can look like it did not work.
#
systemctl enable --quiet "${WORKER_USER}.service" "${POLLER_USER}.service"
systemctl restart "${WORKER_USER}.service" "${POLLER_USER}.service"
for unit in "${units[@]}"; do
    systemctl is-active --quiet "${unit}.service" \
        || { systemctl status --no-pager --lines=20 "${unit}.service" || true;
             die "${unit}.service did not start"; }
    log "  started  ${unit}.service"
done

#
# The poller needs a moment to take the lock, run the helper and write a row.
# Waited for rather than assumed: a unit that is active has started, which is
# not the same as having done its job once.
#
#
# Counted from a moment captured before the restart, not simply "are there any
# rows". A row from an earlier run would let this pass forever on stale data -
# which is precisely how a poller that has stopped working looks like one that
# is fine.
#
#
# Listed once, and every cache the poller writes belongs here. A table added to
# the poller without being added to this list is one nobody proves was written,
# and an empty cache looks exactly like a view that has no data yet.
#
CACHES=(
    cluster_status
    cluster_inventory
    cluster_history
    cluster_backups
    cluster_certificates
    cluster_network
)

step "Proving the poller cached every read it makes"
fresh_rows() {
    sudo -u "$POLLER_USER" psql -d "${DB_NAME}" -qtAX -c \
        "select count(*) from ${1} where observed_at > '${started_at}'" \
        2>/dev/null || echo 0
}
all_cached=0
for _ in $(seq 30); do
    all_cached=1
    for table in "${CACHES[@]}"; do
        [[ "$(fresh_rows "$table")" -gt 0 ]] || all_cached=0
    done
    [[ "$all_cached" -eq 1 ]] && break
    sleep 1
done
[[ "$all_cached" -eq 1 ]] || {
    journalctl -u "${POLLER_USER}.service" --no-pager --lines=20 || true
    die "the poller wrote no fresh rows for every cached read within 30 seconds"
}
for table in "${CACHES[@]}"; do
    sudo -u "$POLLER_USER" psql -d "${DB_NAME}" -qAX -c \
        "select cluster, outcome, coalesce(poll_error, '-') as poll_error, observed_at
           from ${table} order by cluster" | sed 's/^/  /'
done

step "What each identity must not be able to do"
failed=0
refuse() {
    local user="$1" what="$2"; shift 2
    if sudo -u "$user" "$@" >/dev/null 2>&1; then
        warn "  FAIL     ${user} ${what}"
        failed=1
    else
        log "  ok       ${user} ${what}"
    fi
}
#
# The rule names one account. Every other identity asking for the same helper
# must be refused by sudo itself, not by the helper being unavailable - so this
# asks as the accounts that exist and would most like to have it.
#
refuse "$WEB_USER" "cannot run the status helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-status-helper
refuse "$WORKER_USER" "cannot run the status helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-status-helper
refuse "$WEB_USER" "cannot run the inventory helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-inventory-helper
refuse "$WORKER_USER" "cannot run the inventory helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-inventory-helper
refuse "$WEB_USER" "cannot run the list helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-list-helper
refuse "$WORKER_USER" "cannot run the list helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-list-helper
refuse "$WEB_USER" "cannot run the backup helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-list-backups-helper
refuse "$WORKER_USER" "cannot run the backup helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-list-backups-helper
refuse "$WEB_USER" "cannot run the certificate helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-cert-list-helper
refuse "$WORKER_USER" "cannot run the certificate helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-cert-list-helper
refuse "$WEB_USER" "cannot run the network helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-network-helper
refuse "$WORKER_USER" "cannot run the network helper" \
    sudo -n /opt/haproxy-mgmt/current/bin/haproxy-network-helper
refuse "$WEB_USER" "has no DNS profile helper grant" \
    sudo -n -l /opt/haproxy-mgmt/current/bin/haproxy-dns-profile-apply-helper
refuse "$POLLER_USER" "has no DNS profile helper grant" \
    sudo -n -l /opt/haproxy-mgmt/current/bin/haproxy-dns-profile-apply-helper
refuse "$WEB_USER" "has no certificate delete grant" \
    sudo -n -l /opt/haproxy-mgmt/current/bin/haproxy-cert-delete-helper
refuse "$POLLER_USER" "has no certificate delete grant" \
    sudo -n -l /opt/haproxy-mgmt/current/bin/haproxy-cert-delete-helper
if [[ -d "${PLATFORM_ROOT}/secrets/dns-profile-keys" ]]; then
    while IFS= read -r key; do
        refuse "$WEB_USER" "cannot read a DNS profile private key" test -r "$key"
        refuse "$WORKER_USER" "cannot read a DNS profile private key" test -r "$key"
        refuse "$POLLER_USER" "cannot read a DNS profile private key" test -r "$key"
    done < <(find "${PLATFORM_ROOT}/secrets/dns-profile-keys" -maxdepth 1 -type f -name '*.key')
fi
refuse "$POLLER_USER" "cannot write a job row" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "insert into job (operation, cluster, payload) values ('deploy', 'alpha', '{}')"
refuse "$WEB_USER" "cannot write the status cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "update cluster_status set outcome = 'done'"
refuse "$WEB_USER" "cannot write the inventory cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "update cluster_inventory set outcome = 'done'"
refuse "$WEB_USER" "cannot write the backup cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "update cluster_backups set outcome = 'done'"
refuse "$WEB_USER" "cannot write the certificate cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "update cluster_certificates set outcome = 'done'"
refuse "$WEB_USER" "cannot write the history cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "update cluster_history set outcome = 'done'"
refuse "$WEB_USER" "cannot write the network cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "update cluster_network set outcome = 'done'"
[[ $failed -eq 0 ]] || die "an identity can do something it must not"

echo
log "platform step 7 done"
log "The worker is running with management writes off, and claims nothing."
