#!/bin/bash
#
# Platform step 7 - the worker and the poller.
#
#     sudo ./07-platform-services <answers-file>
#
# Each runs as its own account, and that is the point of the step. A single
# application user would have made a web intrusion equivalent to deploy rights;
# here the web process can queue a job it cannot perform, the worker can perform
# one it cannot invent, and the poller can read what neither of them may write.
#
# The worker starts with management writes off and is provably unable to act.
# That is stronger than not installing it: it is the state a rollback returns
# to, so it has to be a state that runs.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"

units=("${WORKER_UNIT%.service}" "${POLLER_UNIT%.service}")

link="${UI_ROOT}/current"
[[ -L "$link" ]] || die "${link} does not exist. Install a release first."

step "The poller's one privilege"
#
# Checked by visudo before it is installed, never after. A sudoers file that
# does not parse takes sudo down for everyone on the machine, including the
# operator who would fix it - so it is validated in a temporary file first and
# only then moved into place.
#
sudoers_staging="$(mktemp)"
cat examples/haprion-poller.sudoers.example > "$sudoers_staging"
if ! visudo -cqf "$sudoers_staging"; then
    rm -f "$sudoers_staging"
    die "the rendered sudoers rule does not parse; nothing was installed"
fi
install -o root -g root -m 440 "$sudoers_staging" "/etc/sudoers.d/${POLLER_SUDOERS}"
rm -f "$sudoers_staging"
log "  installed /etc/sudoers.d/${POLLER_SUDOERS}  (visudo accepted it)"

step "The worker's privileges"
#
# Installed here rather than by hand, which is how it was done until 2026-09-03
# and how it fell behind: the file dated from before the objects-publish helper
# existed, so the editor's publish button would have met sudo's refusal on its
# first use. A rule that lives only in an operator's memory drifts from the
# release that needs it.
sudoers_staging="$(mktemp)"
cat examples/haprion-worker.sudoers.example > "$sudoers_staging"
if ! visudo -cqf "$sudoers_staging"; then
    rm -f "$sudoers_staging"
    die "the worker sudoers rule does not parse; nothing was installed"
fi
install -o root -g root -m 440 "$sudoers_staging" "/etc/sudoers.d/${WORKER_SUDOERS}"
rm -f "$sudoers_staging"
log "  installed /etc/sudoers.d/${WORKER_SUDOERS}  (visudo accepted it)"

#
# The block clients' one rule (B412): their account starts the block helper
# and nothing else. Installed whether or not a client is registered - the
# account has no key until one is, so the rule grants nothing before that.
#
sudoers_staging="$(mktemp)"
cat examples/haprion-block.sudoers.example > "$sudoers_staging"
if ! visudo -cqf "$sudoers_staging"; then
    rm -f "$sudoers_staging"
    die "the block clients' sudoers rule does not parse; nothing was installed"
fi
install -o root -g root -m 440 "$sudoers_staging" "/etc/sudoers.d/${BLOCK_SUDOERS}"
rm -f "$sudoers_staging"
log "  installed /etc/sudoers.d/${BLOCK_SUDOERS}  (visudo accepted it)"

step "The web service's way to the probe"
#
# Not a sudoers rule. The web unit carries NoNewPrivileges=yes, an empty
# capability bounding set and RestrictSUIDSGID=yes, so a setuid sudo there does
# not fail for want of a rule - it fails before it reads sudoers, and it fails
# however the rule is written. A rule installed for that account would grant
# nothing and would read as though the web service could escalate.
#
# So the privilege stays still and the request travels: a root-owned socket,
# group this account, answered by a short-lived instance of the helper that
# takes no arguments and does one thing.
#
# On unless the answers file says no: the form's health check is the web
# account's one way to the real nodes, and it asks only what this helper does.
#
if [[ "${PROBE_SOCKET:-no}" == "yes" ]]; then
    install_file "/etc/systemd/system/haprion-probe-helper@.service" root:root 644 \
        "$(cat 'examples/haprion-probe-helper@.service.example')"
    install_file "/etc/systemd/system/haprion-probe-helper.socket" root:root 644 \
        "$(sed "s|WEB_USER|${WEB_USER}|g" examples/haprion-probe-helper.socket.example)"
    systemctl daemon-reload
    systemctl enable --quiet haprion-probe-helper.socket
    systemctl restart haprion-probe-helper.socket
    systemctl is-active --quiet haprion-probe-helper.socket \
        || die "haprion-probe-helper.socket did not start"
    log "  listening on /run/haprion/probe.sock  (group ${WEB_USER})"
else
    log "  skipped: PROBE_SOCKET is not yes, so this platform cannot probe"
fi

step "The web service's way to a name lookup"
#
# A dns object's server may be a name, and the editor and the preview look it
# up as the publish will (B252, B253). The web reaches nothing past localhost,
# so the lookup goes over a socket, group this account, to a helper that runs
# as a dynamic user with the network and nothing else.
#
install_file "/etc/systemd/system/haprion-resolve-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-resolve-helper@.service.example')"
install_file "/etc/systemd/system/haprion-resolve-helper.socket" root:root 644 \
    "$(sed "s|WEB_USER|${WEB_USER}|g" examples/haprion-resolve-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-resolve-helper.socket
systemctl restart haprion-resolve-helper.socket
systemctl is-active --quiet haprion-resolve-helper.socket \
    || die "haprion-resolve-helper.socket did not start"
log "  listening on /run/haprion/resolve.sock  (group ${WEB_USER})"

#
# An NDES server is confirmed from its CA in the interface (B383, B385): the
# web asks over a socket, group this account, and a root helper writes the
# CA and the runtime policy's ndes block.
#
install_file "/etc/systemd/system/haprion-ndes-server-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-ndes-server-helper@.service.example')"
install_file "/etc/systemd/system/haprion-ndes-server-helper.socket" root:root 644 \
    "$(sed "s|WEB_USER|${WEB_USER}|g" examples/haprion-ndes-server-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-ndes-server-helper.socket
systemctl restart haprion-ndes-server-helper.socket
systemctl is-active --quiet haprion-ndes-server-helper.socket \
    || die "haprion-ndes-server-helper.socket did not start"
log "  listening on /run/haprion/ndes-server.sock  (group ${WEB_USER})"

step "The web service's way to an exportable certificate's key"
#
# A certificate made exportable (B255) is downloaded with its key from the
# certificates page. The store is root's and the web cannot read it, so the web
# asks over a socket, group this account, to a root helper that gives out the
# key of an exportable entry and of no other, and writes nothing.
#
install_file "/etc/systemd/system/haprion-cert-export-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-cert-export-helper@.service.example')"
install_file "/etc/systemd/system/haprion-cert-export-helper.socket" root:root 644 \
    "$(sed "s|WEB_USER|${WEB_USER}|g" examples/haprion-cert-export-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-cert-export-helper.socket
systemctl restart haprion-cert-export-helper.socket
systemctl is-active --quiet haprion-cert-export-helper.socket \
    || die "haprion-cert-export-helper.socket did not start"
log "  listening on /run/haprion/cert-export.sock  (group ${WEB_USER})"

step "The worker's way to the receiver helper"
#
# Not a sudoers rule either, for a different reason (B163). The worker can
# sudo, but a helper it starts inherits its ProtectSystem=strict mount
# namespace, and registering a receiver writes /etc: useradd, an sshd drop-in,
# an nginx snippet. So the helper answers on a root-owned socket, group the
# worker's account, from a short-lived unit outside that sandbox. The worker's
# client, haprion-cert-receiver-ask, carries the request there.
#
# Installed wherever the worker is: a platform with a worker has a receivers
# page, and a page whose job fails with "not installed" is worse than one that
# works. Nothing here reaches the nodes.
#
install_file "/etc/systemd/system/haprion-cert-receiver-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-cert-receiver-helper@.service.example')"
install_file "/etc/systemd/system/haprion-cert-receiver-helper.socket" root:root 644 \
    "$(sed "s|WORKER_USER|${WORKER_USER}|g" examples/haprion-cert-receiver-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-cert-receiver-helper.socket
systemctl restart haprion-cert-receiver-helper.socket
systemctl is-active --quiet haprion-cert-receiver-helper.socket \
    || die "haprion-cert-receiver-helper.socket did not start"
log "  listening on /run/haprion/cert-receiver.sock  (group ${WORKER_USER})"

step "The worker's way to the node helper"
#
# The same reason as the receiver helper (B163, B211): adding or removing a
# node writes root's known_hosts, the pull accounts' authorized_keys, the
# cluster file and the traffic collector's files, none of which a helper the
# worker starts through sudo may write. So it answers on a root-owned socket,
# group the worker's account; haprion-node-ask carries the request there.
#
install_file "/etc/systemd/system/haprion-node-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-node-helper@.service.example')"
install_file "/etc/systemd/system/haprion-node-helper.socket" root:root 644 \
    "$(sed "s|WORKER_USER|${WORKER_USER}|g" examples/haprion-node-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-node-helper.socket
systemctl restart haprion-node-helper.socket
systemctl is-active --quiet haprion-node-helper.socket \
    || die "haprion-node-helper.socket did not start"
log "  listening on /run/haprion/cluster-node.sock  (group ${WORKER_USER})"

step "The worker's way to the interface certificate"
#
# The same reason as the receiver helper (B163, B188): the certificate helpers
# the worker starts through sudo run inside its ProtectSystem=strict namespace,
# and haprion-tls writes /etc/haprion/tls. So the last step of
# publishing the interface certificate - naming it by ID - is asked of a root
# unit on its own socket. The renewal timer installs directly.
#
install_file "/etc/systemd/system/haprion-tls-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-tls-helper@.service.example')"
install_file "/etc/systemd/system/haprion-tls-helper.socket" root:root 644 \
    "$(sed "s|WORKER_USER|${WORKER_USER}|g" examples/haprion-tls-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-tls-helper.socket
systemctl restart haprion-tls-helper.socket
systemctl is-active --quiet haprion-tls-helper.socket \
    || die "haprion-tls-helper.socket did not start"
log "  listening on /run/haprion/ui-tls.sock  (group ${WORKER_USER})"

step "The worker's way to backup jobs"
install_file "/etc/systemd/system/haprion-backup-job-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-backup-job-helper@.service.example')"
install_file "/etc/systemd/system/haprion-backup-job-helper.socket" root:root 644 \
    "$(sed "s|WORKER_USER|${WORKER_USER}|g" examples/haprion-backup-job-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-backup-job-helper.socket
systemctl restart haprion-backup-job-helper.socket
systemctl is-active --quiet haprion-backup-job-helper.socket \
    || die "haprion-backup-job-helper.socket did not start"
log "  listening on /run/haprion/backup-job.sock  (group ${WORKER_USER})"

step "The worker's way to node restore jobs"
#
# Same shape as the backup socket and for the same reason: a restore writes
# under /var/lib and reaches its target as root over SSH, and a helper the
# worker started through sudo would run inside the worker's read-only mounts.
#
install_file "/etc/systemd/system/haprion-node-restore-helper@.service" root:root 644 \
    "$(cat 'examples/haprion-node-restore-helper@.service.example')"
install_file "/etc/systemd/system/haprion-node-restore-helper.socket" root:root 644 \
    "$(sed "s|WORKER_USER|${WORKER_USER}|g" examples/haprion-node-restore-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-node-restore-helper.socket
systemctl restart haprion-node-restore-helper.socket
systemctl is-active --quiet haprion-node-restore-helper.socket \
    || die "haprion-node-restore-helper.socket did not start"
log "  listening on /run/haprion/node-restore.sock  (group ${WORKER_USER})"

#
# A rule from before the socket existed is worse than no rule: it cannot work,
# and it says in /etc/sudoers.d that this account may become root.
#
if [[ -f "/etc/sudoers.d/${WEB_USER}" ]]; then
    rm -f "/etc/sudoers.d/${WEB_USER}"
    log "  removed /etc/sudoers.d/${WEB_USER}  (a sudo rule this account cannot use)"
fi

#
# Taken before anything is restarted, and read from the database rather than
# from this machine's clock, so the comparison below cannot be thrown off by
# the two disagreeing.
#
started_at="$(sudo -u "$POLLER_USER" psql -d "${DB_NAME}" -qtAX \
    -c "select statement_timestamp()")"

step "Directories the worker's sandbox opens"
ensure_worker_directories

step "Units"
policy_paths="$(worker_writable_paths)" \
    || die "cannot read the runtime policy's roots for the worker's sandbox"
[[ -n "$policy_paths" ]] || die "the runtime policy names no roots for the worker's sandbox"
install_file "/etc/systemd/system/${WORKER_UNIT}" root:root 644 \
    "$(sed -e "s|@POLICY_PATHS@|${policy_paths}|" examples/haprion-worker.service.example)"
install_file "/etc/systemd/system/${POLLER_UNIT}" root:root 644 \
    "$(cat examples/haprion-poller.service.example)"
systemctl daemon-reload
log "  reloaded systemd"

step "Starting"
#
# Restarted, not merely enabled. `enable --now` starts a unit that is stopped
# and does nothing to one that is already running - so a rerun after changing a
# unit file leaves the old settings in place while reporting success, which is
# how a sandbox fix can look like it did not work.
#
systemctl enable --quiet "$WORKER_UNIT" "$POLLER_UNIT"
restart_units "$WORKER_UNIT" "$POLLER_UNIT"
for unit in "${units[@]}"; do
    systemctl is-active --quiet "${unit}.service" \
        || { systemctl status --no-pager --lines=20 "${unit}.service" || true;
             die "${unit}.service did not start"; }
    log "  started  ${unit}.service"
done

#
# The poller needs a moment to take the lock, run the helper and write a row.
# Waited for rather than assumed: a unit that is active has started, which is
# not the same as having done its job once.
#
#
# Counted from a moment captured before the restart, not simply "are there any
# rows". A row from an earlier run would let this pass forever on stale data -
# which is precisely how a poller that has stopped working looks like one that
# is fine.
#
#
# Listed once, and every cache the poller writes belongs here. A table added to
# the poller without being added to this list is one nobody proves was written,
# and an empty cache looks exactly like a view that has no data yet.
#
CACHES=(
    cluster_status
    cluster_inventory
    cluster_history
    cluster_backups
    cluster_certificates
    cluster_network
)

fresh_rows() {
    sudo -u "$POLLER_USER" psql -d "${DB_NAME}" -qtAX -c \
        "select count(*) from ${1} where observed_at > '${started_at}'" \
        2>/dev/null || echo 0
}
#
# The cached reads are per cluster, so an installation with none yet (B302)
# has none to prove; what proves the poller then is the list it records on
# every pass - empty, and newer than the restart.
#
if [[ -z "$(installed_clusters)" ]]; then
    step "Proving the poller runs, with no cluster yet"
    recorded=0
    for _ in $(seq 30); do
        recorded="$(sudo -u "$POLLER_USER" psql -d "${DB_NAME}" -qtAX -c \
            "select count(*) from cluster_list where observed_at > '${started_at}' and clusters = '[]'" \
            2>/dev/null || echo 0)"
        [[ "$recorded" -gt 0 ]] && break
        sleep 1
    done
    [[ "$recorded" -gt 0 ]] \
        || fail "the poller recorded no pass within 30 seconds" "$(unit_failure "$POLLER_UNIT")" \
                "the poller's whole journal: journalctl -u ${POLLER_UNIT} -n 50"
    log "  ok       the poller passes, and records that there is no cluster yet"
else
    step "Proving the poller cached every read it makes"
    all_cached=0
    for _ in $(seq 30); do
        all_cached=1
        for table in "${CACHES[@]}"; do
            [[ "$(fresh_rows "$table")" -gt 0 ]] || all_cached=0
        done
        [[ "$all_cached" -eq 1 ]] && break
        sleep 1
    done
    [[ "$all_cached" -eq 1 ]] \
        || fail "the poller wrote no fresh rows for every cached read within 30 seconds" \
                "$(unit_failure "$POLLER_UNIT")" \
                "the poller's whole journal: journalctl -u ${POLLER_UNIT} -n 50"
    for table in "${CACHES[@]}"; do
        sudo -u "$POLLER_USER" psql -d "${DB_NAME}" -qAX -c \
            "select cluster, outcome, coalesce(poll_error, '-') as poll_error, observed_at
               from ${table} order by cluster" | sed 's/^/  /'
    done
fi

step "What each identity must not be able to do"
failed=0
refuse() {
    local user="$1" what="$2"; shift 2
    if sudo -u "$user" "$@" >/dev/null 2>&1; then
        warn "  FAIL     ${user} ${what}"
        failed=1
    else
        log "  ok       ${user} ${what}"
    fi
}
#
# A rule names one account. Every other identity asking for the same helper
# must be refused by sudo itself - so each helper either file grants is asked
# for by every other service account, with `sudo -n -l`, which answers from
# the rules and runs nothing. Asked without -l, sudo's refusal and a helper
# that ran as root and refused an empty request both exit non-zero, so those
# checks could not fail; and they named 4 of the worker's 14 rules (review
# 26-10-24, 08-01).
#
refuse_granted_elsewhere() {
    local file="$1" owner="$2" helper user count=0
    while read -r helper; do
        count=$((count + 1))
        for user in "$WEB_USER" "$WORKER_USER" "$POLLER_USER"; do
            [[ "$user" != "$owner" ]] || continue
            refuse "$user" "has no grant for $(basename "$helper")" sudo -n -l "$helper"
        done
    done < <(awk -v owner="$owner" '$1 == owner && / NOPASSWD: / { print $(NF - 1) }' "$file")
    if (( count == 0 )); then
        warn "  FAIL     no ${owner} rule could be read in ${file}"
        failed=1
    fi
}
refuse_granted_elsewhere "/etc/sudoers.d/${POLLER_SUDOERS}" "$POLLER_USER"
refuse_granted_elsewhere "/etc/sudoers.d/${WORKER_SUDOERS}" "$WORKER_USER"
refuse "$WEB_USER" "has no DNS profile helper grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-dns-profile-apply-helper
refuse "$POLLER_USER" "has no DNS profile helper grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-dns-profile-apply-helper
refuse "$WEB_USER" "has no NDES profile helper grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-ndes-profile-apply-helper
refuse "$POLLER_USER" "has no NDES profile helper grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-ndes-profile-apply-helper
refuse "$WEB_USER" "has no NDES enrollment helper grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-cert-scep-helper
refuse "$POLLER_USER" "has no NDES enrollment helper grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-cert-scep-helper
refuse "$WEB_USER" "has no certificate delete grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-cert-delete-helper
refuse "$POLLER_USER" "has no certificate delete grant" \
    sudo -n -l /opt/haprion/current/bin/haprion-cert-delete-helper
if [[ -d "${UI_SECRETS}/dns-profile-keys" ]]; then
    while IFS= read -r key; do
        refuse "$WEB_USER" "cannot read a DNS profile private key" test -r "$key"
        refuse "$WORKER_USER" "cannot read a DNS profile private key" test -r "$key"
        refuse "$POLLER_USER" "cannot read a DNS profile private key" test -r "$key"
    done < <(find "${UI_SECRETS}/dns-profile-keys" -maxdepth 1 -type f -name '*.key')
fi
#
# Each write inside a transaction that is rolled back, as 03-verify asks: a
# grant that is wrong lets the write through, and it must not then stay - a
# real deploy job for a cluster, or every cache row marked done (review
# 26-10-24, 03-07).
#
refuse "$POLLER_USER" "cannot write a job row" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "begin; insert into job (operation, cluster, payload) values ('deploy', 'alpha', '{}'); rollback"
refuse "$WEB_USER" "cannot write the status cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "begin; update cluster_status set outcome = 'done'; rollback"
refuse "$WEB_USER" "cannot write the inventory cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "begin; update cluster_inventory set outcome = 'done'; rollback"
refuse "$WEB_USER" "cannot write the backup cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "begin; update cluster_backups set outcome = 'done'; rollback"
refuse "$WEB_USER" "cannot write the certificate cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "begin; update cluster_certificates set outcome = 'done'; rollback"
refuse "$WEB_USER" "cannot write the history cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "begin; update cluster_history set outcome = 'done'; rollback"
refuse "$WEB_USER" "cannot write the network cache" \
    psql -d "${DB_NAME}" -qtAX -v ON_ERROR_STOP=1 \
    -c "begin; update cluster_network set outcome = 'done'; rollback"
[[ $failed -eq 0 ]] || die "an identity can do something it must not"

echo
log "platform step 7 done"
log "The worker is running with management writes off, and claims nothing."
