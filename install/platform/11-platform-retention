#!/bin/bash
#
# Platform step 11 - keep the database bounded, and its partitions ahead.
#
#     sudo ./11-platform-retention <answers-file>
#
# Installs haprion-retention, a daily timer and an hourly one for the traffic
# partitions' space budget. Required: the metric, traffic
# and WAF tables are partitioned by day with no default partition, and this is
# what creates the days ahead - without it the poller's samples have nowhere to
# go and the WAF matches are dropped (review 2026-10-22, 3-2). Separate from
# the backup step on purpose: this removes rows from a live table, which is a
# different kind of action from writing a dump.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
require_vars DB_NAME

config="/etc/haprion/ui-admin.conf"
[[ -r "$config" ]] || die "${config} is missing. Run ./02-platform-database first."
#
# Read out of the admin config rather than out of the answers file, because that
# is where the command itself reads it: a check that consulted a second source
# could pass while the command talks to something else.
#
DB_ROLE="$(admin_value "$config" DB_ROLE)"
[[ -n "$DB_ROLE" ]] || die "DB_ROLE is not in ${config}"

step "The command"
[[ -x /usr/sbin/haprion-retention ]] || die "/usr/sbin/haprion-retention is missing; install the haprion-ui package"
log "  ok       /usr/sbin/haprion-retention"

step "Timer"
unit="haprion-retention"
#
# Two timers: the nightly pruning and rollup, and the hourly space budget for
# the traffic and WAF partitions.
#
for timer in haprion-retention haprion-retention-budget; do
    for kind in service timer; do
        install_file "/etc/systemd/system/${timer}.${kind}" root:root 644 \
            "$(cat "examples/${timer}.${kind}.example")"
    done
done
systemctl daemon-reload
log "  reloaded systemd"
systemctl enable --quiet --now "${unit}.timer" haprion-retention-budget.timer
log "  enabled  daily pruning and rollup, and the hourly space budget"

#
# Asked of the running system rather than assumed from a clean enable. A timer
# that is enabled but whose next run is never is retention that will not happen.
#
systemctl list-timers --no-pager --no-legend "${unit}.timer" haprion-retention-budget.timer | sed 's/^/  /'

step "The partitions ahead"
#
# Made now rather than at the first nightly run: until then there is no
# partition for a metric sample, and nothing is deleted by this.
#
/usr/sbin/haprion-retention horizon

step "What the first run will remove"
#
# Reported, not done. This is the one step that deletes rows from a live table,
# and an installation that deletes on the way past gives nobody the chance to
# disagree with the number. The timer does the first real prune, or an operator
# does it deliberately - which is also the honest reading of a dry run: it means
# something, or it is decoration.
#
/usr/sbin/haprion-retention prune --dry-run
/usr/sbin/haprion-retention budget --dry-run

step "What must not be able to do this"
#
# The boundary the command rests on, checked rather than described. If an
# application identity can reach the database as the owning role, nothing about
# `delete` being ungranted matters.
#
failed=0
for user in "${WEB_USER:-}" "${WORKER_USER:-}" "${POLLER_USER:-}"; do
    [[ -n "$user" ]] || continue
    if sudo -u "$user" psql -U "$DB_ROLE" -d "$DB_NAME" -qtAX -c 'select 1' >/dev/null 2>&1; then
        warn "  FAIL     ${user} can connect as the owning role"
        failed=1
    else
        log "  ok       ${user} cannot connect as the owning role"
    fi
done
[[ $failed -eq 0 ]] || die "an application identity can reach the database as its owner"

step "Done"
log "  ${unit}.timer runs daily: prunes finished jobs older than a week, keeping the 20 most recent,"
log "           rolls up metric hours, and rotates traffic-log partitions at the configured retention"
log "  haprion-retention-budget.timer runs hourly: drops the oldest traffic days only while they hold"
log "           more than a quarter of the database's volume or leave less than a tenth of it free"
log "  nothing has been deleted yet; run it now with:"
log "    sudo haprion-retention prune"
