#!/bin/bash
# TLS receiver, fixed source mapping, retention and read-only web access.
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
require_vars PLATFORM_ROOT WEB_USER WORKER_USER POLLER_USER SERVER_NAME
ENVIRONMENT="${ENVIRONMENT:-prod}"
[[ "$ENVIRONMENT" == "prod" ]] || die "traffic-log receiver is production-only"
TRAFFIC_LOG_PORT="${TRAFFIC_LOG_PORT:-6514}"
if [[ ! "$TRAFFIC_LOG_PORT" =~ ^[0-9]+$ ]] \
    || (( TRAFFIC_LOG_PORT < 1 || TRAFFIC_LOG_PORT > 65535 )); then
    die "TRAFFIC_LOG_PORT must be an integer between 1 and 65535"
fi
[[ "$SERVER_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]] \
    || die "SERVER_NAME is not a valid certificate DNS name"
command -v rsyslogd >/dev/null || die "rsyslog is not installed"
command -v openssl >/dev/null || die "openssl is not installed"
getent group syslog >/dev/null || die "the rsyslog service group 'syslog' is missing"
find /usr/lib -name lmnsd_gtls.so -print -quit 2>/dev/null | grep -q . \
    || die "the rsyslog GnuTLS driver is missing; install rsyslog-gnutls"

engine_release="$(readlink -f /opt/haproxy-mgmt/current)"
[[ -d "${engine_release}/lib" ]] || die "the installed CLI release is missing"
mapfile -d '' -t inventory < <(/usr/bin/python3 -I - "${engine_release}/lib" <<'PY'
import sys

sys.path.insert(0, sys.argv[1])
from haproxy_mgmt.config import load_policy, load_runtime_config

policy = load_policy()
config = load_runtime_config(policy)
print(policy.publish_root, end="\0")
for cluster_id, cluster in config.clusters.items():
    for node in cluster.nodes:
        print(cluster_id, node.name, node.mgmt_host, sep="\t", end="\0")
PY
)
[[ ${#inventory[@]} -gt 1 ]] || die "the installed CLI configuration contains no nodes"
PUBLISH_ROOT="${inventory[0]}"
PULL_USER="$(stat -c %G "$PUBLISH_ROOT")"
[[ "$PULL_USER" != root ]] || die "the publish root has no dedicated read group"

tls=/etc/haproxy-manager/traffic-log-tls
ca_cert="${tls}/ca.crt"
ca_key="${tls}/ca.key"
server_cert="${tls}/server.crt"
server_key="${tls}/server.key"
published_dir="${PUBLISH_ROOT}/.haproxy-manager"
published_ca="${published_dir}/traffic-log-ca.pem"

step "TLS identity"
ensure_dir /etc/haproxy-manager root:root 755
ensure_dir "$tls" root:syslog 750
ensure_dir "$published_dir" "root:${PULL_USER}" 750
install_file /etc/haproxy-manager/traffic-log-tls.conf root:root 600 "$(cat <<EOF
CA_CERT=${ca_cert}
CA_KEY=${ca_key}
SERVER_CERT=${server_cert}
SERVER_KEY=${server_key}
SERVER_NAME=${SERVER_NAME}
PUBLISHED_CA=${published_ca}
PULL_USER=${PULL_USER}
RSYSLOG_GROUP=syslog
EOF
)"
install -o root -g root -m 755 bin/haproxy-traffic-log-tls /usr/local/sbin/haproxy-traffic-log-tls
/usr/local/sbin/haproxy-traffic-log-tls init

step "Source identities"
rules=""
senders=""
declare -A seen=()
for entry in "${inventory[@]:1}"; do
        IFS=$'\t' read -r cluster name host <<<"$entry"
        valid_id "$name" || die "invalid node name: ${name}"
        mapfile -t addresses < <(getent ahostsv4 "$host" | awk '{print $1}' | sort -u)
        [[ ${#addresses[@]} -eq 1 ]] || die "${host} must resolve to exactly one IPv4 management address"
        address="${addresses[0]}"
        [[ -z "${seen[$address]:-}" ]] || die "${address} maps to both ${seen[$address]} and ${cluster}/${name}"
        seen[$address]="${cluster}/${name}"
        senders+="${address},"
        rules+="if (\$fromhost-ip == \"${address}\" and \$programname == \"haproxy\") then { action(type=\"omfile\" file=\"${PLATFORM_ROOT}/data/logs/${cluster}--${name}.jsonl\" template=\"haproxy-manager-json\" fileOwner=\"root\" fileGroup=\"${WEB_USER}\" fileCreateMode=\"0640\" dirCreateMode=\"0750\") stop }\n"
done
senders="${senders%,}"

step "Receiver and files"
ensure_dir "${PLATFORM_ROOT}/data/logs" "root:${WEB_USER}" 750
receiver="global(DefaultNetstreamDriver=\"gtls\"
       DefaultNetstreamDriverCAFile=\"${ca_cert}\"
       DefaultNetstreamDriverCertFile=\"${server_cert}\"
       DefaultNetstreamDriverKeyFile=\"${server_key}\")
module(load=\"imtcp\")
\$AllowedSender TCP, ${senders}
template(name=\"haproxy-manager-json\" type=\"string\" string=\"%msg%\\n\")
ruleset(name=\"haproxy-manager-traffic\") {
$(printf '%b' "$rules")    stop
}
input(type=\"imtcp\" port=\"${TRAFFIC_LOG_PORT}\" ruleset=\"haproxy-manager-traffic\"
      StreamDriver.Name=\"gtls\" StreamDriver.Mode=\"1\" StreamDriver.AuthMode=\"anon\")"
install_file /etc/rsyslog.d/50-haproxy-manager-receiver.conf root:root 640 "$receiver"

apparmor="# Read only the receiver identity; the private CA key is deliberately absent.
/etc/haproxy-manager/traffic-log-tls/ r,
/etc/haproxy-manager/traffic-log-tls/ca.crt r,
/etc/haproxy-manager/traffic-log-tls/server.crt r,
/etc/haproxy-manager/traffic-log-tls/server.key r,
${PLATFORM_ROOT}/data/logs/ rw,
${PLATFORM_ROOT}/data/logs/*.jsonl rwk,"
if [[ -d /etc/apparmor.d/rsyslog.d ]]; then
    install_file /etc/apparmor.d/rsyslog.d/haproxy-manager-traffic root:root 644 "$apparmor"
    [[ ! -x /usr/lib/rsyslog/reload-apparmor-profile ]] \
        || /usr/lib/rsyslog/reload-apparmor-profile
fi

rotation="${PLATFORM_ROOT}/data/logs/*.jsonl {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    su root ${WEB_USER}
    create 0640 root ${WEB_USER}
    postrotate
        /bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}"
install_file /etc/logrotate.d/haproxy-manager-traffic root:root 644 "$rotation"
rsyslogd -N1
systemctl restart rsyslog
systemctl is-active --quiet rsyslog || die "rsyslog did not restart"

step "Web configuration"
config="${PLATFORM_ROOT}/config/ui.toml"
[[ -f "$config" ]] || die "${config} is missing; run 01-platform-prepare first"
section="$(sed -n '/^\[traffic_logs\]$/,/^\[/p' "$config")"
disabled_count="$(grep -c '^enabled = false$' <<<"$section" || true)"
enabled_count="$(grep -c '^enabled = true$' <<<"$section" || true)"
if [[ "$disabled_count" == 1 && "$enabled_count" == 0 ]]; then
    sed -i '/^\[traffic_logs\]$/,/^\[/ s/^enabled = false$/enabled = true/' "$config"
    log "  enabled  traffic_logs"
elif [[ "$enabled_count" == 1 && "$disabled_count" == 0 ]]; then
    log "  ok       traffic_logs already enabled"
else
    die "enable [traffic_logs] explicitly in ${config}; its current shape was not rewritten"
fi
chown "root:$(stat -c %G "$config")" "$config"
chmod 640 "$config"
systemctl restart "${WEB_USER}.service"
sudo -u "$WEB_USER" test -r "${PLATFORM_ROOT}/data/logs" || die "web identity cannot read the log directory"
sudo -u "$WORKER_USER" test ! -r "${PLATFORM_ROOT}/data/logs" \
    || die "worker identity can read the traffic-log directory"
sudo -u "$POLLER_USER" test ! -r "${PLATFORM_ROOT}/data/logs" \
    || die "poller identity can read the traffic-log directory"

echo
log "platform traffic logging installed on TCP ${TRAFFIC_LOG_PORT}"
echo "Next, on each node after updating its node bundle:"
echo "  sudo haproxy-traffic-log-trust"
