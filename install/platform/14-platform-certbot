#!/bin/bash
#
# Platform step 14 - the locked certbot environment and its renewal timer.
#
#     sudo ./14-platform-certbot [answers-file|-] [source-tree]
#     sudo UV_BIN=/path/to/uv ./14-platform-certbot [answers-file|-] [source-tree]
#
# Makes the release the haprion-certbot package carries current - certbot and
# every DNS plugin the product offers, built from certbot/uv.lock - or, with
# UV_BIN, builds one from the source tree's lock into an immutable release
# under /opt/haprion-certbot;
# proves it against this host's lineages with a dry-run renewal; and moves
# renewal from the distribution's timer to one that runs the release. Rerun it
# with a newer lock to upgrade: the same gate, and the previous release is
# restored if it fails.
#
# One certbot owns /etc/letsencrypt. `renew` walks every lineage and fails on
# one whose plugin it cannot load, so a lineage issued through a plugin only the
# release carries cannot be renewed by the distribution's certbot - which is why
# that timer is masked here, not merely left disabled.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
require_vars WORKER_USER
#
# The tree this step came in: the package's /usr/share/haprion-ui, or a
# source checkout, unless another is named.
#
source_tree="$(caller_path "${2:-}")"
[[ -n "${2:-}" ]] || source_tree="$(cd ../.. && pwd)"
[[ -d "$source_tree" ]] || die "usage: $0 [answers-file|-] [source-tree]"
source_tree="$(cd "$source_tree" && pwd)"
uv="${UV_BIN:-}"
[[ -z "$uv" || -x "$uv" ]] || die "UV_BIN names ${uv}, which is not an executable"
#
# What the haprion-certbot package unpacked (B322, 26-10-17): the release to
# make current when no uv is named to build one.
#
PAYLOAD="/usr/lib/haprion/certbot/PAYLOAD"

TARGET="/opt/haprion-certbot"
CERTBOT="${TARGET}/current/venv/bin/certbot"
POLICY="/etc/haprion/runtime-policy.yaml"
UNIT="haprion-certbot-renew"

if [[ -n "$uv" ]]; then
    [[ -f "${source_tree}/certbot/uv.lock" ]] \
        || die "${source_tree}/certbot/uv.lock is missing; this is not a source tree with the certbot environment"
    [[ -f "${source_tree}/tools/install-certbot-env.py" ]] \
        || die "${source_tree}/tools/install-certbot-env.py is missing"
else
    [[ -r "$PAYLOAD" ]] \
        || die "the haprion-certbot package is not installed; install it, or set UV_BIN to build from the lock"
fi

step "The worker's sandbox"
#
# The issue helper runs certbot inside the worker's mount namespace, and the
# unit opens certbot's three directories, the publisher's target and the
# registry's directory for it.
# Checked before anything is built: a unit without them makes every issuance
# fail on certbot's log lock, and step 07 is what installs the unit.
#
worker_unit_file="/etc/systemd/system/${WORKER_UNIT}"
[[ -f "$worker_unit_file" ]] || die "${worker_unit_file} is missing; run 07-platform-services first"
policy_paths="$(worker_writable_paths)" \
    || die "cannot read the runtime policy's roots for the worker's sandbox"
# shellcheck disable=SC2086 # one path per word, as the unit lists them
for path in /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt $policy_paths /etc/haprion/dns-profiles; do
    grep -Eq "^ReadWritePaths=(.* )?${path}( .*)?$" "$worker_unit_file" \
        || die "${worker_unit_file} does not open ${path}; rerun 07-platform-services with this source tree"
done
log "  ok       ${worker_unit_file} opens certbot's directories"

previous="$(readlink "${TARGET}/current" 2>/dev/null || true)"
if [[ -n "$uv" ]]; then
    step "Building the environment"
    /usr/bin/python3 "${source_tree}/tools/install-certbot-env.py" \
        --project "${source_tree}/certbot" --uv "$uv" --target "$TARGET"
else
    step "The packaged environment"
    # shellcheck source=/dev/null
    RELEASE_ID="$(. "$PAYLOAD" && echo "$RELEASE_ID")"
    [[ "$RELEASE_ID" =~ ^[A-Za-z0-9.+_-]+$ && -d "${TARGET}/releases/${RELEASE_ID}" ]] \
        || die "the package's release ${RELEASE_ID} is not unpacked; reinstall haprion-certbot"
    ln -sfn "releases/${RELEASE_ID}" "${TARGET}/.current.$$"
    mv -T "${TARGET}/.current.$$" "${TARGET}/current"
    log "  ok       ${RELEASE_ID} from the package"
fi
release="$(readlink "${TARGET}/current")"

restore_previous() {
    if [[ -z "$previous" || "$previous" == "$release" ]]; then
        warn "no previous certbot environment to restore"
        return 0
    fi
    warn "restoring certbot environment ${previous##*/}"
    ln -sfn "$previous" "${TARGET}/.current.$$"
    mv -T "${TARGET}/.current.$$" "${TARGET}/current"
}

step "Proving it against this host's lineages"
#
# A dry run renews every lineage against Let's Encrypt's staging server with
# the release's certbot and plugins, and runs the deploy hook - which publishes
# nothing, because no certificate changed. The one gate a certbot upgrade has.
#
if ! /opt/haprion/current/bin/haprion-cert-renew \
    --certbot "$CERTBOT" --dry-run --run-deploy-hooks; then
    restore_previous
    if [[ -n "$previous" && "$previous" != "$release" ]]; then
        die "the dry-run renewal failed with ${release##*/}; the previous environment is current again"
    fi
    die "the dry-run renewal failed with ${release##*/}"
fi
if compgen -G "/etc/letsencrypt/renewal/*.conf" >/dev/null; then
    log "  ok       renew --dry-run --run-deploy-hooks with ${release##*/}"
else
    log "  ok       no certificates from Let's Encrypt yet; nothing to renew"
fi

step "Renewal timer"
install_file "/etc/systemd/system/${UNIT}.service" root:root 644 \
    "$(cat "examples/${UNIT}.service.example")"
install_file "/etc/systemd/system/${UNIT}.timer" root:root 644 \
    "$(cat "examples/${UNIT}.timer.example")"
systemctl daemon-reload
if systemctl list-unit-files certbot.timer --no-legend 2>/dev/null | grep -q .; then
    if [[ "$(systemctl is-enabled certbot.timer 2>/dev/null || true)" != "masked" ]]; then
        systemctl disable --now --quiet certbot.timer 2>/dev/null || true
        systemctl mask --quiet certbot.timer
        log "  masked   certbot.timer (the distribution's)"
    else
        log "  ok       certbot.timer is masked"
    fi
fi
systemctl enable --now --quiet "${UNIT}.timer"
systemctl is-active --quiet "${UNIT}.timer" || die "${UNIT}.timer is not active"
log "  active   ${UNIT}.timer"

step "The runtime policy"
#
# Not edited here: the policy is the operator's file. Until it names this
# certbot, the issue helper keeps using the distribution's - which works, and
# offers the distribution's plugins and nothing more.
#
if grep -Eq "^\s*certbot:\s*${CERTBOT}\s*$" "$POLICY" 2>/dev/null; then
    log "  ok       ${POLICY} names ${CERTBOT}"
else
    warn "${POLICY} does not name the release's certbot. Add, under acme:"
    warn "    certbot: ${CERTBOT}"
fi

echo
log "certbot environment ${release##*/} is current"
[[ -n "$previous" && "$previous" != "$release" ]] \
    && log "  rollback  ln -sfn ${previous} ${TARGET}/current  (then rerun the dry run)"
log "  plugins   $(python3 -c "import json;print(len(json.load(open('${TARGET}/current/INSTALLATION.json'))['plugins']))")"
