#!/bin/bash
#
# Platform step 17 - the OIDC helper: its key pair, its directory and its socket.
#
#     sudo ./17-platform-oidc [answers-file|-] [source-tree]
#
# Sign-in through an OpenID Connect provider (Fas 13 part 4, B195-B199) needs
# the provider, and the web service must not reach the network. So the requests
# go through /run/haprion/oidc.sock to haprion-oidc-helper, which runs as an
# account of its own - the identity policy's `oidc` role, OIDC_USER here - and
# is the one holder of the key that opens the client secret the web sealed.
#
# This step makes:
#
#   /etc/haprion/oidc/<key id>.key    OIDC_USER, 0600 (directory 0500)
#   /etc/haprion/oidc-keys/<id>.pub    root:PLATFORM_GROUP, 0640
#   haprion-oidc-helper.socket and @.service  the socket group is WEB_USER
#
# An installation that already has a pair keeps it; ROTATE=1 adds a second one
# beside it, and the client secret is then saved again under the new key.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh
need_root
load_answers "${1:-}"
#
# The tree this step came in: the package's /usr/share/haprion-ui, or a
# source checkout, unless another is named.
#
source_tree="${2:-$(cd ../.. && pwd)}"
[[ -d "$source_tree" ]] || die "usage: $0 [answers-file|-] [source-tree]"
source_tree="$(cd "$source_tree" && pwd)"
tool="${source_tree}/tools/dns-profile-keys.py"
[[ -f "$tool" ]] || die "${tool} is missing; this is not a source tree with the key tool"

id -u "$OIDC_USER" >/dev/null 2>&1 \
    || die "service account ${OIDC_USER} does not exist. Run ../01-manager-prepare
  first; it applies sysusers/haprion.conf."

KEY_DIR="/etc/haprion/oidc"
PUBLIC_DIR="/etc/haprion/oidc-keys"
BINARY="/opt/haprion/current/bin/haprion-oidc-helper"

step "The helper"
[[ -x "$BINARY" ]] \
    || die "${BINARY} is missing; install a CLI release that carries haprion-oidc-helper first"
log "  ok       ${BINARY}"

step "The interpreter"
if /usr/bin/python3 -I -c 'import nacl.public' 2>/dev/null; then
    log "  ok       /usr/bin/python3 imports nacl"
else
    die "/usr/bin/python3 cannot import nacl; install the distribution's package: apt install python3-nacl"
fi

step "Directories"
[[ -f "$UI_CONFIG" ]] || die "${UI_CONFIG} is missing; run 01-platform-prepare first"
ensure_dir "$PUBLIC_DIR" "root:${PLATFORM_GROUP}" 750
#
# Root's while the pair is written, the helper's afterwards: the key tool
# writes as root, and the helper refuses a key that is not its account's alone.
#
if [[ ! -d "$KEY_DIR" ]]; then
    install -d -o root -g root -m 700 "$KEY_DIR"
    log "  created  ${KEY_DIR}"
fi

step "The key pair"
existing=()
while IFS= read -r file; do
    [[ -n "$file" ]] && existing+=("$file")
done < <(find "$KEY_DIR" -maxdepth 1 -name '*.key' -type f | sort)

if (( ${#existing[@]} > 0 )) && [[ "${ROTATE:-0}" != "1" ]]; then
    for file in "${existing[@]}"; do
        key_id="$(basename "$file" .key)"
        [[ -f "${PUBLIC_DIR}/${key_id}.pub" ]] \
            || die "${file} has no public half at ${PUBLIC_DIR}/${key_id}.pub"
        log "  ok       ${key_id}"
    done
    log "  kept     ${#existing[@]} pair(s); run with ROTATE=1 to add a new one"
else
    chown root:root "$KEY_DIR"
    chmod 700 "$KEY_DIR"
    key_id="$(/usr/bin/python3 -I "$tool" create \
        --private "$KEY_DIR" --public "$PUBLIC_DIR" --group "$PLATFORM_GROUP")"
    log "  created  ${key_id}"
fi

for file in "$KEY_DIR"/*.key; do
    chown "${OIDC_USER}:${OIDC_USER}" "$file"
    chmod 600 "$file"
done
chown "${OIDC_USER}:${OIDC_USER}" "$KEY_DIR"
chmod 500 "$KEY_DIR"
log "  ok       ${KEY_DIR}  (${OIDC_USER}, 0500; keys 0600)"

step "The socket"
install_file /etc/systemd/system/haprion-oidc-helper@.service root:root 644 \
    "$(sed "s|OIDC_USER|${OIDC_USER}|g" 'examples/haprion-oidc-helper@.service.example')"
install_file /etc/systemd/system/haprion-oidc-helper.socket root:root 644 \
    "$(sed "s|WEB_USER|${WEB_USER}|g" examples/haprion-oidc-helper.socket.example)"
systemctl daemon-reload
systemctl enable --quiet haprion-oidc-helper.socket
systemctl restart haprion-oidc-helper.socket
systemctl is-active --quiet haprion-oidc-helper.socket \
    || die "haprion-oidc-helper.socket did not start"
log "  listening on /run/haprion/oidc.sock  (group ${WEB_USER})"

step "The web's half"
#
# What the web seals the client secret against: the newest pair. Added to
# ui.toml only when it names none, as its own table at the end, the way step
# 15 adds the DNS profiles' key; one that names a key is the operator's choice
# and is checked, not changed (26-10-14: a new installation was left to edit
# the file by hand).
#
newest="$(find "$PUBLIC_DIR" -maxdepth 1 -name '*.pub' -type f -printf '%T@ %p\n' | sort -n | tail -n 1 | cut -d' ' -f2-)"
[[ -n "$newest" ]] || die "${PUBLIC_DIR} holds no public key, though the step above made one"
if grep -Eq '^\s*\[oidc\]\s*$' "$UI_CONFIG"; then
    named="$(sed -n '/^\s*\[oidc\]/,/^\s*\[/s/^\s*public_key\s*=\s*"\(.*\)"\s*$/\1/p' "$UI_CONFIG" | head -n 1)"
    if [[ -n "$named" && -f "$named" ]]; then
        log "  ok       ${UI_CONFIG} names ${named}"
    else
        warn "${UI_CONFIG} has an [oidc] table whose public_key is not a file here: '${named}'"
        warn "  Set it to ${newest}, then restart ${WEB_UNIT}."
    fi
else
    install_file "$UI_CONFIG" "root:${PLATFORM_GROUP}" 640 "$(cat "$UI_CONFIG")

[oidc]
public_key = \"${newest}\""
    log "  added    [oidc] public_key = ${newest}"
    if systemctl is-active --quiet "$WEB_UNIT"; then
        systemctl restart "$WEB_UNIT"
        log "  restarted ${WEB_UNIT}, which reads it at start"
    fi
fi

echo
log "platform step 17 done"
