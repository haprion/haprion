#!/bin/bash
#
# haprion-backup - dump the interface database, and prove the dump is usable.
#
#     haprion-backup dump
#     haprion-backup dump-before-migration <from> <to>
#     haprion-backup verify-restore
#     haprion-backup list
#     haprion-backup after-restore
#     haprion-backup restore <dump>
#
# A dump nobody has restored is a belief, not a backup. `dump` therefore reads
# every dump back with `pg_restore --list` before keeping it, and
# `verify-restore` goes further: it restores the newest dump into a scratch
# database, compares what came out against what the archive holds, and drops
# it again.
#
# The dumps contain every password hash and every session hash in the
# installation. They are root-owned 0600 in a 0700 directory, and no application
# identity can read them - which is the same boundary as the private key nginx
# uses, for the same reason.
#
set -Eeuo pipefail

CONFIG_DIRECTORY=/etc/haprion
KEEP_DAYS=7
#
# The plan's alarm threshold. Warned about rather than enforced: a backup that
# refuses to run because a disk is filling is a backup that stops exactly when
# things are going wrong.
#
DISK_WARN_PERCENT=85

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
warn() { echo "WARNING: $*" >&2; }
die()  { echo "ERROR: $*" >&2; exit 1; }

#
# A root-owned KEY=value file a platform step wrote (ui-admin.conf, ui-tls.conf),
# read as haprion.admin_file reads it: comments, blank lines and plain
# assignments, anything else refused rather than interpreted, the last of a key
# winning. Only the keys named are set, as variables of the caller. The same
# function in install/lib.sh and in each command under install/platform/bin/
# that reads one, held together by a test (review 2026-10-22, 6-10).
#
read_admin_file() {
    local file="$1" line number=0 key
    local pattern='^([A-Z][A-Z0-9_]*)=([A-Za-z0-9_./:@+,=-]+)$'
    shift
    while IFS= read -r line || [[ -n "$line" ]]; do
        number=$((number + 1))
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == "#"* ]] && continue
        if [[ ! "$line" =~ $pattern ]]; then
            echo "ERROR: ${file}:${number}: not a plain assignment" >&2
            return 78
        fi
        for key; do
            if [[ "${BASH_REMATCH[1]}" == "$key" ]]; then
                printf -v "$key" '%s' "${BASH_REMATCH[2]}"
            fi
        done
    done < "$file"
    return 0
}
counted() { if [[ "$1" == 1 ]]; then echo "1 $2"; else echo "$1 ${3:-$2s}"; fi; }  # "1 row", "2 rows"

usage() {
    sed -n '3,10p' "$0" | sed 's/^# \?//'
    exit 64
}

[[ $EUID -eq 0 ]] || die "run this with sudo"

command="${1:-}"
shift || true
if [[ "$command" == dump-before-migration ]]; then
    [[ $# -eq 2 ]] || usage
elif [[ "$command" == restore ]]; then
    [[ $# -eq 1 ]] || usage
else
    [[ $# -eq 0 ]] || usage
fi

config="${CONFIG_DIRECTORY}/ui-admin.conf"
[[ -r "$config" ]] || { echo "ERROR: cannot read ${config}" >&2; exit 78; }
read_admin_file "$config" DB_NAME DB_ROLE DUMP_DIR UI_CONFIG || exit 78
for name in DB_NAME DB_ROLE DUMP_DIR; do
    [[ -n "${!name:-}" ]] || die "${name} is not set in ${config}"
done

#
# Two ways in, and the difference is not cosmetic. The ident map lets root be
# the migration role for THIS database only, so the scratch database a restore
# test creates cannot be reached that way - it would fail on authentication,
# which reads as a broken restore rather than as a boundary working correctly.
# Scratch work therefore goes through the postgres superuser, which is also the
# only identity that may create and drop a database.
#
psql_as()      { psql -U "$DB_ROLE" -qtAX -v ON_ERROR_STOP=1 "$@"; }
psql_scratch() { sudo -u postgres psql -qtAX -v ON_ERROR_STOP=1 "$@"; }

#
# The tables whose contents are the reason this database is backed up at all.
# Named rather than discovered, so a restore that silently produced an empty
# schema cannot pass by matching zero against zero.
#
TABLES=(alembic_version app_user app_session audit_event login_attempt job)

#
# `how` is the name of one of the two functions above, so the caller states
# which identity is asking rather than this guessing from the database name.
#
row_counts() {
    local how="$1" database="$2" table
    for table in "${TABLES[@]}"; do
        printf '%s=%s\n' "$table" "$("$how" -d "$database" -c "select count(*) from ${table}")"
    done
}

#
# How many rows the archive itself holds per table, read from its data section
# without a database. COPY's text format writes one line per row - a newline in
# a value is escaped as `\n` - so the lines between `COPY` and `\.` are the rows.
#
# This, and not the live database, is what a restore is measured against. The
# live tables move on after the dump: a sign-in adds a session and an audit
# row, and retention removes old jobs between the dump and the check. Compared
# with live, the check failed every week retention had something to do
# (2026-09-20: job live 59, restored 63) while the restore was perfect.
#
archive_counts() {
    local archive="$1" table
    for table in "${TABLES[@]}"; do
        printf '%s=%s\n' "$table" "$(
            pg_restore --data-only --table="$table" --file=- "$archive" \
                | awk '/^COPY /{rows=1; next} /^\\\.$/{rows=0} rows{count++} END{print count+0}'
        )"
    done
}

#
# The schema revision a dump holds: the one row of its alembic_version, read
# from the archive without a database, like the counts above.
#
dump_revision() {
    local archive="$1" revision
    revision="$(pg_restore --data-only --table=alembic_version --file=- "$archive" \
                | awk '/^COPY /{rows=1; next} /^\\\.$/{rows=0} rows')"
    [[ "$revision" =~ ^[0-9A-Za-z_]{1,32}$ ]] \
        || die "$(basename "$archive") holds no schema revision; it is not a dump of this database"
    echo "$revision"
}

#
# The import package of the UI release a Python interpreter belongs to, asked of
# the release itself: the package behind its `haprion-worker` command. A release
# this one replaces or rolls back to may call its package something else; the
# command is what every release has. The same function in lib.sh,
# haprion-backup, haprion-rollback and haprion-web, held together by a test.
#
release_module() {
    "$1" -I -c 'from importlib.metadata import entry_points
print(entry_points(group="console_scripts")["haprion-worker"].module.partition(".")[0])'
}

UI_PLATFORM_ROOT=/opt/haprion-ui
UI_PAYLOAD=/usr/lib/haprion/ui/PAYLOAD

#
# Where a dump at `revision` goes once restored (review 26-10-29, A1): `same
# <head> <release>`, or `migrate <head> <release>` for an older one, else the
# reason on stderr. Asked of the release this package installed, whose head the
# package's 03-verify proves: the release `current` points at, except after a
# rollback, when `current` is an older release that runs on that head
# (haprion_ui.restore_schema).
#
schema_plan() {
    local revision="$1" packaged python
    packaged="$(sed -n 's/^RELEASE_ID=//p' "$UI_PAYLOAD" 2>/dev/null || true)"
    python="${UI_PLATFORM_ROOT}/releases/${packaged}/venv/bin/python"
    if [[ ! "$packaged" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ || ! -x "$python" ]]; then
        echo "the release this package installed (${UI_PAYLOAD}) is not on disk; reinstall the haprion-ui package" >&2
        return 1
    fi
    "$python" -I -m "$(release_module "$python").restore_schema" \
        --platform-root "$UI_PLATFORM_ROOT" --packaged "$packaged" --revision "$revision"
}

#
# A row count of zero everywhere would compare equal against an empty restore,
# so the restore must bring back the schema's version: every migrated
# database holds exactly one row in alembic_version, the newest installation
# too, before it has an account.
#
restore_brought_back() {
    local restored="$1"
    [[ "$(grep '^alembic_version=' <<<"$restored" | cut -d= -f2)" == 1 ]] \
        || die "the restored database holds no schema version; the restore brought nothing back"
}

#
# A dump to `target`, read back before it is given its name.
#
write_dump() {
    local target="$1" staging used
    staging="${target}.partial"

    used="$(df --output=pcent "$DUMP_DIR" | tail -1 | tr -dc '0-9')"
    [[ "$used" -lt "$DISK_WARN_PERCENT" ]] \
        || warn "the filesystem holding ${DUMP_DIR} is ${used}% full"

    #
    # Written to a name that is not the final one and renamed into place. A
    # reader - Veeam, or the next run of this script - then either sees a
    # complete dump or does not see it at all, rather than a file that is still
    # being written and looks finished.
    #
    step_log "Dumping ${DB_NAME}"
    rm -f -- "$staging"
    ( umask 077 && pg_dump -U "$DB_ROLE" -d "$DB_NAME" --format=custom --file="$staging" )

    #
    # Read back before it is kept. pg_dump exiting zero says the command ran;
    # this says the archive can be opened and its table of contents parsed,
    # which is the cheapest question that a truncated or corrupt dump fails.
    #
    local entries
    entries="$(pg_restore --list "$staging" | grep -c '^[0-9]' || true)"
    [[ "$entries" -gt 0 ]] || { rm -f -- "$staging"; die "the dump has no readable contents"; }
    log "  ok       ${entries} archive entries readable"

    chown root:root "$staging"
    chmod 600 "$staging"
    mv -f -- "$staging" "$target"
    log "  written  ${target}  ($(du -h "$target" | cut -f1))"
}

do_dump() {
    install -d -o root -g root -m 700 "$DUMP_DIR"
    write_dump "${DUMP_DIR}/${DB_NAME}-$(date +%Y%m%d).dump"

    #
    # One dump per day: today's overwrites today's. Retention counts files, not
    # days on the calendar, so a week with the machine switched off does not
    # quietly delete the last dump that exists.
    #
    step_log "Retention"
    local -a dumps=()
    while IFS= read -r file; do dumps+=("$file"); done < <(
        find "$DUMP_DIR" -maxdepth 1 -name "${DB_NAME}-*.dump" -printf '%f\n' | sort -r
    )
    log "  ok       $(counted "${#dumps[@]}" dump) held, keeping ${KEEP_DAYS}"
    local index
    for index in "${!dumps[@]}"; do
        if [[ "$index" -ge "$KEEP_DAYS" ]]; then
            rm -f -- "${DUMP_DIR}/${dumps[$index]}"
            log "  removed  ${dumps[$index]}"
        fi
    done
}

#
# Before a release changes the schema (logic review 2026-10-22, F1). A
# migration that fails is rolled back by PostgreSQL itself; this is for one
# that succeeds and is wrong, and for the way back to the release before it.
# Named by both revisions and the moment, in a directory of its own so the
# daily retention neither counts nor removes it, and the newest three kept.
#
BEFORE_MIGRATION_KEPT=3

do_dump_before_migration() {
    local from="$1" to="$2" directory
    [[ "$from" =~ ^[0-9A-Za-z_]{1,32}$ && "$to" =~ ^[0-9A-Za-z_]{1,32}$ ]] \
        || die "dump-before-migration takes two schema revisions"
    directory="${DUMP_DIR}/before-migration"
    install -d -o root -g root -m 700 "$DUMP_DIR" "$directory"
    write_dump "${directory}/${DB_NAME}-${from}-to-${to}-$(date +%Y%m%d-%H%M%S).dump"

    keep_newest "$directory" "$BEFORE_MIGRATION_KEPT"
}

#
# The newest `count` dumps of `directory` by modification time, the rest removed.
#
keep_newest() {
    local directory="$1" count="$2" index
    local -a dumps=()
    while IFS= read -r file; do dumps+=("$file"); done < <(
        find "$directory" -maxdepth 1 -name "${DB_NAME}-*.dump" -printf '%T@ %f\n' \
            | sort -rn | cut -d' ' -f2-
    )
    for index in "${!dumps[@]}"; do
        if [[ "$index" -ge "$count" ]]; then
            rm -f -- "${directory}/${dumps[$index]}"
            log "  removed  ${dumps[$index]}"
        fi
    done
}

#
# Before a restore replaces the database (B399): a dump of what is about to be
# replaced, so that the wrong dump chosen is a step back and not the loss of
# everything since the one chosen. Its own directory, like before-migration, so
# the daily retention neither counts nor removes it; the newest three kept.
# Nothing to dump when the database does not exist yet (a restore onto a new
# machine.
#
BEFORE_RESTORE_KEPT=3

dump_before_restore() {
    local directory="${DUMP_DIR}/before-restore" target
    [[ "$(psql_scratch -d postgres -c \
        "select 1 from pg_database where datname = '${DB_NAME}'")" == 1 ]] || {
        log "  ${DB_NAME} does not exist; nothing to dump"
        return
    }
    install -d -o root -g root -m 700 "$DUMP_DIR" "$directory"
    target="${directory}/${DB_NAME}-$(date +%Y%m%d-%H%M%S).dump"
    write_dump "$target"
    keep_newest "$directory" "$BEFORE_RESTORE_KEPT"
}

#
# Counts can match while the data is unusable, so one row is compared whole:
# the oldest local account's password hash as the restored database holds it
# against the same row in the archive. An OIDC account has none, by the
# schema's own rule, so it is not the row read (review 2026-10-20, R2). A new
# installation has no account yet - haprion-setup asks for the first after its
# last step - and an installation can be all OIDC but its break-glass account;
# the check compares a hash once there is one.
#
# The archive's side is "id<TAB>hash" of the local row with the lowest id, read
# from the COPY data by the column names its header gives.
#
archive_local_hash() {
    local archive="$1"
    pg_restore --data-only --table=app_user --file=- "$archive" | awk -F'\t' '
        /^COPY / {
            header = $0
            sub(/^[^(]*\(/, "", header)
            sub(/\).*$/, "", header)
            n = split(header, columns, /, /)
            for (i = 1; i <= n; i++) {
                if (columns[i] == "id") id = i
                if (columns[i] == "source") source = i
                if (columns[i] == "password_hash") hash = i
            }
            rows = 1
            next
        }
        /^\\\.$/ { rows = 0 }
        rows && $source == "local" && (best == "" || $id + 0 < bestid) {
            bestid = $id + 0
            best = $id "\t" $hash
        }
        END { print best }'
}

restored_hash_intact() {
    local scratch="$1" archive="$2" expected id hash
    expected="$(archive_local_hash "$archive")"
    if [[ -z "$expected" ]]; then
        log "  ok       no local account; a password hash is compared once there is one"
        return
    fi
    id="${expected%%$'\t'*}"
    [[ "$id" =~ ^[0-9]+$ ]] || die "the archive's account list is not in the form this check reads"
    hash="$(psql_scratch -d "$scratch" -c \
        "select password_hash from app_user where id = ${id}")"
    [[ "$hash" == "${expected#*$'\t'}" ]] || die "a restored password hash differs from the archive's"
    log "  ok       a restored password hash matches the archive's"
}

#
# Whether `restore` takes the dump, asked as it asks (review 26-10-29, B1):
# this check said `verified` of the dumps from before an update that migrated,
# and `restore` stopped on each of them.
#
restore_takes() {
    local archive="$1" revision plan verdict head release
    revision="$(dump_revision "$archive")"
    plan="$(schema_plan "$revision")" || die "haprion-backup restore refuses this dump at schema ${revision}"
    read -r verdict head release <<<"$plan"
    if [[ "$verdict" == migrate ]]; then
        log "  ok       schema ${revision}; a restore migrates it to ${head} (${release})"
    else
        log "  ok       schema ${revision}, the head of ${release}"
    fi
}

do_verify_restore() {
    local newest
    newest="$(find "$DUMP_DIR" -maxdepth 1 -name "${DB_NAME}-*.dump" -printf '%f\n' \
              | sort -r | head -1)"
    [[ -n "$newest" ]] || die "no dump to restore from in ${DUMP_DIR}"
    local archive="${DUMP_DIR}/${newest}"
    local scratch="${DB_NAME}_restorecheck"

    step_log "Restoring ${newest} into ${scratch}"
    #
    # A scratch database created and dropped by this command, never an existing
    # one named in configuration. A restore test that can be pointed at the
    # wrong database is a restore test that will eventually overwrite something
    # real.
    #
    psql_scratch \
        -c "drop database if exists \"${scratch}\"" \
        -c "create database \"${scratch}\" owner \"${DB_ROLE}\"" >/dev/null
    #
    # Double-quoted so the name is baked in when the trap is set. Single quotes
    # would defer the expansion to exit time, by which point `scratch` is a
    # local variable that has gone out of scope - and under `set -u` the cleanup
    # then dies on an unbound variable instead of dropping the database, which
    # is the one moment it exists to handle.
    #
    # shellcheck disable=SC2064  # expanding now is the fix, see above
    trap "sudo -u postgres psql -qtAX -c 'drop database if exists \"${scratch}\"' >/dev/null 2>&1 || true" EXIT

    #
    # The grants in the dump name the contract roles, which exist; --no-owner is
    # not used, so a restore that cannot reproduce ownership fails here rather
    # than producing a database that only looks right.
    #
    #
    # Fed over stdin rather than named as a file. The dump is root-owned 0600 in
    # a 0700 directory because it holds every password hash in the installation,
    # and pg_restore here runs as postgres - which must not be able to open it.
    # Root opens the file and hands over the descriptor, so the archive is read
    # without ever becoming readable to another account.
    #
    # shellcheck disable=SC2024  # the redirect is opened by root, which is the point
    if ! sudo -u postgres pg_restore -d "$scratch" --exit-on-error <"$archive" 2>&1 \
         | sed 's/^/  /'; then
        die "pg_restore refused the archive"
    fi
    log "  ok       restored without error"

    step_log "Comparing what came out with what the archive holds"
    local expected restored live mismatch=0
    expected="$(archive_counts "$archive")"
    restored="$(row_counts psql_scratch "$scratch")"
    #
    # Live is shown beside it, not compared: it says how far the installation
    # has moved since the dump, which is worth seeing and is not a fault.
    #
    live="$(row_counts psql_as "$DB_NAME")"
    local line table expected_count restored_count live_count
    while IFS= read -r line; do
        table="${line%%=*}"
        expected_count="${line#*=}"
        restored_count="$(grep "^${table}=" <<<"$restored" | cut -d= -f2)"
        live_count="$(grep "^${table}=" <<<"$live" | cut -d= -f2)"
        if [[ "$expected_count" == "$restored_count" ]]; then
            log "  ok       ${table}: ${restored_count}  (live now ${live_count})"
        else
            warn "  DIFFERS  ${table}: archive ${expected_count}, restored ${restored_count}"
            mismatch=1
        fi
    done <<<"$expected"

    restore_brought_back "$restored"

    restored_hash_intact "$scratch" "$archive"

    restore_takes "$archive"

    [[ "$mismatch" -eq 0 ]] || die "the restore does not match the archive"

    #
    # Dropped here rather than left to the trap, so the ordinary path cleans up
    # in the open and the trap is only the failure path.
    #
    psql_scratch -c "drop database if exists \"${scratch}\"" >/dev/null
    trap - EXIT
    log "  ok       ${scratch} dropped"

    echo
    log "restore verified from ${newest}"
}

#
# After a dump was restored into the live database without the machine
# starting again (review 2026-10-20, R1). The worker holds what was queued
# before a boot by itself; a restore without one needs this. Every waiting or
# running job is held for an admin's Run or Discard on *Jobs* - they are the
# backup's, and ran then; an answer given before is cleared (0085) - and every session is ended: the restored ones
# include sessions signed out since. Both are written to the audit record.
#
# Refused while the worker runs (review 26-10-29, C05): a job it is running
# would be held as well, and an admin's Discard is read when a job is taken,
# not while it runs - so the job would go on with what follows it. `restore`
# has stopped the worker before it gets here. Checked once, without a lock: a
# worker that starts after the check - by hand, or restarting on its own - is
# not refused.
#
do_after_restore() {
    local answer
    if systemctl is-active --quiet haprion-worker.service; then
        die "haprion-worker.service is running; stop it first: sudo systemctl stop haprion-worker.service, and start it again after: sudo systemctl start haprion-worker.service"
    fi
    answer="$(psql_as -d "$DB_NAME" <<'SQL'
begin;
with held as (
    select hold_jobs_queued_before(null) as id
)
insert into audit_event (actor, action, detail)
select 'haprion-backup', 'jobs_held',
       jsonb_build_object('jobs', coalesce(jsonb_agg(id order by id), '[]'::jsonb),
                          'reason', 'restored from a dump')
  from held
returning detail->'jobs';
with ended as (
    update app_session set revoked_at = statement_timestamp()
     where revoked_at is null
    returning 1
)
insert into audit_event (actor, action, detail)
select 'haprion-backup', 'all_sessions_revoked', jsonb_build_object('sessions', count(*))
  from ended
returning detail->'sessions';
commit;
SQL
)"
    local jobs sessions
    jobs="$(sed -n 1p <<<"$answer")"
    sessions="$(sed -n 2p <<<"$answer")"
    log "held for an admin on Jobs: ${jobs}"
    log "sessions ended: ${sessions}"
}

#
# `after-restore` run by hand (review 26-10-30, P3-1). The restore that failed
# stopped the services and wrote RESTORE_STOPPED, which keeps an update, a
# rollback and a setup out until a restore finishes. Holding the jobs is what
# that refusal waits for: whoever runs this has them held and starts the
# services as they choose, so the file goes. `restore` itself calls
# do_after_restore, and removes the file when it has started the units.
#
after_restore_by_hand() {
    do_after_restore
    rm -f -- "$RESTORE_STOPPED"
}

step_log() { echo; echo "== $*"; }

#
# A dump read back into the running installation, the whole way (B376). By
# hand it took seven steps in an order with two traps (R2 26-10-27, F21): the
# web's socket starts the web again unless it is stopped too, and
# `pg_restore --clean` into the existing database fails on the partitions'
# inherited constraints. The database is made again from the dump instead
# (`--create`, through the postgres superuser), which keeps its owner, its
# grants and the roles' settings in it.
#
# Everything that writes the database, or starts something that does, in the
# order it is stopped; started again in the opposite order, the worker after
# `after-restore` has held what was waiting.
#
RESTORE_UNITS=(
    haprion-traffic-collector.timer
    haprion-retention.timer
    haprion-retention-budget.timer
    haprion-backup.timer
    haprion-restore-check.timer
    haprion-traffic-collector.service
    haprion-web.socket
    haprion-web.service
    haprion-worker.service
    haprion-poller.service
)
PLATFORM_STEPS="${HAPRION_PLATFORM_STEPS:-/usr/share/haprion-ui/install/platform}"
COLLECTOR_CONFIG=/etc/haprion/traffic-collector.json
COLLECTOR_COMMAND=/opt/haprion/current/bin/haprion-traffic-collector
RETENTION_COMMAND=/usr/sbin/haprion-retention
RETENTION_TIMER=/etc/systemd/system/haprion-retention.timer
#
# The units a restore stopped, kept until a restore finishes (review 26-10-29,
# D1). A restore that fails after the stop leaves them stopped and says to run
# it again, and that run found nothing active: it started nothing, and the web,
# the worker and every timer - the daily dump's too - stayed down while it said
# the restore had finished. Under /run, which is emptied at every boot, when
# systemd starts the enabled units itself; root's alone, and written under the
# lock `restore` takes.
#
RESTORE_STOPPED=/run/haprion/restore-stopped

#
# The units in RESTORE_STOPPED, one per line. Only a name in RESTORE_UNITS is
# one: anything else is said and left alone rather than started as root.
#
stopped_before() {
    local unit known
    [[ -e "$RESTORE_STOPPED" ]] || return 0
    while IFS= read -r unit || [[ -n "$unit" ]]; do
        for known in "${RESTORE_UNITS[@]}"; do
            if [[ "$unit" == "$known" ]]; then
                echo "$unit"
                continue 2
            fi
        done
        warn "${RESTORE_STOPPED} names ${unit}, which a restore does not stop; it is left alone"
    done <"$RESTORE_STOPPED"
}

#
# RESTORE_STOPPED holding the units named, in RESTORE_UNITS' order, or removed
# when none is. Renamed into place, so a run stopped mid-write leaves the list
# before it.
#
remember_stopped() {
    local unit name
    local -a kept=()
    for unit in "${RESTORE_UNITS[@]}"; do
        for name; do
            if [[ "$name" == "$unit" ]]; then
                kept+=("$unit")
                break
            fi
        done
    done
    if [[ ${#kept[@]} -eq 0 ]]; then
        rm -f -- "$RESTORE_STOPPED"
        return
    fi
    mkdir -p -- "${RESTORE_STOPPED%/*}"
    ( umask 077 && printf '%s\n' "${kept[@]}" >"${RESTORE_STOPPED}.partial" )
    mv -f -- "${RESTORE_STOPPED}.partial" "$RESTORE_STOPPED"
}

#
# A restore that stopped once the services were (review 26-10-29, D1 and
# P3-3): they stay stopped, and a run again starts them once it finishes.
# `held` says the dump's jobs are in the database and nothing has held them
# yet, so whoever starts a service by hand holds them first; after a failed
# pg_restore there may be no database to hold them in. `behind` says the
# schema is the dump's, behind the code (the migration runs in one transaction
# and fell): nothing is started by hand then, only a run again. Then the units.
#
restore_stopped() {
    local reason="$1" names="$2" held="$3" hold=""
    shift 3
    if [[ "$held" == behind ]]; then
        hold="
  The schema is behind the code, so do not start any of them by hand."
    elif [[ -n "$held" ]]; then
        hold="
  Before starting any of them by hand, hold the restored jobs: sudo haprion-backup after-restore"
    fi
    local stopped="the services stay stopped: $*"
    [[ $# -gt 0 ]] || stopped="no service was running"
    die "${reason}; ${stopped}.
  Correct what ${names} names and run this again; it starts them once a restore finishes.${hold}"
}

do_restore() {
    local dump="$1" unit connections collector revision plan verdict head release
    local -a before=() stopped=() now=()
    [[ -f "$dump" && -r "$dump" ]] || die "cannot read the dump ${dump}"
    pg_restore --list "$dump" >/dev/null 2>&1 || die "${dump} is not a dump pg_restore can read"
    [[ -x "${PLATFORM_STEPS}/03-verify" ]] || die "${PLATFORM_STEPS}/03-verify is missing"
    #
    # The dump's schema, before anything stops (review 26-10-29, A1). 03-verify
    # proves the database at the package's head, and a dump taken before an
    # update that migrated is older: restored as it was, it failed there with
    # the services stopped. An older one is migrated after it is restored; one
    # the release cannot take is refused here, with nothing changed.
    #
    revision="$(dump_revision "$dump")"
    plan="$(schema_plan "$revision")" \
        || die "nothing was stopped or restored; the dump is at schema ${revision}"
    read -r verdict head release <<<"$plan"
    [[ "$verdict" != migrate || -x "${PLATFORM_STEPS}/migrate" ]] \
        || die "${PLATFORM_STEPS}/migrate is missing; nothing was stopped or restored"

    #
    # What a restore before this one stopped and did not start again, started
    # with what this one stops once it finishes. Each unit is written down
    # before it is stopped, so a run cut short keeps it too.
    #
    mapfile -t before < <(stopped_before)
    step_log "Stopping what writes the database"
    for unit in "${RESTORE_UNITS[@]}"; do
        if systemctl is-active --quiet "$unit"; then
            remember_stopped "${before[@]}" "${now[@]}" "$unit"
            systemctl stop "$unit"
            now+=("$unit")
            stopped+=("$unit")
            log "  stopped  ${unit}"
        elif [[ " ${before[*]} " == *" ${unit} "* ]]; then
            stopped+=("$unit")
            log "  ${unit} stays stopped from a restore that did not finish"
        fi
    done
    connections="$(psql_scratch -d postgres -c \
        "select count(*) from pg_stat_activity where datname = '${DB_NAME}'")"
    if [[ "$connections" != 0 ]]; then
        #
        # Only what this run stopped: the database is untouched since, and what
        # a failed restore before it stopped stays stopped on what that left.
        #
        start_units "${now[@]}"
        remember_stopped "${before[@]}"
        die "$(counted "$connections" connection) to ${DB_NAME} still open; nothing was restored${before[*]:+, and ${before[*]} stay stopped}.
  See them with: sudo -u postgres psql -c \"select pid, usename, application_name from pg_stat_activity where datname = '${DB_NAME}'\""
    fi

    step_log "Dumping what is about to be replaced"
    if ! ( dump_before_restore ); then
        start_units "${now[@]}"
        remember_stopped "${before[@]}"
        die "the database could not be dumped before it is replaced; nothing was restored${before[*]:+, and ${before[*]} stay stopped}"
    fi

    step_log "Restoring ${dump}"
    #
    # Root opens the dump, which no other account may read, and postgres reads
    # it on stdin. From here a failure leaves the services stopped: the
    # database may be half made, and nothing should write to it.
    #
    # shellcheck disable=SC2024 # root opening the file is the point: postgres may not read it
    if ! sudo -u postgres pg_restore -d postgres --clean --create --if-exists \
            --exit-on-error < "$dump"; then
        restore_stopped "the restore stopped" pg_restore "" "${stopped[@]}"
    fi
    log "  restored ${DB_NAME} from $(basename "$dump")"

    #
    # By the release's own migrations; the release that runs was asked by the
    # rollback's rule whether it runs on that head, and does, as it did before
    # the restore. The partitions ahead follow, as after an update's
    # migration: one may have added a partitioned table.
    #
    if [[ "$verdict" == migrate ]]; then
        step_log "Migrating ${revision} -> ${head}"
        (cd "$PLATFORM_STEPS" && ./migrate --release "$release") \
            || restore_stopped "the migration from ${revision} stopped" migrate behind "${stopped[@]}"
        log "  the dump is at ${revision}; migrated to ${head}"
        if [[ -e "$RETENTION_TIMER" ]]; then
            "$RETENTION_COMMAND" horizon \
                || warn "the partitions ahead could not be made; the nightly haprion-retention will try again"
        fi
    fi

    step_log "Proving the database's privileges"
    (cd "$PLATFORM_STEPS" && ./03-verify) \
        || restore_stopped "the restored database does not grant what the contract says" \
            03-verify held "${stopped[@]}"

    step_log "Holding waiting jobs and ending sessions"
    do_after_restore

    step_log "Starting what was stopped"
    start_units "${stopped[@]}"
    remember_stopped

    collector="$(systemctl show -p User --value haprion-traffic-collector.service 2>/dev/null || true)"
    if [[ -n "$collector" && -r "$COLLECTOR_CONFIG" && -x "$COLLECTOR_COMMAND" ]]; then
        step_log "Replaying the traffic log"
        runuser -u "$collector" -- "$COLLECTOR_COMMAND" --replay-database "$COLLECTOR_CONFIG" \
            || warn "the traffic log was not replayed; run: sudo -u ${collector} ${COLLECTOR_COMMAND} --replay-database ${COLLECTOR_CONFIG}"
    fi
    echo
    log "restored from $(basename "$dump"); waiting jobs are held for an admin on Jobs"
    log "the database it replaced is kept in ${DUMP_DIR}/before-restore/"
}

start_units() {
    local index
    for (( index = $# ; index > 0 ; index-- )); do
        if systemctl start "${!index}"; then
            log "  started  ${!index}"
        else
            warn "${!index} did not start"
        fi
    done
}

#
# One dump or restore check at a time (review 2026-10-20, R3). Two share the
# day's file name, its `.partial` and the scratch database's name, so a run by
# hand beside the timer's could remove the other's file or drop its database
# and report a backup failure that was neither's fault. systemd keeps a unit
# from starting twice, not a terminal from starting the same thing. The second
# waits for the first rather than failing: the timer's run then still happens.
#
LOCK=/run/lock/haprion-backup.lock
LOCK_WAIT_SECONDS=1800

#
# The release lock, for as long as a restore runs (review 26-10-30, U3): an
# update, a rollback or an activation switching the release, or restarting the
# services, under a restore. Descriptor 8: `take_lock` owns 9. It does not
# refuse for the marker `restore` itself leaves - a restore that failed is
# run again.
#
RELEASE_LOCK=/run/haprion/ui-release.lock

hold_release_lock_for_restore() {
    local mask
    mkdir -p -- "${RELEASE_LOCK%/*}"
    mask="$(umask)"
    umask 077
    exec 8>>"$RELEASE_LOCK"
    umask "$mask"
    chmod 600 -- "$RELEASE_LOCK"
    flock -n 8 \
        || die "an update, a rollback or a setup of the UI release is running; run this again when it is done"
    printf '%s\n' "$$" >"$RELEASE_LOCK"
}

take_lock() {
    exec 9>"$LOCK"
    flock -n 9 && return
    log "another haprion-backup dump or verify-restore is running; waiting for it"
    flock -w "$LOCK_WAIT_SECONDS" 9 \
        || die "another haprion-backup run still holds ${LOCK} after ${LOCK_WAIT_SECONDS} s"
}

case "$command" in
    dump)           take_lock; do_dump ;;
    dump-before-migration) take_lock; do_dump_before_migration "$@" ;;
    after-restore)  after_restore_by_hand ;;
    restore)        hold_release_lock_for_restore; take_lock; do_restore "$1" ;;
    verify-restore) take_lock; do_verify_restore ;;
    list)
        [[ -d "$DUMP_DIR" ]] || die "no dump directory: ${DUMP_DIR}"
        find "$DUMP_DIR" -maxdepth 1 -name "${DB_NAME}-*.dump" \
            -printf '%TY-%Tm-%Td %TH:%TM  %10s  %f\n' | sort -r
        ;;
    *) usage ;;
esac
