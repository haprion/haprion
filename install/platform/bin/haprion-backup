#!/bin/bash
#
# haprion-backup - dump the interface database, and prove the dump is usable.
#
#     haprion-backup dump
#     haprion-backup dump-before-migration <from> <to>
#     haprion-backup verify-restore
#     haprion-backup list
#     haprion-backup after-restore
#
# A dump nobody has restored is a belief, not a backup. `dump` therefore reads
# every dump back with `pg_restore --list` before keeping it, and
# `verify-restore` goes further: it restores the newest dump into a scratch
# database, compares what came out against what the archive holds, and drops
# it again.
#
# The dumps contain every password hash and every session hash in the
# installation. They are root-owned 0600 in a 0700 directory, and no application
# identity can read them - which is the same boundary as the private key nginx
# uses, for the same reason.
#
set -Eeuo pipefail

CONFIG_DIRECTORY=/etc/haprion
KEEP_DAYS=7
#
# The plan's alarm threshold. Warned about rather than enforced: a backup that
# refuses to run because a disk is filling is a backup that stops exactly when
# things are going wrong.
#
DISK_WARN_PERCENT=85

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
warn() { echo "WARNING: $*" >&2; }
die()  { echo "ERROR: $*" >&2; exit 1; }

#
# A root-owned KEY=value file a platform step wrote (ui-admin.conf, ui-tls.conf),
# read as haprion.admin_file reads it: comments, blank lines and plain
# assignments, anything else refused rather than interpreted, the last of a key
# winning. Only the keys named are set, as variables of the caller. The same
# function in install/lib.sh and in each command under install/platform/bin/
# that reads one, held together by a test (review 2026-10-22, 6-10).
#
read_admin_file() {
    local file="$1" line number=0 key
    local pattern='^([A-Z][A-Z0-9_]*)=([A-Za-z0-9_./:@+,=-]+)$'
    shift
    while IFS= read -r line || [[ -n "$line" ]]; do
        number=$((number + 1))
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == "#"* ]] && continue
        if [[ ! "$line" =~ $pattern ]]; then
            echo "ERROR: ${file}:${number}: not a plain assignment" >&2
            return 78
        fi
        for key; do
            if [[ "${BASH_REMATCH[1]}" == "$key" ]]; then
                printf -v "$key" '%s' "${BASH_REMATCH[2]}"
            fi
        done
    done < "$file"
    return 0
}
counted() { if [[ "$1" == 1 ]]; then echo "1 $2"; else echo "$1 ${3:-$2s}"; fi; }  # "1 row", "2 rows"

usage() {
    sed -n '3,10p' "$0" | sed 's/^# \?//'
    exit 64
}

[[ $EUID -eq 0 ]] || die "run this with sudo"

command="${1:-}"
shift || true
if [[ "$command" == dump-before-migration ]]; then
    [[ $# -eq 2 ]] || usage
else
    [[ $# -eq 0 ]] || usage
fi

config="${CONFIG_DIRECTORY}/ui-admin.conf"
[[ -r "$config" ]] || { echo "ERROR: cannot read ${config}" >&2; exit 78; }
read_admin_file "$config" DB_NAME DB_ROLE DUMP_DIR UI_CONFIG || exit 78
for name in DB_NAME DB_ROLE DUMP_DIR; do
    [[ -n "${!name:-}" ]] || die "${name} is not set in ${config}"
done

#
# Two ways in, and the difference is not cosmetic. The ident map lets root be
# the migration role for THIS database only, so the scratch database a restore
# test creates cannot be reached that way - it would fail on authentication,
# which reads as a broken restore rather than as a boundary working correctly.
# Scratch work therefore goes through the postgres superuser, which is also the
# only identity that may create and drop a database.
#
psql_as()      { psql -U "$DB_ROLE" -qtAX -v ON_ERROR_STOP=1 "$@"; }
psql_scratch() { sudo -u postgres psql -qtAX -v ON_ERROR_STOP=1 "$@"; }

#
# The tables whose contents are the reason this database is backed up at all.
# Named rather than discovered, so a restore that silently produced an empty
# schema cannot pass by matching zero against zero.
#
TABLES=(alembic_version app_user app_session audit_event login_attempt job)

#
# `how` is the name of one of the two functions above, so the caller states
# which identity is asking rather than this guessing from the database name.
#
row_counts() {
    local how="$1" database="$2" table
    for table in "${TABLES[@]}"; do
        printf '%s=%s\n' "$table" "$("$how" -d "$database" -c "select count(*) from ${table}")"
    done
}

#
# How many rows the archive itself holds per table, read from its data section
# without a database. COPY's text format writes one line per row - a newline in
# a value is escaped as `\n` - so the lines between `COPY` and `\.` are the rows.
#
# This, and not the live database, is what a restore is measured against. The
# live tables move on after the dump: a sign-in adds a session and an audit
# row, and retention removes old jobs between the dump and the check. Compared
# with live, the check failed every week retention had something to do
# (2026-09-20: job live 59, restored 63) while the restore was perfect.
#
archive_counts() {
    local archive="$1" table
    for table in "${TABLES[@]}"; do
        printf '%s=%s\n' "$table" "$(
            pg_restore --data-only --table="$table" --file=- "$archive" \
                | awk '/^COPY /{rows=1; next} /^\\\.$/{rows=0} rows{count++} END{print count+0}'
        )"
    done
}

#
# A row count of zero everywhere would compare equal against an empty restore,
# so the restore must bring back the schema's version: every migrated
# database holds exactly one row in alembic_version, the newest installation
# too, before it has an account.
#
restore_brought_back() {
    local restored="$1"
    [[ "$(grep '^alembic_version=' <<<"$restored" | cut -d= -f2)" == 1 ]] \
        || die "the restored database holds no schema version; the restore brought nothing back"
}

#
# A dump to `target`, read back before it is given its name.
#
write_dump() {
    local target="$1" staging used
    staging="${target}.partial"

    used="$(df --output=pcent "$DUMP_DIR" | tail -1 | tr -dc '0-9')"
    [[ "$used" -lt "$DISK_WARN_PERCENT" ]] \
        || warn "the filesystem holding ${DUMP_DIR} is ${used}% full"

    #
    # Written to a name that is not the final one and renamed into place. A
    # reader - Veeam, or the next run of this script - then either sees a
    # complete dump or does not see it at all, rather than a file that is still
    # being written and looks finished.
    #
    step_log "Dumping ${DB_NAME}"
    rm -f -- "$staging"
    ( umask 077 && pg_dump -U "$DB_ROLE" -d "$DB_NAME" --format=custom --file="$staging" )

    #
    # Read back before it is kept. pg_dump exiting zero says the command ran;
    # this says the archive can be opened and its table of contents parsed,
    # which is the cheapest question that a truncated or corrupt dump fails.
    #
    local entries
    entries="$(pg_restore --list "$staging" | grep -c '^[0-9]' || true)"
    [[ "$entries" -gt 0 ]] || { rm -f -- "$staging"; die "the dump has no readable contents"; }
    log "  ok       ${entries} archive entries readable"

    chown root:root "$staging"
    chmod 600 "$staging"
    mv -f -- "$staging" "$target"
    log "  written  ${target}  ($(du -h "$target" | cut -f1))"
}

do_dump() {
    install -d -o root -g root -m 700 "$DUMP_DIR"
    write_dump "${DUMP_DIR}/${DB_NAME}-$(date +%Y%m%d).dump"

    #
    # One dump per day: today's overwrites today's. Retention counts files, not
    # days on the calendar, so a week with the machine switched off does not
    # quietly delete the last dump that exists.
    #
    step_log "Retention"
    local -a dumps=()
    while IFS= read -r file; do dumps+=("$file"); done < <(
        find "$DUMP_DIR" -maxdepth 1 -name "${DB_NAME}-*.dump" -printf '%f\n' | sort -r
    )
    log "  ok       $(counted "${#dumps[@]}" dump) held, keeping ${KEEP_DAYS}"
    local index
    for index in "${!dumps[@]}"; do
        if [[ "$index" -ge "$KEEP_DAYS" ]]; then
            rm -f -- "${DUMP_DIR}/${dumps[$index]}"
            log "  removed  ${dumps[$index]}"
        fi
    done
}

#
# Before a release changes the schema (logic review 2026-10-22, F1). A
# migration that fails is rolled back by PostgreSQL itself; this is for one
# that succeeds and is wrong, and for the way back to the release before it.
# Named by both revisions and the moment, in a directory of its own so the
# daily retention neither counts nor removes it, and the newest three kept.
#
BEFORE_MIGRATION_KEPT=3

do_dump_before_migration() {
    local from="$1" to="$2" directory index
    [[ "$from" =~ ^[0-9A-Za-z_]{1,32}$ && "$to" =~ ^[0-9A-Za-z_]{1,32}$ ]] \
        || die "dump-before-migration takes two schema revisions"
    directory="${DUMP_DIR}/before-migration"
    install -d -o root -g root -m 700 "$DUMP_DIR" "$directory"
    write_dump "${directory}/${DB_NAME}-${from}-to-${to}-$(date +%Y%m%d-%H%M%S).dump"

    local -a dumps=()
    while IFS= read -r file; do dumps+=("$file"); done < <(
        find "$directory" -maxdepth 1 -name "${DB_NAME}-*.dump" -printf '%T@ %f\n' \
            | sort -rn | cut -d' ' -f2-
    )
    for index in "${!dumps[@]}"; do
        if [[ "$index" -ge "$BEFORE_MIGRATION_KEPT" ]]; then
            rm -f -- "${directory}/${dumps[$index]}"
            log "  removed  ${dumps[$index]}"
        fi
    done
}

#
# Counts can match while the data is unusable, so one row is read back in full:
# the oldest local account's hash must still verify as an Argon2id hash. An
# OIDC account has none, by the schema's own rule, so it is not the row read
# (review 2026-10-20, R2). A new installation has no account yet - haprion-setup
# asks for the first after its last step - and an installation can be all OIDC
# but its break-glass account; the check reads a hash back once there is one.
#
restored_hash_intact() {
    local scratch="$1" hash
    hash="$(psql_scratch -d "$scratch" -c \
        "select password_hash from app_user where source = 'local' order by id limit 1")"
    if [[ -z "$hash" ]]; then
        log "  ok       no local account; a password hash is read back once there is one"
        return
    fi
    # shellcheck disable=SC2016  # the literal dollar signs are the prefix being matched
    [[ "$hash" == '$argon2id$'* ]] || die "a restored password hash is not Argon2id"
    log "  ok       a restored password hash is intact"
}

do_verify_restore() {
    local newest
    newest="$(find "$DUMP_DIR" -maxdepth 1 -name "${DB_NAME}-*.dump" -printf '%f\n' \
              | sort -r | head -1)"
    [[ -n "$newest" ]] || die "no dump to restore from in ${DUMP_DIR}"
    local archive="${DUMP_DIR}/${newest}"
    local scratch="${DB_NAME}_restorecheck"

    step_log "Restoring ${newest} into ${scratch}"
    #
    # A scratch database created and dropped by this command, never an existing
    # one named in configuration. A restore test that can be pointed at the
    # wrong database is a restore test that will eventually overwrite something
    # real.
    #
    psql_scratch \
        -c "drop database if exists \"${scratch}\"" \
        -c "create database \"${scratch}\" owner \"${DB_ROLE}\"" >/dev/null
    #
    # Double-quoted so the name is baked in when the trap is set. Single quotes
    # would defer the expansion to exit time, by which point `scratch` is a
    # local variable that has gone out of scope - and under `set -u` the cleanup
    # then dies on an unbound variable instead of dropping the database, which
    # is the one moment it exists to handle.
    #
    # shellcheck disable=SC2064  # expanding now is the fix, see above
    trap "sudo -u postgres psql -qtAX -c 'drop database if exists \"${scratch}\"' >/dev/null 2>&1 || true" EXIT

    #
    # The grants in the dump name the contract roles, which exist; --no-owner is
    # not used, so a restore that cannot reproduce ownership fails here rather
    # than producing a database that only looks right.
    #
    #
    # Fed over stdin rather than named as a file. The dump is root-owned 0600 in
    # a 0700 directory because it holds every password hash in the installation,
    # and pg_restore here runs as postgres - which must not be able to open it.
    # Root opens the file and hands over the descriptor, so the archive is read
    # without ever becoming readable to another account.
    #
    # shellcheck disable=SC2024  # the redirect is opened by root, which is the point
    if ! sudo -u postgres pg_restore -d "$scratch" --exit-on-error <"$archive" 2>&1 \
         | sed 's/^/  /'; then
        die "pg_restore refused the archive"
    fi
    log "  ok       restored without error"

    step_log "Comparing what came out with what the archive holds"
    local expected restored live mismatch=0
    expected="$(archive_counts "$archive")"
    restored="$(row_counts psql_scratch "$scratch")"
    #
    # Live is shown beside it, not compared: it says how far the installation
    # has moved since the dump, which is worth seeing and is not a fault.
    #
    live="$(row_counts psql_as "$DB_NAME")"
    local line table expected_count restored_count live_count
    while IFS= read -r line; do
        table="${line%%=*}"
        expected_count="${line#*=}"
        restored_count="$(grep "^${table}=" <<<"$restored" | cut -d= -f2)"
        live_count="$(grep "^${table}=" <<<"$live" | cut -d= -f2)"
        if [[ "$expected_count" == "$restored_count" ]]; then
            log "  ok       ${table}: ${restored_count}  (live now ${live_count})"
        else
            warn "  DIFFERS  ${table}: archive ${expected_count}, restored ${restored_count}"
            mismatch=1
        fi
    done <<<"$expected"

    restore_brought_back "$restored"

    restored_hash_intact "$scratch"

    [[ "$mismatch" -eq 0 ]] || die "the restore does not match the archive"

    #
    # Dropped here rather than left to the trap, so the ordinary path cleans up
    # in the open and the trap is only the failure path.
    #
    psql_scratch -c "drop database if exists \"${scratch}\"" >/dev/null
    trap - EXIT
    log "  ok       ${scratch} dropped"

    echo
    log "restore verified from ${newest}"
}

#
# After a dump was restored into the live database without the machine
# starting again (review 2026-10-20, R1). The worker holds what was queued
# before a boot by itself; a restore without one needs this. Every waiting or
# running job is held for an admin's Run or Discard on *Jobs* - they are the
# backup's, and ran then; an answer given before is cleared (0085) - and every session is ended: the restored ones
# include sessions signed out since. Both are written to the audit record.
#
do_after_restore() {
    local answer
    answer="$(psql_as -d "$DB_NAME" <<'SQL'
begin;
with held as (
    select hold_jobs_queued_before(null) as id
)
insert into audit_event (actor, action, detail)
select 'haprion-backup', 'jobs_held',
       jsonb_build_object('jobs', coalesce(jsonb_agg(id order by id), '[]'::jsonb),
                          'reason', 'restored from a dump')
  from held
returning detail->'jobs';
with ended as (
    update app_session set revoked_at = statement_timestamp()
     where revoked_at is null
    returning 1
)
insert into audit_event (actor, action, detail)
select 'haprion-backup', 'all_sessions_revoked', jsonb_build_object('sessions', count(*))
  from ended
returning detail->'sessions';
commit;
SQL
)"
    local jobs sessions
    jobs="$(sed -n 1p <<<"$answer")"
    sessions="$(sed -n 2p <<<"$answer")"
    log "held for an admin on Jobs: ${jobs}"
    log "sessions ended: ${sessions}"
}

step_log() { echo; echo "== $*"; }

#
# One dump or restore check at a time (review 2026-10-20, R3). Two share the
# day's file name, its `.partial` and the scratch database's name, so a run by
# hand beside the timer's could remove the other's file or drop its database
# and report a backup failure that was neither's fault. systemd keeps a unit
# from starting twice, not a terminal from starting the same thing. The second
# waits for the first rather than failing: the timer's run then still happens.
#
LOCK=/run/lock/haprion-backup.lock
LOCK_WAIT_SECONDS=1800

take_lock() {
    exec 9>"$LOCK"
    flock -n 9 && return
    log "another haprion-backup dump or verify-restore is running; waiting for it"
    flock -w "$LOCK_WAIT_SECONDS" 9 \
        || die "another haprion-backup run still holds ${LOCK} after ${LOCK_WAIT_SECONDS} s"
}

case "$command" in
    dump)           take_lock; do_dump ;;
    dump-before-migration) take_lock; do_dump_before_migration "$@" ;;
    after-restore)  do_after_restore ;;
    verify-restore) take_lock; do_verify_restore ;;
    list)
        [[ -d "$DUMP_DIR" ]] || die "no dump directory: ${DUMP_DIR}"
        find "$DUMP_DIR" -maxdepth 1 -name "${DB_NAME}-*.dump" \
            -printf '%TY-%Tm-%Td %TH:%TM  %10s  %f\n' | sort -r
        ;;
    *) usage ;;
esac
