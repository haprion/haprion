#!/bin/bash
#
# Blocklists under Settings, from a file, for automation. Installed by the
# haprion-ui package.
#
# A shim rather than a link into a release, as haprion-profiles is: it runs
# whatever `current` points at, so an application rollback takes it back too.
# Root only; it connects as the migration role.
#
exec /opt/haprion-ui/current/venv/bin/haprion-blocklists "$@"
