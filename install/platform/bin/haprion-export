#!/bin/bash
#
# What is set now - the interface's settings and every cluster's objects,
# network, Logs & metrics and backup schedule - written as the files the
# apply commands take, for automation to start from. Installed by the
# haprion-ui package.
#
# A shim rather than a link into a release, as haprion-settings is: it runs
# whatever `current` points at, so an application rollback takes it back too.
# Root only; it connects as the migration role.
#
exec /opt/haprion-ui/current/venv/bin/haprion-export "$@"
