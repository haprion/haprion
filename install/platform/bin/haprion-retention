#!/bin/bash
#
# haprion-retention - keep the database bounded.
#
#     haprion-retention prune  [--days <n>] [--dry-run]
#     haprion-retention report [--days <n>] [--exact]
#
# The job table grows without limit otherwise: it holds one row per management
# request ever made, and nothing has ever removed one. The audit trail is what
# records that an operation happened, and is kept far longer than the queue's
# working copy: two years (26-10-11).
#
# It is a root command rather than something the interface does, because no
# application role holds `delete` on any table and none is going to. That is the
# same boundary as the audit trail and the login attempts: a compromised web or
# worker process must not be able to remove the evidence of what it did. The
# migration role owns the table and may therefore delete from it, and the ident
# map lets root - and only root - be that role for this database.
#
set -Eeuo pipefail

CONFIG_DIRECTORY=/etc/haprion

#
# The decided retention: one week. A management request older than that has
# either been acted on or has been superseded, and what it did is in the audit
# trail regardless.
#
KEEP_DAYS=7

#
# A floor under the retention, expressed in rows rather than days.
#
# Without it a quiet week empties the jobs page completely, and an operator who
# opens it after a calm fortnight is shown nothing at all - which reads as "the
# interface has lost its history", not as "nothing has happened lately". This is
# the same number the page itself lists, so the floor is exactly what a reader
# can see.
#
KEEP_MINIMUM=20

#
# The metric tables, and why partition maintenance lives in this command rather
# than in the poller. No application role holds `create` on the schema - the
# whole grant is `usage` - so the account that writes the samples cannot make
# the partition it writes them into. This command is already the one privileged,
# scheduled hand on this database, so it is where the horizon is kept. See B93.
#
METRIC_TABLES=(metric_frontend metric_backend_member)

#
# Raw samples are kept for a week, which is what the phase decided, and one
# partition holds one day.
#
METRIC_KEEP_DAYS=7

#
# How far ahead partitions are created. Long, and that is the point: there is no
# default partition, so a day with no partition is an insert that fails rather
# than a row that lands somewhere misleading. At two months of headroom a
# missed run - or sixty of them - costs nothing, while a horizon of days would
# make this timer a single point of failure between the poller and a sample
# with nowhere to go.
#
METRIC_AHEAD_DAYS=60

#
# The hourly rollup, and how long it is kept. A year, which is what the phase
# decided, in monthly partitions.
#
METRIC_ROLLUP_TABLE=metric_backend_hour
METRIC_ROLLUP_NAME=backend_hour
METRIC_ROLLUP_KEEP_DAYS=365
METRIC_ROLLUP_SAFETY_DAYS=1

#
# How far behind the present the rollup stops. An hour still being filled would
# be rolled up half-finished and then never revisited, so the boundary sits a
# day back: everything older than this is complete and will not change again.
#
# A day rather than an hour gives the normal daily run six days of slack before
# the reader's preferred seven-day boundary. The explicit completion boundary
# below is what keeps longer failures correct: readers stay on raw rows beyond
# it, and the prune cannot remove those rows while the rollup is behind.
#
METRIC_ROLLUP_LAG_DAYS=1
TRAFFIC_KEEP_DAYS=7
TRAFFIC_AHEAD_DAYS=7

#
# A sign-in through the OIDC provider leaves one row (0041): usable for ten
# minutes and once. A day is kept so that a failed sign-in can still be looked
# at the morning after; beyond that a row is only a nonce and a PKCE verifier
# nobody will ever present again. The web role inserts and marks them used but
# holds no `delete`, the same boundary as the job table.
#
OIDC_LOGIN_KEEP_HOURS=24

#
# Sessions and sign-in attempts grew for the life of the installation (review
# 2026-09-28 F07). A session that ended - expired or signed out - more than a
# month ago is a token hash nobody can present again. A sign-in attempt older
# than ninety days is far outside any throttle window (at most a day), with
# one exception: each name keeps its newest successful attempt, because the
# Users page reads "Last sign-in" from it and a break-glass account may go
# unused for longer than that.
#
SESSION_KEEP_DAYS=30
LOGIN_ATTEMPT_KEEP_DAYS=90

#
# The audit trail: two years (26-10-11). It is append-only for every
# application role; this root command is the one hand that removes from it,
# and only by age.
#
AUDIT_KEEP_DAYS=730
#
# What the nodes did on their own, *Events → Nodes* (26-10-12): a server down
# or back up, the VIP moving. Long enough to follow an incident up weeks
# later and see whether it comes back.
#
NODE_EVENT_KEEP_DAYS=90

#
# HAProxy's own counter column names, in the order the rest of the project
# lists them. A fourth copy of this list - the node reads it, the reader keeps
# it, the migration stores it, and this rolls it up - and it cannot be shared:
# this is a shell script and those are Python. `test_metric_samples` compares
# all four rather than trusting them to stay in step.
#
METRIC_COUNTERS="scur, stot, bin, bout, req_tot, qcur, ereq, econ, eresp, dreq, dresp, wretr, wredis, hrsp_2xx, hrsp_3xx, hrsp_4xx, hrsp_5xx"

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
die()  { echo "ERROR: $*" >&2; exit 1; }

usage() {
    sed -n '3,7p' "$0" | sed 's/^# \?//'
    exit 64
}

#
# Partition names are derived from the day they hold, so the day can be read
# back out of the name. That is what lets an expired partition be found without
# parsing `pg_get_expr` output: the catalogue is still asked which partitions
# exist, and only the date comes from the name.
#
metric_partitions_expired() {
    local table="$1"
    local completed=""
    if [[ "$table" == "metric_backend_member" ]] && rollup_state_present; then
        #
        # Age alone is not proof that the derived copy exists. Keep the whole
        # partition unless the rollup's continuous boundary is at least one
        # further day ahead; if the state row is absent, the scalar comparison
        # is unknown and no pool partition is eligible.
        #
        completed="and to_date(right(child.relname, 8), 'YYYYMMDD') + interval '1 day'
                   <= (select complete_before - make_interval(days => ${METRIC_ROLLUP_SAFETY_DAYS})
                         from metric_rollup_state
                        where rollup_name = '${METRIC_ROLLUP_NAME}')"
    fi
    cat <<SQL
    select child.relname
      from pg_inherits
      join pg_class parent on parent.oid = pg_inherits.inhparent
      join pg_class child  on child.oid  = pg_inherits.inhrelid
     where parent.relname = '${table}'
       and child.relname ~ '^${table}_[0-9]{8}\$'
       and to_date(right(child.relname, 8), 'YYYYMMDD')
           < current_date - ${METRIC_KEEP_DAYS}
       ${completed}
     order by child.relname
SQL
}

#
# What `report` says about the metric tables: what exists, never what should.
# The command's whole promise is that it changes nothing, and a report that
# quietly created tomorrow's partition would break it in the one place somebody
# runs it to find out whether it is safe to run `prune`.
#
#
# Whether this database has the metric tables at all.
#
# The command is installed apart from the release, and a database still being
# migrated may not have them yet. That is a normal state and not a fault,
# and it must not take the job pruning down with it: without this, `prune` on an
# unmigrated database fails on the missing function and returns before removing
# a single job row.
#
metrics_present() {
    [[ "$(psql_as -c "select to_regclass('public.metric_frontend') is not null")" == "t" ]]
}

rollup_state_present() {
    [[ "$(psql_as -c "select to_regclass('public.metric_rollup_state') is not null")" == "t" ]]
}

oidc_logins_present() {
    [[ "$(psql_as -c "select to_regclass('public.oidc_login') is not null")" == "t" ]]
}

#
# One predicate for the count and the delete, as with the jobs below.
#
where_oidc_login_expired() {
    echo "created_at < statement_timestamp() - make_interval(hours => ${OIDC_LOGIN_KEEP_HOURS})"
}

oidc_logins() {
    local expired removed
    oidc_logins_present || return 0
    expired="$(psql_as -c "select count(*) from oidc_login where $(where_oidc_login_expired)")"
    if [[ "$command" == "report" ]]; then
        log "  oidc_login: $(psql_as -c 'select count(*) from oidc_login') row(s), ${expired} older than ${OIDC_LOGIN_KEEP_HOURS} hour(s)"
        return 0
    fi
    if [[ "$dry_run" -eq 1 ]]; then
        log "  oidc_login: dry run, would remove ${expired} row(s)"
        return 0
    fi
    removed="$(psql_as -c "with removed as (
                              delete from oidc_login where $(where_oidc_login_expired)
                              returning 1
                           ) select count(*) from removed")"
    log "  oidc_login: removed ${removed} row(s) older than ${OIDC_LOGIN_KEEP_HOURS} hour(s)"
}

version_diffs_present() {
    [[ "$(psql_as -c "select to_regclass('public.version_diff') is not null")" == "t" ]]
}

#
# A kept diff whose version is no longer listed (a history reset, a removed
# cluster) or older than the listing reaches. The poller may only add diffs, so
# this is the one place they go. A cluster whose last listing failed is left
# alone: an unreadable history says nothing about which versions exist.
#
where_version_diff_unlisted() {
    echo "not exists (select 1 from cluster_history history,
                          jsonb_array_elements(case jsonb_typeof(history.result -> 'versions')
                              when 'array' then history.result -> 'versions' else '[]'::jsonb end)
                          as listed(version)
                    where history.cluster = version_diff.cluster
                      and listed.version ->> 'hash' = version_diff.commit)
          and not exists (select 1 from cluster_history unread
                           where unread.cluster = version_diff.cluster
                             and unread.outcome <> 'done')"
}

version_diffs() {
    local unlisted removed
    version_diffs_present || return 0
    unlisted="$(psql_as -c "select count(*) from version_diff where $(where_version_diff_unlisted)")"
    if [[ "$command" == "report" ]]; then
        log "  version_diff: $(psql_as -c 'select count(*) from version_diff') row(s), ${unlisted} for versions no longer listed"
        return 0
    fi
    if [[ "$dry_run" -eq 1 ]]; then
        log "  version_diff: dry run, would remove ${unlisted} row(s)"
        return 0
    fi
    removed="$(psql_as -c "with removed as (
                              delete from version_diff where $(where_version_diff_unlisted)
                              returning 1
                           ) select count(*) from removed")"
    log "  version_diff: removed ${removed} row(s) for versions no longer listed"
}

where_session_ended() {
    echo "coalesce(revoked_at, expires_at) < statement_timestamp() - make_interval(days => ${SESSION_KEEP_DAYS})"
}

where_login_attempt_old() {
    cat <<SQL
at < statement_timestamp() - make_interval(days => ${LOGIN_ATTEMPT_KEEP_DAYS})
   and not (succeeded and at = (select max(newest.at) from login_attempt newest
                                 where newest.username_normalised = login_attempt.username_normalised
                                   and newest.succeeded))
SQL
}

#
# Except each external certificate's newest download or export (0077): the
# registry row reads from it which version was last taken out, and a renewal
# nobody fetched for two years must not start to read as no download at all.
#
where_audit_old() {
    cat <<SQL
at < statement_timestamp() - make_interval(days => ${AUDIT_KEEP_DAYS})
   and not (action in ('certificate_export', 'certificate_download')
            and id = (select max(newest.id) from audit_event newest
                       where newest.action in ('certificate_export', 'certificate_download')
                         and newest.detail->>'certificate' = audit_event.detail->>'certificate'))
SQL
}

where_node_event_old() {
    echo "at < statement_timestamp() - make_interval(days => ${NODE_EVENT_KEEP_DAYS})"
}

#
# One table at a time, with the same predicate for the count and the delete.
#
account_history_table() {
    local table="$1" predicate="$2" keep="$3" expired removed
    expired="$(psql_as -c "select count(*) from ${table} where ${predicate}")"
    if [[ "$command" == "report" ]]; then
        log "  ${table}: $(psql_as -c "select count(*) from ${table}") row(s), ${expired} past ${keep}"
        return 0
    fi
    if [[ "$dry_run" -eq 1 ]]; then
        log "  ${table}: dry run, would remove ${expired} row(s)"
        return 0
    fi
    removed="$(psql_as -c "with removed as (
                              delete from ${table} where ${predicate}
                              returning 1
                           ) select count(*) from removed")"
    log "  ${table}: removed ${removed} row(s) past ${keep}"
}

account_history() {
    account_history_table app_session "$(where_session_ended)" "${SESSION_KEEP_DAYS} day(s) after they ended"
    account_history_table login_attempt "$(where_login_attempt_old)" "${LOGIN_ATTEMPT_KEEP_DAYS} day(s)"
    account_history_table audit_event "$(where_audit_old)" "${AUDIT_KEEP_DAYS} day(s)"
    #
    # A database from before 0071 has no such table; the next migration adds it.
    #
    if [[ "$(psql_as -c "select to_regclass('public.node_event') is not null")" == "t" ]]; then
        account_history_table node_event "$(where_node_event_old)" "${NODE_EVENT_KEEP_DAYS} day(s)"
    fi
}

#
# The day-partitioned record tables share one window: the traffic log and,
# since 0052, the WAF engine's matches, which are read beside the requests they
# came from. Each has its own `<table>_partition(day)` from its migration.
#
TRAFFIC_TABLES=(traffic_log waf_match)

#
# Every partitioned table. PostgreSQL's autovacuum analyzes each partition but
# never a partitioned parent, so the statistics a query over the whole table is
# planned with go stale unless something runs ANALYZE on it (review 2026-10-03,
# D1; PostgreSQL 16, "Updating Planner Statistics"). Held to the schema by a
# database test, so a new partitioned table cannot be left out.
#
PARTITIONED_TABLES=(traffic_log waf_match metric_frontend metric_backend_member metric_backend_hour)

statistics() {
    local table
    for table in "${PARTITIONED_TABLES[@]}"; do
        [[ "$(psql_as -c "select to_regclass('public.${table}') is not null")" == "t" ]] || continue
        if [[ "$dry_run" -eq 1 ]]; then
            log "  ${table}: dry run, statistics not refreshed"
            continue
        fi
        psql_as -c "analyze ${table}"
        log "  ${table}: statistics refreshed"
    done
}

partitions_expired() {
    local parent="$1"
    cat <<SQL
    select child.relname
      from pg_inherits
      join pg_class parent on parent.oid = pg_inherits.inhparent
      join pg_class child on child.oid = pg_inherits.inhrelid
     where parent.relname = '${parent}'
       and child.relname ~ '^${parent}_[0-9]{8}\$'
       and to_date(right(child.relname, 8), 'YYYYMMDD')
           < current_date - ${TRAFFIC_KEEP_DAYS} + 1
     order by child.relname
SQL
}

partition_report_query() {
    local table="$1"
    cat <<SQL
    select coalesce(sum(greatest(child.reltuples, 0)), 0)::bigint,
           count(*) filter (where child.reltuples < 0),
           pg_size_pretty(coalesce(sum(pg_total_relation_size(child.oid)), 0)::bigint)
      from pg_partition_tree('public.${table}'::regclass) tree
      join pg_class child on child.oid = tree.relid
     where tree.isleaf
SQL
}

traffic_report() {
    local table="$1" estimated unknown size exact figures
    figures="$(psql_as -c "$(partition_report_query "$table")")"
    IFS='|' read -r estimated unknown size <<< "$figures"
    if [[ "$exact_count" -eq 1 ]]; then
        exact="$(psql_as -c "select count(*) from ${table}")"
        log "  ${table}: ${exact} row(s) (exact), ${size}, retention ${TRAFFIC_KEEP_DAYS} day(s)"
    else
        log "  ${table}: ${estimated} row(s) (estimated), ${size}, retention ${TRAFFIC_KEEP_DAYS} day(s); ${unknown} partition(s) without statistics"
    fi
}

traffic_partitions() {
    local table partition
    local -a expired
    for table in "${TRAFFIC_TABLES[@]}"; do
        [[ "$(psql_as -c "select to_regclass('public.${table}') is not null")" == "t" ]] || continue
        expired=()
        if [[ "$dry_run" -eq 1 ]]; then
            log "  ${table}: dry run, partition horizon unchanged"
        else
            psql_as -c "select ${table}_partition(day::date)
                          from generate_series(
                              current_date - ${TRAFFIC_KEEP_DAYS} + 1,
                              current_date + ${TRAFFIC_AHEAD_DAYS},
                              interval '1 day'
                          ) as day" >/dev/null
        fi
        mapfile -t expired < <(psql_as -c "$(partitions_expired "$table")")
        if [[ "$dry_run" -eq 1 ]]; then
            log "  ${table}: ${#expired[@]} expired partition(s), none dropped"
            continue
        fi
        for partition in "${expired[@]}"; do
            psql_as -c "drop table if exists \"${partition}\""
        done
        log "  ${table}: dropped ${#expired[@]} expired partition(s)"
    done
}

#
# Counts kept per hour by a trigger beside the rows they were counted from.
# Not partitioned - a trigger that could meet a missing day could fail the
# insert it rides on - so they are trimmed here, a row at a time.
#
# The WAF page's (0054) keep the same first day the traffic partitions keep.
#
WAF_FINDING_TABLES=(waf_finding_path waf_finding_client)

where_waf_finding_expired() {
    echo "hour < (current_date - ${TRAFFIC_KEEP_DAYS} + 1)::timestamptz"
}

#
# The traffic cards' (0055) keep the longest window, 30 days, and an hour more
# than its start can reach. The migration fills no older hour.
#
METRIC_HOUR_TABLES=(metric_frontend_hour_delta metric_backend_hour_delta)
METRIC_HOUR_KEEP_DAYS=31

where_metric_hour_expired() {
    echo "hour < statement_timestamp() - interval '${METRIC_HOUR_KEEP_DAYS} days'"
}

#
# trim_hours <clause function> <what is kept> <table>...
#
trim_hours() {
    local where="$1" kept="$2" table expired removed
    shift 2
    for table in "$@"; do
        [[ "$(psql_as -c "select to_regclass('public.${table}') is not null")" == "t" ]] || continue
        expired="$(psql_as -c "select count(*) from ${table} where $("$where")")"
        if [[ "$command" == "report" ]]; then
            log "  ${table}: $(psql_as -c "select count(*) from ${table}") row(s), ${expired} before ${kept}"
            continue
        fi
        if [[ "$dry_run" -eq 1 ]]; then
            log "  ${table}: dry run, would remove ${expired} row(s)"
            continue
        fi
        removed="$(psql_as -c "with removed as (
                                  delete from ${table} where $("$where")
                                  returning 1
                               ) select count(*) from removed")"
        log "  ${table}: removed ${removed} row(s) before ${kept}"
    done
}

waf_findings() {
    trim_hours where_waf_finding_expired "the traffic window" "${WAF_FINDING_TABLES[@]}"
}

metric_hours() {
    trim_hours where_metric_hour_expired "the longest metrics window" "${METRIC_HOUR_TABLES[@]}"
}

metrics_report() {
    local table covered expired complete_before

    if ! metrics_present; then
        log "  metrics: no metric tables in ${DB_NAME} (migration 0018 not applied)"
        return 0
    fi

    if rollup_state_present; then
        complete_before="$(psql_as -c "select complete_before
                                          from metric_rollup_state
                                         where rollup_name = '${METRIC_ROLLUP_NAME}'")"
        [[ -n "$complete_before" ]] \
            || die "${METRIC_ROLLUP_NAME} has no completion boundary"
        log "  ${METRIC_ROLLUP_TABLE}: complete before ${complete_before}"
    else
        log "  ${METRIC_ROLLUP_TABLE}: no completion boundary (migration 0021 not applied)"
    fi

    for table in "${METRIC_TABLES[@]}"; do
        covered="$(psql_as -c "select count(*) from pg_inherits
                                 join pg_class parent on parent.oid = inhparent
                                where parent.relname = '${table}'")"
        expired="$(psql_as -c "select count(*) from ($(metric_partitions_expired "${table}")) as expired")"
        log "  ${table}: ${covered} partition(s), ${expired} older than ${METRIC_KEEP_DAYS} day(s)"
    done
}

#
# The rollup, computed from the raw rows rather than accumulated as they
# arrive. Derived data that can be rebuilt from its source is data that can be
# repaired; a running total maintained by the writer cannot be checked against
# anything, and a single bad hour would stay bad.
#
# A rollup row is deliberately the same shape as a bucketed raw reading - the
# last cumulative value in the hour and the lowest uptime inside it - so the
# reader that takes differences and spots restarts is the same one either way.
#
# `on conflict do nothing`, so a run that overlaps an earlier one adds only the
# hours that are missing. Recomputing an hour that already exists would be
# rewriting history from rows that may since have been dropped.
#
rollup() {
    local written complete_before

    log "  ${METRIC_ROLLUP_TABLE}: hourly rollup"
    if [[ "$dry_run" -eq 1 ]]; then
        log "  ${METRIC_ROLLUP_TABLE}: dry run, nothing computed"
    else
        psql_as -c "select metric_month_partition('${METRIC_ROLLUP_TABLE}', month::date)
                      from generate_series(
                          date_trunc('month', current_date - ${METRIC_ROLLUP_KEEP_DAYS}),
                          date_trunc('month', current_date + interval '1 month'),
                          interval '1 month'
                      ) as month" >/dev/null
    fi

    if [[ "$dry_run" -eq 1 ]]; then
        :
    elif rollup_state_present; then
        IFS=$'\t' read -r written complete_before <<< "$(psql_as -F $'\t' <<SQL
with boundary as (
    select date_trunc('hour', statement_timestamp())
           - make_interval(days => ${METRIC_ROLLUP_LAG_DAYS}) as complete_before
), hours as (
    select distinct on (cluster, node, backend, member, bucket)
           cluster, node, backend, member,
           date_trunc('hour', observed_at) as bucket,
           observed_at, uptime_sec, status, check_status, check_code,
           min(uptime_sec) over (
               partition by cluster, node, backend, member, date_trunc('hour', observed_at)
           ) as floor_uptime_sec,
           ${METRIC_COUNTERS}
      from metric_backend_member
     where observed_at < (select complete_before from boundary)
     order by cluster, node, backend, member, bucket, observed_at desc
), added as (
    insert into ${METRIC_ROLLUP_TABLE}
        (cluster, node, backend, member, bucket_at, observed_at, uptime_sec,
         floor_uptime_sec, status, check_status, check_code, ${METRIC_COUNTERS})
    select cluster, node, backend, member, bucket, observed_at, uptime_sec,
           floor_uptime_sec, status, check_status, check_code, ${METRIC_COUNTERS}
      from hours
    on conflict do nothing
    returning 1
), advanced as (
    insert into metric_rollup_state (rollup_name, complete_before)
    select '${METRIC_ROLLUP_NAME}', complete_before from boundary
    on conflict (rollup_name) do update
       set complete_before = greatest(
               metric_rollup_state.complete_before,
               excluded.complete_before
           ),
           updated_at = transaction_timestamp()
    returning complete_before
)
select (select count(*) from added), (select complete_before from advanced);
SQL
        )"
        [[ -n "$written" && -n "$complete_before" ]] \
            || die "${METRIC_ROLLUP_NAME} did not advance its completion boundary"
        log "  ${METRIC_ROLLUP_TABLE}: added ${written} hour(s), complete before ${complete_before}"
    else
        #
        # The command is installed apart from the release, so a database may
        # sit at an older migration during a rollout. Keep the old schema
        # working until it reaches 0021; the corrected call order still rolls
        # these rows up before age-based pruning.
        #
        written="$(psql_as <<SQL
with hours as (
    select distinct on (cluster, node, backend, member, bucket)
           cluster, node, backend, member,
           date_trunc('hour', observed_at) as bucket,
           observed_at, uptime_sec, status, check_status, check_code,
           min(uptime_sec) over (
               partition by cluster, node, backend, member, date_trunc('hour', observed_at)
           ) as floor_uptime_sec,
           ${METRIC_COUNTERS}
      from metric_backend_member
     where observed_at < date_trunc('hour', statement_timestamp())
                         - make_interval(days => ${METRIC_ROLLUP_LAG_DAYS})
     order by cluster, node, backend, member, bucket, observed_at desc
), added as (
    insert into ${METRIC_ROLLUP_TABLE}
        (cluster, node, backend, member, bucket_at, observed_at, uptime_sec,
         floor_uptime_sec, status, check_status, check_code, ${METRIC_COUNTERS})
    select cluster, node, backend, member, bucket, observed_at, uptime_sec,
           floor_uptime_sec, status, check_status, check_code, ${METRIC_COUNTERS}
      from hours
    on conflict do nothing
    returning 1
)
select count(*) from added;
SQL
        )"
        log "  ${METRIC_ROLLUP_TABLE}: added ${written} hour(s); completion boundary unavailable"
    fi

    mapfile -t dropped < <(psql_as -c "
        select child.relname
          from pg_inherits
          join pg_class parent on parent.oid = pg_inherits.inhparent
          join pg_class child  on child.oid  = pg_inherits.inhrelid
         where parent.relname = '${METRIC_ROLLUP_TABLE}'
           and child.relname ~ '^${METRIC_ROLLUP_TABLE}_[0-9]{6}\$'
           and to_date(right(child.relname, 6), 'YYYYMM')
               < date_trunc('month', current_date - ${METRIC_ROLLUP_KEEP_DAYS})
         order by child.relname")
    if [[ ${#dropped[@]} -eq 0 || -z "${dropped[0]}" ]]; then
        log "  ${METRIC_ROLLUP_TABLE}: nothing older than ${METRIC_ROLLUP_KEEP_DAYS} day(s)"
        return 0
    fi
    if [[ "$dry_run" -eq 1 ]]; then
        log "  ${METRIC_ROLLUP_TABLE}: dry run, would drop ${#dropped[@]} partition(s)"
        return 0
    fi
    for partition in "${dropped[@]}"; do
        psql_as -c "drop table if exists \"${partition}\""
    done
    log "  ${METRIC_ROLLUP_TABLE}: dropped ${#dropped[@]} partition(s)"
}

metric_partitions_prepare() {
    local table created

    if ! metrics_present; then
        log "  metrics: no metric tables in ${DB_NAME} (migration 0018 not applied)"
        return 0
    fi

    for table in "${METRIC_TABLES[@]}"; do
        #
        # One statement over a series rather than one call per day. The
        # function is `create table if not exists`, so a run that overlaps an
        # earlier one adds only what is missing - and the normal daily answer
        # is that it added one, which is not worth 61 round trips to find out.
        #
        if [[ "$dry_run" -eq 1 ]]; then
            log "  ${table}: dry run, would cover to $(date -d "+${METRIC_AHEAD_DAYS} days" +%F)"
        else
            created="$(psql_as -c "select count(*) from generate_series(
                                       current_date,
                                       current_date + ${METRIC_AHEAD_DAYS},
                                       interval '1 day'
                                   ) as day, metric_partition('${table}', day::date)")"
            log "  ${table}: ${created} day(s) covered, to $(date -d "+${METRIC_AHEAD_DAYS} days" +%F)"
        fi

    done
}

metric_partitions_prune() {
    local table dropped partition

    for table in "${METRIC_TABLES[@]}"; do
        mapfile -t dropped < <(psql_as -c "$(metric_partitions_expired "${table}")")
        if [[ ${#dropped[@]} -eq 0 || -z "${dropped[0]}" ]]; then
            log "  ${table}: nothing older than ${METRIC_KEEP_DAYS} day(s)"
            continue
        fi
        if [[ "$dry_run" -eq 1 ]]; then
            log "  ${table}: dry run, would drop ${#dropped[@]} partition(s)"
            continue
        fi
        for partition in "${dropped[@]}"; do
            #
            # Detached and dropped in one statement rather than deleted from.
            # Dropping the partition is what makes a week of raw samples cost
            # nothing to remove; a `delete` would rewrite the same rows into
            # dead tuples and leave the table to be vacuumed.
            #
            psql_as -c "drop table if exists \"${partition}\""
        done
        log "  ${table}: dropped ${#dropped[@]} partition(s)"
    done
}

[[ $EUID -eq 0 ]] || die "run this with sudo"

dry_run=0
exact_count=0
command="${1:-}"
shift || true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --days) KEEP_DAYS="${2:-}"; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        --exact) exact_count=1; shift ;;
        *) usage ;;
    esac
done
[[ "$exact_count" -eq 0 || "$command" == "report" ]] || usage
[[ "$KEEP_DAYS" =~ ^[0-9]+$ && "$KEEP_DAYS" -ge 1 ]] || die "--days takes a whole number of days"

config="${CONFIG_DIRECTORY}/ui-admin.conf"
[[ -r "$config" ]] || { echo "ERROR: cannot read ${config}" >&2; exit 78; }
# shellcheck disable=SC1090
source "$config"
for name in DB_NAME DB_ROLE; do
    [[ -n "${!name:-}" ]] || die "${name} is not set in ${config}"
done
if [[ -n "${UI_CONFIG:-}" && -r "$UI_CONFIG" ]]; then
    TRAFFIC_KEEP_DAYS="$(/usr/bin/python3 - "$UI_CONFIG" <<'PY'
import sys
import tomllib
with open(sys.argv[1], "rb") as stream:
    value = tomllib.load(stream).get("traffic_logs", {}).get("retention_days", 7)
if not isinstance(value, int) or isinstance(value, bool) or not 1 <= value <= 90:
    raise SystemExit("traffic_logs.retention_days must be an integer between 1 and 90")
print(value)
PY
)"
fi

#
# `client_min_messages=warning` silences one NOTICE per partition that already
# exists - about seventy of them on a normal daily run, since `create
# table if not exists` is how the horizon is kept idempotent. A command whose
# successful output is seventy-five lines of noise is one whose output stops
# being read, and the run that finally has something to say says it in the
# middle of them. Warnings and errors are untouched.
#
psql_as() {
    PGOPTIONS='-c client_min_messages=warning' \
        psql -U "$DB_ROLE" -d "$DB_NAME" -qtAX -v ON_ERROR_STOP=1 "$@"
}

#
# One predicate, written once and used by both the count and the delete, so
# `report` cannot describe a different set of rows than `prune` removes.
#
# Three conditions, and each one is load-bearing. A job that has not finished is
# never removed however old it is: `pending` and `running` are the states the
# single-active-job index is built on, and deleting one would let a second
# operation start on a cluster that is still being changed. `finished_at` is
# guaranteed non-null for every other state by the table's own constraint, so
# the age test cannot silently match a row with no timestamp. And the floor is
# applied as a subquery rather than as a second pass, so a run cannot delete
# rows between counting them and keeping them.
#
# The floor's ordering is the jobs page's ordering, character for character,
# and that is the whole of its correctness. The floor exists to promise that
# nothing the page can show is ever removed; ordered any other way it selects a
# different twenty rows than the page does and quietly stops promising that.
# A rehearsal on 2026-08-31 found exactly this: ordered by id alone, a backdated
# row the page would never list took one of the twenty places.
#
#
# A profile's state is read from its apply jobs, not from its row: "In effect"
# means the job that wrote the root-owned file is done for the current
# revision. So the jobs that say so are kept for as long as the profile exists,
# whatever their age - the newest job, and the newest apply under it, which a
# refused removal on top leaves in charge. Pruned after a week, a profile that
# had been in effect for months read "Not applied" and dropped out of the
# certificate form (found 2026-09-26).
#
profile_evidence() {
    local operation="$1" table="$2" applies_only="$3"
    cat <<SQL
    select distinct on (payload->>'profile') id from job
     where operation = '${operation}'
       and payload->>'profile' in (select id from ${table})
       ${applies_only}
     order by payload->>'profile', created_at desc, id desc
SQL
}

#
# A draft is cleared by the interface once its publish is done and the objects
# cache shows it, and the done publish job is the evidence it reads. So that job
# is kept for as long as its draft exists: pruned first, a published draft read
# as unpublished work and opened in place of the stored object (review
# 2026-10-04, CR-04). A saved network description or settings document (B257)
# is cleared the same way, by the publish its `change` names.
#
draft_evidence() {
    cat <<SQL
    select job.id from job
      join proxy_draft on job.payload->'draft'->>'id' = proxy_draft.id::text
     where job.operation = 'objects_publish'
    union
    select job.id from job
      join cluster_change on job.payload->'change'->>'id' = cluster_change.id::text
     where job.operation in ('network_publish', 'cluster_settings_publish')
    union
    select job.id from job
      cross join lateral jsonb_array_elements(
          coalesce(job.payload->'drafts', '[]') || coalesce(job.payload->'changes', '[]')
      ) as entry
     where job.operation = 'changes_publish'
       and (entry->>'id' in (select id::text from proxy_draft)
            or entry->>'id' in (select id::text from cluster_change))
SQL
}

where_removable() {
    local applies="and coalesce(payload->>'remove', 'false') <> 'true'"
    cat <<SQL
    state not in ('pending', 'running')
    and finished_at < statement_timestamp() - make_interval(days => ${KEEP_DAYS})
    and id not in (select id from job order by created_at desc, id desc limit ${KEEP_MINIMUM})
    and id not in ($(profile_evidence dns_profile_apply dns_provider_profile ""))
    and id not in ($(profile_evidence dns_profile_apply dns_provider_profile "$applies"))
    and id not in ($(profile_evidence ndes_profile_apply ndes_provider_profile ""))
    and id not in ($(profile_evidence ndes_profile_apply ndes_provider_profile "$applies"))
    and id not in ($(draft_evidence))
SQL
}

counts() {
    psql_as -c "select count(*) from job" \
            -c "select count(*) from job where $(where_removable)"
}

main() {
    local total removable removed table
    { read -r total; read -r removable; } < <(counts)

    log "  ${DB_NAME}: ${total} job row(s), ${removable} older than ${KEEP_DAYS} day(s)"
    log "  keeping the ${KEEP_MINIMUM} most recent whatever their age"

    case "$command" in
        report)
            metrics_report
            for table in "${TRAFFIC_TABLES[@]}"; do
                [[ "$(psql_as -c "select to_regclass('public.${table}') is not null")" == "t" ]] || continue
                traffic_report "$table"
            done
            waf_findings
            metric_hours
            oidc_logins
            version_diffs
            account_history
            ;;
        prune)
            #
            # The partitions first, and the jobs after. If a run is going to
            # fail it should fail before the horizon has been extended rather
            # than after - a database with a week of jobs pruned and no
            # partition for tomorrow is worse than one with neither done.
            #
            metric_partitions_prepare
            traffic_partitions
            waf_findings
            metric_hours
            if metrics_present; then
                #
                # After the partitions and before the pruning, because the
                # rollup reads rows the pruning is about to remove. Reversed,
                # a run that pruned first would roll up an hour whose samples
                # had just been dropped - and produce a gap that looks like a
                # restart.
                #
                rollup
                metric_partitions_prune
            fi
            oidc_logins
            version_diffs
            account_history
            statistics
            if [[ "$dry_run" -eq 1 ]]; then
                log "  dry run: nothing was deleted"
            elif [[ "$removable" -eq 0 ]]; then
                log "  nothing to remove"
            else
                #
                # The count comes back from the delete itself rather than from
                # the number counted a moment ago: a worker may have finished a
                # job in between, and reporting the earlier number would state
                # something that was true before the command ran.
                #
                removed="$(psql_as -c "with removed as (
                                          delete from job where $(where_removable)
                                          returning 1
                                       ) select count(*) from removed")"
                log "  removed  ${removed} job row(s)"
            fi
            ;;
        *)
            usage
            ;;
    esac
}

main
