#!/bin/bash
#
# haprion-rollback - go back to an earlier release, having first checked
# that the earlier release can actually run here.
#
#     haprion-rollback --list
#     haprion-rollback [--to <release-id>]
#
# The documented rollback used to be "point current back and restart", and on
# 2026-08-28 that was measured rather than assumed. It took the interface down.
#
# Two reasons, and neither is visible from the symlink:
#
#   * Configuration is validated strictly - unknown keys are refused, which is
#     what makes a typo an error instead of a setting that silently does
#     nothing. A config written for release N therefore makes release N-1 refuse
#     to start, and the rollback that was supposed to be the way out of trouble
#     becomes more of it.
#   * A unit installed for a newer release names a program that an older release
#     does not contain. The poller and the worker did not exist in every release
#     that is still on disk.
#
# So this checks both against the target BEFORE switching, and verifies the
# interface answers AFTER - rolling forward again by itself if it does not. A
# rollback that needs a second rollback is not a way back.
#
set -Eeuo pipefail

CONFIG=/etc/haprion/ui.toml
SERVICES=(haprion-web haprion-worker haprion-poller)

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
step() { echo; echo "== $*"; }
warn() { echo "WARNING: $*" >&2; }
die()  { echo "ERROR: $*" >&2; exit 1; }

#
# A root-owned KEY=value file a platform step wrote (ui-admin.conf, ui-tls.conf),
# read as haprion.admin_file reads it: comments, blank lines and plain
# assignments, anything else refused rather than interpreted, the last of a key
# winning. Only the keys named are set, as variables of the caller. The same
# function in install/lib.sh and in each command under install/platform/bin/
# that reads one, held together by a test (review 2026-10-22, 6-10).
#
read_admin_file() {
    local file="$1" line number=0 key
    local pattern='^([A-Z][A-Z0-9_]*)=([A-Za-z0-9_./:@+,=-]+)$'
    shift
    while IFS= read -r line || [[ -n "$line" ]]; do
        number=$((number + 1))
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == "#"* ]] && continue
        if [[ ! "$line" =~ $pattern ]]; then
            echo "ERROR: ${file}:${number}: not a plain assignment" >&2
            return 78
        fi
        for key; do
            if [[ "${BASH_REMATCH[1]}" == "$key" ]]; then
                printf -v "$key" '%s' "${BASH_REMATCH[2]}"
            fi
        done
    done < "$file"
    return 0
}
counted() { if [[ "$1" == 1 ]]; then echo "1 $2"; else echo "$1 ${3:-$2s}"; fi; }  # "1 row", "2 rows"

usage() { sed -n '3,8p' "$0" | sed 's/^# \?//'; exit 64; }

RELEASE_LOCK=/run/haprion/ui-release.lock
# The same path as RESTORE_STOPPED in lib.sh and haprion-backup, held together by a test.
RESTORE_STOPPED=/run/haprion/restore-stopped
#
# One change of the UI release at a time (review 26-10-29, A10): an update,
# a rollback, an activation or a setup run beside another paused the worker
# twice - the first one's resume lifting the second's pause mid-restart - and
# switched `current` in no order. Held on descriptor 9 until the command
# exits. A command it starts inherits the descriptor, and `flock` on that same
# descriptor succeeds where a second opening of the file fails. The same
# function in lib.sh and haprion-rollback, held together by a test.
#
hold_release_lock() {
    local holder mask again="run this again when it is done"
    if [[ "$(readlink "/proc/$$/fd/9" 2>/dev/null || true)" == "$RELEASE_LOCK" ]] && flock -n 9; then
        return 0
    fi
    mkdir -p -- "${RELEASE_LOCK%/*}"
    #
    # Root's alone: `flock` takes a file opened for reading too, and so any
    # account that could read it held every change off (review 26-10-29,
    # AA06). Made 0600: /run is emptied at every boot, and a `chmod` after
    # making it left a moment any account could open it in, the descriptor
    # outliving the `chmod` (AAA03). Set on the file each time too, for one an
    # older release made 0644.
    #
    mask="$(umask)"
    umask 077
    exec 9>>"$RELEASE_LOCK"
    umask "$mask"
    chmod 600 -- "$RELEASE_LOCK"
    if ! flock -n 9; then
        holder="$(head -1 "$RELEASE_LOCK" 2>/dev/null || true)"
        [[ -z "${DPKG_MAINTSCRIPT_PACKAGE:-}" ]] || again="when it is done: sudo dpkg --configure -a"
        die "another change of the UI release is running (pid ${holder:-unknown} or a command it started); ${again}"
    fi
    printf '%s\n' "$$" > "$RELEASE_LOCK"
    #
    # A restore that stopped the services and did not finish leaves the dump's
    # jobs unheld: whatever started them - an activation, a rollback's restart -
    # would start the worker on them. Said before anything is paused, migrated
    # or switched (review 26-10-30, F1, U3).
    #
    if [[ -e "$RESTORE_STOPPED" ]]; then
        again="Run it again first: sudo haprion-backup restore <dump>"
        [[ -z "${DPKG_MAINTSCRIPT_PACKAGE:-}" ]] || again+=", then: sudo dpkg --configure -a"
        die "a restore stopped the services and did not finish; nothing was changed.
  ${again}"
    fi
}

#
# The import package of the UI release a Python interpreter belongs to, asked of
# the release itself: the package behind its `haprion-worker` command. A release
# this one replaces or rolls back to may call its package something else; the
# command is what every release has. The same function in lib.sh,
# haprion-backup, haprion-rollback and haprion-web, held together by a test.
#
release_module() {
    "$1" -I -c 'from importlib.metadata import entry_points
print(entry_points(group="console_scripts")["haprion-worker"].module.partition(".")[0])'
}

[[ $EUID -eq 0 ]] || die "run this with sudo"

platform_root=/opt/haprion-ui
releases="${platform_root}/releases"
link="${platform_root}/current"
[[ -L "$link" ]] || die "${link} does not exist"

#
# Ordered by modification time rather than by name - the time of the commit
# the release was built from, which the build gives every file. A release id
# ends in a commit hash, which sorts alphabetically and says nothing about
# when it was built - so sorting by name would offer a "previous" release at
# random.
#
read_releases() {
    current="$(basename "$(readlink "$link")")"
    mapfile -t known < <(find "$releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' \
                         | sort -rn | cut -d' ' -f2-)
}

target=""
case "${1:-}" in
    --list)
        read_releases
        for release in "${known[@]}"; do
            if [[ "$release" == "$current" ]]; then
                echo "  ${release}  <- current"
            else
                echo "  ${release}"
            fi
        done
        exit 0
        ;;
    --to) target="${2:-}"; [[ -n "$target" ]] || usage ;;
    "")  ;;
    *)   usage ;;
esac

#
# Read under the lock, as an update reads them: an update that ended in
# between had changed `current`, and the rollback then named the release
# before it (review 26-10-29, AA06).
#
hold_release_lock
read_releases
if [[ -z "$target" ]]; then
    for release in "${known[@]}"; do
        [[ "$release" == "$current" ]] && continue
        target="$release"
        break
    done
fi
[[ -n "$target" ]] || die "there is no other release to roll back to"
[[ -d "${releases}/${target}" ]] || die "no such release: ${target}"
[[ "$target" != "$current" ]] || die "${target} is already current"

log "current: ${current}"
log "target:  ${target}"

step "Can the target run with the configuration that is installed?"
#
# Asked of the target's own code, because the answer is whatever that release's
# validator says and not what this script believes about it. Loading the config
# is exactly what the service does first, so a release that passes here starts.
#
#
# Path, not str: `load` takes a Path and a string fails on it with an
# AttributeError - which this script would have read as "the target refuses the
# configuration". A check that says no to everything is exactly as useless as
# one that says yes to everything, and it fails in the more convincing
# direction. Found by running it against a release that should have passed.
#
# Any exception counts as a refusal, not only ConfigError: whatever the target
# does when it reads this file is what it will do at startup.
#
target_python="${releases}/${target}/venv/bin/python"
module="$(release_module "$target_python")" \
    || die "${target} does not say which package it is; it has no haprion-worker command"
if ! "$target_python" -c '
import importlib
import sys
from pathlib import Path
load = importlib.import_module(sys.argv[1] + ".config").load
try:
    load(Path(sys.argv[2]))
except Exception as exc:
    print(f"the target release refuses this configuration: {exc}", file=sys.stderr)
    raise SystemExit(1)
' "$module" "$CONFIG" 2>&1 | sed 's/^/  /'; then
    die "${target} cannot read ${CONFIG}.
  Configuration follows the same expand/contract rule as the schema: a key added
  for a newer release has to be removed from the configuration before rolling
  back past the release that introduced it."
fi
log "  ok       the target accepts the configuration"
#
# Where the proof below asks: the web's socket where its unit has one
# (haprion-web.socket), else the port the target reads from ui.toml - the unit
# an update that did not finish put back.
#
WEB_SOCKET=/run/haprion-web.sock
port="$("$target_python" -I -c '
import importlib
import sys
from pathlib import Path
load = importlib.import_module(sys.argv[1] + ".config").load
print(load(Path(sys.argv[2])).listen.port)
' "$module" "$CONFIG" 2>/dev/null || true)"

step "Does the target contain what the installed units start?"
missing=""
for service in "${SERVICES[@]}"; do
    unit="/etc/systemd/system/${service}.service"
    [[ -f "$unit" ]] || continue
    #
    # Read out of the unit rather than assumed, so a unit that was edited by
    # hand is checked as it actually is.
    #
    program="$(sed -n 's|^ExecStart=\([^ ]*\).*|\1|p' "$unit" | head -1)"
    program="${program/${platform_root}\/current/${releases}/${target}}"
    if [[ -n "$program" && ! -x "$program" ]]; then
        warn "  missing  ${service}: ${program}"
        missing="${missing} ${service}"
    else
        log "  ok       ${service}"
    fi
done
[[ -z "$missing" ]] || die "${target} does not contain the $(counted "$(wc -w <<<"$missing")" program | cut -d" " -f2-) for:${missing}.
  Those services were added after that release. Roll back to a release that has
  them, or stop and disable them first - deliberately, not by surprise."

step "Can the target run on the database's schema?"
#
# The web starts on a schema newer than its own head, because a rollback over
# migrations declared safe for it is exactly that - and so this is the place
# that decides whether they were (26-10-20: nothing did before). Asked with the
# interpreter of the release this package installed, which knows the newest
# migrations; the target may predate the question.
#
admin_config="/etc/haprion/ui-admin.conf"
[[ -r "$admin_config" ]] || die "cannot read ${admin_config}"
read_admin_file "$admin_config" DB_NAME DB_ROLE || exit 78
[[ -n "${DB_NAME:-}" && -n "${DB_ROLE:-}" ]] || die "DB_NAME or DB_ROLE is not set in ${admin_config}"
revision="$(psql -U "$DB_ROLE" -d "$DB_NAME" -qtAX -v ON_ERROR_STOP=1 \
            -c 'select version_num from alembic_version')" \
    || die "the database did not say its schema revision"
payload=/usr/lib/haprion/ui/PAYLOAD
packaged="$(sed -n 's/^RELEASE_ID=//p' "$payload" 2>/dev/null)"
[[ -n "$packaged" && -x "${releases}/${packaged}/venv/bin/python" ]] \
    || die "the release this package installed (${payload}) is not on disk"
packaged_python="${releases}/${packaged}/venv/bin/python"
if ! "$packaged_python" -I -m "$(release_module "$packaged_python").rollback_schema" \
        --platform-root "$platform_root" --target "$target" --revision "$revision" \
        --packaged "$packaged" 2>&1 \
        | sed 's/^/  /'; then
    die "${target} cannot run on the database's schema ${revision}.
  Roll back to a release at or after the one the schema is declared safe from,
  or restore the database dump taken before the migration."
fi
log "  ok       the target runs on schema ${revision}"

step "Holding the worker's claims"
#
# As a release does (CR-12): the restart below ends the job the worker holds.
# Installed beside this command by the haprion-ui package.
#
drain=/usr/sbin/haprion-drain
if [[ -x "$drain" ]]; then
    # Before the call: a way out during its wait lifts it too (review 26-10-29, A5).
    trap '"$drain" resume || true' EXIT
    "$drain" pause --wait "${DRAIN_SECONDS:-900}"
else
    warn "  ${drain} is missing; the worker restarts without waiting for its jobs"
fi

step "Switching"
ln -sfn "${releases}/${target}" "${link}.new"
mv -T "${link}.new" "$link"
log "  current -> ${target}"

#
# A release whose web dies at start is restarted every 2 s, and five starts in
# 10 s is the start limit, manual starts included: a restart after it is
# refused, and the target would never answer. `reset-failed` sets the count
# back to zero (review 26-10-29, AA02).
#
systemctl reset-failed "${SERVICES[@]}" 2>/dev/null || true
systemctl restart "${SERVICES[@]}" || true

step "Proving the interface answers"
answered=""
for _ in $(seq 15); do
    if [[ -S "$WEB_SOCKET" ]]; then
        answered="$(curl -fsS --max-time 3 --unix-socket "$WEB_SOCKET" http://localhost/healthz 2>/dev/null)" || answered=""
    elif [[ -n "$port" ]]; then
        answered="$(curl -fsS --max-time 3 "http://127.0.0.1:${port}/healthz" 2>/dev/null)" || answered=""
    fi
    if [[ -n "$answered" ]]; then
        break
    fi
    answered=""
    sleep 1
done

if [[ -z "$answered" ]]; then
    #
    # Undone without being asked. Somebody running this is already having a bad
    # day, and leaving them on a release that does not answer - with the rollback
    # reported as done - is the worst possible outcome of a command whose entire
    # purpose is to get back to something that works.
    #
    warn "the interface did not answer on ${target}; switching back to ${current}"
    ln -sfn "${releases}/${current}" "${link}.new"
    mv -T "${link}.new" "$link"
    systemctl reset-failed "${SERVICES[@]}" 2>/dev/null || true
    systemctl restart "${SERVICES[@]}" || true
    journalctl -u haprion-web.service --no-pager --lines=15 || true
    die "back on ${current}; ${target} did not answer"
fi

log "  ok       ${answered}"
for service in "${SERVICES[@]}"; do
    if systemctl is-active --quiet "${service}.service"; then
        log "  ok       ${service}.service"
    else
        warn "  ${service}.service is not active"
    fi
done

echo
# The same words either way: --to may name a newer release as well as an older one (R2, F13).
log "switched to ${target}"
log "To go back: haprion-rollback --to ${current}"
