#!/bin/bash
#
# haprion-tls - inspect and replace the certificate nginx serves the UI with.
#
#     haprion-tls [--config /etc/haprion/ui-tls.conf] show
#     haprion-tls [--config /etc/haprion/ui-tls.conf] install --cert <file> --key <file>
#     haprion-tls [--config /etc/haprion/ui-tls.conf] self-signed [--days <n>]
#     haprion-tls [--config /etc/haprion/ui-tls.conf] publish
#
# This certificate is what an operator's browser meets when logging in. It is
# not the certificate on the HAProxy pair, and it is not used between nginx and
# the web service - that leg is plain HTTP over a local socket, deliberately.
#
# It comes from the certificate registry - an entry marked `interface: true`,
# issued or imported like any other and installed through this command - or,
# until there is one, it is self-signed or a pair handed to this command. See
# B21 and B188 (review 2026-10-24: this said the registry could not supply it).
#
# Root only, and it stays that way. The web identity must never read private key
# material - a form that accepts a key would make a web intrusion sufficient to
# replace the manager's own certificate. The UI's path to this command is to
# name a candidate the poller already listed; the bytes never pass through it.
#
set -Eeuo pipefail

DEFAULT_CONF=/etc/haprion/ui-tls.conf
CONF="$DEFAULT_CONF"

log()  { echo "[$(date '+%H:%M:%S')] $*"; }
warn() { echo "WARNING: $*" >&2; }
die()  { echo "ERROR: $*" >&2; exit 1; }

#
# A root-owned KEY=value file a platform step wrote (ui-admin.conf, ui-tls.conf),
# read as haprion.admin_file reads it: comments, blank lines and plain
# assignments, anything else refused rather than interpreted, the last of a key
# winning. Only the keys named are set, as variables of the caller. The same
# function in install/lib.sh and in each command under install/platform/bin/
# that reads one, held together by a test (review 2026-10-22, 6-10).
#
read_admin_file() {
    local file="$1" line number=0 key
    local pattern='^([A-Z][A-Z0-9_]*)=([A-Za-z0-9_./:@+,=-]+)$'
    shift
    while IFS= read -r line || [[ -n "$line" ]]; do
        number=$((number + 1))
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "$line" == "#"* ]] && continue
        if [[ ! "$line" =~ $pattern ]]; then
            echo "ERROR: ${file}:${number}: not a plain assignment" >&2
            return 78
        fi
        for key; do
            if [[ "${BASH_REMATCH[1]}" == "$key" ]]; then
                printf -v "$key" '%s' "${BASH_REMATCH[2]}"
            fi
        done
    done < "$file"
    return 0
}

usage() {
    sed -n '3,10p' "$0" | sed 's/^# \?//'
    exit 64
}

[[ $EUID -eq 0 ]] || die "run this with sudo"

#
# The default is the interface's own pair. --config names another file under
# /etc/haprion; the interface's TLS helper passes it explicitly.
#
if [[ "${1:-}" == "--config" ]]; then
    CONF="${2:-}"
    shift 2 || usage
fi
[[ "$CONF" == /etc/haprion/*.conf && "$CONF" != *".."* ]] \
    || die "--config must name a configuration file under /etc/haprion"

#
# Exit 78 rather than guessing, the same contract the node scripts follow: a
# command that invents its own paths is worse than one that refuses to run.
#
[[ -r "$CONF" ]] || { echo "ERROR: cannot read ${CONF}" >&2; exit 78; }
read_admin_file "$CONF" TLS_CERT TLS_KEY SERVER_NAME || exit 78
for name in TLS_CERT TLS_KEY SERVER_NAME; do
    [[ -n "${!name:-}" ]] || die "${name} is not set in ${CONF}"
done

#
# Public keys, not fingerprints of the files: a cert and a key belong together
# when the key's public half matches the one in the certificate, whatever
# format or encoding either arrived in.
#
pair_matches() {
    local cert="$1" key="$2" a b
    a="$(openssl x509 -in "$cert" -noout -pubkey 2>/dev/null)" || return 1
    b="$(openssl pkey -in "$key" -pubout 2>/dev/null)" || return 1
    [[ "$a" == "$b" ]]
}

describe() {
    local cert="$1" sans issuer subject
    subject="$(openssl x509 -in "$cert" -noout -subject | sed 's/^subject=//')"
    issuer="$(openssl x509 -in "$cert" -noout -issuer | sed 's/^issuer=//')"
    sans="$(openssl x509 -in "$cert" -noout -ext subjectAltName 2>/dev/null \
            | tail -n +2 | tr -d ' ' || true)"
    echo "  subject      ${subject}"
    echo "  issuer       ${issuer}"
    echo "  san          ${sans:-<none>}"
    echo "  not after    $(openssl x509 -in "$cert" -noout -enddate | sed 's/^notAfter=//')"
    echo "  fingerprint  $(openssl x509 -in "$cert" -noout -fingerprint -sha256 \
                           | sed 's/^.*=//')"
    if [[ "$subject" == "$issuer" ]]; then
        echo "  self-signed  yes - browsers will warn until this is replaced"
    else
        echo "  self-signed  no"
    fi
}

#
# The install path, shared by every way a pair gets here. One implementation,
# not two: the installer's self-signed starting point takes this same route, so
# validation, permissions, the config test and the rollback cannot drift apart
# from the path an operator uses later.
#
activate() {
    local new_cert="$1" new_key="$2" backup=""

    [[ -r "$new_cert" ]] || die "certificate not readable: ${new_cert}"
    [[ -r "$new_key" ]]  || die "key not readable: ${new_key}"
    openssl x509 -in "$new_cert" -noout >/dev/null 2>&1 \
        || die "not a PEM certificate: ${new_cert}"
    openssl pkey -in "$new_key" -noout >/dev/null 2>&1 \
        || die "not a readable private key (encrypted keys are not supported): ${new_key}"
    pair_matches "$new_cert" "$new_key" \
        || die "certificate and key do not belong together"
    openssl x509 -in "$new_cert" -noout -checkend 0 >/dev/null \
        || die "certificate has already expired: ${new_cert}"
    openssl x509 -in "$new_cert" -noout -checkend 2592000 >/dev/null \
        || warn "certificate expires within 30 days"

    install -d -o root -g root -m 700 "$(dirname "$TLS_KEY")" "$(dirname "$TLS_CERT")"

    if [[ -f "$TLS_CERT" && -f "$TLS_KEY" ]]; then
        backup="$(mktemp -d /etc/haprion/.tls-rollback-XXXXXX)"
        cp -a "$TLS_CERT" "${backup}/cert"
        cp -a "$TLS_KEY" "${backup}/key"
    fi

    #
    # Written beside the target and renamed, so nginx never reads a half-written
    # pair if this is interrupted.
    #
    install -o root -g root -m 644 "$new_cert" "${TLS_CERT}.incoming"
    install -o root -g root -m 600 "$new_key" "${TLS_KEY}.incoming"
    mv -f "${TLS_CERT}.incoming" "$TLS_CERT"
    mv -f "${TLS_KEY}.incoming" "$TLS_KEY"
    log "  installed ${TLS_CERT}"
    log "  installed ${TLS_KEY}"

    #
    # Asked of nginx rather than assumed. If it refuses the new pair the old one
    # goes back and the failure is reported - a manager whose UI stopped
    # answering is a worse outcome than a refused replacement.
    #
    if ! nginx -t 2>&1 | sed 's/^/  /'; then
        if [[ -n "$backup" ]]; then
            cp -a "${backup}/cert" "$TLS_CERT"
            cp -a "${backup}/key" "$TLS_KEY"
            rm -rf "$backup"
            nginx -t >/dev/null 2>&1 && systemctl try-reload-or-restart nginx || true
            die "nginx rejected the new pair; the previous one has been restored"
        fi
        die "nginx rejected the new pair, and there was no previous one to restore"
    fi

    #
    # A stopped nginx is left stopped: on a first installation 05-platform-nginx
    # starts it once the site is in place, and a reload of it would fail.
    #
    systemctl try-reload-or-restart nginx
    log "  reloaded nginx"
    [[ -n "$backup" ]] && rm -rf "$backup"
    publish_copy

    echo
    log "now serving on ${SERVER_NAME}:"
    describe "$TLS_CERT"
}

#
# A public copy of the certificate, served by the interface's own server block
# at /certdist/manager-ui.pem, so a receiver that fetches over https can save
# what to trust without openssl on its side, as
# user-manual.md, 'Registering a receiver' describes. Public
# material: nginx sends it in every handshake. A copy rather than the file
# itself because the TLS directory is root-only and nginx's workers are not.
#
PUBLIC_COPY=${PUBLIC_COPY:-/srv/certdist/manager-ui.pem}
publish_copy() {
    install -d -o root -g root -m 755 "$(dirname "$PUBLIC_COPY")"
    install -o root -g root -m 644 "$TLS_CERT" "${PUBLIC_COPY}.incoming"
    mv -f "${PUBLIC_COPY}.incoming" "$PUBLIC_COPY"
    log "  published ${PUBLIC_COPY}  (the certificate, for receivers to trust)"
}

cmd="${1:-}"
shift || true

case "$cmd" in
    show)
        [[ -f "$TLS_CERT" ]] || die "no certificate installed at ${TLS_CERT}"
        echo "certificate served for ${SERVER_NAME}:"
        describe "$TLS_CERT"
        ;;

    publish)
        [[ -f "$TLS_CERT" ]] || die "no certificate installed at ${TLS_CERT}"
        publish_copy
        ;;

    install)
        cert="" key=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --cert) cert="${2:-}"; shift 2 ;;
                --key)  key="${2:-}";  shift 2 ;;
                *) usage ;;
            esac
        done
        [[ -n "$cert" && -n "$key" ]] || usage
        activate "$cert" "$key"
        ;;

    self-signed)
        days=825
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --days) days="${2:-}"; shift 2 ;;
                *) usage ;;
            esac
        done
        [[ "$days" =~ ^[0-9]+$ ]] || die "--days takes a number"
        tmp="$(mktemp -d)"
        trap 'rm -rf "$tmp"' EXIT
        log "generating a self-signed certificate for ${SERVER_NAME}, ${days} days"
        openssl req -x509 -newkey rsa:3072 -sha256 -days "$days" -nodes \
            -keyout "${tmp}/key" -out "${tmp}/cert" \
            -subj "/CN=${SERVER_NAME}" \
            -addext "subjectAltName=DNS:${SERVER_NAME}" \
            -addext "basicConstraints=critical,CA:FALSE" \
            -addext "keyUsage=critical,digitalSignature,keyEncipherment" \
            -addext "extendedKeyUsage=serverAuth" 2>/dev/null \
            || die "openssl could not generate the pair"
        activate "${tmp}/cert" "${tmp}/key"
        echo
        warn "this certificate is self-signed - browsers will warn on every login."
        warn "replace it with one your clients trust:"
        if [[ "$CONF" == "$DEFAULT_CONF" ]]; then
            warn "  sudo haprion-tls install --cert <file> --key <file>"
        else
            warn "  sudo haprion-tls --config ${CONF} install --cert <file> --key <file>"
        fi
        ;;

    *) usage ;;
esac
