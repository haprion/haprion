#!/bin/bash
#
# Start the web interface of the UI release `current` points at.
#
#     haprion-web
#
# What haprion-web.service runs. The unit names this command rather than the
# release's package, so it stays the same file for every release: the package
# is asked of the release. It listens on the socket systemd holds for it
# (haprion-web.socket), descriptor 3, which only root and nginx's group may
# open - so the forwarded headers are believed from whoever connects, since
# that can only be nginx, which overwrites them (review 2026-10-22, 5-8).
# Every local process could reach the loopback port it listened on before.
#
set -Eeuo pipefail

CONFIG=/etc/haprion/ui.toml
release=/opt/haprion-ui/current
python="${release}/venv/bin/python"

#
# The import package of the UI release a Python interpreter belongs to, asked of
# the release itself: the package behind its `haprion-worker` command. A release
# this one replaces or rolls back to may call its package something else; the
# command is what every release has. The same function in lib.sh,
# haprion-backup, haprion-rollback and haprion-web, held together by a test.
#
release_module() {
    "$1" -I -c 'from importlib.metadata import entry_points
print(entry_points(group="console_scripts")["haprion-worker"].module.partition(".")[0])'
}

module="$(release_module "$python")"

if [[ "${LISTEN_FDS:-}" == 1 ]]; then
    exec "${release}/venv/bin/uvicorn" \
        --factory "${module}.app:create_app" \
        --fd 3 \
        --no-server-header --proxy-headers --forwarded-allow-ips='*'
fi
#
# A unit without its socket: the one an update that did not finish put back,
# with the nginx site that proxies to the loopback port. That release reads
# the port from ui.toml, as it did.
#
port="$("$python" -I -c 'import importlib, sys; from pathlib import Path
load = importlib.import_module(sys.argv[1] + ".config").load
print(load(Path(sys.argv[2])).listen.port)' "$module" "$CONFIG")"

exec "${release}/venv/bin/uvicorn" \
    --factory "${module}.app:create_app" \
    --host 127.0.0.1 --port "$port" \
    --no-server-header --proxy-headers --forwarded-allow-ips=127.0.0.1
