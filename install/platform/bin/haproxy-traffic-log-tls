#!/bin/bash
# Own the private CA and receiver certificate used only for traffic-log TLS.
set -Eeuo pipefail

CONF=/etc/haproxy-manager/traffic-log-tls.conf
[[ $EUID -eq 0 ]] || { echo "ERROR: run this with sudo" >&2; exit 1; }
[[ -r "$CONF" ]] || { echo "ERROR: ${CONF} is missing" >&2; exit 78; }
# shellcheck source=/dev/null
source "$CONF"
for name in CA_CERT CA_KEY SERVER_CERT SERVER_KEY SERVER_NAME PUBLISHED_CA PULL_USER RSYSLOG_GROUP; do
    [[ -n "${!name:-}" ]] || { echo "ERROR: ${name} is not set in ${CONF}" >&2; exit 78; }
done

REQUEST_FILE="${SERVER_CERT}.request.new"
EXTENSION_FILE="${SERVER_CERT}.extensions.new"
cleanup() {
    rm -f "$REQUEST_FILE" "$EXTENSION_FILE" "${SERVER_CERT}.new" "${SERVER_KEY}.new"
}
trap cleanup EXIT

issue_server() {
    openssl req -new -newkey rsa:3072 -nodes -subj "/CN=${SERVER_NAME}" \
        -keyout "${SERVER_KEY}.new" -out "$REQUEST_FILE" >/dev/null 2>&1
    printf 'subjectAltName=DNS:%s\nextendedKeyUsage=serverAuth\n' "$SERVER_NAME" > "$EXTENSION_FILE"
    openssl x509 -req -in "$REQUEST_FILE" -CA "$CA_CERT" -CAkey "$CA_KEY" \
        -CAcreateserial -days 825 -sha256 -extfile "$EXTENSION_FILE" \
        -out "${SERVER_CERT}.new" >/dev/null 2>&1
    openssl verify -CAfile "$CA_CERT" "${SERVER_CERT}.new" >/dev/null
    chmod 600 "${SERVER_KEY}.new"
    chmod 644 "${SERVER_CERT}.new"
}

activate_server() {
    local saved_cert="${SERVER_CERT}.rollback" saved_key="${SERVER_KEY}.rollback"
    [[ ! -f "$SERVER_CERT" ]] || cp -a "$SERVER_CERT" "$saved_cert"
    [[ ! -f "$SERVER_KEY" ]] || cp -a "$SERVER_KEY" "$saved_key"
    install -o root -g "$RSYSLOG_GROUP" -m 640 "${SERVER_KEY}.new" "$SERVER_KEY"
    install -o root -g "$RSYSLOG_GROUP" -m 640 "${SERVER_CERT}.new" "$SERVER_CERT"
    if rsyslogd -N1 && systemctl restart rsyslog && systemctl is-active --quiet rsyslog; then
        rm -f "$saved_cert" "$saved_key"
        return
    fi
    [[ ! -f "$saved_cert" ]] || mv -f "$saved_cert" "$SERVER_CERT"
    [[ ! -f "$saved_key" ]] || mv -f "$saved_key" "$SERVER_KEY"
    systemctl restart rsyslog || true
    echo "ERROR: rsyslog refused the new certificate; the previous pair was restored" >&2
    exit 1
}

install_initial_server() {
    install -o root -g "$RSYSLOG_GROUP" -m 640 "${SERVER_KEY}.new" "$SERVER_KEY"
    install -o root -g "$RSYSLOG_GROUP" -m 640 "${SERVER_CERT}.new" "$SERVER_CERT"
}

case "${1:-}" in
    init)
        if [[ ! -f "$CA_CERT" || ! -f "$CA_KEY" ]]; then
            [[ ! -e "$CA_CERT" && ! -e "$CA_KEY" ]] || {
                echo "ERROR: only one CA file exists; refusing to replace it" >&2; exit 1;
            }
            openssl req -x509 -newkey rsa:4096 -nodes -days 3650 -sha256 \
                -subj "/CN=HAProxy Manager traffic log CA" \
                -addext "basicConstraints=critical,CA:TRUE" \
                -addext "keyUsage=critical,keyCertSign,cRLSign" \
                -keyout "$CA_KEY" -out "$CA_CERT" >/dev/null 2>&1
            chmod 600 "$CA_KEY"
            chmod 644 "$CA_CERT"
        fi
        if [[ ! -f "$SERVER_CERT" || ! -f "$SERVER_KEY" ]]; then
            [[ ! -e "$SERVER_CERT" && ! -e "$SERVER_KEY" ]] || {
                echo "ERROR: only one server certificate file exists" >&2; exit 1;
            }
            issue_server
            install_initial_server
        fi
        ;;
    renew)
        issue_server
        activate_server
        ;;
    show)
        openssl x509 -in "$CA_CERT" -noout -subject -enddate
        openssl x509 -in "$SERVER_CERT" -noout -subject -issuer -enddate
        exit 0
        ;;
    *) echo "usage: haproxy-traffic-log-tls {init|renew|show}" >&2; exit 64 ;;
esac

chown "root:${RSYSLOG_GROUP}" "$CA_CERT" "$SERVER_CERT" "$SERVER_KEY"
chmod 640 "$CA_CERT" "$SERVER_CERT" "$SERVER_KEY"
chown root:root "$CA_KEY"
chmod 600 "$CA_KEY"
install -o root -g "$PULL_USER" -m 640 "$CA_CERT" "$PUBLISHED_CA"
openssl verify -CAfile "$CA_CERT" "$SERVER_CERT"
