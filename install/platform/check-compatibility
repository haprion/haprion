#!/bin/bash
#
# Read all independently installed parts as one compatibility report.
#
#     sudo ./check-compatibility [--release <release-id>] [--before-migration | --first-install]
#
# --first-install is the check before a first installation's release is
# activated: the worker unit, sudo rules and helper sockets come from step 07,
# after activation, and are left to the check that follows it.
#
# This changes nothing. Requirements come from either the running UI release or
# an explicitly named prepared release, never from the checkout containing this
# wrapper, so the answer remains meaningful after that checkout moves on. The
# code that checks them is the release this package installed (below).
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root

release_id=""
before_migration=0
first_install=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --release)
            [[ -n "${2:-}" ]] || die "--release needs a release id"
            release_id="$2"
            shift 2
            ;;
        --before-migration)
            before_migration=1
            shift
            ;;
        --first-install)
            first_install=1
            shift
            ;;
        *) die "usage: $(basename "$0") [--release <release-id>] [--before-migration | --first-install]" ;;
    esac
done
[[ "$before_migration" -eq 0 || -n "$release_id" ]] \
    || die "--before-migration requires --release"
[[ "$first_install" -eq 0 || ( -n "$release_id" && "$before_migration" -eq 0 ) ]] \
    || die "--first-install requires --release and excludes --before-migration"

python_root="${UI_ROOT}/current"
extra_args=()
if [[ -n "$release_id" ]]; then
    [[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] \
        || die "invalid release id: ${release_id}"
    python_root="${UI_ROOT}/releases/${release_id}"
    extra_args+=(--ui-release "$release_id" --skip-services)
fi
if [[ "$before_migration" -eq 1 ]]; then
    extra_args+=(--upgrade-from-current)
fi
if [[ "$first_install" -eq 1 ]]; then
    extra_args+=(--first-install)
fi

CLI_ROOT="${CLI_ROOT:-/opt/haprion}"
module="$(release_module "${python_root}/venv/bin/python")" \
    || die "cannot tell which package the checked UI release is"
#
# The check itself runs under the release this package installed, against the
# checked release's requirements: after a rollback the checked release is
# older, and only the newest knows the rule `haprion-rollback` decided by -
# its code ruled a schema past its head out that the rollback had let it run
# on (review 26-10-29, A01). Under the checked release when the package's
# release is not on disk.
#
checker_root="$python_root"
checker_args=()
packaged="$(sed -n 's/^RELEASE_ID=//p' "$UI_PAYLOAD" 2>/dev/null || true)"
if [[ "$packaged" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ && -x "${UI_ROOT}/releases/${packaged}/venv/bin/python" ]]; then
    checker_root="${UI_ROOT}/releases/${packaged}"
    checker_args+=(--packaged "$packaged")
else
    warn "the release ${UI_PAYLOAD} names is not on disk; the checked release's own code checks it"
fi
checker_module="$(release_module "${checker_root}/venv/bin/python")" \
    || die "cannot tell which package the release this package installed is"
# shellcheck disable=SC2153 # UI_CONFIG is accounts.sh's, read through lib.sh
ui_lines="$("${python_root}/venv/bin/python" - \
    "$module" "$UI_CONFIG" <<'PY'
import importlib
import sys
from pathlib import Path

load = importlib.import_module(sys.argv[1] + ".config").load
config = load(Path(sys.argv[2]))
print("enabled" if config.traffic_logs.enabled else "disabled")
for cluster in config.clusters:
    print(cluster)
PY
)" || die "cannot read clusters from the installed UI configuration"
mapfile -t ui_config <<<"$ui_lines"
traffic_logs_enabled="${ui_config[0]}"
listed=()
if [[ ${#ui_config[@]} -gt 1 ]]; then
    listed=("${ui_config[@]:1}")
fi

#
# The clusters are the cluster file's, as the poller, the web and step 07 read
# them: `ui.toml`'s list was checked instead, so a cluster created in the
# interface was never asked and a removed one still listed there stopped the
# update (review 2026-10-22, 6-1).
#
cluster_lines="$(installed_clusters)" || exit 1
clusters=()
if [[ -n "$cluster_lines" ]]; then
    mapfile -t clusters <<<"$cluster_lines"
fi
if [[ ${#listed[@]} -gt 0 ]] \
    && [[ "$(printf '%s\n' "${listed[@]}" | sort)" != "$(printf '%s\n' "${clusters[@]}" | sort)" ]]; then
    warn "ui.toml's clusters (${listed[*]}) differ from the cluster file's (${clusters[*]}); the cluster file is the one checked"
fi

if [[ "$traffic_logs_enabled" == "enabled" ]]; then
    # The inventory check belongs to the release that runs the check, not to
    # this checkout: a release without it is reported without it, never refused.
    if "${checker_root}/venv/bin/python" -m "${checker_module}.compatibility" --help 2>/dev/null \
        | grep -q -- '--collector-config'; then
        extra_args+=(
            --runtime-policy /etc/haprion/runtime-policy.yaml
            --collector-config /etc/haprion/traffic-collector.json
        )
    else
        warn "the checking UI release predates the traffic collector inventory check; it is skipped"
    fi
fi

exec "${checker_root}/venv/bin/python" -m "${checker_module}.compatibility" \
    --platform-root "$UI_ROOT" \
    --cli-root "$CLI_ROOT" \
    --database "$DB_NAME" \
    --database-role "$DB_MIGRATION_ROLE" \
    --clusters "${clusters[@]}" \
    "${checker_args[@]}" \
    "${extra_args[@]}"
