# Runs one bounded backup operation as root, outside the worker's read-only mount namespace.
[Unit]
Description=Run one Haprion backup job
Documentation=file:///opt/haprion/current

[Service]
Type=exec
ExecStart=/opt/haprion/current/bin/haprion-backup-job-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Memory (B357): a helper starts in 19-35 MB, and the largest step measured, a
# node restore, peaked at 84 MB in eight runs (26-10-23); a publish's
# generator takes 45 MB for 500 objects, and the parsers run in units of their
# own. Stopped, not swapped, past three times the largest.
MemoryMax=256M
MemorySwapMax=0

# With Type=exec this bounds the start only; systemd does not end a run that
# has begun. What bounds a run is each node's fetch, 300 s over SSH
# with a ten-second connect. No RuntimeMaxSec on
# purpose: a root step stopped midway would skip its own clean-up
# (review 2026-09-28).
TimeoutStartSec=13min
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete
