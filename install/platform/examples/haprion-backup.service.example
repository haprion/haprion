[Unit]
# Dumps the interface database. Rendered by 06-platform-backup.
Description=Dump the Haprion interface database
Documentation=file:///opt/haprion-ui/current
After=postgresql.service
Requires=postgresql.service
# Waits for the data directory's mount when it is one (the user manual's
# "Where the data lives"): without it a late volume leaves this writing to the
# root filesystem underneath it.
RequiresMountsFor=/var/lib/haprion-ui

[Service]
Type=oneshot
# Root, because the dump holds every password and session hash and is written
# where no application identity can read it.
User=root
ExecStart=/usr/local/sbin/haprion-backup dump
# The dump is worthless if it silently stops happening, so a failure is a failed
# unit rather than a line in a log nobody reads.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
