# Gives out one exportable certificate's key, then exits (B255).
#
# Started by haprion-cert-export-helper.socket, one instance per connection. The
# connection is this process's stdin and stdout, the protocol the helper
# speaks when a person pipes a request into it.
#
# What it may do with root
# ------------------------
# Read the runtime policy, the registry and one certificate's chain and key
# from the store - only for an entry marked `exportable`, which names no
# cluster and no receiver - and run openssl to build a PKCS#12 bundle in
# memory. It writes nothing: the file is the answer on the socket, and what was
# exported, for whom, goes to the journal.
#
# So the sandbox is read-only everywhere and has no network.
#
# Installed as /etc/systemd/system/haprion-cert-export-helper@.service.

[Unit]
Description=Export an Haprion certificate's key
Documentation=file:///opt/haprion/current
# One instance per connection. Its answer went to the caller and its log to the
# journal; one that answered with a refusal or a failure is collected rather
# than left behind as a failed unit for monitoring to alarm on (26-10-27).
CollectMode=inactive-or-failed

[Service]
Type=exec
ExecStart=/opt/haprion/current/bin/haprion-cert-export-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=30
RuntimeMaxSec=60
# Memory (B357): a helper starts in 19-35 MB, and the largest step measured, a
# node restore, peaked at 84 MB in eight runs (26-10-23); a publish's
# generator takes 45 MB for 500 objects, and the parsers run in units of their
# own. Stopped, not swapped, past three times the largest.
MemoryMax=256M
MemorySwapMax=0

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
