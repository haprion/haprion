# Registers or removes exactly one receiver, then exits.
#
# Started by haprion-cert-receiver-helper.socket, one instance per connection.
# The connection is this process's stdin and stdout, which is the same
# protocol the helper speaks when a person pipes a request into it. The worker
# reaches it through haprion-cert-receiver-ask; the operator's own command,
# haprion-cert-receiver, does not go this way - root runs it directly.
#
# What it may do with root
# ------------------------
# Everything registering a receiver is: create or delete one account, one
# directory under the receiver root, one authorized_keys lock, one sshd
# drop-in or one nginx snippet, and the registry entry; then reload sshd or
# nginx. It never reads a private key and never returns one.
#
# Why this sandbox is looser than the worker's: useradd is the job. It writes
# /etc/passwd and its neighbours through a rename, so /etc has to be writable
# as a directory. ProtectSystem=yes keeps /usr, /boot and /efi read-only and
# leaves /etc to the helper; `full` and `strict` would both take /etc away,
# which is the failure this unit exists to end. ProtectHome is off because a
# receiver's account may have its home under /home on an older installation
# (the legacy layout).
#
# Errors go to the journal and not to the socket. The caller reads one JSON
# document; a diagnostic mixed into that stream would be read as a malformed
# answer instead of as the problem it describes.
#
# Installed as /etc/systemd/system/haprion-cert-receiver-helper@.service.

[Unit]
Description=Register or remove one Haprion certificate receiver
Documentation=file:///opt/haprion/current

[Service]
Type=exec
ExecStart=/opt/haprion/current/bin/haprion-cert-receiver-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal

# With Type=exec this bounds the start only; systemd does not end a run that
# has begun. What bounds a run is each command it runs (useradd,
# sshd, nginx), 30 s. No RuntimeMaxSec on
# purpose: a root step stopped midway would skip its own clean-up
# (review 2026-09-28).
TimeoutStartSec=180
TimeoutStopSec=10

NoNewPrivileges=yes
ProtectSystem=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete

# AF_UNIX is the connection it was handed and the bus it reloads sshd or nginx
# over; AF_INET and AF_INET6 are the resolver, which the lock is built from.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
