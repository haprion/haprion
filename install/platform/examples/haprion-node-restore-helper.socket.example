[Unit]
Description=Socket the Haprion worker uses for node restore jobs
Documentation=file:///opt/haprion/current

[Socket]
ListenStream=/run/haprion/node-restore.sock
SocketUser=root
SocketGroup=WORKER_USER
SocketMode=0660
Accept=yes
# One restore at a time on the whole manager: two runs writing root's SSH
# state and a node's network at once is not a thing to allow by accident.
MaxConnections=1
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
