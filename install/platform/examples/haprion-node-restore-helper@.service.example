# Runs one node restore step as root, outside the worker's read-only mount namespace.
# It reads the root-only state archive, keeps the run's one-time key under
# /var/lib/haprion/restore, and reaches the target VM over SSH.
[Unit]
Description=Run one Haprion node restore step
Documentation=file:///opt/haprion/current
# One instance per connection. Its answer went to the caller and its log to the
# journal; one that answered with a refusal or a failure is collected rather
# than left behind as a failed unit for monitoring to alarm on (26-10-27).
CollectMode=inactive-or-failed

[Service]
Type=exec
ExecStart=/opt/haprion/current/bin/haprion-node-restore-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Memory (B357): at most 84 MB in eight runs (measured 26-10-23); an archive
# is read a file at a time. Six times that, because a step stopped midway
# skips its own clean-up. Stopped, not swapped, past it.
MemoryMax=512M
MemorySwapMax=0

# With Type=exec this bounds the start only; systemd does not end a run that
# has begun. What bounds a run is each of its SSH sessions, 600 s, four at
# most: the target inspected, applied, given its network, and finished or put
# back. No RuntimeMaxSec on
# purpose: a root step stopped midway would skip its own clean-up, the
# roll-back of a half-written target first
# (review 2026-09-28).
TimeoutStartSec=14min
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=yes
# AF_NETLINK because `ip route get` names the address the target will see this
# host come from - the one the one-time key's from= is limited to.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete
