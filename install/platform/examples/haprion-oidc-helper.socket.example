# Where the interface asks the OIDC provider something (Fas 13 part 4, O3; B196).
#
# The web service reaches localhost and nothing else, and should not reach
# more: it is the part a browser talks to. Sign-in through an OpenID Connect
# provider needs the provider, so the requests go through this socket to a
# small helper that may reach the network and holds the key that opens the
# client secret. The web keeps IPAddressDeny=any.
#
# Who may connect
# ---------------
# Root-owned, group WEB_USER, mode 0660: the web account and nobody else. The
# helper is not root - it runs as an account of its own - but it is the only thing that
# can open the client secret, so the socket is as narrow as the others.
#
# Installed by install/platform/17-platform-oidc as
# /etc/systemd/system/haprion-oidc-helper.socket.

[Unit]
Description=Socket the Haprion interface asks its OIDC provider through
Documentation=file:///opt/haprion/current

[Socket]
ListenStream=/run/haprion/oidc.sock
SocketUser=root
SocketGroup=WEB_USER
SocketMode=0660

# One connection is one request, in its own short-lived instance.
Accept=yes

# A sign-in waits on the provider for up to ten seconds per call. This bounds
# how many can be in flight, so a burst of sign-in clicks cannot become a queue
# of outbound connections.
MaxConnections=16

RemoveOnStop=yes

[Install]
WantedBy=sockets.target
