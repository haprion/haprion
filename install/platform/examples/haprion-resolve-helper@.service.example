# One lookup for the Haprion interface, answered by haprion-resolve-helper (B253).
#
# Not root and no account of its own: a dynamic user, nothing to read but the
# release, nothing to write, and a way out to the network - which is the
# point of it, and why this unit has no IPAddressDeny. Everything else is the
# other helpers' sandbox.
#
# Installed by install/platform/07-platform-services as
# /etc/systemd/system/haprion-resolve-helper@.service.

[Unit]
Description=Look up dns server names for the Haprion interface
Documentation=file:///opt/haprion/current
# One instance per connection. Its answer went to the caller and its log to the
# journal; one that answered with a refusal or a failure is collected rather
# than left behind as a failed unit for monitoring to alarm on (26-10-27).
CollectMode=inactive-or-failed

[Service]
Type=exec
DynamicUser=yes
ExecStart=/opt/haprion/current/bin/haprion-resolve-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=20
# Memory (B357): a helper starts in 19-35 MB, and the largest step measured, a
# node restore, peaked at 84 MB in eight runs (26-10-23); a publish's
# generator takes 45 MB for 500 objects, and the parsers run in units of their
# own. Stopped, not swapped, past three times the largest.
MemoryMax=256M
MemorySwapMax=0

#
# The whole answer, not only the start: the web stops waiting after 15 s
# (resolve_socket.TIMEOUT_SECONDS), and this makes the helper stop too.
#
RuntimeMaxSec=20
TimeoutStopSec=5
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
