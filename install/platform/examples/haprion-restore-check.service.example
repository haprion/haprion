[Unit]
# Restores the newest dump into a scratch database and compares it with the live
# one. A dump nobody has restored is a belief, not a backup.
Description=Verify that the newest interface dump restores
Documentation=file:///opt/haprion-ui/current
After=postgresql.service
Requires=postgresql.service
# Waits for the data directory's mount when it is one (the user manual's
# "Where the data lives"): without it a late volume leaves this writing to the
# root filesystem underneath it.
RequiresMountsFor=/var/lib/haprion-ui

[Service]
Type=oneshot
User=root
ExecStart=/usr/sbin/haprion-backup verify-restore

[Install]
WantedBy=multi-user.target
