[Unit]
# Keeps jobs and metric history bounded. Rendered by 11-platform-retention.
Description=Prune bounded Haprion history
Documentation=file:///opt/haprion-ui/current
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# Root, because no application role holds delete on any table and none will.
# The migration role owns the table, and the ident map lets only root be it.
User=root
ExecStart=/usr/sbin/haprion-retention prune
# A prune that quietly stops leaves the history growing, so a failure is a
# failed unit rather than a line in a log nobody reads.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
