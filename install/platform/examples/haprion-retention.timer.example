[Unit]
Description=Daily pruning for Haprion

[Timer]
# After the daily dump rather than before it, so the newest dump still holds the
# rows this removes. A week of job rows is small; losing the ability to read
# them back out of a backup for the sake of half an hour is not a trade worth
# making.
#
# Daily rather than weekly: it removes what is older than a week, so running it
# more often removes the same rows a little sooner.
OnCalendar=*-*-* 03:30:00
# Persistent so a machine that was off at 03:30 catches up when it comes back,
# rather than skipping a day and then removing twice as much unannounced.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
