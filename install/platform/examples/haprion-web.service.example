[Unit]
Description=Haprion web interface
Documentation=file:///opt/haprion-ui/current
After=network-online.target postgresql.service haprion-web.socket
Wants=network-online.target
# Its listener (haprion-web.socket): systemd hands it over as descriptor 3.
Requires=haprion-web.socket

[Service]
Type=exec
User=_haprion-web
Group=_haprion-web

# The release, not a checkout. Switching `current` and restarting is the whole
# deployment; rolling back is switching it and restarting again. The command
# reads the release's package, so this file is the same for every release
# (haprion-web).
ExecStart=/usr/sbin/haprion-web

Restart=on-failure
RestartSec=2

# The service reads its configuration and its own release, and writes nothing to
# the filesystem at all. Everything below says that in terms systemd enforces
# rather than in terms the code promises.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# AF_UNIX for the database socket, AF_INET for the port nginx connects to.
# Nothing else - this process has no reason to open any other kind of socket.
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressAllow=localhost
IPAddressDeny=any

# It has no sudo rule and must never gain one. The engine's helpers are the
# worker's business, and the worker is a different account.
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
