[Unit]
Description=Haprion job worker
Documentation=file:///opt/haprion-ui/current
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=_haprion-worker
Group=_haprion-worker

Environment=HAPRION_UI_CONFIG=/etc/haprion/ui.toml
ExecStart=/opt/haprion-ui/current/venv/bin/haprion-worker
# Memory (B357), with the root helpers sudo starts in this unit: at most 95 MB
# in 57 runs since 26-10-09 (measured 26-10-23); generating 500 objects takes
# 45 MB, and a candidate's parsers run in units of their own. Stopped and
# started again, not swapped, past several times that.
MemoryMax=768M
MemorySwapMax=0

Restart=on-failure
RestartSec=5

# Relaxed on purpose, in the diff the old comment here asked for. This unit
# runs the three cluster mutations, and every line below is here because the
# helper cannot work without it - not because a tighter value was untested.
#
# The thing to understand before changing any of it: sudo execs the helper
# INSIDE this unit's sandbox. Seccomp filters survive exec and mount namespaces
# are inherited, so every restriction here applies to the privileged helper too,
# not just to the Python process that calls it. That is why this file had to
# open rather than the helper being hardened separately.
#
# Where the real limit now lives: /etc/sudoers.d/haprion-worker, which names
# each mutation helper and permits no arguments at all. The sandbox never was what
# stopped this account from deploying - the absence of a sudo rule was. Widening
# here does not widen what may be run; only that file does.

# sudo cannot raise privilege under NoNewPrivileges, and setuid needs both a
# capability to arrive through and the syscalls to use it.
#
# CAP_CHOWN is not sudo's; it is the publish step's. A released version is
# installed root-owned with the pull account's group so the nodes can fetch it,
# and setting that group is a chown - which root cannot do with an empty
# bounding set. Found by running the gate: the revert reached install_release
# and failed there with EPERM, one step past the write paths.
#
# CAP_DAC_READ_SEARCH is the publish step's as well, and the poller already
# carries it. Root inside this sandbox is only uid 0: without it the mode bits
# are the law, and a receiver's directory is what the publisher must look into
# while its files belong to the fetch account (0600) and one made before the
# registry existed may belong to that account outright (0700). Found on the
# machine: a target change from the interface ended `target_missing` on a
# directory the same command, run as root from a terminal, published to. Read
# and traverse only - what may be written is still the write paths above, and
# what may be run is still the sudoers file.
NoNewPrivileges=no
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_AUDIT_WRITE CAP_CHOWN CAP_DAC_READ_SEARCH

# @privileged carries setuid/setgid and @resources carries the setrlimit calls
# sudo makes while building the target environment. Denying either denies sudo.
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete
SystemCallArchitectures=native

# The rollout reaches the nodes over SSH, and AF_NETLINK is how glibc resolves
# their names. AF_UNIX alone is what a database-only worker needed.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# The three deploy identities are keys under /root/.ssh, named by
# runtime-policy.yaml. ProtectHome=yes hid them. read-only rather than off: the
# helper reads those keys and writes nothing under any home.
ProtectHome=read-only

# What the mutations actually write, and nothing else. Found by running the
# gate rather than by reading: a deploy only reads and reaches nodes over SSH,
# so /run alone carried it, and the gap did not appear until a revert - which
# publishes - failed on "git commit-tree: Read-only file system".
#
#   /run/haprion           the cluster lock, which stops two rollouts at once
#   config_root            the clusters' Git repositories; revert commits here
#   publish_root           the immutable release the commit is swapped into
#   validation_certs_root  a revert validates before it publishes
#
# The last three are the runtime policy's, written in by platform step 07 as
# @POLICY_PATHS@ below, with the registry's and the publisher's directories.
#
# And what issuing a certificate writes (Phase 11), because the issue helper
# runs certbot inside this namespace too. Found the same way: the first
# issuance from the web interface failed on certbot's log lock with "Read-only
# file system".
#
#   /etc/letsencrypt            certbot's lineages, account and renewal configs
#   /var/lib/letsencrypt        certbot's working directory
#   /var/log/letsencrypt        certbot's log, and the lock it takes first
#   @POLICY_PATHS@              the runtime policy's roots: the configuration
#                               repositories, their publish and validation roots,
#                               the registry's directory, where the publisher
#                               writes and the HTTP-01 webroot - written in by
#                               platform step 07
#   /etc/haprion/dns-profiles  root-only provider credentials
#   /etc/haprion/certificates  the import store a deletion removes from
#   /etc/haprion/block-clients the block clients' registry and key file (B412)
#
# All of these are root-owned and writable by root alone, so opening the mount
# namespace does not let the worker account itself write to them - the helper
# writes as root, and file permissions stay the real boundary. This list is the
# second layer, not the only one.
ProtectSystem=strict
ReadWritePaths=/run/haprion @POLICY_PATHS@ /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /etc/haprion/dns-profiles /etc/haprion/certificates /etc/haprion/ndes-profiles /etc/haprion/ndes-requests /etc/haprion/block-clients

# Unchanged, and none of them stand in the helper's way. Kept so that opening
# the four above is a decision about four things and not about the whole file.
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# sudo-rs reads its parent's start time from /proc for the timestamp it ties a
# password to, and the parent - this unit's process, another user than the
# root sudo runs as - is hidden by ProtectProc without CAP_SYS_PTRACE, which
# the bounding set leaves out on purpose. Every call then logged one warning,
# some 24 000 lines a day (measured 26-10-13). The rules are NOPASSWD, so the
# timestamp is never used: the one exact line is dropped, everything else sudo
# says is kept. Hiding the processes and withholding the capability are the
# sandbox doing its job, and neither is loosened for a log line.
LogFilterPatterns=~^Could not get parent process starting time$
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
