#
# nginx site for the Haprion UI.
#
# This is the direct manager address, and it deliberately does not go through
# the HAProxy pair. The UI is the tool used to repair that pair, so putting the
# UI behind it means a broken publish locks the operator out of the only thing
# that could revert it. A front - a reverse proxy elsewhere - may be added as an
# additional path, never as a replacement. See B21 and plan section 7.
#
# Rendered by 05-platform-nginx from the answers file. Edit that, not this.
#

#
# Sign-in attempts, counted per client before the application spends an Argon2
# on them (B305, security review S01). Only a POST to /login and the start of a
# sign-in through the identity provider have a key; every other request maps
# to an empty one, which nginx does not count. Ten a minute, with room for a
# burst of ten: a person mistyping never meets it, a script does, and is
# answered 429 without the application seeing it. The provider's start runs a
# discovery helper and stores a pending sign-in each time, for nobody in
# particular (security review 2026-10-22, S3); its callback is not counted,
# so a sign-in already under way is never the one turned away.
#
map $request_method$uri $haprion_sign_in {
    default          "";
    POST/login       $binary_remote_addr;
    GET/login/oidc   $binary_remote_addr;
}
limit_req_zone $haprion_sign_in zone=haprion_sign_in:1m rate=10r/m;

server {
    listen 80;
    listen [::]:80;
    server_name SERVER_NAME;

    # Nothing is served over plain HTTP: the session cookie is Secure, so it
    # would never be sent here anyway.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name SERVER_NAME;

    ssl_certificate     TLS_CERT;
    ssl_certificate_key TLS_KEY;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:haprion_ui:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    #
    # Deliberately not enabled while the certificate is self-signed. HSTS makes
    # a certificate warning unclickable, so switching it on before a trusted
    # certificate is installed locks every operator out of the UI - including
    # the one who would fix it. Enable it after replacing the pair:
    #
    #   add_header Strict-Transport-Security "max-age=31536000" always;
    #

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    #
    # Bodies stay small, and they stay in memory. A certificate import carries
    # a private key, sealed by the application before anything is stored; a
    # body larger than nginx's default buffer (8-16 KiB) would first be written
    # to a temporary file under /var/lib/nginx/body, which the promise that the
    # key exists only in memory during the request does not survive. The two
    # sizes are the same on purpose: whatever nginx accepts, it holds in memory.
    #
    client_max_body_size 1m;
    client_body_buffer_size 1m;

    #
    # A reverse proxy in front (TRUSTED_PROXIES, INSTALLATION 4.5): from here on
    # $remote_addr is the client the proxy names, for the sign-in throttle, the
    # audit log, the receivers' `allow` and the access log alike. Empty unless
    # the answers file names a proxy; 05-platform-nginx writes it on every run.
    #
    include /etc/nginx/snippets/haprion-real-ip.conf;

    access_log /var/log/nginx/haprion.access.log;
    error_log  /var/log/nginx/haprion.error.log;

    #
    # Certificate receivers that fetch over https (INSTALLATION 1.4.9). The
    # file holds one whitelisted `location /certdist/<receiver>/` per such
    # receiver and is written by haprion-cert-receiver alone; 05-platform-nginx
    # creates it empty. It lives in this block because nginx serves the first
    # server block for a name and port and silently ignores a second one, so
    # a block of its own beside this one would never answer. The interface
    # does not route /certdist/.
    #
    include /etc/nginx/snippets/haprion-receivers.conf;

    #
    # The interface's own certificate, as a file, for a receiver that fetches
    # over https to save and pass to --cacert. Public material - it is sent in
    # every handshake - and a copy (haprion-tls writes it) because the TLS
    # directory is root-only and the workers are not. Exact match, so the
    # receiver locations above, which are prefixes, never shadow it.
    #
    location = /certdist/manager-ui.pem {
        alias /srv/certdist/manager-ui.pem;
        default_type application/x-pem-file;
    }

    location / {
        limit_req zone=haprion_sign_in burst=10 nodelay;
        limit_req_status 429;
        # Only nginx's group may open it (haprion-web.socket).
        proxy_pass http://unix:/run/haprion-web.sock;
        proxy_http_version 1.1;

        #
        # Every one of these is set here, overwriting whatever arrived. The app
        # trusts nginx's forwarded headers, which is only safe because a client
        # cannot contribute to them - a request that arrives claiming its own
        # X-Forwarded-For has that claim replaced, not appended.
        #
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
