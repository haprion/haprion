#
# nginx site for the Haprion UI.
#
# This is the direct manager address, and it deliberately does not go through
# the HAProxy pair. The UI is the tool used to repair that pair, so putting the
# UI behind it means a broken publish locks the operator out of the only thing
# that could revert it. A front - a reverse proxy elsewhere - may be added as an
# additional path, never as a replacement. See B21 and plan section 7.
#
# Rendered by 05-platform-nginx from the answers file. Edit that, not this.
#

#
# The client as the application counts it: an IPv6 address is its first 64
# bits, an IPv4 address itself. Counted per whole IPv6 address, one host with a
# /64 had as many buckets as it liked and reached the application at full
# speed (review 26-11-05, A06). An IPv4-mapped address (::ffff:a.b.c.d, which
# a dual-stack proxy hands over) is the IPv4 address a.b.c.d, as the
# application counts it; cut to 64 bits every such client would share one
# bucket (AA02).
#
map $binary_remote_addr $haprion_source {
    "~(?s)^\x00{10}\xff\xff(?<v4>.{4})$"  $v4;
    "~(?s)^(?<prefix>.{8}).{8}$"           $prefix;
    default                                $binary_remote_addr;
}

#
# Sign-in attempts, counted per client before the application spends an Argon2
# on them (B305, security review S01). Only a POST to /login and the start of a
# sign-in through the identity provider have a key; every other request maps
# to an empty one, which nginx does not count. Ten a minute, with room for a
# burst of ten: a person mistyping never meets it, a script does, and is
# answered 429 without the application seeing it. The provider's start runs a
# discovery helper and stores a pending sign-in each time, for nobody in
# particular (security review 2026-10-22, S3); its callback is not counted,
# so a sign-in already under way is never the one turned away.
#
map $request_method$uri $haprion_sign_in {
    default          "";
    POST/login       $haprion_source;
    GET/login/oidc   $haprion_source;
}
limit_req_zone $haprion_sign_in zone=haprion_sign_in:1m rate=10r/m;

#
# The API (B416), per client as the application counts one - an IPv6 host by
# its /64, an IPv4-mapped address as the IPv4 one: ten calls a second with room
# for a burst of fifty, enough for a fail2ban that bans a list at once. A token
# that is not valid is counted harder by the application itself, which closes
# the source for a minute after ten of them.
#
limit_req_zone $haprion_source zone=haprion_api:1m rate=10r/s;

#
# A certificate receiver's fetch (B496, 10; B498): any request under a
# receiver's own `/certdist/<receiver>/`, written to a log of its own as well,
# from which the manager reads when each receiver last fetched. The interface's
# own certificate (`/certdist/manager-ui.pem`) is not a receiver's fetch.
map $uri $haprion_receiver_fetch {
    default             0;
    "~^/certdist/[^/]+/" 1;
}

# nginx's own answers on /api/ carry a request id in the envelope, as the
# application's do, and in the same shape: nginx's 32 hex characters written
# as a UUID, so one schema describes every answer a script can get.
#
map $request_id $haprion_request_uuid {
    "~^(?<a>[0-9a-f]{8})(?<b>[0-9a-f]{4})(?<c>[0-9a-f]{4})(?<d>[0-9a-f]{4})(?<e>[0-9a-f]{12})$" "$a-$b-$c-$d-$e";
}

server {
    listen 80;
    listen [::]:80;
    server_name SERVER_NAME;

    # Nothing is served over plain HTTP: the session cookie is Secure, so it
    # would never be sent here anyway.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name SERVER_NAME;

    ssl_certificate     TLS_CERT;
    ssl_certificate_key TLS_KEY;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:haprion_ui:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    #
    # HSTS, off until `sudo haprion-tls hsts on`, which refuses while the
    # certificate is self-signed: HSTS makes a certificate warning unclickable,
    # so switching it on before a trusted certificate is installed locks every
    # operator out of the UI - including the one who would fix it. The choice
    # is HSTS= in /etc/haprion/ui-tls.conf; step 05 and every update write this
    # file from it.
    #
    include /etc/nginx/snippets/haprion-hsts.conf;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    #
    # Bodies stay small, and they stay in memory. A certificate import carries
    # a private key, sealed by the application before anything is stored; a
    # body larger than nginx's default buffer (8-16 KiB) would first be written
    # to a temporary file under /var/lib/nginx/body, which the promise that the
    # key exists only in memory during the request does not survive. The two
    # sizes are the same on purpose: whatever nginx accepts, it holds in memory.
    #
    client_max_body_size 1m;
    client_body_buffer_size 1m;

    #
    # A reverse proxy in front (TRUSTED_PROXIES; see
    # user-manual.md, 'Behind another reverse proxy'): from here on
    # $remote_addr is the client the proxy names, for the sign-in throttle, the
    # audit log, the receivers' `allow` and the access log alike. Empty unless
    # the answers file names a proxy; 05-platform-nginx writes it on every run.
    #
    include /etc/nginx/snippets/haprion-real-ip.conf;

    access_log /var/log/nginx/haprion.access.log;
    access_log /var/log/nginx/haprion-receivers.access.log combined if=$haprion_receiver_fetch;
    error_log  /var/log/nginx/haprion.error.log;

    #
    # Certificate receivers that fetch over https (see
    # user-manual.md, 'Registering a receiver'). The
    # file holds one whitelisted `location /certdist/<receiver>/` per such
    # receiver and is written by haprion-cert-receiver alone; 05-platform-nginx
    # creates it empty. It lives in this block because nginx serves the first
    # server block for a name and port and silently ignores a second one, so
    # a block of its own beside this one would never answer. The interface
    # does not route /certdist/.
    #
    include /etc/nginx/snippets/haprion-receivers.conf;

    #
    # The interface's own certificate, as a file, for a receiver that fetches
    # over https to save and pass to --cacert. Public material - it is sent in
    # every handshake - and a copy (haprion-tls writes it) because the TLS
    # directory is root-only and the workers are not. Exact match, so the
    # receiver locations above, which are prefixes, never shadow it.
    #
    location = /certdist/manager-ui.pem {
        alias /srv/certdist/manager-ui.pem;
        default_type application/x-pem-file;
    }

    #
    # The API reads a bearer token and never a cookie, and this location keeps
    # it that way whatever the application does: a browser's cookie is not
    # passed on, and nothing the API answers may set one. The same socket and
    # the same forwarded headers as the pages.
    #
    location /api/ {
        limit_req zone=haprion_api burst=50 nodelay;
        limit_req_status 429;
        error_page 413 @api_413;
        error_page 429 @api_429;
        error_page 502 @api_502;
        error_page 503 @api_503;
        error_page 504 @api_504;
        proxy_pass http://unix:/run/haprion-web.sock;
        proxy_http_version 1.1;

        proxy_set_header Cookie            "";
        proxy_hide_header Set-Cookie;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }

    #
    # What nginx itself answers on /api/ - the rate, a body that is too large,
    # a manager that does not answer - is the same envelope as the application's,
    # so a script never has to read an HTML page. Fixed text; the request id is
    # nginx's own.
    #
    location @api_413 {
        internal;
        default_type application/json;
        return 413 '{"schema_version":1,"ok":false,"outcome":"blocked","operation":"api","cluster":null,"request_id":"$haprion_request_uuid","result":null,"warnings":[],"error":{"code":"too_large","message":"The request body is larger than 1 MB.","node":null,"details":null}}';
    }

    location @api_429 {
        internal;
        default_type application/json;
        add_header Retry-After 1 always;
        return 429 '{"schema_version":1,"ok":false,"outcome":"blocked","operation":"api","cluster":null,"request_id":"$haprion_request_uuid","result":null,"warnings":[],"error":{"code":"rate_limited","message":"Too many calls from this address; try again in a second.","node":null,"details":null}}';
    }

    location @api_502 {
        internal;
        default_type application/json;
        return 502 '{"schema_version":1,"ok":false,"outcome":"failed","operation":"api","cluster":null,"request_id":"$haprion_request_uuid","result":null,"warnings":[],"error":{"code":"unavailable","message":"The manager did not answer; try again shortly.","node":null,"details":null}}';
    }

    location @api_503 {
        internal;
        default_type application/json;
        return 503 '{"schema_version":1,"ok":false,"outcome":"failed","operation":"api","cluster":null,"request_id":"$haprion_request_uuid","result":null,"warnings":[],"error":{"code":"unavailable","message":"The manager did not answer; try again shortly.","node":null,"details":null}}';
    }

    location @api_504 {
        internal;
        default_type application/json;
        return 504 '{"schema_version":1,"ok":false,"outcome":"failed","operation":"api","cluster":null,"request_id":"$haprion_request_uuid","result":null,"warnings":[],"error":{"code":"unavailable","message":"The manager did not answer in time.","node":null,"details":null}}';
    }

    location / {
        limit_req zone=haprion_sign_in burst=10 nodelay;
        limit_req_status 429;
        # Only nginx's group may open it (haprion-web.socket).
        proxy_pass http://unix:/run/haprion-web.sock;
        proxy_http_version 1.1;

        #
        # Every one of these is set here, overwriting whatever arrived. The app
        # trusts nginx's forwarded headers, which is only safe because a client
        # cannot contribute to them - a request that arrives claiming its own
        # X-Forwarded-For has that claim replaced, not appended.
        #
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;

        proxy_connect_timeout 5s;
        proxy_read_timeout    60s;
    }
}
