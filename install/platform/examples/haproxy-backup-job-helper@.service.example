# Runs one bounded backup operation as root, outside the worker's read-only mount namespace.
[Unit]
Description=Run one HAProxy Manager backup job
Documentation=file:///opt/haproxy-mgmt/current

[Service]
Type=exec
ExecStart=/opt/haproxy-mgmt/current/bin/haproxy-backup-job-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=13min
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete
