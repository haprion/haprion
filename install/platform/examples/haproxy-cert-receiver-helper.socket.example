# The socket the Haprion job worker asks for a receiver on.
#
# Owned by root, connectable by the worker's account and nobody else. Each
# connection starts one instance of haproxy-cert-receiver-helper@.service,
# which reads one request and writes one answer. The worker gains nothing by
# connecting: what answers takes no arguments and does exactly one thing.
#
# Why a socket and not a sudoers rule (B163): the helper writes /etc - it runs
# useradd and rewrites an sshd drop-in and an nginx snippet - and a helper the
# worker starts through sudo inherits the worker's ProtectSystem=strict.
# Opening /etc to the job runner would undo that sandbox; moving the helper
# out of it keeps both.
#
# Installed as /etc/systemd/system/haproxy-cert-receiver-helper.socket, with
# WORKER_USER rendered by 07-platform-services.

[Unit]
Description=Socket the Haprion job worker asks for a receiver on
Documentation=file:///opt/haproxy-mgmt/current

[Socket]
ListenStream=/run/haproxy-mgmt/cert-receiver.sock
SocketUser=root
SocketGroup=WORKER_USER
SocketMode=0660

Accept=yes

# The queue runs one certificate job at a time; a second connection is a
# second worker, and it waits.
MaxConnections=2

RemoveOnStop=yes

[Install]
WantedBy=sockets.target
