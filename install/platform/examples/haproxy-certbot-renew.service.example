[Unit]
Description=HAProxy Manager certbot renewal
Documentation=file:///apps/haproxy-manager/current

# The distribution's certbot.timer runs /usr/bin/certbot; this one runs the
# locked environment's, against the same /etc/letsencrypt. One certbot owns the
# lineages - `renew` walks every one of them and fails on a lineage whose plugin
# it cannot load - so the distribution's timer is masked when this is enabled.
[Service]
Type=oneshot
ExecStart=/opt/haproxy-certbot/current/venv/bin/certbot -q renew --no-random-sleep-on-renew
PrivateTmp=true
