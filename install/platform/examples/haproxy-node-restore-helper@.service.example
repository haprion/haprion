# Runs one node restore step as root, outside the worker's read-only mount namespace.
# It reads the root-only state archive, keeps the run's one-time key under
# /var/lib/haproxy-mgmt/restore, and reaches the target VM over SSH.
[Unit]
Description=Run one Haprion node restore step
Documentation=file:///opt/haproxy-mgmt/current

[Service]
Type=exec
ExecStart=/opt/haproxy-mgmt/current/bin/haproxy-node-restore-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
# With Type=exec this bounds the start only; systemd does not end a run that
# has begun. What bounds a run is each of its three SSH sessions,
# 600 s, and the agent on the target, 900 s. No RuntimeMaxSec on
# purpose: a root step stopped midway would skip its own clean-up, the
# roll-back of a half-written target first
# (review 2026-09-28).
TimeoutStartSec=14min
TimeoutStopSec=15
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=yes
# AF_NETLINK because `ip route get` names the address the target will see this
# host come from - the one the one-time key's from= is limited to.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete
