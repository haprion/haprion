# One request to the OIDC provider, answered by haproxy-oidc-helper (O3, B196).
#
# Not root. The helper reads answers from a provider an administrator chose,
# so it runs with what the job needs and no more: its own account, the one
# directory holding the key that opens the client secret, and a way out to the
# network - which is the point of it, and why this unit has no IPAddressDeny.
# Everything else is the other helpers' sandbox.
#
# Installed by install/platform/17-platform-oidc as
# /etc/systemd/system/haproxy-oidc-helper@.service.

[Unit]
Description=Ask the Haprion OIDC provider one thing
Documentation=file:///opt/haprion/current

[Service]
Type=exec
User=OIDC_USER
Group=OIDC_USER
ExecStart=/opt/haprion/current/bin/haproxy-oidc-helper
StandardInput=socket
StandardOutput=socket
StandardError=journal
TimeoutStartSec=45
#
# The whole answer, not only the start: with Type=exec the start timeout ends
# once the helper runs, and a provider that answers a byte at a time keeps
# each read inside its own ten seconds. The web stops waiting at the same 45
# (oidc_web.TIMEOUT_SECONDS); this makes the helper stop too.
#
RuntimeMaxSec=45
TimeoutStopSec=10

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @privileged
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
