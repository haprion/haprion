# Lets the interface's poller read published cluster metadata, and nothing else.
#
# The existing rules for this helper are granted to %sudo - the humans - and the
# comments in them say why an application identity must not ride along on an
# operator's rule: %haproxy-mgmt also holds the worker, and a service account
# must not gain a privilege because somebody else needed one. This is that
# separate decision, with its own rule.
#
# What it grants, exactly: run one helper, with no arguments at all. The helper
# accepts no argv and reads a bounded JSON request on stdin, which is what makes
# an exact rule possible - PRIVILEGE.md forbids wildcards in argument matching,
# and without the no-argument form a rule naming a cluster would need one.
#
# All three helpers write nothing and take no lock. The status helper reaches
# The backup helper reads directory metadata under the state backup root and
# never opens an archive - which matters, because those archives hold password
# hashes and private SSH keys. The certificate helper reports metadata about the
# distribution root and about which certificates certbot is renewing; private
# key material never reaches its output, because what it parses is the leaf
# certificate alone. Both are reads, both take no lock.
#
# nodes; the inventory helper reads the exact commit named by the published
# RELEASE stamp rather than a work tree; the list helper reads saved commit
# metadata - version number, date and comment - and no file content at all. So
# the poller cannot choose what the interface is told is current, cannot show an
# unpublished draft as live, and cannot block a deploy.
#
# NOPASSWD because a service has no terminal to type a password at.
#
# Installed 0440 root:root, and accepted by visudo before it is put in place.

POLLER_USER ALL=(root) NOPASSWD: /opt/haproxy-mgmt/current/bin/haproxy-status-helper ""
POLLER_USER ALL=(root) NOPASSWD: /opt/haproxy-mgmt/current/bin/haproxy-inventory-helper ""
POLLER_USER ALL=(root) NOPASSWD: /opt/haproxy-mgmt/current/bin/haproxy-list-helper ""
POLLER_USER ALL=(root) NOPASSWD: /opt/haproxy-mgmt/current/bin/haproxy-list-backups-helper ""
POLLER_USER ALL=(root) NOPASSWD: /opt/haproxy-mgmt/current/bin/haproxy-cert-list-helper ""
