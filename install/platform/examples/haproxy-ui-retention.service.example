[Unit]
# Keeps jobs and metric history bounded. Rendered by 11-platform-retention.
Description=Roll up metrics and prune bounded HAProxy Manager history
Documentation=file:///apps/haproxy-manager-dev/src/haproxy-manager/docs/user-manual.md
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
# Root, because no application role holds delete on any table and none will.
# The migration role owns the table, and the ident map lets only root be it.
User=root
ExecStart=/usr/local/sbin/haproxy-ui-retention prune -e ENVIRONMENT
# A rollup that quietly stops leaves readers on growing raw history, so a
# failure is a failed unit rather than a line in a log nobody reads.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
