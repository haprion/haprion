[Unit]
Description=Weekly pruning of finished HAProxy Manager jobs

[Timer]
# After the daily dump rather than before it, so the newest dump still holds the
# rows this removes. A week of job rows is small; losing the ability to read
# them back out of a backup for the sake of half an hour is not a trade worth
# making.
OnCalendar=Sun *-*-* 03:30:00
# Persistent so a machine that was off on Sunday prunes when it comes back,
# rather than skipping a week and then removing twice as much unannounced.
Persistent=true
RandomizedDelaySec=15m

[Install]
WantedBy=timers.target
