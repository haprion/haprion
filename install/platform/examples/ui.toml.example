# Configuration for the web interface.
#
# Root-owned, readable by the platform group, and never writable by the accounts
# that read it: every value here is a decision the deployment made, not state a
# running service can rewrite.
#
# management_writes comes FIRST. A bare key written after a table belongs to
# that table in TOML, so the same line below [listen] would silently become
# listen.management_writes and read as absent - which looks exactly like writes
# being disabled.

# Phase 4 installs the platform read-only. Turning this on is what enables the
# job path, and turning it off is the documented rollback for it: no build, no
# deploy, back to a read-only interface.
management_writes = false

# Only for visual UI work before a safe non-production cluster fixture exists.
# It supplies clearly labelled synthetic Dashboard/Proxies data in the web
# process; it never starts a poll, reaches a cluster, or writes the database.
# It may only be enabled with management_writes=false and clusters=[].
# demo_fixture = true

# Development only: displays a manually captured, root-owned one-way snapshot
# from production. It never permits this environment to reach production, and
# may only be enabled with management_writes=false, clusters=[] and no demo
# fixture. Capture it explicitly with platform step 10 before enabling it.
# production_snapshot = true

# Which clusters the poller asks about. Named here rather than discovered,
# because the application accounts cannot read the engine's configuration - that
# tree is private, and a poller reaching into it directly is what the privilege
# split exists to prevent. The privileged helper still decides whether each name
# is a real cluster; this only says which ones to ask about.
#
# Empty means the poller has nothing to do and says so rather than starting.
clusters = []

[poller]
# How stale a status reading is allowed to get. Nothing renders a reading
# without saying how old it is, so this is a statement about that number rather
# than a tuning knob.
interval_seconds = 60

[database]
# Connections use the local socket and peer authentication. There is no user and
# no password here, and no place to put one: each service account is named after
# its database role, so the kernel establishes who is connecting.
name = "haproxy_ui"
socket_directory = "/var/run/postgresql"

[listen]
# Bound to loopback. Nginx terminates TLS and is the only thing that reaches
# this port; the interface is never exposed directly.
host = "127.0.0.1"
port = 8080
