# Configuration for the web interface.
#
# Root-owned, readable by the platform group, and never writable by the accounts
# that read it: every value here is a decision the deployment made, not state a
# running service can rewrite.
#
# management_writes comes FIRST. A bare key written after a table belongs to
# that table in TOML, so the same line below [listen] would silently become
# listen.management_writes and read as absent - which looks exactly like writes
# being disabled.

# On: the interface builds, publishes and deploys, which is what it is for. Off
# is the documented rollback for the job path: no build, no deploy, back to a
# read-only interface, and nothing to rebuild. A file without this line reads
# as off, so only a line that says so turns writes on.
management_writes = true

# Only for visual UI work before a safe non-production cluster fixture exists.
# It supplies clearly labelled synthetic Dashboard/Proxies data in the web
# process; it never starts a poll, reaches a cluster, or writes the database.
# It may only be enabled with management_writes=false and clusters=[].
# demo_fixture = true

# Which clusters the poller asks about. Named here rather than discovered,
# because the application accounts cannot read the engine's configuration - that
# tree is private, and a poller reaching into it directly is what the privilege
# split exists to prevent. The privileged helper still decides whether each name
# is a real cluster; this only says which ones to ask about.
#
# Empty means the poller has nothing to do and says so rather than starting.
clusters = []

[poller]
# How stale a status reading is allowed to get. Nothing renders a reading
# without saying how old it is, so this is a statement about that number rather
# than a tuning knob.
#
# The poller is also woken by a finished job, so a change made through the
# interface is read back at once and never waits for this. What waits for it is
# a change made outside the interface - a publish or a deploy run from the
# command line - and the whole interval is then how long a page can disagree
# with the nodes.
#
# One pass over two clusters measured 2-3 seconds on the reference machine, so
# 20 leaves the poller idle most of the time while keeping that disagreement
# short. Raise it where a cluster is large or its nodes are far away; the floor
# of 10 is close enough to a pass that a slow one would run into the next.
interval_seconds = 20

[database]
# Connections use the local socket and peer authentication. There is no user and
# no password here, and no place to put one: each service account is named after
# its database role, so the kernel establishes who is connecting.
name = "haprion"
socket_directory = "/var/run/postgresql"

[listen]
# Bound to loopback. Nginx terminates TLS and is the only thing that reaches
# this port; the interface is never exposed directly.
host = "127.0.0.1"
port = 8080

# [traffic_logs]
# Off unless a deployment turns it on, and read-only in every sense: this
# process reads files the collector already placed in the mirror, and never asks
# a node anything. A node that is slow or unreachable therefore cannot make a
# page slow - it can only make its own mirror old, which the page reports per
# node rather than hiding behind an empty table.
#
# Requires platform step 13 and each node's own route. Cannot be combined with
# demo_fixture: the fixture has no collector, no key and no node access, so a
# mirror it could read arrived some other way.
#
# The unfiltered page shows the newest database records. Filters use the
# retained daily partitions and show the newest max_lines matches (1-10000).
# enabled = true
# directory = "/apps/haproxy-manager/logs/mirror"
# max_lines = 500
# retention_days = 7

# [dns_profiles]
# The public half of the key pair platform step 15 made. DNS provider
# credentials entered in the interface are sealed against it before they are
# stored; the private half is root's, under secrets/, and this process never
# reads it. Absent, the interface offers no provider profiles.
# public_key = "/apps/haproxy-manager/config/dns-profile-keys/<key id>.pub"


# [oidc]
# The public half of the key pair platform step 17 made. The OIDC client
# secret typed in the interface is sealed against it before it is stored; the
# OIDC helper holds the private half and this process never reads it. Absent,
# Settings -> Users -> OIDC configuration says the helper is not installed.
# public_key = "/apps/haproxy-manager/config/oidc-keys/<key id>.pub"
