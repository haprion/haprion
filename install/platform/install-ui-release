#!/bin/bash
#
# Activate a release of the web interface, or only prepare it.
#
#     sudo ./install-ui-release [--prepare] [--no-first-account] <release-id>
#
# --no-first-account is haprion-setup's: it asks for the first account itself,
# last, when everything else is done.
#
# The release is the one the haprion-ui package unpacked under
# /opt/haprion-ui/releases: built from one commit, in a container of this
# distribution, against this distribution's /usr/bin/python3, and named after
# that commit - so "which code is running" is answerable by reading a symlink,
# and answerable the same way in a year. Nothing is built here.
#
# The release directory holds the runtime environment and the migrations that
# prepare its schema, with the tool that applies them. All are immutable parts
# of the same named delivery.
#
# `current` is switched only after the new release has imported successfully.
# It is then restarted and proved through the running service. A release that
# cannot import its own dependencies must not become the one a restart picks.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
prepare_only=0
first_account=1
while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --prepare) prepare_only=1 ;;
        --no-first-account) first_account=0 ;;
        *) die "unknown option: $1" ;;
    esac
    shift
done
release_id="${1:-}"
[[ -n "$release_id" ]] || die "usage: $(basename "$0") [--prepare] [--no-first-account] <release-id>"
[[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] || die "invalid release id: ${release_id}"
release="${UI_ROOT}/releases/${release_id}"

step "The release"
#
# Each part checked by name, because a release unpacked from a damaged or
# older archive fails later, somewhere less legible: a migration bundle without
# its tool says nothing until the update is half-way through.
#
for part in venv/bin/python migration/alembic.ini migration/migrations/env.py migration/lib/alembic; do
    [[ -e "${release}/${part}" ]] || die "${release} has no ${part}; reinstall the haprion-ui package"
done
log "  ok       ${release}"

step "Ownership"
#
# Root-owned and not writable by the account that runs it. A service that can
# rewrite its own code turns any flaw that reaches the filesystem into a
# permanent one.
#
chown -R "root:${PLATFORM_GROUP}" "$release"
find "$release" -type d -exec chmod 750 {} +
find "$release" -type f -exec chmod g-w,o-rwx {} +
log "  ok       root:${PLATFORM_GROUP}, not group-writable"

step "Self-containment"
#
# Checked rather than trusted, because the failure it prevents is unreadable
# from the symptom. Everything the release needs must be inside the release or
# under /usr; a path anywhere else is a dependency on the machine that built it,
# and the sandbox the service runs in will simply report it as missing.
#
interpreter="$(readlink -f "${release}/venv/bin/python")"
case "$interpreter" in
    /usr/*) log "  ok       interpreter ${interpreter}" ;;
    *)      die "the release interpreter is outside /usr: ${interpreter}
  A release must not depend on an interpreter from the machine that built it." ;;
esac

#
# And that the scripts point into this release. A shebang naming any other
# directory is a release that cannot run, and it fails at exec with "no such
# file or directory" for a file that is plainly present - which reads as
# anything except a wrong shebang.
#
shebang="$(head -1 "${release}/venv/bin/uvicorn")"
case "$shebang" in
    "#!${release}/venv/bin/python") log "  ok       scripts point into the release" ;;
    *) die "a console script points outside the release: ${shebang}" ;;
esac

step "Proving the release before it becomes current"
#
# Imported as the account that will run it, from the release that is about to be
# activated. A release that cannot import its own dependencies, or that the
# service account cannot read, must not become the one a restart picks up - and
# the only way to know is to try it as that user.
#
sudo -u "$WEB_USER" "${release}/venv/bin/python" -c \
    'import haprion_ui.app, haprion.cluster_status, haprion.inventory; print("imports ok")' \
    || die "the release cannot be imported by ${WEB_USER}"
log "  ok       ${WEB_USER} can import the release"

if [[ "$prepare_only" -eq 1 ]]; then
    echo
    log "release ${release_id} is prepared but not active"
    log "migrate it with: ./migrate --release ${release_id}"
    log "activate it by rerunning this command without --prepare"
    exit 0
fi

#
# Claims paused, and the running jobs waited for, before anything is switched
# or restarted (CR-12): a restart ends the job the worker holds, and a node
# restore or a backup then ends `unknown` while its root helper carries on.
# Lifted again however this script ends. Only once a worker is installed - a
# first installation has none yet.
#
if systemctl cat "$WORKER_UNIT" >/dev/null 2>&1; then
    step "Holding the worker's claims"
    drain=(/usr/sbin/haprion-drain)
    "${drain[@]}" pause --wait "${DRAIN_SECONDS:-900}"
    # shellcheck disable=SC2064 # the command is fixed now, not when the trap runs
    trap "$(printf '%q ' "${drain[@]}") resume || true" EXIT
fi

step "Activating"
link="${UI_ROOT}/current"
#
# `readlink` without -f, deliberately. -f canonicalises a path even when the
# link is absent, so it answers with the link's own path and the "was ..." line
# below reports the switch as coming from itself.
#
existing="$(readlink "$link" 2>/dev/null || true)"
if [[ "$existing" == "$release" ]]; then
    log "  ok       current already points at ${release_id}"
else
    previous="${existing:-nothing}"
    [[ "$previous" == "nothing" ]] || previous="$(basename "$previous")"
    #
    # Written beside and renamed over, so `current` is never briefly absent.
    # A service restarting during the switch finds one release or the other,
    # never nothing.
    #
    ln -sfn "$release" "${link}.new"
    mv -T "${link}.new" "$link"
    log "  switched current -> ${release_id}  (was ${previous})"
fi

#
# The same reasoning as the web unit below, and the reason it cannot be left
# implicit: all three services exec out of the same `current` symlink, so a
# release that restarts only the web unit is running in one process and not in
# the other two. That is worse than not having switched at all, because the
# symlink then says the new release is live while two thirds of it is not.
#
# Done before the web unit so that the health response, which is this script's
# only evidence, is evidence about a platform that is wholly on the new
# release rather than a third of it.
#
# A missing unit is skipped rather than refused: on a first installation the
# worker and poller are installed by step 7, after the first release.
#
step "Starting the background services"
for background_unit in "$WORKER_UNIT" "$POLLER_UNIT"; do
    if systemctl cat "$background_unit" >/dev/null 2>&1; then
        systemctl restart "$background_unit"
        log "  restarted ${background_unit}"
    else
        log "  pending  ${background_unit} is not installed here"
    fi
done

unit="$WEB_UNIT"
if systemctl cat "$unit" >/dev/null 2>&1; then
    step "Starting"
    #
    # A process follows the `current` symlink only when it execs. `start` (and
    # `enable --now`) silently leaves an already-active unit on the previous
    # release, so every activation must restart the web unit before its health
    # response is accepted as evidence for the new release.
    #
    # With its socket: a socket unit an update changed takes effect only when
    # restarted, and the web holds the descriptor it was handed until it is.
    socket="${unit%.service}.socket"
    systemctl enable --quiet "$socket"
    systemctl restart "$socket" "$unit"
    log "  restarted ${socket} ${unit}"

    step "Proving it answers"
    for _ in $(seq 10); do
        if answer="$(curl -fsS --max-time 3 --unix-socket "$WEB_SOCKET" http://localhost/healthz 2>/dev/null)"; then
            log "  ok       ${answer}"
            break
        fi
        sleep 1
    done
    [[ -n "${answer:-}" ]] || {
        systemctl status --no-pager --lines=20 "$unit" || true
        die "${unit} did not answer /healthz on ${WEB_SOCKET} after the release switch"
    }
else
    log "  pending  ${unit} is installed and started by platform step 4"
fi

step "The first account"
#
# `admin`, a break-glass admin whose password the installer types here, on an
# installation with no account at all (B196). Every later release finds
# accounts and does nothing, so this runs every time rather than being a step
# someone has to remember on the first.
#
# A warning rather than a stop: the release is already active, and an
# installation that has not migrated yet makes the account after it has.
#
if (( first_account )); then
    /usr/sbin/haprion-user init-admin \
        || warn "no first account was made; after ./migrate, run: haprion-user init-admin"
else
    log "  later    haprion-setup asks for it when everything else is done"
fi

echo
log "release ${release_id} is current"
