#!/bin/bash
#
# Build and activate a release of the web interface.
#
#     sudo UV_BIN=/path/to/uv ./install-ui-release <answers-file> <source-tree>
#
# A release is a commit. The source tree must be a clean checkout, and the
# release is named after the commit it was built from - so "which code is
# running" is answerable by reading a symlink, and answerable the same way in a
# year.
#
# The release directory holds one thing: a virtual environment with both
# distributions installed non-editably. The plan sketched app/ beside venv/;
# one directory that is replaced whole is simpler and cannot half-update.
#
# `current` is switched only after the new release has been started and has
# answered. A release that cannot import its own dependencies must not become
# the one a service restart would pick up.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
load_answers "${1:-}"
source_tree="${2:-}"
require_vars PLATFORM_ROOT PLATFORM_GROUP WEB_USER

[[ -n "$source_tree" ]] || die "usage: $(basename "$0") <answers-file> <source-tree>"
[[ -d "${source_tree}/ui" ]] || die "not a source tree: ${source_tree}"

uv="${UV_BIN:-}"
[[ -n "$uv" && -x "$uv" ]] || die "set UV_BIN to the uv executable"

PYTHON_BIN="${PYTHON_BIN:-/usr/bin/python3}"
[[ -x "$PYTHON_BIN" ]] || die "not executable: ${PYTHON_BIN}"

step "Source tree"
#
# Refused rather than warned about. A release built from an edited tree is a
# release nobody can reproduce, and the moment it is running in production the
# question "what is in it" has no answer.
#
if [[ -n "$(git -C "$source_tree" status --porcelain)" ]]; then
    die "the source tree has uncommitted changes. A release is a commit."
fi
commit="$(git -C "$source_tree" rev-parse --short=12 HEAD)"
version="$(sed -n 's/^version = "\(.*\)"$/\1/p' "${source_tree}/ui/pyproject.toml" | head -1)"
[[ -n "$version" ]] || die "cannot read the version from ui/pyproject.toml"
release_id="${version}-${commit}"
log "  ok       ${release_id}"

release="${PLATFORM_ROOT}/releases/${release_id}"

step "Building"
if [[ -d "$release" ]]; then
    log "  ok       ${release} already exists"
else
    #
    # Built at its final path, not staged and renamed.
    #
    # A virtual environment is not relocatable: every console script carries an
    # absolute shebang naming the interpreter at the path it was built in, and
    # pyvenv.cfg and the activate scripts do the same. Building somewhere else
    # and moving it leaves each of those pointing at a directory that no longer
    # exists - which surfaces as the service failing to exec a program that is
    # plainly there.
    #
    # Nothing is lost by dropping the staging step. The switch that has to be
    # atomic is the `current` symlink, and that happens further down, after the
    # release has been proved. A half-built directory here is removed on the way
    # out and was never current.
    #
    trap 'rm -rf -- "$release"' EXIT
    #
    # --locked so the lockfile decides, and a stale lockfile fails instead of
    # being refreshed underneath a release. --no-dev leaves the test and lint
    # tooling out of something that only has to run. --no-editable so the
    # installed code is a copy rather than a pointer into a working tree that
    # can change after installation.
    #
    #
    # --python-preference only-system, and the system interpreter named. Left to
    # itself uv builds the environment against its OWN downloaded Python, which
    # lives under the home directory of whoever ran the build - and a release
    # that depends on an interpreter in a developer's home is not a release. It
    # also fails in a way that takes a while to read: ProtectHome hides /home
    # from the service, so exec reports the interpreter as not found.
    #
    ( cd "${source_tree}/ui" \
      && UV_PROJECT_ENVIRONMENT="${release}/venv" "$uv" sync --locked --no-dev \
             --no-editable --python "$PYTHON_BIN" --python-preference only-system )
    trap - EXIT
    log "  built    ${release}"
fi

step "Ownership"
#
# Root-owned and not writable by the account that runs it. A service that can
# rewrite its own code turns any flaw that reaches the filesystem into a
# permanent one.
#
chown -R "root:${PLATFORM_GROUP}" "$release"
find "$release" -type d -exec chmod 750 {} +
find "$release" -type f -exec chmod g-w,o-rwx {} +
log "  ok       root:${PLATFORM_GROUP}, not group-writable"

step "Self-containment"
#
# Checked rather than trusted, because the failure it prevents is unreadable
# from the symptom. Everything the release needs must be inside the release or
# under /usr; a path anywhere else is a dependency on the machine that built it,
# and the sandbox the service runs in will simply report it as missing.
#
interpreter="$(readlink -f "${release}/venv/bin/python")"
case "$interpreter" in
    /usr/*) log "  ok       interpreter ${interpreter}" ;;
    *)      die "the release interpreter is outside /usr: ${interpreter}
  A release must not depend on an interpreter from the machine that built it." ;;
esac

#
# And that the scripts point into this release. A shebang naming any other
# directory is a release that cannot run, and it fails at exec with "no such
# file or directory" for a file that is plainly present - which reads as
# anything except a wrong shebang.
#
shebang="$(head -1 "${release}/venv/bin/uvicorn")"
case "$shebang" in
    "#!${release}/venv/bin/python") log "  ok       scripts point into the release" ;;
    *) die "a console script points outside the release: ${shebang}" ;;
esac

step "Proving the release before it becomes current"
#
# Imported as the account that will run it, from the release that is about to be
# activated. A release that cannot import its own dependencies, or that the
# service account cannot read, must not become the one a restart picks up - and
# the only way to know is to try it as that user.
#
sudo -u "$WEB_USER" "${release}/venv/bin/python" -c \
    'import haproxy_ui.app, haproxy_mgmt.cluster_status; print("imports ok")' \
    || die "the release cannot be imported by ${WEB_USER}"
log "  ok       ${WEB_USER} can import the release"

step "Activating"
link="${PLATFORM_ROOT}/current"
#
# `readlink` without -f, deliberately. -f canonicalises a path even when the
# link is absent, so it answers with the link's own path and the "was ..." line
# below reports the switch as coming from itself.
#
existing="$(readlink "$link" 2>/dev/null || true)"
if [[ "$existing" == "$release" ]]; then
    log "  ok       current already points at ${release_id}"
else
    previous="${existing:-nothing}"
    [[ "$previous" == "nothing" ]] || previous="$(basename "$previous")"
    #
    # Written beside and renamed over, so `current` is never briefly absent.
    # A service restarting during the switch finds one release or the other,
    # never nothing.
    #
    ln -sfn "$release" "${link}.new"
    mv -T "${link}.new" "$link"
    log "  switched current -> ${release_id}  (was ${previous})"
fi

step "The account tool"
#
# A shim rather than a symlink into the release. The tool must follow `current`,
# so that a rollback takes the account tool back with it: a shim resolves the
# link at every invocation, while a symlink written now would have to be
# rewritten by every future release to stay honest.
#
install_file /usr/local/sbin/haproxy-ui-user root:root 755 "$(cat <<EOF
#!/bin/bash
#
# Accounts for the web interface. Installed by install-ui-release.
#
# Runs whatever \`current\` points at, so an application rollback takes this with
# it. Root only; it connects as the migration role, which is the only identity
# allowed to write the account table.
#
exec ${PLATFORM_ROOT}/current/venv/bin/haproxy-ui-user "\$@"
EOF
)"

echo
log "release ${release_id} is current"
