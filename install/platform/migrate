#!/bin/bash
#
# Apply database migrations from a prepared release.
#
# This is a deliberate root action, not something a service does when it starts.
# The migration role owns every object in the database and no operating-system
# account maps to it except root, so a service that restarts cannot alter the
# schema even by accident.
#
#     sudo ./migrate <answers-file> [--release <release-id>] [alembic arguments]
#
# With no alembic arguments it runs `upgrade head`. Anything else is passed
# through, so `sudo ./migrate answers.env current` and `... history` work.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
answers="${1:-}"
load_answers "$answers"
shift
require_vars DB_NAME DB_MIGRATION_ROLE

release_id=""
if [[ "${1:-}" == "--release" ]]; then
    [[ -n "${2:-}" ]] || die "--release needs a release id"
    release_id="$2"
    shift 2
    require_vars PLATFORM_ROOT
    [[ "$release_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] \
        || die "invalid release id: ${release_id}"
    migration_root="${PLATFORM_ROOT}/releases/${release_id}/migration"
    [[ -f "${migration_root}/alembic.ini" && -f "${migration_root}/migrations/env.py" ]] \
        || die "release ${release_id} has no migration bundle; prepare it first"
fi

alembic="${ALEMBIC_BIN:-}"
#
# The development environment's alembic, not a release's. alembic is in the
# `dev` dependency group and a release is built with --no-dev, so no release has
# ever had one - which is correct: a running service must not be able to alter
# the schema it reads. This script reads the migrations out of the source tree
# on purpose, and alembic is the tool that applies them rather than application
# code that serves requests.
#
[[ -n "$alembic" ]] || die "set ALEMBIC_BIN to the alembic executable of the
  development environment, for example /path/to/venv-ui/bin/alembic. It is not
  in a release: alembic is a development dependency and releases are built with
  --no-dev."
[[ -x "$alembic" ]] || die "not executable: ${alembic}"

#
# The role is named in the URL because libpq would otherwise ask for one named
# after the operating-system user - root, here, which is not a role and must not
# become one. Peer authentication and the ident map decide whether root may be
# this role; the URL only states which role it is asking for.
#
export HAPROXY_UI_DATABASE_URL="postgresql+psycopg://${DB_MIGRATION_ROLE}@/${DB_NAME}?host=/var/run/postgresql"

#
# Checked here rather than left to Postgres. The migrations grant to the three
# contract roles, so running them before step 2 has created those roles fails
# somewhere in the middle of a stack trace with "role app_web does not exist" -
# true, but not a sentence that tells anyone what to do about it.
#
missing=""
for role in app_web app_worker app_poller app_collector; do
    if [[ "$(psql -U "$DB_MIGRATION_ROLE" -d "$DB_NAME" -qtAX \
             -c "select 1 from pg_roles where rolname = '${role}'")" != "1" ]]; then
        missing="${missing} ${role}"
    fi
done
[[ -z "$missing" ]] || die "the contract role(s)${missing} do not exist.
  Run ./02-platform-database ${answers} first; the migrations grant to them."

if [[ $# -eq 0 ]]; then
    set -- upgrade head
fi

step "Migrating ${DB_NAME} as ${DB_MIGRATION_ROLE}"
if [[ -n "$release_id" ]]; then
    log "  release  ${release_id}"
    cd "$migration_root"
    exec "$alembic" -c alembic.ini "$@"
fi

# Compatibility path for an installation made before releases carried their
# migrations. The coordinated update path always supplies --release; retain
# this only so an existing installation can reach its first bundled release.
warn "reading migrations from the source tree; use --release after preparing a bundled release"
cd ../../ui
exec "$alembic" "$@"
