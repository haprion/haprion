#!/bin/bash
#
# Prepare, migrate, activate and prove one UI platform release as one update.
#
#     sudo ./update-platform-release <release-id>
#
# What the haprion-ui package's postinst runs on an upgrade (B266, D2), with
# the release the package has just unpacked; an operator can run it the same
# way. It reads no answers file: everything it needs is fixed or in ui.toml.
#
# The CLI and node package remain independent installations. This flow checks
# them before it changes the database; it never installs either one. The first
# platform installation still uses the numbered steps in README.md.
#
set -Eeuo pipefail
cd "$(dirname "$0")"
# shellcheck source=../lib.sh
source ../lib.sh

need_root
release_id="${1:-}"
[[ -n "$release_id" ]] || die "usage: $(basename "$0") <release-id>"

current="${UI_ROOT}/current"
[[ -L "$current" ]] || die "${current} is missing; use the numbered first-install steps"
previous_path="$(readlink -f "$current")"
[[ -d "$previous_path" && "$previous_path" == "${UI_ROOT}/releases/"* ]] \
    || die "${current} does not point into ${UI_ROOT}/releases"
previous_id="$(basename "$previous_path")"
rollback="/usr/sbin/haprion-rollback"
[[ -x "$rollback" ]] || die "${rollback} is missing; reinstall the haprion-ui package"

#
# Activation restarts the worker. `install-ui-release` pauses the worker's
# claims and waits for the running jobs before it switches anything (CR-12);
# checked once here, minutes before the restart, a restore could start in
# between and be cut off by it.
#
step "Preparing ${release_id}"
./install-ui-release --prepare "$release_id"

#
# What the first installation's steps lay out besides files - the accounts,
# the run-time directory and the directories the worker's sandbox opens - made
# again from this package before its units are installed. A release that needs
# one more then fails no update for want of a step run by hand, and the
# optional steps' identity directories get the owner and mode their step gives
# them now (review 26-10-24, 14-02). Each makes what is missing and changes
# only what differs.
#
step "Accounts and directories"
apply_sysusers ../sysusers/haprion.conf
apply_tmpfiles ../tmpfiles/haprion.conf
ensure_worker_directories
ensure_identity_directories

#
# The units, sudo rules, sockets, timers and site the numbered steps
# installed, from this package (review 2026-10-22, 6-5) - before the first
# check, which holds them to the candidate. What they replace is kept, and put
# back by any way this update ends short of a proved release: a die before
# activation leaves the previous release running, with the files it was
# checked against.
#
kept="$(mktemp -d)"
files_settled=no
settle_files() {
    if [[ "$files_settled" != yes ]]; then
        ./refresh-platform-files --restore "$kept" \
            || warn "the platform files could not all be put back; ${kept} holds them"
        files_settled=yes
    fi
}
#
# Any way out after the switch and before the proof - an error under `set -e`,
# Ctrl-C, a dropped SSH session - puts the previous release back, not only its
# files. With the files alone the candidate stayed current beside the previous
# release's units, and the next run found it current and called it done
# (review 26-10-24, 03-02).
#
on_exit() {
    local status=$?
    if [[ "$files_settled" != yes ]] && declare -F restore_previous >/dev/null && candidate_current; then
        restore_previous || warn "the previous release could not be restored; run ${rollback} --to ${previous_id}"
    fi
    settle_files
    rm -rf -- "$kept"
    (( status == 0 )) || where_it_stands
}

#
# The last words of an update that did not complete (R2, F7): under apt they
# are all there is. Which release runs, where the database stands when a
# migration ran, and what to do next - for dpkg, `dpkg --configure -a`.
#
schema_now=""
where_it_stands() {
    local running schema dump="" dump_dir
    running="$(basename "$(readlink -f "$current" 2>/dev/null || echo unknown)")"
    {
        echo
        echo "The update to ${release_id} did not complete. ${running} is running."
        if [[ -n "$schema_now" ]]; then
            schema="$(./migrate --release "$running" current 2>/dev/null \
                      | { grep -Eo '^[0-9A-Za-z_]+' || true; } | tail -1)"
            if [[ -n "$schema" && "$schema" != "$schema_now" ]]; then
                dump_dir="$(admin_value /etc/haprion/ui-admin.conf DUMP_DIR 2>/dev/null || true)"
                [[ -z "$dump_dir" ]] || dump="$(find "${dump_dir}/before-migration" -maxdepth 1 \
                        -name "*-${schema_now}-to-*.dump" -printf '%T@ %p\n' 2>/dev/null \
                        | sort -rn | head -1 | cut -d' ' -f2-)"
                echo "The database moved from schema ${schema_now} to ${schema}, which ${running} runs on."
                [[ -z "$dump" ]] || echo "The dump taken before the migration: ${dump}"
            fi
        fi
        if [[ -n "${DPKG_MAINTSCRIPT_PACKAGE:-}" ]]; then
            echo "Correct what the lines above name, then: sudo dpkg --configure -a"
        else
            echo "Correct what the lines above name, then run the update again."
        fi
    } >&2
}
trap on_exit EXIT
./refresh-platform-files "$release_id" "$kept"

step "Checking prerequisites and rollback-safe schema transition"
./check-compatibility --release "$release_id" --before-migration
#
# This package no longer names PostgreSQL as a dependency (26-10-17); the
# server it brought is marked as installed by hand before apt can count it
# as unneeded. On a running cluster this changes nothing else.
#
./ensure-postgresql

#
# A dump before a schema change, by the release's own alembic (logic review
# 2026-10-22, F1): the daily one is up to a day old and today's run replaces
# it. Only when the schema moves - a package installed again takes none.
#
schema_now="$(./migrate --release "$release_id" current | { grep -Eo '^[0-9A-Za-z_]+' || true; } | tail -1)"
schema_next="$(./migrate --release "$release_id" heads | { grep -Eo '^[0-9A-Za-z_]+' || true; } | tail -1)"
[[ -n "$schema_now" && -n "$schema_next" ]] || die "cannot read the schema revisions"
if [[ "$schema_now" != "$schema_next" ]]; then
    step "Dumping the database before ${schema_now} -> ${schema_next}"
    /usr/sbin/haprion-backup dump-before-migration "$schema_now" "$schema_next"
fi

step "Migrating from the prepared release"
./migrate --release "$release_id"

step "Proving database privileges after migration"
# The privilege contract belongs to the release being installed, like its
# migrations, and this copy came in the same package as the release.
./03-verify

#
# The days ahead, for a release whose migration may have added a partitioned
# table, and for an installation whose nightly maintenance has not run lately.
# Creates partitions and deletes nothing (review 2026-10-22, 3-2).
#
if [[ -e /etc/systemd/system/haprion-retention.timer ]]; then
    step "Making the partitions ahead"
    /usr/sbin/haprion-retention horizon \
        || warn "the partitions ahead could not be made; the nightly haprion-retention will try again"
fi

step "Checking the complete candidate before activation"
./check-compatibility --release "$release_id"

#
# Whether the switch happened. A failure before it leaves the previous release
# running with nothing to put back, and says so once (R2, F8: "was restored"
# and "no UI rollback is needed" twice, for an update that never switched).
#
candidate_current() {
    [[ "$(readlink -f "$current" 2>/dev/null || true)" == "${UI_ROOT}/releases/${release_id}" ]]
}

restore_previous() {
    settle_files
    warn "restoring UI release ${previous_id}"
    "$rollback" --to "$previous_id"
    ./check-compatibility \
        || die "release ${previous_id} was restored but the installation is not compatible"
}

step "Activating ${release_id}"
if ! ./install-ui-release "$release_id"; then
    if candidate_current; then
        restore_previous
        die "activation failed; UI release ${previous_id} was restored"
    fi
    die "activation stopped before the switch; ${previous_id} kept running"
fi
#
# The site refresh-platform-files proved, now that the web listens where it
# says (haprion-web.socket).
#
if [[ -e /etc/nginx/sites-available/haprion ]]; then
    #
    # The site was proved with `nginx -t` before anything moved. A reload that
    # fails here - nginx not running - is said, and the proof below decides.
    #
    if systemctl reload nginx; then
        log "  reloaded nginx"
    else
        warn "nginx was not reloaded; once it runs: sudo systemctl reload nginx"
    fi
fi

step "Proving the running installation"
if ! ./check-compatibility; then
    restore_previous
    die "the final compatibility check failed; UI release ${previous_id} was restored"
fi
files_settled=yes

#
# Release retention (B156), only now that the update is proved: a new release
# has been added, and a failed activation is exactly when nothing may go.
# Ten stay (RELEASES_KEPT in the environment overrides) - a release
# is reproducible from its commit, so an old directory loses nothing Git
# holds. The release just activated and the one it replaced always stay,
# whatever their age: the rollback path is never the one pruned. Ordered by
# modification time, not name - a release id ends in a commit hash.
# Said only when there is something to remove: "removed 0" on every update
# is a line to read that says nothing (Fas 18, 26-10-13).
#
keep="${RELEASES_KEPT:-10}"
[[ "$keep" =~ ^[0-9]+$ && "$keep" -ge 2 ]] || die "RELEASES_KEPT must be a whole number of at least 2"
old_releases=()
while read -r old_release; do
    [[ -z "$old_release" || "$old_release" == "$release_id" || "$old_release" == "$previous_id" ]] && continue
    old_releases+=("$old_release")
done < <(find "${UI_ROOT}/releases" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' \
         | sort -rn | cut -d' ' -f2- | tail -n +"$((keep + 1))")
if (( ${#old_releases[@]} > 0 )); then
    step "Pruning old releases"
    pruned=0
    for old_release in "${old_releases[@]}"; do
        if rm -rf -- "${UI_ROOT}/releases/${old_release}"; then
            pruned=$((pruned + 1))
        else
            warn "could not remove release ${old_release}; it stays"
        fi
    done
    log "  kept the ${keep} newest releases, removed ${pruned}"
fi

echo
log "platform update complete"
log "  previous  ${previous_id}"
log "  current   ${release_id}"
log "  rollback  ${rollback} --to ${previous_id}"

#
# Where to go next, in one place for whoever ran the update. The name is the
# one step 5 made the certificate for.
#
server_name="$(admin_value /etc/haprion/ui-tls.conf SERVER_NAME 2>/dev/null || true)"
echo
echo "The web interface is at https://${server_name:-<this machine>}/, and the commands"
echo "(haprion-status, haprion-deploy, haprion-cluster ...) are ready in /usr/bin."
