#!/bin/sh
set -eu

base=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ -z "${HAPRION_SECRET_RULES:-}" ]; then
    echo "run-tests: HAPRION_SECRET_RULES is required" >&2
    exit 2
fi
#
# The interface's suite needs its own environment and a browser; named, not
# defaulted, for the reasons ui/run-tests gives.
#
if [ -z "${HAPRION_UI_PYTHON:-}" ] || [ ! -x "${HAPRION_UI_PYTHON}" ]; then
    echo "run-tests: set HAPRION_UI_PYTHON to the python of the interface environment" >&2
    exit 2
fi
if [ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" ]; then
    echo "run-tests: set PLAYWRIGHT_BROWSERS_PATH to the Playwright browser directory" >&2
    exit 2
fi
export PLAYWRIGHT_BROWSERS_PATH

for command_name in actionlint coverage mypy pip-audit ruff shellcheck uv zizmor; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "run-tests: required command is missing: $command_name" >&2
        exit 2
    fi
done
if ! python3 -c 'import build' >/dev/null 2>&1; then
    echo "run-tests: required Python module is missing: build" >&2
    exit 2
fi

python3 "$base/tools/secret_scan.py" \
    --worktree "$base" \
    --rules "$HAPRION_SECRET_RULES"
#
# The interface tree is linted by the same pinned ruff as the engine. Its
# types are checked by its own environment, which is the one holding its
# dependencies; this gate would otherwise pass by not looking.
#
ruff check "$base/src" "$base/tests" "$base/contract-tests" "$base/tools" "$base/ui"
ruff format --check "$base/src" "$base/tests" "$base/contract-tests" "$base/tools" "$base/ui"
#
# And the Python scripts installed without a .py ending - the nodes' status,
# probe and server state helpers, tools/install-test - which a directory walk
# never offers ruff.
# Found by their first line, so a new one is linted the day it is added; until
# 2026-10-09 eleven findings sat in them unseen.
#
python_scripts=$(find "$base/install" "$base/examples" "$base/tools" -type f ! -name '*.py' ! -path '*/__pycache__/*' \
    -exec sh -c 'head -n 1 "$1" | grep -q "^#!.*python"' _ {} \; -print | sort)
if [ -z "$python_scripts" ]; then
    echo "run-tests: found no Python scripts under install/ - the search is broken" >&2
    exit 2
fi
# shellcheck disable=SC2086 # one path per word; none of them has a space
ruff check $python_scripts
# shellcheck disable=SC2086
ruff format --check $python_scripts
#
# Every shell script, found as the Python scripts are - by its ending or its
# first line - so a new one is checked the day it is added. A list kept by hand
# had left six out, a new step of the update among them (review 2026-10-22).
#
shell_scripts=$(find "$base/install" "$base/examples" "$base/tools" "$base/ui/tools" -type f \
    ! -path '*/__pycache__/*' \( -name '*.sh' \
    -o -exec sh -c 'head -n 1 "$1" | grep -Eq "^#! ?(/usr)?/bin/(env )?(ba)?sh( |$)"' _ {} \; \) \
    -print | sort)
if [ -z "$shell_scripts" ]; then
    echo "run-tests: found no shell scripts under install/ - the search is broken" >&2
    exit 2
fi
# -x so the installation scripts' `source ./lib.sh` is followed rather than
# reported as unreadable, and -P SCRIPTDIR so it is looked up beside the script
# that sources it rather than in whatever directory the gate was started from.
# shellcheck disable=SC2086 # one path per word; none of them has a space
shellcheck -x -P SCRIPTDIR "$base/run-checks" "$base/run-tests" $shell_scripts
actionlint "$base/.github/workflows"/*.yml
zizmor --pedantic "$base/.github/workflows"
mypy
#
# The same scripts' types: mypy's `files` takes only .py, and each script
# without one is its own `__main__`, so they are checked one at a time. Until
# 2026-10-18 none was, and 270 findings sat in them - one a request field that
# crashed the health probe instead of being refused. Each is checked with its
# own directory on the path, so a script that imports a module beside it
# (install/removal.py, B372) finds it as the script itself does.
#
for script in $python_scripts; do
    MYPYPATH="$(dirname -- "$script")" mypy --no-incremental "$script"
done
(cd "$base/ui" && "$(dirname -- "$HAPRION_UI_PYTHON")/mypy")
python3 "$base/contract-tests/validate_contracts.py"
#
# Both suites share one pool of processes, one test module each, so the gate
# takes as long as its cores allow rather than as long as its tests add up to.
# The interface's suite runs in its own environment, never skipped: a gate
# that passes because it could not import what it was meant to check is the
# failure this repository already had once. Each module's coverage is written
# to its own file and combined before the report.
#
#
# A document whose exit code contradicts its outcome is written anyway in use,
# with the outcome's code; here it fails the test (helper_protocol.STRICT_VARIABLE).
#
export HAPRION_EXIT_STRICT=1
coverage_dir=$(mktemp -d)
trap 'rm -rf -- "$coverage_dir"' EXIT HUP INT TERM
COVERAGE_FILE="$coverage_dir/.coverage" python3 "$base/tools/run_test_modules.py" \
    --durations "${XDG_CACHE_HOME:-$HOME/.cache}/haprion/test-durations.json" \
    --suite engine "$base/tests" "coverage run --parallel-mode -m unittest discover -s tests -v" \
    --suite ui "$base/ui/tests" "$HAPRION_UI_PYTHON -m unittest discover -s tests -t . -v"
#
# Again without HAProxy, as CI's runner has none: every module that looks the
# binary up must skip what needs it rather than fail. Two of them asserted it
# was there, passed here and failed on the first push to CI (26-10-10).
# Dropping the sbin directories from PATH is what hides it.
#
without_haproxy=$(printf '%s' "$PATH" | tr ':' '\n' | grep -v 'sbin/*$' | paste -sd: -)
for module in $(cd "$base/tests" && grep -l 'which("haproxy")' test_*.py); do
    (cd "$base" && PATH="$without_haproxy" python3 -m unittest -q "tests.${module%.py}")
done
for module in $(cd "$base/ui/tests" && grep -l 'which("haproxy")' test_*.py); do
    (cd "$base/ui" && PATH="$without_haproxy" "$HAPRION_UI_PYTHON" -m unittest -q "tests.${module%.py}")
done
COVERAGE_FILE="$coverage_dir/.coverage" coverage combine --quiet
COVERAGE_FILE="$coverage_dir/.coverage" coverage report
python3 "$base/tools/build_smoke.py"
#
# --skip-editable: the project itself is installed editable here and is not on
# PyPI. Asking for it anyway made the gate fail whenever PyPI answered that
# lookup with a 503 instead of a 404 - three times on 2026-09-28 - while it
# audits nothing: this project's own code is what the rest of the gate reads.
#
pip-audit --local --skip-editable
#
# The interface's dependencies - the web framework, the database driver - live
# in ui/uv.lock and its own environment, which the audit above never sees. uv
# reads the lockfile itself: exactly what a release installs, whatever is in
# any environment here. `audit` is a preview command in uv 0.12; the flag says
# so on purpose rather than printing it as a warning each run.
#
(cd "$base/ui" && uv audit --locked --preview-features audit-command)
#
# And certbot's: the locked set platform step 14 installs as the DNS issuer.
# Not audited until 2026-10-05, when GitHub reported six advisories in it on a
# push that the gate had passed.
#
(cd "$base/certbot" && uv audit --locked --preview-features audit-command)
