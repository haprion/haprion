#!/bin/sh
set -eu

base=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ -z "${HAPROXY_MANAGER_SECRET_RULES:-}" ]; then
    echo "run-tests: HAPROXY_MANAGER_SECRET_RULES is required" >&2
    exit 2
fi

for command_name in actionlint coverage mypy pip-audit ruff shellcheck zizmor; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "run-tests: required command is missing: $command_name" >&2
        exit 2
    fi
done
if ! python3 -c 'import build' >/dev/null 2>&1; then
    echo "run-tests: required Python module is missing: build" >&2
    exit 2
fi

python3 "$base/tools/secret_scan.py" \
    --worktree "$base" \
    --rules "$HAPROXY_MANAGER_SECRET_RULES"
#
# The interface tree is linted by the same pinned ruff as the engine. Its
# types are checked by its own environment, which is the one holding its
# dependencies; this gate would otherwise pass by not looking.
#
ruff check "$base/src" "$base/tests" "$base/contract-tests" "$base/tools" "$base/ui"
ruff format --check "$base/src" "$base/tests" "$base/contract-tests" "$base/tools" "$base/ui"
# -x so the installation scripts' `source ./lib.sh` is followed rather than
# reported as unreadable, and -P SCRIPTDIR so it is looked up beside the script
# that sources it rather than in whatever directory the gate was started from.
shellcheck -x -P SCRIPTDIR "$base/run-checks" "$base/run-tests" "$base/tools/install-actionlint" \
    "$base/tools/install-gitleaks" "$base/tools/install-shellcheck" \
    "$base/tools/install-node-bundle" \
    "$base/tools/run-codeql" "$base/tools/run-gitleaks" \
    "$base/install/lib.sh" "$base/install"/[0-9][0-9]-* \
    "$base/install/platform"/[0-9][0-9]-* "$base/install/platform/migrate" \
    "$base/install/platform/install-ui-release" \
    "$base/install/platform/bin"/haproxy-ui-* \
    "$base/install/node/haproxy-pull-deploy" \
    "$base/install/node/haproxy-cert-pull" \
    "$base/install/node/haproxy-cert-remove" \
    "$base/install/node/haproxy-cert-trigger" \
    "$base/install/node/haproxy-keepalived-state" \
    "$base/install/node/haproxy-state-export" \
    "$base/install/node/haproxy-traffic-log-enable" \
    "$base/examples/receivers"/fetch-*
actionlint "$base/.github/workflows"/*.yml
zizmor --pedantic "$base/.github/workflows"
mypy
coverage_file=$(mktemp)
trap 'rm -f -- "$coverage_file"' EXIT HUP INT TERM
COVERAGE_FILE="$coverage_file" coverage run -m unittest discover -s "$base/tests" -v
COVERAGE_FILE="$coverage_file" coverage report
python3 "$base/contract-tests/validate_contracts.py"
#
# The interface has its own suite and its own environment. Run, never
# skipped: a gate that passes because it could not import what it was meant
# to check is the failure this repository already had once this week.
#
"$base/ui/run-tests"
python3 "$base/tools/build_smoke.py"
#
# --skip-editable: the project itself is installed editable here and is not on
# PyPI. Asking for it anyway made the gate fail whenever PyPI answered that
# lookup with a 503 instead of a 404 - three times on 2026-09-28 - while it
# audits nothing: this project's own code is what the rest of the gate reads.
#
pip-audit --local --skip-editable
