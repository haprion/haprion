{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-block-client.schema.json",
  "title": "haprion-block-client-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "block_client" },
        "cluster": { "type": ["string", "null"] },
        "outcome": { "enum": ["done", "failed"] },
        "result": {
          "oneOf": [{ "$ref": "#/$defs/client_result" }, { "type": "null" }]
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "client_result": {
      "description": "One block client added or removed (B412): the client as the registry holds it, its key named by fingerprint only.",
      "type": "object",
      "required": ["action", "client"],
      "properties": {
        "action": { "enum": ["add", "remove"] },
        "client": {
          "type": "object",
          "required": ["id", "host", "cluster", "objects", "fingerprint", "added_by", "added_at"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
            "host": { "type": "string", "minLength": 1, "maxLength": 253 },
            "cluster": { "$ref": "common.schema.json#/$defs/cluster_id" },
            "objects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" }
            },
            "fingerprint": { "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" },
            "added_by": { "type": "string", "maxLength": 64 },
            "added_at": { "type": "string", "maxLength": 32 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
