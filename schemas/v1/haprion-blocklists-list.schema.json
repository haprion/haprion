{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-blocklists-list.schema.json",
  "title": "haprion-blocklists list JSON result",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "operation": {
          "const": "blocklists_list"
        },
        "cluster": {
          "type": "null"
        },
        "outcome": {
          "enum": [
            "done",
            "failed"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/list_result"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "done"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/list_result"
              }
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "entry": {
      "description": "One blocklist as *Settings \u2192 Blocklists* shows it.",
      "type": "object",
      "required": [
        "name",
        "source",
        "every",
        "addresses",
        "fetched",
        "status",
        "stored"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "source": {
          "type": "string",
          "maxLength": 255
        },
        "every": {
          "type": "string",
          "maxLength": 16
        },
        "addresses": {
          "type": "string",
          "maxLength": 64
        },
        "fetched": {
          "type": "string",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "maxLength": 64,
          "description": "What the card says beside the list: `Applying`, `Apply failed`, `Not applied` (root's file is not what the row says), `Only on the manager` (a file without a row) or empty."
        },
        "stored": {
          "type": "boolean",
          "description": "False for a definition only the manager's file has."
        }
      },
      "additionalProperties": false
    },
    "list_result": {
      "type": "object",
      "required": [
        "blocklists"
      ],
      "properties": {
        "blocklists": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/entry"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
