{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-bmc.schema.json",
  "title": "haprion-bmc-helper JSON result",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "operation": {
          "const": "bmc"
        },
        "cluster": {
          "type": "null"
        },
        "outcome": {
          "enum": [
            "done",
            "failed",
            "blocked"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/checked"
            },
            {
              "$ref": "#/$defs/saved"
            },
            {
              "$ref": "#/$defs/assigned"
            },
            {
              "$ref": "#/$defs/removed"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "checked": {
      "description": "check (B526, B538): what the BMC receiver serves, read with the account the web sealed, for the administrator to confirm. Nothing is written. `id` is the BMC's name or address.",
      "type": "object",
      "required": [
        "id",
        "address",
        "port",
        "served_sha256",
        "subject",
        "issuer",
        "not_after",
        "model",
        "firmware",
        "may_upload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "served_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subject": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1024
        },
        "not_after": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "model": {
          "type": "string",
          "maxLength": 256
        },
        "firmware": {
          "type": "string",
          "maxLength": 256
        },
        "may_upload": {
          "description": "Whether the account may upload a certificate, read from its role's privileges (`ConfigureManager`); nothing is sent. Null when the BMC does not say.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "saved": {
      "description": "save: the BMC receiver in the registry with the fingerprint that was confirmed and the user root opened from the sealed account, the account kept for root, and the certificate it carries.",
      "type": "object",
      "required": [
        "id",
        "address",
        "port",
        "fingerprint_sha256",
        "username",
        "certificate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "username": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "install": {
          "description": "haprion-cert-bmc save only: the install the save starts, as the page's save starts it. A save whose install failed is a failed answer with the install's code, and the saved target in error.details.saved.",
          "$ref": "haprion-bmc-install.schema.json#/$defs/attempt"
        },
        "certificate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$"
        }
      },
      "additionalProperties": false
    },
    "removed": {
      "description": "remove: the BMC receiver and its account are gone; the BMC keeps the certificate it serves.",
      "type": "object",
      "required": [
        "id",
        "removed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "removed": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "assigned": {
      "description": "assign (B538): the certificate a registered BMC carries now, or null for none. The account is not touched.",
      "type": "object",
      "required": [
        "id",
        "certificate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
        },
        "certificate": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$"
        }
      },
      "additionalProperties": false
    }
  }
}
