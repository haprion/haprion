{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haprion-cert-export.schema.json",
  "title": "haprion-cert-export-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cert_export" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/exported" },
            { "type": "null" }
          ]
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "exported": {
      "description": "One exportable certificate's key (B255): the key alone as PEM, or a PKCS#12 bundle of key and chain under the password the caller gave - `pfx` as OpenSSL writes one (AES-256, PBKDF2, SHA-256 MAC), `pfx-compatible` with 3DES and a SHA-1 MAC for older readers. Only for a registry entry marked exportable; the password is never returned.",
      "type": "object",
      "required": ["id", "format", "filename", "media_type", "fingerprint_sha256", "content_base64"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$" },
        "format": { "enum": ["pem-key", "pfx", "pfx-compatible"] },
        "filename": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,254}\\.(key\\.pem|pfx)$" },
        "media_type": { "enum": ["application/x-pem-file", "application/x-pkcs12"] },
        "fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "content_base64": { "type": "string", "minLength": 4, "maxLength": 262144, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      },
      "additionalProperties": false
    }
  }
}
