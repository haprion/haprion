{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haprion-cert-request.schema.json",
  "title": "haprion-cert-request JSON result",
  "description": "A key made on the manager and a signing request for somebody else's CA (C9b). The result carries the CSR, which is public by construction, and nothing about the key: it waits in the import store under the certificate's ID until the signed certificate is imported over it.",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cert_request" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/request_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/request_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "request_result": {
      "type": "object",
      "required": ["id", "domains", "key_type", "requested_at", "state", "csr_pem"],
      "properties": {
        "id": { "$ref": "haprion-cert-publish.schema.json#/$defs/certificate_id" },
        "domains": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
        "key_type": { "enum": ["ec-p256", "rsa-2048", "rsa-4096"] },
        "requested_at": { "type": "string", "format": "date-time" },
        "state": { "const": "pending" },
        "csr_pem": { "type": "string", "minLength": 1, "maxLength": 16384, "pattern": "^-----BEGIN CERTIFICATE REQUEST-----\\n" }
      },
      "additionalProperties": false
    }
  }
}
