{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haprion-cert-scep.schema.json",
  "title": "haprion-cert-scep JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cert_scep" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "partial", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/scep_result" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/issued_result" } } } },
        { "if": { "properties": { "outcome": { "const": "partial" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/pending_result" } } } }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "scep_result": { "oneOf": [{ "$ref": "#/$defs/issued_result" }, { "$ref": "#/$defs/pending_result" }] },
    "binding": {
      "type": "object",
      "required": ["id", "profile", "domains", "state"],
      "properties": {
        "id": { "$ref": "haprion-cert-publish.schema.json#/$defs/certificate_id" },
        "profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "domains": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
        "state": { "enum": ["issued", "pending"] }
      }
    },
    "pending_result": {
      "allOf": [{ "$ref": "#/$defs/binding" }],
      "properties": { "state": { "const": "pending" } },
      "not": { "required": ["publication"] }
    },
    "issued_result": {
      "allOf": [{ "$ref": "#/$defs/binding" }],
      "required": ["publication"],
      "properties": {
        "state": { "const": "issued" },
        "publication": {
          "type": "object",
          "required": ["certificate", "fingerprint_sha256", "common_name", "sans", "issuer", "not_before", "not_after", "chain_length", "replaced", "publish"],
          "properties": {
            "certificate": { "$ref": "haprion-cert-publish.schema.json#/$defs/certificate_id" },
            "fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "common_name": { "type": "string", "minLength": 1, "maxLength": 255 },
            "sans": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
            "issuer": { "type": "string", "maxLength": 1024 },
            "not_before": { "type": "string", "format": "date-time" },
            "not_after": { "type": "string", "format": "date-time" },
            "chain_length": { "type": "integer", "minimum": 0 },
            "replaced": { "type": "boolean" },
            "publish": { "$ref": "haprion-cert-publish.schema.json#/$defs/publish_result" },
            "interface": { "description": "Additive (B188): present and true when this certificate is the manager's own interface certificate.", "const": true },
            "exportable": { "description": "Additive (B255): present and true when this certificate is to be taken out and installed by hand.", "const": true },
            "retired": { "$ref": "haprion-cert-publish.schema.json#/$defs/retired_interface" }
          },
          "additionalProperties": false
        }
      }
    }
  }
}
