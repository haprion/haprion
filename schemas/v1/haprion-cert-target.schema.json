{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-cert-target.schema.json",
  "title": "haprion-cert-target JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cert_target" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "partial", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/target_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/target_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "target_names": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "minLength": 1, "maxLength": 255 }
    },
    "certificate": {
      "type": "object",
      "required": ["certificate", "state", "added", "abandoned"],
      "properties": {
        "certificate": { "$ref": "haprion-cert-delete.schema.json#/$defs/certificate_id" },
        "state": { "enum": ["changed", "unchanged", "refused", "incomplete"] },
        "added": { "$ref": "#/$defs/target_names" },
        "abandoned": { "$ref": "#/$defs/target_names" },
        "code": { "type": "string" },
        "reason": { "type": "string" },
        "layers": { "type": "array", "items": { "$ref": "haprion-cert-delete.schema.json#/$defs/layer" } },
        "nodes": { "type": "array", "items": { "$ref": "haprion-cert-delete.schema.json#/$defs/node_copy" } }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "required": ["cluster", "exit_code"],
      "properties": {
        "cluster": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": true
    },
    "target_result": {
      "type": "object",
      "required": ["action", "certificates", "changed", "unchanged", "refused", "incomplete", "deployments"],
      "properties": {
        "action": { "enum": ["add", "remove"] },
        "certificates": { "type": "array", "items": { "$ref": "#/$defs/certificate" } },
        "changed": { "type": "array", "items": { "$ref": "haprion-cert-delete.schema.json#/$defs/certificate_id" } },
        "unchanged": { "type": "array", "items": { "$ref": "haprion-cert-delete.schema.json#/$defs/certificate_id" } },
        "refused": { "type": "array", "items": { "$ref": "haprion-cert-delete.schema.json#/$defs/certificate_id" } },
        "incomplete": { "type": "array", "items": { "$ref": "haprion-cert-delete.schema.json#/$defs/certificate_id" } },
        "deployments": { "type": "array", "items": { "$ref": "#/$defs/deployment" } }
      },
      "additionalProperties": true
    }
  }
}
