{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haprion-cluster-list.schema.json",
  "title": "haprion-cluster-list-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cluster_list" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "failed"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/list_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/list_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "list_result": {
      "description": "Every cluster in clusters.yaml, in the file's order - the order the interface draws them in. Never empty: the engine refuses a cluster file without clusters.",
      "type": "object",
      "required": ["clusters"],
      "properties": {
        "clusters": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["id", "display_name", "nodes"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
              "display_name": { "type": "string", "maxLength": 128 },
              "nodes": { "type": "integer", "minimum": 2, "maximum": 8 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
