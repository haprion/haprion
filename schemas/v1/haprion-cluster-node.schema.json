{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-cluster-node.schema.json",
  "title": "haprion-node-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cluster_node" },
        "outcome": { "enum": ["done", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/node_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/node_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "node_result": {
      "description": "One node added to or removed from one cluster, or moved to another host name (`host_changed`): which files changed, and - after an addition or a host change - the host key's fingerprint the node answered with. `blocked` is a node that did not answer as itself (everything put back), the node holding the VIP, or a cluster already busy.",
      "type": "object",
      "required": ["action", "cluster", "node", "host", "files", "host_key_fingerprint"],
      "properties": {
        "action": { "enum": ["added", "removed", "host_changed"] },
        "cluster": { "type": "string", "maxLength": 63 },
        "node": { "type": "string", "maxLength": 63 },
        "host": { "type": "string", "maxLength": 253 },
        "files": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 128 } },
        "host_key_fingerprint": { "oneOf": [{ "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" }, { "type": "null" }] },
        "previous_host": { "description": "After a host change: the name the node was reached at before.", "type": "string", "maxLength": 253 },
        "publication": {
          "description": "B318: the version the node list was published as, or why it was not. The change above stands either way.",
          "oneOf": [
            {
              "type": "object",
              "required": ["version", "hash", "changed"],
              "properties": {
                "version": { "type": "integer", "minimum": 1 },
                "hash": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                "changed": { "type": "boolean" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": {
                  "type": "object",
                  "required": ["code", "message"],
                  "properties": {
                    "code": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
                    "message": { "type": "string", "minLength": 1, "maxLength": 2048 }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
