{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haprion-deploy.schema.json",
  "title": "haprion-deploy JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "deploy" },
        "outcome": { "enum": ["done", "partial", "failed", "blocked"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/deploy_result" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "enum": ["done", "partial"] } } },
          "then": { "properties": { "result": { "$ref": "#/$defs/deploy_result" } } }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "target": {
      "type": "object",
      "required": ["version", "hash"],
      "properties": {
        "version": { "$ref": "common.schema.json#/$defs/version" },
        "hash": { "$ref": "common.schema.json#/$defs/hash" }
      },
      "additionalProperties": true
    },
    "deploy_result": {
      "type": "object",
      "required": [
        "target",
        "converged",
        "override_used",
        "initial_summary",
        "final_summary",
        "nodes"
      ],
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "converged": { "type": "boolean" },
        "override_used": { "type": "boolean" },
        "initial_summary": {
          "$ref": "haprion-status.schema.json#/$defs/summary"
        },
        "final_summary": {
          "oneOf": [
            { "$ref": "haprion-status.schema.json#/$defs/summary" },
            { "type": "null" }
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/node_reconcile_result" }
        }
      },
      "additionalProperties": true
    }
  }
}
