{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-ndes-server.schema.json",
  "title": "haprion-ndes-server-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "ndes_server" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "blocked", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/fetched" },
            { "$ref": "#/$defs/added" },
            { "$ref": "#/$defs/removed" },
            { "type": "null" }
          ]
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "endpoint": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fetched": {
      "description": "The CA certificates the server gives with GetCACert, the one that issued its RA certificate first (B383, B385).",
      "type": "object",
      "required": ["endpoint", "authorities", "confirmed"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/endpoint" },
        "confirmed": { "type": "boolean" },
        "authorities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "required": ["subject", "sha256", "sha1", "issues_ra"],
            "properties": {
              "subject": { "type": "string", "maxLength": 1024 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "issues_ra": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "added": {
      "type": "object",
      "required": ["endpoint", "issuing_ca", "sha256"],
      "properties": {
        "endpoint": { "$ref": "#/$defs/endpoint" },
        "issuing_ca": { "type": "string", "pattern": "^/" },
        "sha256": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "removed": {
      "type": "object",
      "required": ["endpoint"],
      "properties": { "endpoint": { "$ref": "#/$defs/endpoint" } },
      "additionalProperties": false
    }
  }
}
