{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-node-restore-prepare.schema.json",
  "title": "HAProxy node restore: prepare",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "operation": {
          "const": "node_restore_prepare"
        },
        "outcome": {
          "enum": [
            "done",
            "failed",
            "blocked"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/result"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "done"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/result"
              }
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,39}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "hostname",
            "address",
            "vip"
          ],
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "address": {
              "type": "string",
              "maxLength": 18
            },
            "vip": {
              "type": "string",
              "maxLength": 18
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "description": "The run and the line the operator pastes on the target. The line holds the run's public key only.",
      "type": "object",
      "required": [
        "run",
        "cluster",
        "node",
        "archive",
        "target",
        "mode",
        "profile",
        "paste"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/run_id"
        },
        "cluster": {
          "type": "string"
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "archive": {
          "$ref": "#/$defs/version"
        },
        "target": {
          "type": "string",
          "format": "ipv4"
        },
        "mode": {
          "enum": [
            "new_vm",
            "test"
          ]
        },
        "profile": {
          "$ref": "#/$defs/profile"
        },
        "paste": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "additionalProperties": false
    }
  }
}
