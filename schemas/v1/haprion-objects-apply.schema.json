{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-objects-apply.schema.json",
  "title": "haprion-objects apply and remove JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "objects_apply" },
        "outcome": { "enum": ["done", "failed"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/objects_apply_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/objects_apply_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "names": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" }
    },
    "objects_apply_result": {
      "type": "object",
      "required": ["changed", "check", "added", "updated", "removed", "unchanged", "versions", "deployment_required"],
      "properties": {
        "changed": { "type": "boolean" },
        "check": { "type": "boolean" },
        "added": { "$ref": "#/$defs/names" },
        "updated": { "$ref": "#/$defs/names" },
        "removed": { "$ref": "#/$defs/names" },
        "unchanged": { "$ref": "#/$defs/names" },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["version", "hash", "changed"],
            "properties": {
              "version": { "type": ["integer", "null"], "minimum": 0 },
              "hash": { "type": ["string", "null"] },
              "changed": { "type": ["boolean", "null"] }
            },
            "additionalProperties": true
          }
        },
        "deployment_required": { "type": "boolean" },
        "unresolved_servers": {
          "description": "Finding 72: the published objects' server names the manager cannot resolve, as the publish reported them. A warning.",
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        }
      },
      "additionalProperties": true
    }
  }
}
