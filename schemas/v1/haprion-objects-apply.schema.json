{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-objects-apply.schema.json",
  "title": "haprion-objects apply and remove JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "objects_apply" },
        "outcome": { "enum": ["done", "partial", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/objects_apply_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "enum": ["done", "partial"] } } }, "then": { "properties": { "result": { "$ref": "#/$defs/objects_apply_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "names": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" }
    },
    "objects_apply_result": {
      "type": "object",
      "required": ["changed", "check", "added", "updated", "removed", "unchanged", "versions", "deployment_required"],
      "properties": {
        "changed": { "type": "boolean" },
        "check": { "type": "boolean" },
        "added": { "$ref": "#/$defs/names" },
        "updated": { "$ref": "#/$defs/names" },
        "removed": { "$ref": "#/$defs/names" },
        "unchanged": { "$ref": "#/$defs/names" },
        "versions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["version", "hash", "changed"],
            "properties": {
              "version": { "type": ["integer", "null"], "minimum": 0 },
              "hash": { "type": ["string", "null"] },
              "changed": { "type": ["boolean", "null"] }
            },
            "additionalProperties": true
          }
        },
        "deployment_required": { "type": "boolean" },
        "unresolved_servers": {
          "description": "Finding 72: the published objects' server names the manager cannot resolve, as the publishes reported them, each once. A warning. Bounded by the applied objects.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "unasked_servers": {
          "description": "B483: server names not looked up because a publish's time for lookups ran out; empty when none. A warning, as an unresolved name is.",
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "unchecked_nodes": {
          "description": "The nodes that were not asked, or did not answer, when an applied object started to need what only a node can have. A warning.",
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "minLength": 1, "maxLength": 253 }
        },
        "unchecked_features": {
          "description": "What those nodes were not asked: waf, dns or syslog.",
          "type": "array",
          "maxItems": 3,
          "items": { "enum": ["waf", "dns", "syslog"] }
        },
        "unchecked_reason": {
          "description": "Why: `no_answer` (asked, no answer) or `no_status_identity` (the installation has none to ask with); null when nothing was unchecked.",
          "enum": ["no_answer", "no_status_identity", null]
        },
        "check_tls_mismatches": {
          "description": "The applied objects' pools whose health check and traffic disagree about TLS on the same port, one sentence each. A warning.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": true
    }
  }
}
