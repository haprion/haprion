{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haprion-oidc.schema.json",
  "title": "haprion-oidc-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "oidc" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/discovery" },
            { "$ref": "#/$defs/verification" },
            { "$ref": "#/$defs/sign_in" },
            { "type": "null" }
          ]
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 },
    "discovery": {
      "description": "The provider's endpoints, read from the issuer's own discovery document and checked against it.",
      "type": "object",
      "required": ["issuer", "authorization_endpoint", "token_endpoint", "jwks_uri", "userinfo_endpoint", "end_session_endpoint", "auth_methods", "algorithms"],
      "properties": {
        "issuer": { "$ref": "#/$defs/url" },
        "authorization_endpoint": { "$ref": "#/$defs/url" },
        "token_endpoint": { "$ref": "#/$defs/url" },
        "jwks_uri": { "$ref": "#/$defs/url" },
        "userinfo_endpoint": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
        "end_session_endpoint": { "oneOf": [{ "$ref": "#/$defs/url" }, { "type": "null" }] },
        "auth_methods": { "type": "array", "items": { "type": "string" } },
        "algorithms": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "verification": {
      "description": "Verify on the settings page: each check in order, and whether all passed.",
      "type": "object",
      "required": ["ok", "checks"],
      "properties": {
        "ok": { "type": "boolean" },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "ok", "message"],
            "properties": {
              "name": { "enum": ["discovery", "keys", "method", "algorithm", "client"] },
              "ok": { "type": "boolean" },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sign_in": {
      "description": "Who signed in: the verified id_token's issuer and subject, the name and groups read from the claims the provider row names, and whether userinfo was used. `claims` only when the request asked, for Test sign-in.",
      "type": "object",
      "required": ["issuer", "subject", "username", "groups", "id_token", "userinfo"],
      "properties": {
        "issuer": { "$ref": "#/$defs/url" },
        "subject": { "type": "string", "minLength": 1, "maxLength": 255 },
        "username": { "type": "string", "minLength": 1 },
        "groups": { "type": "array", "items": { "type": "string" } },
        "id_token": { "type": "string" },
        "userinfo": { "type": "string" },
        "claims": { "type": "object" }
      },
      "additionalProperties": false
    }
  }
}
