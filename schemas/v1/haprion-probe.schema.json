{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-probe.schema.json",
  "title": "haprion-probe-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "probe" },
        "cluster": { "type": ["string", "null"] },
        "outcome": { "enum": ["done", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/probe_result" },
            { "type": "null" }
          ]
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "probe_result": {
      "description": "What each node said about each server. A server that is down is a finding in `results`, not a failed probe; `failed` with a result is a probe no node could run.",
      "type": "object",
      "required": ["source", "nodes"],
      "properties": {
        "source": { "type": "string", "maxLength": 45 },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node", "reachable", "error", "source_held", "results"],
            "properties": {
              "node": { "type": "string", "minLength": 1 },
              "reachable": { "type": "boolean" },
              "error": { "type": ["string", "null"] },
              "source_held": { "type": ["boolean", "null"] },
              "results": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["host", "port", "ok", "status", "error", "ms", "certificate"],
                  "properties": {
                    "host": { "type": "string", "minLength": 1 },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "ok": { "type": "boolean" },
                    "status": { "type": ["integer", "null"] },
                    "error": { "type": ["string", "null"] },
                    "ms": { "type": ["integer", "null"], "minimum": 0 },
                    "certificate": {
                      "description": "The certificate the server presented to the node over TLS (B496 nr 9); null without TLS, when the handshake failed, or from a node older than the field.",
                      "oneOf": [
                        {
                          "type": "object",
                          "required": ["subject", "names", "issuer", "not_after", "version"],
                          "properties": {
                            "subject": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
                            "names": { "type": "array", "maxItems": 10, "items": { "type": "string", "minLength": 1, "maxLength": 255 } },
                            "issuer": { "type": ["string", "null"], "minLength": 1, "maxLength": 255 },
                            "not_after": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
                            "version": { "enum": ["TLSv1", "TLSv1.1", "TLSv1.2", "TLSv1.3", null] }
                          },
                          "additionalProperties": false
                        },
                        { "type": "null" }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
