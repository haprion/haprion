{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-server-state.schema.json",
  "title": "haprion-server-state-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "enum": ["server_state", "dynamic_unblock", "dynamic_block"] },
        "cluster": { "type": ["string", "null"] },
        "outcome": { "enum": ["done", "partial", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/state_result" },
            { "$ref": "#/$defs/unblock_result" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": { "const": "server_state" },
              "outcome": { "enum": ["done", "partial"] }
            }
          },
          "then": { "properties": { "result": { "$ref": "#/$defs/state_result" } } }
        },
        {
          "if": {
            "properties": {
              "operation": { "enum": ["dynamic_unblock", "dynamic_block"] },
              "outcome": { "enum": ["done", "partial"] }
            }
          },
          "then": { "properties": { "result": { "$ref": "#/$defs/unblock_result" } } }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "unblock_result": {
      "description": "Dynamic blocking lifted (B271) or placed (B412, haprion-block-helper): per node, whether every address left both of the object's tables after the second round - or is in its blocked table - each address's own answer, and why not.",
      "type": "object",
      "required": ["object", "nodes"],
      "properties": {
        "object": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["node", "outcome", "message", "addresses"],
            "properties": {
              "node": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["done", "refused", "failed"] },
              "message": { "type": ["string", "null"], "maxLength": 300 },
              "addresses": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": ["address", "outcome"],
                  "properties": {
                    "address": { "type": "string", "minLength": 2, "maxLength": 45 },
                    "outcome": { "enum": ["done", "failed"] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "state_result": {
      "type": "object",
      "required": ["object", "state", "nodes"],
      "properties": {
        "object": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" },
        "state": { "enum": ["ready", "drain", "maint"] },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["node", "servers"],
            "properties": {
              "node": { "type": "string", "minLength": 1 },
              "servers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "required": ["server", "guid", "outcome", "message"],
                  "properties": {
                    "server": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}/[^\\s/]+:[0-9]{1,5}$" },
                    "guid": { "type": "string", "pattern": "^srv:[a-z][a-z0-9_-]{0,39}\\.[0-9a-f]{16}$" },
                    "outcome": { "enum": ["done", "refused", "failed"] },
                    "message": { "type": ["string", "null"], "maxLength": 300 }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
