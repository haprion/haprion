{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haprion/schemas/v1/haprion-tls-install.schema.json",
  "title": "haprion-tls-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "ui_tls_install" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "failed"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/install_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/install_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "install_result": {
      "description": "The interface certificate the registry marks, now served by nginx. `changed` is false when nginx already served that leaf and nothing was installed or reloaded.",
      "type": "object",
      "required": ["id", "changed", "fingerprint_sha256", "not_after"],
      "properties": {
        "id": { "type": "string", "maxLength": 255 },
        "changed": { "type": "boolean" },
        "fingerprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "not_after": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    }
  }
}
