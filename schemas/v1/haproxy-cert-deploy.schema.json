{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-cert-deploy.schema.json",
  "title": "haproxy-cert-deploy JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cert_deploy" },
        "outcome": { "enum": ["done", "partial", "failed", "blocked"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/cert_deploy_result" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "enum": ["done", "partial"] } } },
          "then": { "properties": { "result": { "$ref": "#/$defs/cert_deploy_result" } } }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "certificate_target": {
      "type": "object",
      "required": ["id", "fingerprint_sha256"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 255 },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "cert_deploy_result": {
      "type": "object",
      "required": [
        "target_certificates",
        "converged",
        "override_used",
        "initial_summary",
        "final_summary",
        "nodes"
      ],
      "properties": {
        "target_certificates": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/certificate_target" }
        },
        "converged": { "type": "boolean" },
        "override_used": { "type": "boolean" },
        "initial_summary": {
          "$ref": "haproxy-status.schema.json#/$defs/summary"
        },
        "final_summary": {
          "oneOf": [
            { "$ref": "haproxy-status.schema.json#/$defs/summary" },
            { "type": "null" }
          ]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "common.schema.json#/$defs/node_reconcile_result" }
        }
      },
      "additionalProperties": true
    }
  }
}
