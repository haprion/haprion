{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-cert-list.schema.json",
  "title": "haproxy-cert-list JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cert_list" },
        "outcome": { "enum": ["done", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/cert_list_result" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "done" } } },
          "then": { "properties": { "result": { "$ref": "#/$defs/cert_list_result" } } }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "deployable_certificate": {
      "allOf": [
        { "$ref": "common.schema.json#/$defs/certificate" },
        {
          "type": "object",
          "required": ["referenced_by_cluster", "deployable", "validation_error"],
          "properties": {
            "referenced_by_cluster": { "type": "boolean" },
            "deployable": { "type": "boolean" },
            "validation_error": { "type": ["string", "null"], "maxLength": 2048 },
            "source": {
              "description": "Where the certificate comes from, from the certificate registry. Null where the installation has no registry or no entry names this certificate.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["kind", "lineage"],
                  "properties": {
                    "kind": { "enum": ["acme", "import"] },
                    "lineage": { "type": ["string", "null"], "maxLength": 255 }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "targets": {
              "description": "Which clusters and receivers the certificate is published to, from the certificate registry. Null where source is null.",
              "oneOf": [
                { "type": "null" },
                {
                  "type": "object",
                  "required": ["clusters", "receivers"],
                  "properties": {
                    "clusters": { "type": "array", "items": { "type": "string", "maxLength": 63 } },
                    "receivers": { "type": "array", "items": { "type": "string", "maxLength": 63 } }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      ]
    },
    "cert_list_result": {
      "type": "object",
      "required": ["certificates"],
      "properties": {
        "certificates": {
          "type": "array",
          "items": { "$ref": "#/$defs/deployable_certificate" }
        }
      },
      "additionalProperties": true
    }
  }
}
