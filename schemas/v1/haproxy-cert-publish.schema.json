{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-cert-publish.schema.json",
  "title": "haproxy-cert-publish JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cert_publish" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "partial", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/publish_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/publish_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "publish_result": {
      "type": "object",
      "required": ["certificates", "changed_clusters", "deployments"],
      "properties": {
        "certificates": { "type": "array", "items": { "$ref": "#/$defs/certificate" } },
        "changed_clusters": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/cluster_id" } },
        "deployments": { "type": "array", "items": { "$ref": "#/$defs/deployment" } }
      },
      "additionalProperties": true
    },
    "certificate": {
      "type": "object",
      "required": ["id", "status", "fingerprint_sha256", "not_after", "targets", "error"],
      "properties": {
        "id": { "$ref": "#/$defs/certificate_id" },
        "status": { "enum": ["published", "unchanged", "skipped", "failed"] },
        "fingerprint_sha256": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
        "not_after": { "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/target" } },
        "error": { "oneOf": [{ "$ref": "#/$defs/error_detail" }, { "type": "null" }] }
      },
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["kind", "name", "changed"],
      "properties": {
        "kind": { "enum": ["cluster", "receiver", "interface"] },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "changed": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "deployment": {
      "type": "object",
      "required": ["cluster", "exit_code"],
      "properties": {
        "cluster": { "$ref": "common.schema.json#/$defs/cluster_id" },
        "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
      },
      "additionalProperties": true
    },
    "error_detail": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "certificate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,254}$" },
    "retired_interface": {
      "description": "Additive (B188, D5): the entry that served the manager's interface until this certificate took the mark, and what became of it - `removed` once the new one is served, `kept` (unmarked, no targets) when it is not, or the deletion's own `refused`/`incomplete` with its reason.",
      "type": "object",
      "required": ["id", "state", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/certificate_id" },
        "state": { "enum": ["removed", "kept", "refused", "incomplete"] },
        "reason": { "type": "string", "maxLength": 2048 }
      },
      "additionalProperties": false
    }
  }
}
