{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-changes-publish.schema.json",
  "title": "haproxy-changes-publish JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "changes_publish" },
        "outcome": { "enum": ["done", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/changes_publish_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/changes_publish_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "changes_publish_result": {
      "type": "object",
      "required": ["changed", "version", "hash", "published_at", "comment", "deployment_required", "next_command", "release", "already_current", "objects", "removed", "network", "settings"],
      "properties": {
        "changed": { "type": "boolean" },
        "version": { "$ref": "common.schema.json#/$defs/version" },
        "hash": { "$ref": "common.schema.json#/$defs/hash" },
        "published_at": { "oneOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
        "comment": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "deployment_required": { "type": "boolean" },
        "next_command": { "type": ["string", "null"], "maxLength": 1024 },
        "release": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "already_current": { "type": "boolean" },
        "objects": { "$ref": "#/$defs/object_names" },
        "removed": { "$ref": "#/$defs/object_names" },
        "network": { "type": "boolean" },
        "settings": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "object_names": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$" }
    }
  }
}
