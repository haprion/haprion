{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-cluster-node.schema.json",
  "title": "haproxy-node-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "cluster_node" },
        "outcome": { "enum": ["done", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/node_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/node_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "node_result": {
      "description": "One node added to or removed from one cluster: which files changed, and - after an addition - the host key's fingerprint the node answered with. `blocked` is a node that did not answer as itself (everything put back), the node holding the VIP, or a cluster already busy.",
      "type": "object",
      "required": ["action", "cluster", "node", "host", "files", "host_key_fingerprint"],
      "properties": {
        "action": { "enum": ["added", "removed"] },
        "cluster": { "type": "string", "maxLength": 63 },
        "node": { "type": "string", "maxLength": 63 },
        "host": { "type": "string", "maxLength": 253 },
        "files": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 128 } },
        "host_key_fingerprint": { "oneOf": [{ "type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$" }, { "type": "null" }] }
      },
      "additionalProperties": false
    }
  }
}
