{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-dns-profile-apply.schema.json",
  "title": "haproxy-dns-profile-apply-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "dns_profile_apply" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "failed", "blocked"] },
        "result": { "oneOf": [{ "$ref": "#/$defs/apply_result" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "outcome": { "const": "done" } } }, "then": { "properties": { "result": { "$ref": "#/$defs/apply_result" } } } }]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "apply_result": {
      "type": "object",
      "required": ["profile", "provider", "key_id", "revision", "plugin"],
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
        "provider": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "key_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "revision": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "plugin": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
        "removed": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
