{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-list-backups.schema.json",
  "title": "haproxy-list-backups JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "list_backups" },
        "outcome": { "enum": ["done", "partial", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/backup_list_result" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "enum": ["done", "partial"] } } },
          "then": { "properties": { "result": { "$ref": "#/$defs/backup_list_result" } } }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "backup_schedule": {
      "type": "object",
      "required": [
        "unit",
        "known",
        "enabled",
        "active",
        "calendar",
        "next_run",
        "last_run",
        "last_result"
      ],
      "properties": {
        "unit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "known": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "active": { "type": "boolean" },
        "calendar": { "type": ["string", "null"], "maxLength": 256 },
        "next_run": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "last_run": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/timestamp" },
            { "type": "null" }
          ]
        },
        "last_result": { "type": ["string", "null"], "maxLength": 64 },
        "scheduled": { "type": "boolean" },
        "retention": { "type": "integer", "minimum": 1, "maximum": 365 }
      },
      "additionalProperties": true
    },
    "backup": {
      "type": "object",
      "required": ["version", "created_at", "size_bytes", "latest"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "created_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "latest": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "node_backups": {
      "type": "object",
      "required": ["name", "available", "latest_version", "backups", "error"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 253 },
        "available": { "type": "boolean" },
        "retained_count": { "type": "integer", "minimum": 0 },
        "retained_size_bytes": { "type": "integer", "minimum": 0 },
        "latest_version": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$"
        },
        "backups": {
          "type": "array",
          "items": { "$ref": "#/$defs/backup" }
        },
        "error": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/error" },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": true
    },
    "backup_list_result": {
      "type": "object",
      "required": ["limit", "nodes"],
      "properties": {
        "schedule": {
          "oneOf": [
            { "$ref": "#/$defs/backup_schedule" },
            { "type": "null" }
          ]
        },
        "limit": { "type": ["integer", "null"], "minimum": 1 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/node_backups" }
        }
      },
      "additionalProperties": true
    }
  }
}
