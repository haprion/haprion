{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-node-restore.schema.json",
  "title": "HAProxy node restore: run",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "operation": {
          "const": "node_restore"
        },
        "outcome": {
          "enum": [
            "done",
            "failed",
            "blocked"
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/result"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "enum": [
                  "done"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "#/$defs/result"
              }
            }
          }
        }
      ]
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{7,39}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}-[0-9]{2}-[0-9]{2}$"
    },
    "profile": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "hostname",
            "address",
            "vip"
          ],
          "properties": {
            "hostname": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "address": {
              "type": "string",
              "maxLength": 18
            },
            "vip": {
              "type": "string",
              "maxLength": 18
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "result": {
      "description": "One carried-out restore. `rolled_back` says whether the target is back where it was (B176): for a new VM, back on its temporary address.",
      "type": "object",
      "required": [
        "run",
        "rolled_back",
        "sessions"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/run_id"
        },
        "rolled_back": {
          "type": "boolean"
        },
        "stage": {
          "enum": [
            "apply",
            "network",
            "finish"
          ]
        },
        "address": {
          "type": "string",
          "format": "ipv4"
        },
        "hostname": {
          "type": "string"
        },
        "sessions": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "apply",
              "network",
              "finish"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "steps": {
                "type": "array"
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
