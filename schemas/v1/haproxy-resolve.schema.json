{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/haproxy-manager/schemas/v1/haproxy-resolve.schema.json",
  "title": "haproxy-resolve-helper JSON result",
  "allOf": [
    { "$ref": "common.schema.json#/$defs/envelope" },
    {
      "properties": {
        "operation": { "const": "resolve" },
        "cluster": { "type": "null" },
        "outcome": { "enum": ["done", "failed"] },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/answers" },
            { "type": "null" }
          ]
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "answers": {
      "description": "Each name asked, with the one address the manager's resolver gives it or the sentence the generator would refuse it with (B252, B253).",
      "type": "object",
      "required": ["names"],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["name", "address", "problem"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 253 },
              "address": { "oneOf": [{ "type": "string", "minLength": 2, "maxLength": 45 }, { "type": "null" }] },
              "problem": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 1024 }, { "type": "null" }] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
