#!/usr/bin/env python3
"""Build every package a release ships, from one commit, the one way (B325).

    tools/build-release-packages --source <tree> --output-dir <dir>
                                 --uv <uv> [--cache <dir>] [--podman <podman>]
                                 [--only waf]

The same command runs here before a tag and twice in CI after it, and the
repository is published only when the builds agree byte for byte - so a build
that differs, wherever it ran, publishes nothing. The order is the one
`docs/install.md` gives, because the CLI package carries the engine package:

    haprion-crs, haprion-coraza-spoa   tools/build-coraza-package.py
    haprion-cli                         tools/build-cli-package.py
    haprion-node                        tools/node-package.py
    haprion-ui, haprion-certbot         per distribution, in podman
    haprion-archive-keyring             tools/build-keyring-package.py

Every input that is not in the tree is fetched into the cache and checked
against a digest before it is used: the Coraza and CRS archives against the
digests `build-coraza-package.py` pins, and the Go toolchain against the digest
below, so the engine is compiled by the same toolchain bytes everywhere.
govulncheck is built with that toolchain, at the version the engine tool names.

`--only waf` builds the engine and the rules and nothing else: an engine
update merged on `main` reaches the repository without a release (B323),
beside the release packages the site already serves.

The tree is the one given, at its HEAD commit; each tool reads its own copy
of itself from it, so an older tag builds with the tools it was tagged with.
`SHA256SUMS` beside the packages names every file.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import os
import shutil
import subprocess
import sys
import tarfile
import urllib.request
from pathlib import Path
from types import ModuleType

#
# The official archives from go.dev (`https://go.dev/dl/?mode=json`), by the
# version build-coraza-package.py compiles the engine with. A Go bump there
# without its digest here stops the build rather than fetching unchecked.
#
GO_ARCHIVES = {
    "go1.26.9": "42d158b4d8f7b61ac0a830567c940a86098fb7aac52e467a5ebec03ef5cc2f8d",
}
DISTRIBUTIONS = ("debian13", "ubuntu26.04")
FETCH_TIMEOUT = 120


class BuildError(RuntimeError):
    """A release build that cannot go on."""


def engine_tool(source: Path) -> ModuleType:
    path = source / "tools" / "build-coraza-package.py"
    spec = importlib.util.spec_from_file_location("build_coraza_package", path)
    if spec is None or spec.loader is None:
        raise BuildError(f"cannot read {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module  # its dataclasses look themselves up here
    spec.loader.exec_module(module)
    return module


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def fetched(cache: Path, name: str, url: str, expected: str) -> Path:
    """The file in the cache, fetched first if it is missing; refused unless its digest is `expected`."""
    path = cache / name
    if not path.exists():
        if not url.startswith("https://"):
            raise BuildError(f"{name}: refusing a non-https source")
        partial = path.with_name(path.name + ".partial")
        with (
            urllib.request.urlopen(url, timeout=FETCH_TIMEOUT) as response,  # noqa: S310 - https only, checked above
            partial.open("wb") as out,
        ):
            shutil.copyfileobj(response, out)
        partial.rename(path)
    if sha256(path) != expected:
        raise BuildError(f"{name} does not match its pinned SHA-256")
    return path


def go_root(cache: Path, version: str) -> Path:
    expected = GO_ARCHIVES.get(version)
    if expected is None:
        raise BuildError(f"no pinned digest for {version}; add it to GO_ARCHIVES")
    name = f"{version}.linux-amd64.tar.gz"
    archive = fetched(cache, name, f"https://go.dev/dl/{name}", expected)
    root = cache / version
    if not (root / "go" / "bin" / "go").exists():
        shutil.rmtree(root, ignore_errors=True)
        root.mkdir(parents=True)
        with tarfile.open(archive) as tar:
            tar.extractall(root, filter="data")
    return root / "go"


def run(*command: str | Path, env: dict[str, str]) -> None:
    print("+", " ".join(str(part) for part in command), flush=True)
    subprocess.run([str(part) for part in command], check=True, env=env)  # noqa: S603 - fixed tools from the tree


def build(
    source: Path, output_dir: Path, uv: Path, cache: Path, podman: str, *, waf_only: bool = False
) -> list[Path]:
    source = source.resolve(strict=True)
    if subprocess.run(  # noqa: S603 - fixed arguments
        ["/usr/bin/git", "-C", str(source), "status", "--porcelain", "--untracked-files=no"],  # noqa: S607
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip():
        raise BuildError("the tree has uncommitted changes; a release builds from a commit")
    output_dir.mkdir(parents=True, exist_ok=True)
    if any(output_dir.iterdir()):
        raise BuildError(f"{output_dir} is not empty")
    cache.mkdir(parents=True, exist_ok=True)
    #
    # Every step's temporary files under the cache, not in /tmp: the engine and
    # the two Python environments take gigabytes there, and /tmp is a small
    # tmpfs on some build hosts (measured 26-10-17: 5.9 GB, mostly in use).
    #
    scratch = cache / "tmp"
    shutil.rmtree(scratch, ignore_errors=True)
    scratch.mkdir()
    environment = {**os.environ, "TMPDIR": str(scratch)}
    tool = engine_tool(source)
    sources = cache / "sources"
    sources.mkdir(exist_ok=True)
    for pinned in (tool.CORAZA, tool.CRS):
        fetched(sources, pinned.file, pinned.url, pinned.sha256)
    go = go_root(cache, tool.GO_VERSION)
    bin_dir = cache / f"govulncheck-{tool.GOVULNCHECK_VERSION}"
    govulncheck = bin_dir / "govulncheck"
    if not govulncheck.exists():
        env = {
            **environment,
            "GOTMPDIR": str(scratch),
            "GOBIN": str(bin_dir),
            "GOTOOLCHAIN": "local",
            "GOPATH": str(cache / "gopath"),
            "GOCACHE": str(cache / "gocache"),
        }
        run(
            go / "bin" / "go",
            "install",
            f"golang.org/x/vuln/cmd/govulncheck@{tool.GOVULNCHECK_VERSION}",
            env=env,
        )

    def step(*command: str | Path) -> None:
        run(*command, env=environment)

    tools = source / "tools"
    python = sys.executable
    step(
        python,
        tools / "build-coraza-package.py",
        "crs",
        "--source-dir",
        sources,
        "--output-dir",
        output_dir,
    )
    step(
        python,
        tools / "build-coraza-package.py",
        "coraza",
        "--source-dir",
        sources,
        "--go-root",
        go,
        "--govulncheck",
        govulncheck,
        "--output-dir",
        output_dir,
    )
    (engine,) = output_dir.glob("haprion-coraza-spoa_*_amd64.deb")
    if waf_only:
        return write_sums(output_dir)
    step(
        python,
        tools / "build-cli-package.py",
        "--source",
        source,
        "--output-dir",
        output_dir,
        "--uv",
        uv,
        "--waf-engine-package",
        engine,
    )
    step(python, tools / "node-package.py", "build", "--source", source, "--output-dir", output_dir)
    for distribution in DISTRIBUTIONS:
        for builder in ("build-ui-package.py", "build-certbot-package.py"):
            step(
                python,
                tools / builder,
                "--source",
                source,
                "--output-dir",
                output_dir,
                "--distribution",
                distribution,
                "--uv",
                uv,
                "--podman",
                podman,
            )
    step(python, tools / "build-keyring-package.py", "--source", source, "--output-dir", output_dir)
    return write_sums(output_dir)


def write_sums(output_dir: Path) -> list[Path]:
    packages = sorted(output_dir.glob("*.deb"))
    (output_dir / "SHA256SUMS").write_text(
        "".join(f"{sha256(deb)}  {deb.name}\n" for deb in packages), encoding="utf-8"
    )
    return packages


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument("--source", type=Path, required=True)
    parser.add_argument("--output-dir", type=Path, required=True)
    parser.add_argument(
        "--uv", type=Path, required=True, help="the uv the repository is locked with"
    )
    parser.add_argument("--cache", type=Path, default=Path.home() / ".cache" / "haprion-build")
    parser.add_argument("--podman", default="podman")
    parser.add_argument("--only", choices=("waf",), help="the engine and the rules only")
    args = parser.parse_args()
    try:
        packages = build(
            args.source,
            args.output_dir,
            args.uv,
            args.cache,
            args.podman,
            waf_only=args.only == "waf",
        )
    except (BuildError, OSError, subprocess.CalledProcessError, ValueError) as exc:
        parser.exit(1, f"release build failed: {exc}\n")
    print(f"{len(packages)} packages in {args.output_dir}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
