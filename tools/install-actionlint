#!/bin/sh
set -eu

version="1.7.12"
destination=${1:-}

if [ -z "$destination" ]; then
    echo "Usage: install-actionlint <empty-destination-directory>" >&2
    exit 2
fi
if [ -e "$destination" ]; then
    echo "install-actionlint: destination already exists: $destination" >&2
    exit 2
fi

case "$(uname -m)" in
    x86_64|amd64)
        architecture="amd64"
        digest="8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8"
        ;;
    aarch64|arm64)
        architecture="arm64"
        digest="325e971b6ba9bfa504672e29be93c24981eeb1c07576d730e9f7c8805afff0c6"
        ;;
    *)
        echo "install-actionlint: unsupported architecture: $(uname -m)" >&2
        exit 2
        ;;
esac

temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT HUP INT TERM
archive="$temporary/actionlint.tar.gz"
url="https://github.com/rhysd/actionlint/releases/download/v${version}/actionlint_${version}_linux_${architecture}.tar.gz"

curl --fail --location --silent --show-error --retry 3 --proto '=https' --tlsv1.2 \
    "$url" --output "$archive"
printf '%s  %s\n' "$digest" "$archive" | sha256sum --check --status
mkdir -p "$destination"
tar -xzf "$archive" -C "$destination" actionlint
chmod 755 "$destination/actionlint"
