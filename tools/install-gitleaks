#!/bin/sh
set -eu

version=8.30.1
sha256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
archive_name="gitleaks_${version}_linux_x64.tar.gz"
url="https://github.com/gitleaks/gitleaks/releases/download/v${version}/${archive_name}"

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: install-gitleaks <empty-destination-directory>" >&2
    exit 64
fi

destination=$1
if [ -e "$destination" ]; then
    echo "install-gitleaks: destination already exists: $destination" >&2
    exit 2
fi

mkdir -p "$destination"
archive="$destination/$archive_name"
curl -fsSL --retry 3 --proto '=https' --tlsv1.2 -o "$archive" "$url"
printf '%s  %s\n' "$sha256" "$archive" | sha256sum -c -
tar -xzf "$archive" -C "$destination" gitleaks
chmod 755 "$destination/gitleaks"
"$destination/gitleaks" version
