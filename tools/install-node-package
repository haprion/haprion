#!/bin/bash
# Install the verified node package through an operator's interactive SSH path,
# then configure the node with 04-node-prepare from where the package put it.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VERIFY="${SCRIPT_DIR}/node-package.py"
NODE_PREPARE=/usr/share/haprion-node/install/04-node-prepare
STATE_BACKUP=/opt/haprion/current/bin/haprion-state-backup

node_package=""
expected_sha=""
answers=""
node=""
cluster=""
packages_in=()
package_shas=()
dry_run="no"
#
# apt refuses to put an older package in place of a newer one under -y. Going
# back is a decision, so it is asked for by name: the rollback to a retained
# package, never a side effect of installing the wrong file.
#
downgrade="no"
#
# The state backup archives both nodes of the package's cluster, so a package
# rolled across a pair one invocation at a time would take four of them for
# one change. The rule is one before the first write and one after the last:
# the first node keeps its "before", the last node its "after", the ones
# between skip both. The default stays both, so a single-node run needs no
# flag. Per cluster since the engine's own command took over from the
# fleet-wide script: the other cluster is not touched and is not archived.
#
backup_before="yes"
backup_after="yes"

fail() { echo "ERROR: $*" >&2; exit 1; }
usage() {
    echo "usage: $(basename "$0") --node-package <deb> --sha256 <digest> --answers <file> --node <host> --cluster <id> [--package <deb> --package-sha256 <digest>]... [--downgrade] [--dry-run] [--skip-backup-before] [--skip-backup-after]"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --node-package) node_package="${2:-}"; shift 2 ;;
        --sha256) expected_sha="${2:-}"; shift 2 ;;
        --answers) answers="${2:-}"; shift 2 ;;
        --node) node="${2:-}"; shift 2 ;;
        --cluster) cluster="${2:-}"; shift 2 ;;
        --package) packages_in+=("${2:-}"); shift 2 ;;
        --package-sha256) package_shas+=("${2:-}"); shift 2 ;;
        --dry-run) dry_run="yes"; shift ;;
        --downgrade) downgrade="yes"; shift ;;
        --skip-backup-before) backup_before="no"; shift ;;
        --skip-backup-after) backup_after="no"; shift ;;
        -h|--help) usage; exit 0 ;;
        *) usage >&2; fail "unknown argument: $1" ;;
    esac
done

[[ $EUID -ne 0 ]] || fail "run as yourself, not with sudo"
[[ "$node_package" == /* && -f "$node_package" && ! -L "$node_package" ]] \
    || fail "node package must be an absolute regular non-symlink file"
[[ "$answers" == /* && -f "$answers" && ! -L "$answers" ]] \
    || fail "answers must be an absolute regular non-symlink file"
[[ "$expected_sha" =~ ^[0-9a-f]{64}$ ]] || fail "SHA-256 must be 64 lowercase hexadecimal characters"
[[ "$node" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$ ]] || fail "invalid node hostname"
# The engine's pattern (`valid_id` in install/lib.sh), held to it by a test.
[[ "$cluster" =~ ^[a-z][a-z0-9-]{0,62}$ ]] || fail "invalid cluster id"
bash -n "$answers" || fail "answers file is not valid shell"

#
# Packages that travel with the node package - the WAF engine and its rule set
# (B229) - go through the same session, backups and checks rather than a loop
# of their own, and the same apt call, which takes all or none. Each --package
# has its own --package-sha256, in order. Only the project's own packages,
# verified here and again on the node, and only ones built for the node's
# architecture: the preflight compares them before anything is written, so a
# dry run answers the question too.
#
package_names=()
package_arch=""
((${#packages_in[@]} == ${#package_shas[@]})) || fail "each --package needs its own --package-sha256"
for index in "${!packages_in[@]}"; do
    package="${packages_in[$index]}"
    package_sha="${package_shas[$index]}"
    [[ "$package" == /* && -f "$package" && ! -L "$package" ]] \
        || fail "package must be an absolute regular non-symlink file"
    [[ "$package_sha" =~ ^[0-9a-f]{64}$ ]] || fail "package SHA-256 must be 64 lowercase hexadecimal characters"
    printf '%s  %s\n' "$package_sha" "$package" | sha256sum -c --quiet - \
        || fail "package does not match its SHA-256"
    name="$(dpkg-deb --field "$package" Package)"
    arch="$(dpkg-deb --field "$package" Architecture)"
    [[ "$name" =~ ^haprion-[a-z0-9-]+$ ]] \
        || fail "only the project's own packages are installed this way"
    [[ "$arch" =~ ^[a-z0-9]+$ ]] || fail "package declares an invalid architecture"
    if [[ "$arch" != all ]]; then
        [[ -z "$package_arch" || "$package_arch" == "$arch" ]] || fail "the packages are built for different architectures"
        package_arch="$arch"
    fi
    package_names+=("$name")
    echo "package: ${name} $(dpkg-deb --field "$package" Version) ${arch}"
done

verification="$(/usr/bin/python3 "$VERIFY" verify --package "$node_package" --sha256 "$expected_sha")" \
    || fail "node package verification failed"
node_version="$(sed -n 's/^version: //p' <<<"$verification")"
[[ "$node_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+\+git[0-9]{14}\.[0-9a-f]{12}$ ]] \
    || fail "package verifier returned an invalid version"
printf '%s\n' "$verification"

work_dir="$(mktemp -d)"
chmod 700 "$work_dir"
control_dir="${work_dir}/ssh"
mkdir -m 700 "$control_dir"
remote_dir=""
ssh_opts=(
    -o StrictHostKeyChecking=yes
    -o ControlMaster=auto
    -o "ControlPath=${control_dir}/%r@%h"
    -o ControlPersist=180
)

cleanup() {
    if [[ -n "$remote_dir" && "$remote_dir" =~ ^/tmp/haprion-node-package\.[A-Za-z0-9]+$ ]]; then
        # The path came from the node's constrained mktemp shape above.
        # shellcheck disable=SC2029
        ssh "${ssh_opts[@]}" "$node" "find '$remote_dir' -depth -delete" >/dev/null 2>&1 \
            || echo "WARNING: could not remove node staging ${remote_dir}" >&2
    fi
    ssh -O exit -o "ControlPath=${control_dir}/%r@%h" "$node" >/dev/null 2>&1 || true
    find "$work_dir" -depth -delete 2>/dev/null || true
}
trap cleanup EXIT

preflight="
    set -Eeuo pipefail
    sudo -v
    test -d /run/lock
    command -v rsyslogd >/dev/null
    echo \"node architecture: \$(dpkg --print-architecture)\"
    if [[ -n '${package_arch}' && '${package_arch}' != all ]]; then
        [[ \"\$(dpkg --print-architecture)\" == '${package_arch}' ]] \
            || { echo 'ERROR: the package is built for ${package_arch}, not for this node' >&2; exit 1; }
    fi
    if sudo test -f /etc/haprion/node.conf; then
        sudo grep -Fqx 'CLUSTER=\"${cluster}\"' /etc/haprion/node.conf \
            || { echo 'ERROR: existing node belongs to another cluster' >&2; exit 1; }
    fi
    echo 'node preflight: PASS'
"

if [[ "$dry_run" == "yes" ]]; then
    # Fixed, validated node and cluster values are intentionally sent to the node.
    # shellcheck disable=SC2029
    ssh -tt "${ssh_opts[@]}" "$node" "$preflight"
    echo "dry run: no file or backup was written"
    exit 0
fi

sudo -v
sudo test -x "$STATE_BACKUP" \
    || fail "state backup command is not executable by root: ${STATE_BACKUP}"
if [[ "$backup_before" == "yes" ]]; then
    sudo "$STATE_BACKUP" -c "$cluster"
else
    echo "state backup before: skipped on request (take one before the cluster's first node)"
fi

remote_dir="$(ssh "${ssh_opts[@]}" "$node" 'mktemp -d /tmp/haprion-node-package.XXXXXXXX')"
remote_dir="${remote_dir//$'\r'/}"
[[ "$remote_dir" =~ ^/tmp/haprion-node-package\.[A-Za-z0-9]+$ ]] \
    || fail "node returned an unsafe staging path"
# The path is returned by the node and shape-checked immediately above.
# shellcheck disable=SC2029
ssh "${ssh_opts[@]}" "$node" "chmod 700 '$remote_dir'"
scp "${ssh_opts[@]}" "$node_package" "${node}:${remote_dir}/node.deb" >/dev/null
scp "${ssh_opts[@]}" "$answers" "${node}:${remote_dir}/answers.env" >/dev/null
packages="./node.deb"
package_check=""
apt_options="-y --no-install-recommends"
[[ "$downgrade" == "yes" ]] && apt_options+=" --allow-downgrades"
for index in "${!packages_in[@]}"; do
    scp "${ssh_opts[@]}" "${packages_in[$index]}" "${node}:${remote_dir}/package-${index}.deb" >/dev/null
    packages+=" ./package-${index}.deb"
    package_check+="printf '%s  %s\\n' '${package_shas[$index]}' package-${index}.deb | sha256sum -c -
"
done

remote_install="
    ${preflight}
    cd '$remote_dir'
    printf '%s  %s\n' '$expected_sha' node.deb | sha256sum -c -
    ${package_check}
    chmod 644 ${packages}
    chmod 600 answers.env
    sudo apt-get install ${apt_options} ${packages}
    dpkg-query -W -f='\${Package} \${Version} \${Status}\\n' haprion-node ${package_names[*]}
    sudo '${NODE_PREPARE}' '$remote_dir/answers.env' '$cluster'
"

# The staging path, node and cluster were all shape-checked above.
# shellcheck disable=SC2029
ssh -tt "${ssh_opts[@]}" "$node" "$remote_install"

if [[ "$backup_after" == "yes" ]]; then
    sudo "$STATE_BACKUP" -c "$cluster"
else
    echo "state backup after: skipped on request (take one after the cluster's last node)"
fi
if [[ -x /opt/haprion/current/bin/haprion-status ]]; then
    /opt/haprion/current/bin/haprion-status -c "$cluster"
else
    echo "WARNING: haprion-status is unavailable; run the installation check manually" >&2
fi
echo "node package installation: PASS (${node}, haprion-node ${node_version})"
