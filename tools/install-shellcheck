#!/bin/sh
set -eu

version="0.11.0"
destination=${1:-}

if [ -z "$destination" ]; then
    echo "Usage: install-shellcheck <empty-destination-directory>" >&2
    exit 2
fi
if [ -e "$destination" ]; then
    echo "install-shellcheck: destination already exists: $destination" >&2
    exit 2
fi

case "$(uname -m)" in
    x86_64|amd64)
        architecture="x86_64"
        digest="8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198"
        ;;
    aarch64|arm64)
        architecture="aarch64"
        digest="12b331c1d2db6b9eb13cfca64306b1b157a86eb69db83023e261eaa7e7c14588"
        ;;
    *)
        echo "install-shellcheck: unsupported architecture: $(uname -m)" >&2
        exit 2
        ;;
esac

temporary=$(mktemp -d)
trap 'rm -rf -- "$temporary"' EXIT HUP INT TERM
archive="$temporary/shellcheck.tar.xz"
url="https://github.com/koalaman/shellcheck/releases/download/v${version}/shellcheck-v${version}.linux.${architecture}.tar.xz"

curl --fail --location --silent --show-error --retry 3 --proto '=https' --tlsv1.2 \
    "$url" --output "$archive"
printf '%s  %s\n' "$digest" "$archive" | sha256sum --check --status
mkdir -p "$destination"
tar -xJf "$archive" -C "$temporary"
install -m 755 "$temporary/shellcheck-v${version}/shellcheck" "$destination/shellcheck"
