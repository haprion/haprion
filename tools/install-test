    def left_behind(self, role: str, before: dict[str, set[str]]) -> list[str]:
        """What is on the machine now that was not before the installation, and is nobody's."""

        brought = sorted(self.footprint(role)["packages"] - before["packages"])
        if brought:
            self.on(
                role,
                #
                # Some came in as dependencies and are essential to the
                # distribution; the machine is thrown away after this.
