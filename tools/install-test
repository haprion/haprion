MIGRATION_ROLE_WORD = '"${DB_MIGRATION_ROLE}"'


def public_schema_statements(owner: str, step: Path = PLATFORM_DATABASE_STEP) -> list[str]:
    """What step 02 does to the schema `public`, read out of it, with `owner` for the migration role.

    A new installation's database has these too (B441): left out of the
    comparison database, the dump of the two differs in `SCHEMA: public` and
    `ACL: SCHEMA public` on every real installation. They are read, not copied,
    so that a step 02 written differently stops this rather than drops them.
    """

    #
    # The role's own name, as `pg_get_userbyid` gives it - not `regrole`, which
    # quotes `_haprion-migrate` for its hyphen, and quoted again here would be
    # no name at all (B441, re-review H01).
    #
    if not owner or '"' in owner or "\n" in owner:
        raise SystemExit(f"install-test: {owner!r} is not a role name to own schema public")
    found = PUBLIC_SCHEMA_STATEMENT.findall(step.read_text())
    kinds = sorted(statement.split()[0] for statement in found)
    if kinds != ["alter", "grant", "revoke"] or not any(
        MIGRATION_ROLE_WORD in statement for statement in found
    ):
        raise SystemExit(
            f"install-test: expected one revoke, one grant and one alter on schema public"
            f" (owner {MIGRATION_ROLE_WORD}) in {step}, found {len(found)}: {found}"
        )
    return [statement.replace(MIGRATION_ROLE_WORD, f'"{owner}"') for statement in found]


def package(directory: Path, pattern: str) -> Path:
    found = sorted(directory.glob(pattern))
    if len(found) != 1:
        raise SystemExit(f"install-test: expected one {pattern} in {directory}, found {len(found)}")
    return found[0]


def release_files(
    packages: Path, distribution: Distribution, *, previous: bool = False
) -> tuple[list[Path], list[Path]]:
    """A release's files for the manager, and for a node.

    haprion-scep came after 0.99.4 (B383): a previous release may be without it,
    the release under test may not.
    """

    scep = f"haprion-scep_*{distribution.ui_suffix}_amd64.deb"
    with_scep = not previous or any(packages.glob(scep))

    key = package(packages, "haprion-archive-keyring_*_all.deb")
    engine = package(packages, "haprion-coraza-spoa_*_amd64.deb")
    manager_files = [
        package(packages, "haprion-cli_*_all.deb"),
        package(packages, f"haprion-ui_*{distribution.ui_suffix}_amd64.deb"),
        package(packages, f"haprion-certbot_*{distribution.ui_suffix}_amd64.deb"),
        *([package(packages, scep)] if with_scep else []),
        engine,
        package(packages, "haprion-crs_*_all.deb"),
        key,
    ]
    return manager_files, [engine, key, package(packages, "haprion-node_*_all.deb")]


def run_one(
    distribution: Distribution,
    packages: Path | None,
    site: Path | None,
    logs: Path,
    keep: bool,
    url: str | None = None,
) -> bool:
    manager_files = node_files = None
    if packages is not None:
        manager_files, node_files = release_files(packages, distribution)
    logs.mkdir(parents=True, exist_ok=True)
    run = Run(distribution, logs)
    steps: list[str] = []

    def step(title: str, action: Callable[[], T]) -> T:
        run.heading(title)
        started = time.monotonic()
        result = action()
        print(f"ok ({time.monotonic() - started:.0f} s)")
        steps.append(title)
        return result

    try:
        image = step("an empty server image", run.image)
        step("a manager and two nodes booted", lambda: run.start(image))
        before = step(
            "what the machines hold before the installation",
            lambda: {role: run.footprint(role) for role in ("mgr", *NODES)},
        )
        step(
            "the manager: packages, haprion-setup",
            lambda: run.install_manager(manager_files, site, url),
        )
        blocks = [
            step(
                f"{role}: the package, and the block it printed",
                functools.partial(run.prepare_node, role, node_files, site, url),
            )
            for role in NODES
        ]
        step("one rsyslogd on each node, rsyslog.service's own", run.one_rsyslogd_per_node)
        step(
            f"haprion-cluster add with {NODES[0]}: joined, version 1 published",
            lambda: run.create_cluster(blocks[0]),
        )
        step("the first deploy rolls out version 1", run.first_deploy_is_version_one)
        step(
            f"haprion-node add {NODES[1]}: joined, version 2 published",
            lambda: run.add_node(NODES[1], blocks[1]),
        )
        step("the joins warned of nothing", run.joined_quietly)
        step(
            "still one rsyslogd on each node after the joins turned the traffic log on",
            run.one_rsyslogd_per_node,
        )
        step(
            "each node's keys read its own cluster alone, from its own address",
            run.a_node_reads_its_own_cluster_alone,
        )
        step("every function has what it needs", run.every_function_has_what_it_needs)
        step(
            "an NDES server confirmed from its CA, as the web and the command do",
            run.ndes_server_confirmed,
        )
        step("an object published", run.publish)

        def added_node_starts_as_standby() -> None:
            """B320, Fas 18 finding 75: the added node deploys after the owner and never leads.

            Deployed first, it started keepalived before the owner had it as a
            peer and became MASTER beside it when the owner's deploy was slow.
            The order is what is held to; the journal says it held.
            """

            output = run.deploy()
            order = re.findall(r"^=== Deploy: (\S+) ===$", output, re.MULTILINE)
            if order != [NODES[0], NODES[1]]:
                raise Failed(
                    f"the deploy went {order}, not the owner before the added node:\n{output}"
                )
            _, log = run.on(NODES[1], "journalctl -u keepalived --no-pager -o cat", check=False)
            if "Entering BACKUP STATE" not in log:
                raise Failed(f"{NODES[1]}'s keepalived did not start as a standby:\n{log}")
            if "Entering MASTER STATE" in log:
                raise Failed(f"{NODES[1]} took the address when it was added:\n{log}")

        step(
            f"haprion-deploy: {NODES[1]}, added to a serving cluster, after the owner and as a standby",
            added_node_starts_as_standby,
        )
        step("haproxy and keepalived running on both nodes", run.services_running)
        step("both nodes report HAProxy's statistics", run.statistics_reported)
        holder = step("the virtual address on exactly one node", run.wait_for_one_holder)
        step("the object answers on the virtual address", run.answers_on_the_vip)
        step(
            "a probe answers through the helper's socket",
            run.a_probe_answers_through_the_helper_socket,
        )
        step(
            "the traffic log reaches the manager",
            lambda: run.traffic_log_reaches_the_manager(holder),
        )

        def failover() -> None:
            run.on(holder, "systemctl stop keepalived")
            other = run.wait_for_one_holder()
            if other == holder:
                raise Failed(f"the address stayed on {holder} with its keepalived stopped")
            run.answers_on_the_vip()
            run.on(holder, "systemctl start keepalived")
            time.sleep(5)
            if run.wait_for_one_holder() != other:
                raise Failed(f"the address went back to {holder}; nopreempt should keep it")

        step("the address moves when its holder stops, and stays", failover)

        def converged() -> None:
            output = run.deploy()
            if output.count("already runs this version; nothing to do") != len(NODES):
                raise Failed(f"a second deploy did not skip the current nodes:\n{output}")

        step("a second deploy changes nothing", converged)

        def an_operator_reads_as_themself() -> None:
            """install.md: the terminal's commands read the configuration as the account that runs them.

            Everything above runs as root, so nothing ran them the way the
            guide has an operator do: git refused root's repositories to a
            member of the configuration group, and `haprion-list` and
            `haprion-config-status` called them unusable (26-11-02).
            """

            run.on(
                "mgr",
                # No group of its own: the distributions have a group `operator` already.
                "id operator >/dev/null 2>&1 || useradd --create-home --no-user-group operator; "
                "usermod -a -G haprion operator",
            )
            try:
                # What each command must show when it was really read as the
                # user. The published version may be unreadable here (the
                # account has no sudo), which is expected and not asserted.
                readings = {
                    f"haprion-list -c {CLUSTER}": r"(?m)^\d+\s+\d{4}-",
                    f"haprion-list -c {CLUSTER} --diff 1": rf"(?m)^{CLUSTER} v1 \(",
                    f"haprion-config-status -c {CLUSTER}": r"Last saved:\s+\d+\s",
                }
                for command, expected in readings.items():
                    code, output = run.on("mgr", f"runuser -u operator -- {command}", check=False)
                    if (
                        code != 0
                        or "not a usable configuration repository" in output
                        or not re.search(expected, output)
                    ):
                        raise Failed(
                            f"`{command}` as a member of the group exited {code} "
                            f"or did not show what it reads:\n{output}"
                        )
            finally:
                # The account is the test's, not Haprion's: the removal step counts what is left.
                run.on("mgr", "userdel --remove operator", check=False)

        step(
            "an operator in the haprion group reads the history and the status",
            an_operator_reads_as_themself,
        )

        def an_api_token_is_made_and_used() -> None:
            """B416: a token made on the manager reads through nginx's /api/, and not once revoked.

            The secret stays in a root-only file on the manager, so the log of
            this run never holds it.
            """

            run.on(
                "mgr",
                "umask 077 && haprion-api-token add install-test --level read --days 30 "
                "> /root/api-token 2>/dev/null "
                "&& printf 'Authorization: Bearer %s\\n' \"$(cat /root/api-token)\" > /root/api-header",
            )
            call = (
                "curl -sSk -o /root/api-answer -w '%{http_code}\\n' -H @/root/api-header "
                "https://127.0.0.1/api/v1/clusters && cat /root/api-answer"
            )
            _, answered = run.on("mgr", call)
            status, _, body = answered.partition("\n")
            listed: list[object] = []
            for record in _records(body):
                result = record.get("result")
                if record.get("ok") is True and isinstance(result, dict):
                    clusters = result.get("clusters")
                    listed += clusters if isinstance(clusters, list) else []
            names = [entry.get("name") for entry in listed if isinstance(entry, dict)]
            if status.strip() != "200" or CLUSTER not in names:
                raise Failed(f"the API did not list the cluster to a read token:\n{answered}")
            run.on("mgr", "haprion-api-token revoke install-test")
            _, refused = run.on("mgr", call)
            if refused.partition("\n")[0].strip() != "401":
                raise Failed(f"a revoked token was not refused:\n{refused}")
            run.on("mgr", "rm -f /root/api-token /root/api-header /root/api-answer")

        step("an API token made, used through nginx and revoked", an_api_token_is_made_and_used)

        def a_write_goes_to_done() -> str:
            """B416, release 3: a change saved and published through the API reaches the nodes.

            A write token saves the object with dynamic blocking (PUT) and
            publishes it (POST, with a new Idempotency-Key), is answered 202
            with the job to follow, and the job is followed to `done`. What
            the job did is read on both nodes: HAProxy runs the blocking
            table the new version defines.
            """

            header = run.api_token("install-test-write", "--level write", f"--cluster {CLUSTER}")
            document = OBJECT.format(backend=run.address("mgr")) + BLOCKING
            #
            # The poller reads the cluster's repository on its interval; until
            # it has, there is no base to change objects against (409) or no
            # stored object to replace (404).
            #
            until = time.monotonic() + 120
            while True:
                status, answer, _ = run.api(
                    header, "PUT", f"/clusters/{CLUSTER}/objects/shop", document
                )
                if status == 200 or time.monotonic() > until or status not in (404, 409):
                    break
                time.sleep(5)
            result = answer.get("result")
            if status != 200 or not isinstance(result, dict) or result.get("changed") is not True:
                raise Failed(f"saving the object through the API answered {status}:\n{answer}")
            publish = f"/clusters/{CLUSTER}/publish"
            status, answer, _ = run.api(header, "POST", publish, '{"comment": "API test"}')
            if status != 400:
                raise Failed(f"a publish without an Idempotency-Key answered {status}:\n{answer}")
            job = run.api_write(header, "POST", publish, '{"comment": "API test"}')
            finished = run.api_job(header, job)
            for role in NODES:
                run.table_holds(role, BLOCKED)  # fails when the table is not there
            print(
                f"job {job}: queued {finished['queued_at']}, started {finished['started_at']}, "
                f"finished {finished['finished_at']}"
            )
            return header

        write_header = step(
            "a write through the API goes to done on both nodes", a_write_goes_to_done
        )

        def a_block_token_blocks() -> str:
            """B416, release 2: a `block` token places a block through nginx, and it is on the nodes.

            The token is limited to the shop. The block is read on both nodes
            (the table HAProxy answers from) and, once the poller has read
            the nodes, through the API as the object page shows it. Not
            tried: a block with management writes off - switching them off
            means rewriting the UI's configuration and restarting it, which
            this test does not do.
            """

            header = run.api_token(
                "install-test-block", "--level block", f"--cluster {CLUSTER}", "--object shop"
            )
            path = f"/clusters/{CLUSTER}/objects/shop/blocks"
            status, answer, _ = run.api(header, "POST", path, json.dumps({"addresses": [BLOCKED]}))
            result = answer.get("result")
            if status != 200 or not isinstance(result, dict) or result.get("blocked") != [BLOCKED]:
                raise Failed(f"the block answered {status}:\n{answer}")
            for role in NODES:
                if not run.table_holds(role, BLOCKED):
                    raise Failed(f"{role} holds no block for {BLOCKED}")
            until = time.monotonic() + 120
            while True:
                status, answer, _ = run.api(header, "GET", path)
                result = answer.get("result")
                listed = result.get("addresses", []) if isinstance(result, dict) else []
                if status == 200 and any(one.get("address") == BLOCKED for one in listed):
                    break
                if time.monotonic() > until:
                    raise Failed(f"the API never listed the block ({status}):\n{answer}")
                time.sleep(5)
            return header

        block_header = step("a block token blocks an address through nginx", a_block_token_blocks)

        def a_block_is_lifted_by_a_job() -> None:
            """B416: lifting a block is a job; it ends `done` and the address is gone from both nodes."""

            path = f"/clusters/{CLUSTER}/objects/shop/blocks"
            job = run.api_write(write_header, "DELETE", path, json.dumps({"addresses": [BLOCKED]}))
            run.api_job(write_header, job)
            for role in NODES:
                if run.table_holds(role, BLOCKED):
                    raise Failed(f"{role} still holds the block for {BLOCKED}")

        step("lifting the block is a job that ends done", a_block_is_lifted_by_a_job)

        def jobs_wait_in_the_queue_for_a_minute_at_most() -> None:
            """Plan 6, release 3: the queue's wait per job, measured on what this harness can do.

            Measures: several API writes sent at once to the one cluster (the
            harness has alpha only), each an *Unblock* job; the database lets
            one run at a time per cluster, so the rest are answered 409
            `cluster_busy` and are sent again after Retry-After as a client
            does. For each job: the wait (queued to started) and the time to
            done, from the API; the step fails if the p95 wait is over a
            minute.

            Does not measure: two clusters at once, or certificate jobs
            beside a cluster job (the other kind the database lets run
            together). Issuing a certificate needs a CA reachable from the
            harness (ACME or NDES with an enrollment) and the harness has
            none, and a second cluster needs more containers. So this is the
            worker's pickup time under a burst, not the queue wait that two
            clusters would show; the plan's check across clusters is made on
            a lab with two.
            """

            path = f"/clusters/{CLUSTER}/objects/shop/blocks"
            for address in BURST:
                status, answer, _ = run.api(
                    block_header, "POST", path, json.dumps({"addresses": [address]})
                )
                if status != 200:
                    raise Failed(f"blocking {address} answered {status}:\n{answer}")
            with concurrent.futures.ThreadPoolExecutor(len(BURST)) as pool:
                queued = [
                    pool.submit(
                        run.api_write, write_header, "DELETE", path, json.dumps({"addresses": [a]})
                    )
                    for a in BURST
                ]
                ids = [each.result() for each in queued]
            waits = []
            for job in sorted(ids):
                done = run.api_job(write_header, job)
                moments = [
                    datetime.fromisoformat(done[field])
                    for field in ("queued_at", "started_at", "finished_at")
                ]
                waits.append((moments[1] - moments[0]).total_seconds())
                print(
                    f"job {job}: waited {waits[-1]:.1f} s, "
                    f"done after {(moments[2] - moments[0]).total_seconds():.1f} s"
                )
            ranked = sorted(waits)
            p95 = ranked[min(len(ranked) - 1, math.ceil(0.95 * len(ranked)) - 1)]
            print(f"{len(waits)} jobs, p95 wait {p95:.1f} s")
            if p95 > 60:
                raise Failed(f"the p95 wait in the queue is {p95:.1f} s, over a minute")
            for role in NODES:
                held = [address for address in BURST if run.table_holds(role, address)]
                if held:
                    raise Failed(f"{role} still holds blocks for {held}")

        step(
            "a burst of API writes waits a minute at most",
            jobs_wait_in_the_queue_for_a_minute_at_most,
        )

        def the_tokens_are_revoked() -> None:
            """A revoked token is refused (401) at once, and nothing of the tokens stays on the manager."""

            for name, header in (
                ("install-test-write", write_header),
                ("install-test-block", block_header),
            ):
                run.on("mgr", f"haprion-api-token revoke {name}")
                status, _, _ = run.api(header, "GET", "/clusters")
                if status != 401:
                    raise Failed(f"the revoked token {name} was answered {status}, not 401")
            run.on("mgr", "rm -f /root/api-install-test-*")

        step("the API tokens are revoked and refused", the_tokens_are_revoked)

        def removed_steps_down() -> tuple[str, str]:
            """B319, Fas 18 finding 73: a removed node left running took the address."""

            holder = run.wait_for_one_holder()
            leaving = next(role for role in NODES if role != holder)
            _, output = run.on("mgr", f"haprion-node remove -c {CLUSTER} {leaving} --deploy")
            if "stopped keepalived and HAProxy" not in output:
                raise Failed(f"removing {leaving} did not say it stepped down:\n{output}")
            #
            # B321: converged before, so the removal is deployed with it.
            #
            if f"=== Deploy: {holder} ===" not in output or "RESULT: OK" not in output:
                raise Failed(f"the removal was not deployed with it:\n{output}")
            _, active = run.on(leaving, "systemctl is-active haproxy keepalived", check=False)
            _, enabled = run.on(leaving, "systemctl is-enabled haproxy keepalived", check=False)
            if active.split() != ["inactive", "inactive"] or enabled.split() != [
                "disabled",
                "disabled",
            ]:
                raise Failed(f"{leaving} still runs or starts at boot:\n{active}\n{enabled}")
            time.sleep(8)
            if run.holders() != [holder]:
                raise Failed(f"after the removal the address is on {run.holders()}")
            run.answers_on_the_vip()
            return holder, leaving

        holder, leaving = step(
            "haprion-node remove --deploy: the node steps down, the rest is deployed, "
            "the address stays on one node",
            removed_steps_down,
        )

        def added_back_and_deployed() -> None:
            """B321 and B320: added back with --deploy, after the owner, as a standby."""

            _, since = run.on(leaving, "date +%s")
            _, printed = run.on(leaving, "haprion-node-key --again")
            block = re.search(r"^((?:haprion|haproxy)-node-v2:\S+)$", printed, re.M)
            if not block:
                raise Failed(f"haprion-node-key --again printed no block:\n{printed}")
            _, output = run.on(
                "mgr",
                f"haprion-node add -c {CLUSTER} --host {leaving} --deploy",
                stdin=block.group(1) + "\n",
            )
            order = re.findall(r"^=== Deploy: (\S+) ===$", output, re.MULTILINE)
            if order[-2:] != [holder, leaving] or "RESULT: OK" not in output:
                raise Failed(f"the addition was not deployed after the owner:\n{output}")
            _, log = run.on(
                leaving,
                f"journalctl -u keepalived --no-pager -o cat --since @{since.strip()}",
                check=False,
            )
            if "Entering BACKUP STATE" not in log or "Entering MASTER STATE" in log:
                raise Failed(f"{leaving} did not start as a standby:\n{log}")
            if run.holders() != [holder]:
                raise Failed(f"after the addition the address is on {run.holders()}")
            run.answers_on_the_vip()

        step(
            "haprion-node add --deploy: certificates and configuration, the node a standby",
            added_back_and_deployed,
        )

        def every_account_holds_what_the_contract_grants() -> None:
            """R2 moment 4: sudo, sockets, groups and secrets, for every account on the manager."""

            probe = run.copy("mgr", Path(__file__).resolve().parent / "privilege-probe")
            code, output = run.on("mgr", f"bash {probe}", check=False)
            if code != 0 or "RESULT:" not in output:
                failed = [line for line in output.splitlines() if line.startswith("FAIL")]
                raise Failed("the privilege probe failed:\n" + "\n".join(failed or [output]))

        step(
            "privilege-probe: every account can do what the contract grants and nothing more",
            every_account_holds_what_the_contract_grants,
        )

        def the_database_comes_back_from_a_dump() -> None:
            """B376 (R2 26-10-27, F21): one command reads a dump back into the running manager."""

            psql = "runuser -u postgres -- psql -d haprion -qtAX -c "
            run.on("mgr", "haprion-backup dump")
            _, listed = run.on("mgr", "haprion-backup list")
            # Newest first: the dump just taken.
            dump = listed.splitlines()[0].split()[-1] if listed.strip() else ""
            if not dump.endswith(".dump"):
                raise Failed(f"haprion-backup list named no dump:\n{listed}")
            run.on(
                "mgr",
                psql
                + shlex.quote(
                    "insert into audit_event (actor, action, detail)"
                    " values ('install-test', 'after_the_dump', '{}')"
                ),
            )
            _, restored = run.on("mgr", f"haprion-backup restore /var/lib/haprion-ui/dumps/{dump}")
            if "restored from" not in restored:
                raise Failed(f"haprion-backup restore did not say it restored:\n{restored}")
            _, after = run.on(
                "mgr",
                psql
                + shlex.quote("select count(*) from audit_event where action = 'after_the_dump'"),
            )
            if after.strip() != "0":
                raise Failed("the row written after the dump is still there after the restore")
            for unit in ("haprion-web.socket", "haprion-worker", "haprion-poller"):
                run.on("mgr", f"systemctl is-active --quiet {unit}")
            _, answer = run.on(
                "mgr", "curl -fsS --unix-socket /run/haprion-web.sock http://localhost/healthz"
            )
            if '"ok":true' not in answer.replace(" ", ""):
                raise Failed(f"the web does not answer after the restore:\n{answer}")

        step(
            "haprion-backup restore: a dump read back into the running manager",
            the_database_comes_back_from_a_dump,
        )

        def removed_as_before() -> None:
            """B372: listed, removed, the packages purged - and nothing of Haprion left."""

            for role, command in (
                *((node, "haprion-node-prepare --remove") for node in NODES),
                ("mgr", "haprion-setup --remove"),
            ):
                _, listed = run.on(role, command)
                if "Nothing was changed" not in listed:
                    raise Failed(f"{role}: `{command}` without --yes did not say so:\n{listed}")
                _, removed = run.on(role, f"{command} --yes")
                purge = re.search(r"sudo apt purge ([a-z0-9 .-]+)$", removed, re.MULTILINE)
                if purge is None:
                    raise Failed(f"{role}: the removal named no packages to purge:\n{removed}")
                run.on(
                    role,
                    "export DEBIAN_FRONTEND=noninteractive && "
                    f"apt-get purge -y -q {purge.group(1)} "
                    f"&& rm -f /etc/apt/sources.list.d/haprion.sources {KEYRING}",
                )
                if role == "mgr":
                    _, names = run.on(
                        "mgr",
                        "runuser -u postgres -- psql -qtAX -c "
                        '"select datname from pg_database union all select rolname from pg_roles"',
                    )
                    kept = [n for n in names.split() if "haprion" in n or n.startswith("app_")]
                    if kept:
                        raise Failed(f"the database still holds {kept}")
                left = run.left_behind(role, before[role])
                if left:
                    raise Failed(f"{role}: Haprion left these behind:\n  " + "\n  ".join(left))

        step(
            "haprion-setup --remove and haprion-node-prepare --remove: as before the installation",
            removed_as_before,
        )
    except Failed as failure:
        print("FAILED")
        print()
        print(str(failure))
        run.save_logs()
        print(f"\n  The whole output of every machine is in {logs}")
        if keep:
            print(f"  The machines are left running: podman exec -it {run.container('mgr')} bash")
        else:
            run.remove()
        return False
    run.save_logs()
    if not keep:
        run.remove()
    print(f"  [{distribution.name}] installed and serving: {len(steps)} steps")
    return True


#
# Opt-in scenarios (B481): what no release run proves and a release run should
# not grow by. `--scenario scale|readdress|faults` installs the release as
# run_one does, then does only that. Sizes are the product's own: the manager
# 2 vCPU and 4 GiB (docs/install.md, "Manager"), a node 1 vCPU and 1 GiB.
#
MANAGER_SIZE = ("--cpus", "2", "--memory", "4g")
NODE_SIZE = ("--cpus", "1", "--memory", "1g")
#
# The objects of the scale scenario: the template of
# test_ten_thousand_generated_objects_pass_the_candidate_path (B475), with the
# backends pointing at the test's own backend and the health checks off - ten
# thousand TCP checks every two seconds would measure the checks, not the
# configuration. Written on the manager, one file each, as `haprion-objects
# apply` reads them. Applied with `-m`: without one, the comment is made from
# every name in the plan and the helper refuses it above 4096 bytes (found by
# this scenario, 26-11-05: between 300 and 600 new objects).
#
SCALE_OBJECTS = 10_000
SCALE_DIR = "/root/install/scale"
CONFIG_ROOT = "/srv/haprion/config"
#
# Room in the counters file per object: a light object took about three
# entries (the limit of 2000 was reached near 700, 26-11-05), a heavy one has
# ten servers. Ten and twenty leave room over that.
#
COUNTERS_PER_OBJECT = {"light": 10, "heavy": 20}


@dataclass(frozen=True)
class Scale:
    """What one scale run measures (B482): how many objects, of which kind, on what machines.

    The nodes have a size too since 26-11-06: 10 000 heavy objects did not get a
    new HAProxy worker within the node's 15 s on 1 vCPU / 1 GiB.
    """

    objects: int = SCALE_OBJECTS
    kind: str = "light"
    cpus: str = MANAGER_SIZE[1]
    memory: str = MANAGER_SIZE[3]
    node_cpus: str = NODE_SIZE[1]
    node_memory: str = NODE_SIZE[3]

    def manager(self) -> tuple[str, ...]:
        return ("--cpus", self.cpus, "--memory", self.memory)

    def node(self) -> tuple[str, ...]:
        return ("--cpus", self.node_cpus, "--memory", self.node_memory)


SCALE_GENERATE = """\
import pathlib, sys
backend, count, root = sys.argv[1], int(sys.argv[2]), sys.argv[3]
kind = sys.argv[4] if len(sys.argv) > 4 else "light"
light = (
    "schema: 1\\nname: s{i}\\nhostnames: [s{i}.example.com, www-s{i}.example.com]\\n"
    "listen:\\n  protocol: http\\nrate_limit:\\n  window: 10s\\n  max_requests: 100\\n"
    "routes:\\n- path: /\\n  backend: web{i}\\n- path: /api\\n  backend: api{i}\\n"
    "  strip_prefix: /api\\n  add_prefix: /v2\\n- path: /health\\n  match: exact\\n"
    "  backend: web{i}\\nbackends:\\n  web{i}:\\n    balance: roundrobin\\n"
    "    health:\\n      type: disabled\\n    servers:\\n    - host: " + backend + "\\n"
    "      port: 9080\\n    - host: " + backend + "\\n      port: 9081\\n  api{i}:\\n"
    "    balance: roundrobin\\n    health:\\n      type: disabled\\n    servers:\\n"
    "    - host: " + backend + "\\n      port: 9080\\n"
)
#
# B475's heavy object: four host names, six routes, ten servers in four pools
# (/api rewrites the path and /v1 does not, so they are two pools: the
# generator refuses one pool with two rewrites, found 26-11-06). Only the two
# servers of web{i} listen (9080, 9081); the others are never asked, as the
# sampled requests go to /, and their checks are off.
#
def servers(ports):
    return "".join(
        "    - host: " + backend + "\\n      port: " + str(port) + "\\n" for port in ports
    )
def pool(name, ports):
    return (
        "  " + name + "{i}:\\n    balance: roundrobin\\n    health:\\n      type: disabled\\n"
        "    servers:\\n" + servers(ports)
    )
heavy = (
    "schema: 1\\nname: s{i}\\nhostnames: [s{i}.example.com, www-s{i}.example.com, "
    "api-s{i}.example.com, static-s{i}.example.com]\\n"
    "listen:\\n  protocol: http\\nrate_limit:\\n  window: 10s\\n  max_requests: 100\\n"
    "routes:\\n- path: /\\n  backend: web{i}\\n- path: /api\\n  backend: api{i}\\n"
    "  strip_prefix: /api\\n  add_prefix: /v2\\n- path: /v1\\n  backend: v1{i}\\n"
    "- path: /health\\n  match: exact\\n  backend: web{i}\\n"
    "- path: /static\\n  backend: static{i}\\n- path: /assets\\n  backend: static{i}\\n"
    "backends:\\n" + pool("web", (9080, 9081)) + pool("api", range(9082, 9084))
    + pool("v1", range(9084, 9086)) + pool("static", range(9086, 9090))
)
template = {"light": light, "heavy": heavy}[kind]
root = pathlib.Path(root)
root.mkdir(parents=True, exist_ok=True)
for i in range(count):
    (root / f"s{i}.yaml").write_text(template.format(i=i))
"""
#
# Reads the machine's memory while a step runs, as its control group has it:
# `memory.current` (with the page cache, which the kernel gives back) and the
# part it does not give back, anonymous memory plus the kernel's own. The
# group's `memory.peak` cannot be reset from inside a container, so a step's
# peak is sampled.
#
SAMPLER = """\
import os, time
top = [0, 0]
def kib(text, key):
    for line in text.splitlines():
        name, _, value = line.partition(" ")
        if name == key:
            return int(value)
    return 0
while not os.path.exists("/run/itest-peak.stop"):
    now = int(open("/sys/fs/cgroup/memory.current").read())
    stat = open("/sys/fs/cgroup/memory.stat").read()
    held = kib(stat, "anon") + kib(stat, "kernel") + kib(stat, "shmem")
    top = [max(top[0], now), max(top[1], held)]
    time.sleep(0.05)
open("/run/itest-peak.out", "w").write(f"{top[0]} {top[1]}")
"""


@dataclass
class Measured:
    """One step of a scenario: its wall time and, per machine, the peaks."""

    title: str
    seconds: float
    peaks: dict[str, tuple[int, int]]


def mib(value: int) -> str:
    return f"{value / 1048576:.0f}"


class Scenario:
    """The installation a scenario starts from, and the tools it shares."""

    def __init__(self, run: Run, step: Callable[[str, Callable[[], Any]], Any]) -> None:
        self.run = run
        self.step = step
        self.measurements: list[Measured] = []
        self.previous: Path | None = None
        self.new_manager: list[Path] = []
        self.new_node: list[Path] = []
        self.cut_at = ""
        self.scale = Scale()

    def bring_up(self, manager_files: list[Path], node_files: list[Path], *, sized: bool) -> None:
        """A manager and two nodes, installed, joined, an object deployed to both."""

        run = self.run
        if sized:
            run.limits = {
                "mgr": self.scale.manager(),
                **{node: self.scale.node() for node in NODES},
            }
        image = self.step("an empty server image", run.image)
        self.step("a manager and two nodes booted", lambda: run.start(image))
        self.step(
            "the manager: packages, haprion-setup", lambda: run.install_manager(manager_files)
        )
        blocks = [
            self.step(
                f"{role}: the package, and the block it printed",
                functools.partial(run.prepare_node, role, node_files),
            )
            for role in NODES
        ]
        self.step("the cluster with its first node", lambda: run.create_cluster(blocks[0]))
        self.step("the first deploy rolls out version 1", run.first_deploy_is_version_one)
        self.step(f"{NODES[1]} added", lambda: run.add_node(NODES[1], blocks[1]))

        def serving() -> None:
            run.publish()
            output = run.deploy()
            if "RESULT: OK" not in output:
                raise Failed(f"the deploy of the first object did not succeed:\n{output}")
            run.wait_for_one_holder()
            run.answers_on_the_vip()

        self.step("an object published and deployed to both nodes", serving)

    def sampling(self, roles: tuple[str, ...]) -> None:
        for role in roles:
            self.run.on(role, "rm -f /run/itest-peak.stop /run/itest-peak.out")
            self.run.on(role, "cat > /root/itest-sampler.py", stdin=SAMPLER)
            self.run.podman(
                "exec", "-d", self.run.container(role), "python3", "-I", "/root/itest-sampler.py"
            )

    def sampled(self, roles: tuple[str, ...]) -> dict[str, tuple[int, int]]:
        peaks = {}
        for role in roles:
            self.run.on(role, "touch /run/itest-peak.stop")
            _, found = self.run.on(
                role,
                "for _ in $(seq 50); do test -s /run/itest-peak.out && break; sleep 0.2; done; "
                "cat /run/itest-peak.out",
            )
            current, held = (int(part) for part in found.split())
            peaks[role] = (current, held)
        return peaks

    def measure(
        self, title: str, roles: tuple[str, ...], action: Callable[[], T]
    ) -> tuple[T, Measured]:
        """`action`, with the wall time it took and each machine's peak memory while it ran."""

        self.sampling(roles)
        started = time.monotonic()
        try:
            result = action()
        finally:
            seconds = time.monotonic() - started
            peaks = self.sampled(roles)
        measured = Measured(title, seconds, peaks)
        self.measurements.append(measured)
        said = ", ".join(f"{role} {mib(held)} MiB" for role, (_, held) in peaks.items())
        print(f"\n      {title}: {seconds:.1f} s; peak {said}", end=" ... ")
        return result, measured

    def table(self) -> str:
        roles = [
            role for role in ("mgr", *NODES) if any(role in m.peaks for m in self.measurements)
        ]
        header = f"  {'step':<48} {'seconds':>8}" + "".join(
            f" {role + ' MiB':>14}" for role in roles
        )
        lines = [header, "  " + "-" * (len(header) - 2)]
        for one in self.measurements:
            cells = "".join(
                f" {mib(one.peaks[role][1]) + ' (' + mib(one.peaks[role][0]) + ')':>14}"
                if role in one.peaks
                else f" {'':>14}"
                for role in roles
            )
            lines.append(f"  {one.title:<48} {one.seconds:>8.1f}{cells}")
        lines.append("  Memory: anonymous + kernel + shared (memory.current with the page cache).")
        return "\n".join(lines)


#
# How long the scale scenario lets a reloaded node take to be `active` again.
#
RELOAD_READY_SECONDS = 120


def scale_steps(scenario: Scenario) -> None:
    """The objects applied, published, deployed to both nodes and answering on the VIP (B481, B482)."""

    run = scenario.run
    step = scenario.step
    roles = ("mgr", *NODES)
    scale = scenario.scale
    count = scale.objects
    probe = f"s{count // 2}"
    print(
        f"  {count} {scale.kind} objects, the manager {scale.cpus} vCPU / {scale.memory}, "
        f"each node {scale.node_cpus} vCPU / {scale.node_memory}"
    )

    def generated() -> None:
        run.on(
            "mgr",
            "systemd-run --unit install-test-backend-2 --property=Restart=always "
            "/usr/bin/python3 -m http.server 9081 --directory /srv/install-test",
        )
        run.on(
            "mgr",
            "python3 -I - " + f"{run.address('mgr')} {count} {SCALE_DIR} {scale.kind}",
            stdin=SCALE_GENERATE,
        )
        _, found = run.on("mgr", f"ls {SCALE_DIR} | wc -l")
        if int(found) != count:
            raise Failed(f"{found.strip()} object files, not {count}")

    step(f"{count} object files written on the manager", generated)

    shipped: dict[str, str] = {}

    def lifted() -> None:
        """The services' own limits read, then lifted, so that a peak is what a service needs.

        At 10 000 heavy objects the poller was killed at its 512M (26-11-06):
        its peak then said only the limit. The limits shipped are compared at
        the end, against what was used.
        """

        for unit in LIMITED_UNITS:
            _, said = run.on("mgr", f"systemctl show -p MemoryMax --value {unit}")
            shipped[unit] = said.strip()
            run.on(
                "mgr",
                f"install -d /etc/systemd/system/{unit}.d && printf '[Service]\\nMemoryMax=infinity\\n' "
                f"> /etc/systemd/system/{unit}.d/zz-install-test-measure.conf",
            )
        run.on("mgr", "systemctl daemon-reload")
        run.on(
            "mgr",
            "systemctl restart haprion-web haprion-worker haprion-poller "
            "&& systemctl reset-failed haprion-traffic-collector.service || true",
        )
        print(
            "(shipped: "
            + ", ".join(f"{u.split('.')[0]} {limit_mib(v)}" for u, v in shipped.items())
            + ")",
            end=" ",
        )

    step("the manager's service limits read and lifted for the measure", lifted)

    def counters_file() -> None:
        """A new cluster's core gives the counters file room for the objects (B487).

        Found by this scenario (26-11-05): HAProxy 3.4 holds 2000 counters,
        one per frontend, listener and server, and a publish of about 700 of
        these objects was refused. The scenario wrote the line by hand until
        the core template carried it. A reload holds the old process's
        counters and the new one's at once, hence twice.
        """

        core = f"{CONFIG_ROOT}/{CLUSTER}/core/haproxy.cfg"
        _, said = run.on("mgr", f"sed -n 's/^ *shm-stats-file-max-objects //p' {core}")
        needed = 2 * count * COUNTERS_PER_OBJECT[scale.kind]
        if not said.strip().isdigit() or int(said) < needed:
            raise Failed(
                f"the new cluster's core gives the counters file {said.strip() or 'no'} places, "
                f"not the {needed} these objects need"
            )
        print(f"({said.strip()} places, {needed} needed)", end=" ")

    step("core/haproxy.cfg: a new cluster's counters file has room for the objects", counters_file)

    def checked() -> None:
        scenario.measure(
            "apply --check",
            ("mgr",),
            lambda: run.on(
                "mgr",
                f"haprion-objects apply -c {CLUSTER} {SCALE_DIR} --check -m 'scale test'",
            ),
        )

    step("haprion-objects apply --check: the difference, refused or passed", checked)

    def applied() -> None:
        scenario.measure(
            "apply (batches as one request holds, each a version)",
            ("mgr",),
            lambda: run.on(
                "mgr", f"haprion-objects apply -c {CLUSTER} {SCALE_DIR} -m 'scale test'"
            ),
        )

    step("haprion-objects apply: the objects published", applied)

    def again() -> None:
        _, said = run.on(
            "mgr", f"haprion-objects apply -c {CLUSTER} {SCALE_DIR} -m 'scale test' --json"
        )
        if '"changed": false' not in said.replace('":false', '": false'):
            raise Failed(f"applying the same files again changed something:\n{said[-2000:]}")

    step("the same files applied again change nothing", again)

    def publish_job() -> None:
        header = run.api_token("scale-write", "--level write", f"--cluster {CLUSTER}")
        #
        # The apply made one version per batch; the web reads them through the
        # poller afterwards. A change saved over a reading behind the newest
        # version is fenced off by the publish as moved (run 26-11-05: job
        # blocked, expected_target_changed) - right for a person who saves on
        # a page older than the repository. The scenario saves once the
        # reading has caught up, as a person opening the page then would, and
        # says how long that took.
        #
        _, newest = run.on(
            "mgr", f"git -c safe.directory='*' -C {CONFIG_ROOT}/{CLUSTER} rev-parse HEAD"
        )
        newest = newest.strip()
        began = time.monotonic()
        until = began + 600
        while True:
            status, answer, _ = run.api(header, "GET", f"/clusters/{CLUSTER}/objects/{probe}")
            read = (answer.get("result") or {}).get("commit") if status == 200 else None
            if read == newest:
                break
            if time.monotonic() > until:
                raise Failed(
                    f"the web still reads {read} after 600 s, the repository is at {newest}"
                )
            time.sleep(5)
        print(f"(the web read the newest version after {time.monotonic() - began:.0f} s)", end=" ")
        _, shown = run.on("mgr", f"haprion-objects -c {CLUSTER} --show {probe}")
        document = shown.rstrip("\n") + "\ndescription: changed through the API\n"
        until = time.monotonic() + 180
        while True:
            status, answer, _ = run.api(
                header, "PUT", f"/clusters/{CLUSTER}/objects/{probe}", document
            )
            if status == 200 or time.monotonic() > until or status not in (404, 409):
                break
            time.sleep(5)
        if status != 200:
            raise Failed(f"saving {probe} through the API answered {status}:\n{answer}")

        def publish() -> dict[str, Any]:
            job = run.api_write(
                header,
                "POST",
                f"/clusters/{CLUSTER}/publish",
                '{"comment": "scale", "deploy": false}',
                300,
            )
            return run.api_job(header, job, 900)

        finished, _ = scenario.measure(
            "publish job through the API (full candidate)", ("mgr",), publish
        )
        moments = [
            datetime.fromisoformat(finished[field])
            for field in ("queued_at", "started_at", "finished_at")
        ]
        print(
            f"(queued {(moments[1] - moments[0]).total_seconds():.1f} s, "
            f"ran {(moments[2] - moments[1]).total_seconds():.1f} s)",
            end=" ",
        )
        run.on("mgr", "haprion-api-token revoke scale-write && rm -f /root/api-scale-write.*")

    step(
        "one change saved and published as a job: the sandbox checks of the whole candidate",
        publish_job,
    )
    step(
        "what the manager's services used through the publishing",
        functools.partial(within_limits, run, shipped, enforce=False),
    )

    def deployed() -> None:
        output, _ = scenario.measure("haprion-deploy to both nodes", roles, run.deploy)
        order = re.findall(r"^=== Deploy: (\S+) ===$", output, re.MULTILINE)
        if sorted(order) != list(NODES) or "RESULT: OK" not in output:
            raise Failed(f"the deploy did not end OK on both nodes:\n{output[-3000:]}")
        _, status = run.on("mgr", f"haprion-status -c {CLUSTER}", check=False)
        print(f"\n{status}", end="")

    step("haprion-deploy rolls the published version out to both nodes", deployed)

    def reloaded() -> None:
        for role in NODES:
            _, count = run.on(
                role, "grep -c '^frontend ' /etc/haproxy/conf.d/*frontends.cfg || true"
            )
            _, size = run.on(role, "du -sh --apparent-size /etc/haproxy/ | cut -f1")
            print(
                f"\n      {role}: frontends {count.strip()}, configuration {size.strip()}", end=" "
            )
            (_, said), _ = scenario.measure(
                f"systemctl reload haproxy on {role}",
                (role,),
                functools.partial(
                    run.on,
                    role,
                    "systemctl reload haproxy && systemctl is-active haproxy "
                    "&& ps -o rss= -C haproxy | sort -n | tail -1 | sed 's/^/haproxy rss KiB: /'",
                ),
            )
            print(f"({' '.join(said.split())})", end=" ")
            #
            # `systemctl reload` returns before HAProxy is done: the unit stays
            # `reloading` until the new worker says it is ready (measured
            # 26-11-06: 10 000 light objects, still reloading as the reload
            # returned). The time to `active` is the margin against the 15 s
            # the node's server-state helper waits for a new worker
            # (WAIT_FOR_WORKER_SECONDS, B482).
            #
            waited = time.monotonic()
            while True:
                _, state = run.on(role, "systemctl is-active haproxy keepalived", check=False)
                if state.split() == ["active", "active"]:
                    break
                if time.monotonic() - waited > RELOAD_READY_SECONDS:
                    raise Failed(f"{role} after the reload, {RELOAD_READY_SECONDS} s on:\n{state}")
                time.sleep(0.5)
            print(f"(active {time.monotonic() - waited:.1f} s after the reload returned)", end=" ")

    step("HAProxy reloads on each node with the whole configuration", reloaded)

    def answering() -> None:
        sample = list(range(0, count, count // 20))[:19] + [count - 1]
        wrong = []
        for i in sample:
            _, body = run.on(
                "mgr",
                f"curl -sS --max-time 5 -H 'Host: s{i}.example.com' http://{run.address('vip')}/",
                check=False,
            )
            if BACKEND_BODY not in body:
                wrong.append(f"s{i}: {body.strip()[:80]!r}")
        if wrong:
            raise Failed("objects that did not answer on the virtual address:\n" + "\n".join(wrong))
        print(f"({len(sample)} objects over the range)", end=" ")

    step("20 objects spread over the range answer on the virtual address", answering)

    def converged() -> None:
        output = run.deploy()
        if output.count("already runs this version; nothing to do") != len(NODES):
            raise Failed(f"a second deploy did not skip the current nodes:\n{output[-3000:]}")

    step("a second deploy changes nothing", converged)
    step(
        "the manager's services used less than the limits they ship with",
        functools.partial(within_limits, run, shipped, enforce=True),
    )


#
# The manager's long-running services and their memory limits (B357). Found
# by the scale run of 26-11-06: at 10 000 heavy objects the poller went past
# its 512M and was killed, on 2 vCPU / 4 GiB and on 4 vCPU / 8 GiB alike.
#
LIMITED_UNITS = (
    "haprion-web.service",
    "haprion-worker.service",
    "haprion-poller.service",
    "haprion-traffic-collector.service",
)


def limit_mib(value: str) -> str:
    """systemd's byte count as MiB, or what it said (infinity)."""

    return f"{int(value) // 2**20} MiB" if value.isdigit() else (value or "?")


def within_limits(run: Run, shipped: dict[str, str], *, enforce: bool) -> None:
    """Each service's peak against the limit it ships with; past it, or killed, fails when enforced."""

    over = []
    for unit in LIMITED_UNITS:
        _, said = run.on(
            "mgr", f"systemctl show -p MemoryPeak -p NRestarts -p Result {unit}", check=False
        )
        values = dict(line.partition("=")[::2] for line in said.split())
        peak, limit = values.get("MemoryPeak", ""), shipped.get(unit, "")
        print(
            f"\n      {unit}: peak {limit_mib(peak)}, ships with {limit_mib(limit)}, "
            f"restarted {values.get('NRestarts', '?')} times, result {values.get('Result', '?')}",
            end="",
        )
        killed = values.get("NRestarts", "0") not in ("", "0") or values.get("Result") == "oom-kill"
        past = peak.isdigit() and limit.isdigit() and int(peak) > int(limit)
        if killed or past:
            over.append(unit)
    print(" ... ", end="")
    if enforce and over:
        raise Failed(f"past the limits they ship with, or killed: {', '.join(over)}")


def keepalived_view(run: Run, role: str) -> dict[str, str]:
    """What a node's keepalived is configured with and says it is doing, for the log and the asserts."""

    _, own = run.on(
        role, "awk '$1 == \"unicast_src_ip\" {print $2}' /etc/keepalived/keepalived.conf"
    )
    _, peers = run.on(
        role, "sed -n '/unicast_peer {/,/}/p' /etc/keepalived/keepalived.conf | sed '1d;$d'"
    )
    _, active = run.on(role, "systemctl is-active keepalived", check=False)
    _, state = run.on(
        role,
        "journalctl -u keepalived --no-pager -o cat | grep -E 'Entering (MASTER|BACKUP|FAULT)' | tail -1",
        check=False,
    )
    _, addresses = run.on(role, "ip -4 -o addr show | awk '{print $4}' | tr '\\n' ' '")
    return {
        "src": own.strip(),
        "peers": " ".join(peers.split()),
        "active": active.strip(),
        "state": state.strip() or "no state line yet",
        "addresses": addresses.strip(),
    }


def readdress_steps(scenario: Scenario) -> None:
    """A node changes its address: what keepalived does, Change host, failover, a deploy (B481)."""

    run = scenario.run
    step = scenario.step
    holder = run.wait_for_one_holder()
    moving = next(role for role in NODES if role != holder)
    staying = holder
    old = run.address(moving)
    new = f"{run.distribution.subnet}.32"
    seen: dict[str, dict[str, dict[str, str]]] = {}

    def show(moment: str) -> None:
        seen[moment] = {role: keepalived_view(run, role) for role in NODES}
        for role, view in seen[moment].items():
            print(
                f"\n      {moment} / {role}: unicast_src_ip {view['src']}, peers [{view['peers']}], "
                f"keepalived {view['active']}, {view['state']}",
                end="",
            )
        print(" ... ", end="")

    def before() -> None:
        show("before")
        if seen["before"][moving]["src"] != old or seen["before"][staying]["peers"] != old:
            raise Failed(f"keepalived does not name {old} for {moving} before the change: {seen}")

    step(f"keepalived names {old} for {moving}, and {staying} holds the address", before)

    def moved() -> None:
        run.podman("network", "disconnect", run.network, run.container(moving))
        run.podman(
            "network",
            "connect",
            "--ip",
            new,
            "--alias",
            moving,
            run.network,
            run.container(moving),
        )
        _, addresses = run.on(moving, "ip -4 -o addr show | awk '{print $4}' | tr '\\n' ' '")
        if f"{new}/" not in addresses or f"{old}/" in addresses:
            raise Failed(f"{moving} carries {addresses.strip()} after the change, not {new}")
        _, resolved = run.on("mgr", f"getent hosts {moving}")
        print(f"(the manager resolves {moving} as {resolved.split()[0]})", end=" ")

    step(f"{moving} is given {new} in place of {old}", moved)

    def untold() -> None:
        time.sleep(15)
        show("address changed, product not told")
        _, status = run.on("mgr", f"haprion-status -c {CLUSTER}", check=False)
        print(f"\n{status.rstrip()}\n      ", end="")
        holders = run.holders()
        print(f"(the virtual address is held by {holders or 'no node'})", end=" ")
        #
        # Found by this scenario (26-11-06): the moved node kept keepalived on
        # its old address, both took the VIP, and the deploy that would have
        # fixed it refuses a split brain. Since B484 the moved node checks its
        # own address and lets the VIP go.
        #
        if holders != [staying]:
            raise Failed(
                f"the virtual address is held by {holders or 'no node'}, not by {staying} alone"
            )
        if "Entering FAULT" not in seen["address changed, product not told"][moving]["state"]:
            raise Failed(f"keepalived on {moving} is not in FAULT: {seen}")

    step("before the product is told: the moved node lets the address go", untold)

    def prepared() -> None:
        _, output = run.on(moving, "haprion-node-prepare")
        print("\n      " + "\n      ".join(output.strip().splitlines()[-6:]), end="\n      ")
        _, listening = run.on(moving, "sshd -T | grep -i '^listenaddress'")
        if new not in listening:
            raise Failed(f"sshd on {moving} does not listen on {new}:\n{listening}")

    step(f"haprion-node-prepare on {moving}, as the manual orders it: sshd moves", prepared)

    def told() -> None:
        _, output = run.on("mgr", f"haprion-node host -c {CLUSTER} {moving} --host {new}")
        print("\n      " + "\n      ".join(output.strip().splitlines()), end="\n      ")
        if f"is now reached at {new}" not in output:
            raise Failed(f"Change host did not say the node is reached at {new}:\n{output}")
        _, hosts = run.on("mgr", f"ssh-keygen -F {new} -f /root/.ssh/known_hosts | head -1")
        if not hosts.strip():
            raise Failed(f"the host key of {moving} is not pinned under {new}")
        show("Change host done, not deployed")
        _, status = run.on("mgr", f"haprion-status -c {CLUSTER}", check=False)
        print(f"\n{status.rstrip()}\n      ", end="")

    step(f"Change host: haprion-node host {moving} --host {new}", told)

    def deployed() -> None:
        output = run.deploy()
        if "RESULT: OK" not in output:
            raise Failed(f"the deploy after Change host did not succeed:\n{output[-3000:]}")
        deadline = time.monotonic() + 30
        while True:
            show("deployed")
            views = seen["deployed"]
            if views[moving]["src"] == new and views[staying]["peers"] == new:
                break
            if time.monotonic() > deadline:
                raise Failed(f"keepalived was not given the new address by the deploy: {views}")
            time.sleep(3)
        for role in NODES:
            if seen["deployed"][role]["active"] != "active":
                raise Failed(f"keepalived on {role} is {seen['deployed'][role]['active']}")

    step("a deploy carries the new address to both nodes' keepalived", deployed)

    def one_holder() -> None:
        time.sleep(5)
        held = run.wait_for_one_holder(30)
        run.answers_on_the_vip()
        print(f"(held by {held})", end=" ")

    step("the virtual address is on exactly one node and answers", one_holder)

    def failover() -> None:
        first = run.wait_for_one_holder()
        run.on(first, "systemctl stop keepalived")
        other = run.wait_for_one_holder(30)
        if other == first:
            raise Failed(f"the address stayed on {first} with its keepalived stopped")
        run.answers_on_the_vip()
        run.on(first, "systemctl start keepalived")
        time.sleep(5)
        if run.wait_for_one_holder() != other:
            raise Failed(f"the address went back to {first}; nopreempt should keep it")
        #
        # And back the other way, so that both directions have crossed the new address.
        #
        run.on(other, "systemctl stop keepalived")
        back = run.wait_for_one_holder(30)
        if back != first:
            raise Failed(f"the address did not go back to {first}: held by {back}")
        run.answers_on_the_vip()
        run.on(other, "systemctl start keepalived")
        time.sleep(5)

    step("the address moves both ways between the nodes, over the new address", failover)

    def change_reaches_both() -> None:
        document = OBJECT.format(backend=run.address("mgr")) + BLOCKING
        run.on("mgr", "cat > /root/install/objects/shop.yaml", stdin=document)
        run.on(
            "mgr",
            f"haprion-objects apply -c {CLUSTER} /root/install/objects -m 'after the address change'",
        )
        output = run.deploy()
        order = re.findall(r"^=== Deploy: (\S+) ===$", output, re.MULTILINE)
        if sorted(order) != sorted(NODES) or "RESULT: OK" not in output:
            raise Failed(f"the deploy did not reach both nodes:\n{output[-3000:]}")
        for role in NODES:
            run.table_holds(role, BLOCKED)  # fails when the node does not run the new version
        run.answers_on_the_vip()
        output = run.deploy()
        if output.count("already runs this version; nothing to do") != len(NODES):
            raise Failed(f"a second deploy did not find the nodes current:\n{output[-3000:]}")

    step(
        "a changed object is deployed to both nodes, and a second deploy changes nothing",
        change_reaches_both,
    )


#
# Faults (B481). A node's reload made slow, so that a deploy is under way for a
# while at a place the test can see: node-a is done and node-b sits in its
# reload. HAProxy's own `ExecReload` runs first; this adds a sleep after it.
#
SLOW_RELOAD = Path("/etc/systemd/system/haproxy.service.d/install-test-slow.conf")
SLOW_RELOAD_UNIT = """[Service]
ExecReload=/bin/sleep {seconds}
"""
SLOW_SECONDS = 50
#
# Faults, the second part (R2 moment 7): a reload that fails outright. The empty
# `ExecReload=` clears HAProxy's own command list, so nothing is reloaded and the
# node keeps running what it ran; `/bin/false` then fails. The name sorts before
# install-test-slow.conf, so the sleep that file adds never runs after it.
#
FAULT_RELOAD = Path("/etc/systemd/system/haproxy.service.d/install-test-a-fault.conf")
FAULT_RELOAD_UNIT = """[Service]
ExecReload=
ExecReload=/bin/false
"""
#
# The worker wakes at least every 30 s to settle abandoned jobs and to look for
# one to claim (worker.py IDLE_SECONDS); a window that holds longer than that
# has seen the worker try. The lease is 60 s (worker.py LEASE_SECONDS).
#
WORKER_IDLE_SECONDS = 30
WORKER_LEASE_SECONDS = 60
#
# An identity provider as far as Verify goes (docs/user-manual.md, "Checking the
# sign-in"): discovery, a key set, and a token endpoint that answers a code it
# never issued with `invalid_grant`. Over TLS, from a certificate for `mgr`.
#
IDP_PORT = 8444
FAKE_IDP = """\
import http.server, json, ssl
issuer = "https://mgr:@PORT@"
discovery = {
    "issuer": issuer,
    "authorization_endpoint": issuer + "/authorize",
    "token_endpoint": issuer + "/token",
    "jwks_uri": issuer + "/jwks",
    "response_types_supported": ["code"],
    "subject_types_supported": ["public"],
    "id_token_signing_alg_values_supported": ["RS256"],
    "token_endpoint_auth_methods_supported": ["client_secret_basic", "client_secret_post"],
}
keys = open("/root/idp-fake/jwks.json", "rb").read()
class Idp(http.server.BaseHTTPRequestHandler):
    def reply(self, status, body):
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    def do_GET(self):
        if self.path == "/.well-known/openid-configuration":
            self.reply(200, json.dumps(discovery).encode())
        elif self.path == "/jwks":
            self.reply(200, keys)
        else:
            self.reply(404, b"{}")
    def do_POST(self):
        self.rfile.read(int(self.headers.get("Content-Length") or 0))
        self.reply(400, b'{"error": "invalid_grant"}')
server = http.server.HTTPServer(("0.0.0.0", @PORT@), Idp)
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain("/root/idp-fake/tls.pem", "/root/idp-fake/tls.key")
server.socket = context.wrap_socket(server.socket, server_side=True)
server.serve_forever()
""".replace("@PORT@", str(IDP_PORT))
IDP_ISSUER = f"https://mgr:{IDP_PORT}"


def b64url(raw: bytes) -> str:
    return base64.urlsafe_b64encode(raw).rstrip(b"=").decode()


class Web:
    """The interface as a person reaches it: through nginx, with a session cookie."""

    def __init__(self, run: Run) -> None:
        self.run = run

    def sign_in(self, jar: str, username: str, password: str) -> tuple[str, str]:
        """The status and the redirect of the sign-in post; a cookie jar on the manager keeps the session."""

        _, answer = self.run.on(
            "mgr",
            f"jar=/root/web-{jar}.jar; rm -f $jar; IFS= read -r secret; "
            "token=$(curl -sSk -c $jar https://127.0.0.1/login "
            '| sed -n \'s/.*name="csrf_token" value="\\([^"]*\\)".*/\\1/p\' | head -1); '
            "test -n \"$token\" || { echo 'no csrf field on the sign-in form'; exit 1; }; "
            "curl -sSk -b $jar -c $jar -o /dev/null -w '%{http_code} %{redirect_url}' "
            f"--data-urlencode username={shlex.quote(username)} "
            '--data-urlencode "password=$secret" --data-urlencode "csrf_token=$token" '
            "https://127.0.0.1/login",
            stdin=password + "\n",
        )
        status, _, redirect = answer.strip().partition(" ")
        return status, redirect

    def get(self, jar: str, path: str) -> tuple[str, str]:
        _, answer = self.run.on(
            "mgr",
            f"curl -sSk -b /root/web-{jar}.jar -w '\\n%{{http_code}}' https://127.0.0.1{path}",
        )
        body, _, status = answer.rstrip("\n").rpartition("\n")
        return status, body

    def post(self, jar: str, path: str, page: str, fields: dict[str, str]) -> tuple[str, str]:
        """A form post; the page it is on gives the CSRF field."""

        _, answer = self.run.on(
            "mgr",
            f"jar=/root/web-{jar}.jar; "
            f"token=$(curl -sSk -b $jar https://127.0.0.1{page} "
            '| sed -n \'s/.*name="csrf_token" value="\\([^"]*\\)".*/\\1/p\' | head -1); '
            "test -n \"$token\" || { echo 'no csrf field on the page'; exit 1; }; "
            "curl -sSk -b $jar -o /dev/null -w '%{http_code} %{redirect_url}' "
            + " ".join(f"--data-urlencode {shlex.quote(f'{k}={v}')}" for k, v in fields.items())
            + f' --data-urlencode "csrf_token=$token" https://127.0.0.1{path}',
        )
        status, _, redirect = answer.strip().partition(" ")
        return status, redirect


def picture(run: Run, header: str) -> dict[str, Any]:
    """What the CLI, the interface's API and the nodes themselves say the cluster runs.

    The version each node runs is read three ways: `haprion-status` (the manager
    asks the node), the API (the poller's reading, which the pages show), and
    the node's own RELEASE file. They are separate readings of one fact.
    """

    _, said = run.on("mgr", f"haprion-status -c {CLUSTER} --json", check=False)
    cli = json.loads(said)["result"]
    cli_nodes = {
        node["name"]: ((node.get("status") or {}).get("release") or {}).get("version")
        for node in cli["nodes"]
    }
    status, shown, _ = run.api(header, "GET", f"/clusters/{CLUSTER}")
    ui = shown.get("result") or {}
    ui_nodes = {node["name"]: node.get("release_version") for node in ui.get("nodes", [])}
    own = {}
    for role in NODES:
        _, version = run.on(
            role, "sed -n 's/^version=//p' /etc/haproxy/current/RELEASE", check=False
        )
        own[role] = int(version) if version.strip().isdigit() else None
    return {
        "cli": {"target": cli["summary"]["target"]["version"], "nodes": cli_nodes,
                "state": cli["summary"]["release_state"]},
        "ui": {"target": ui.get("published_version"), "nodes": ui_nodes,
               "state": ui.get("release_state"), "http": status},
        "nodes": own,
    }  # fmt: skip


def agreed(seen: dict[str, Any]) -> bool:
    """Whether the three readings give one published version and every node on it or not, alike."""

    cli, ui, own = seen["cli"], seen["ui"], seen["nodes"]
    if cli["target"] != ui["target"] or cli["state"] != ui["state"]:
        return False
    return all(cli["nodes"].get(role) == ui["nodes"].get(role) == own.get(role) for role in NODES)


def agree_soon(run: Run, header: str, seconds: float = 180) -> tuple[dict[str, Any], float]:
    """The readings once they agree (the interface's reading is the poller's, so it lags a little)."""

    started = time.monotonic()
    while True:
        seen = picture(run, header)
        if agreed(seen):
            return seen, time.monotonic() - started
        if time.monotonic() - started > seconds:
            raise Failed(
                f"the CLI, the interface and the nodes still disagree after {seconds:.0f} s:\n{seen}"
            )
        time.sleep(3)


def job_line(document: dict[str, Any]) -> str:
    return f"job {document.get('id')}: {document.get('state')}" + (
        f" ({document.get('error_code')}: {document.get('error_message')})"
        if document.get("error_code")
        else ""
    )


def watch_job(run: Run, header: str, job: int, seconds: float = 420) -> dict[str, Any]:
    """The job as the API shows it once it has ended, whatever it ended as."""

    until = time.monotonic() + seconds
    while True:
        status, document, _ = run.api(header, "GET", f"/jobs/{job}")
        result = document.get("result")
        if status != 200 or not isinstance(result, dict):
            raise Failed(f"GET /jobs/{job} answered {status}:\n{document}")
        if result.get("finished"):
            return result
        if time.monotonic() > until:
            raise Failed(f"job {job} is still {result.get('state')} after {seconds:.0f} s")
        time.sleep(3)


def slow_reload_begins(run: Run, seconds: float = 180) -> None:
    """Wait until the second node sits in its slow reload: the first node is done, this one is not."""

    until = time.monotonic() + seconds
    while run.on(NODES[1], f"pgrep -f '^/bin/sleep {SLOW_SECONDS}$'", check=False)[0] != 0:
        if time.monotonic() > until:
            raise Failed(f"{NODES[1]} did not reach its reload within {seconds:.0f} s")
        time.sleep(0.3)


def faults_steps(scenario: Scenario) -> None:
    """Faults (B481): an update under a running job, a deploy cut after the first node, a lost IdP."""

    run = scenario.run
    step = scenario.step
    web = Web(run)
    revision = [0]

    def change_shop() -> None:
        """A published change to the shop, so that the next deploy has something to roll out."""

        revision[0] += 1
        document = OBJECT.format(backend=run.address("mgr")) + BLOCKING.replace(
            "100000", str(100000 + revision[0])
        )
        run.on("mgr", "cat > /root/install/objects/shop.yaml", stdin=document)
        run.on(
            "mgr",
            f"haprion-objects apply -c {CLUSTER} /root/install/objects -m 'fault {revision[0]}'",
        )

    header = [""]

    def prepared() -> None:
        header[0] = run.api_token("faults-write", "--level write", f"--cluster {CLUSTER}")
        run.on(
            NODES[1],
            f"mkdir -p {SLOW_RELOAD.parent} && cat > {SLOW_RELOAD} && systemctl daemon-reload",
            stdin=SLOW_RELOAD_UNIT.format(seconds=SLOW_SECONDS),
        )

    step(f"a write token, and {NODES[1]}'s HAProxy reload made to last {SLOW_SECONDS} s", prepared)

    def served_again() -> None:
        run.deploy()
        seen, _ = agree_soon(run, header[0])
        if seen["cli"]["state"] != "converged":
            raise Failed(f"the cluster is not current to start from:\n{seen}")

    step("a deploy so that every fault starts from a current cluster", served_again)

    if scenario.previous is not None:
        upgrade_during_a_job(scenario, header, change_shop)
    cut_after_the_first_node(scenario, header, change_shop)
    lost_identity_provider(scenario, web)
    older_manager_backup(scenario, header, change_shop, web)
    pause_while_a_lease_runs_out(scenario, header, change_shop)
    failed_activation_then_failed_restore(scenario, header, change_shop)


def upgrade_during_a_job(
    scenario: Scenario, header: list[str], change_shop: Callable[[], None]
) -> None:
    """3a: the manager's packages updated while a deploy is under way (the nodes' too, after)."""

    run = scenario.run
    step = scenario.step
    names: list[str] = []

    def started() -> int:
        change_shop()
        names.extend(run.copy("mgr", path) for path in scenario.new_manager)
        job = run.api_write(header[0], "POST", f"/clusters/{CLUSTER}/deploy")
        slow_reload_begins(run)
        return job

    job = step(f"a deploy under way: {NODES[0]} done, {NODES[1]} in its reload", started)

    def updated() -> None:
        before = run.on("mgr", "systemctl show haprion-worker -p MainPID --value")[1].strip()
        run.on(
            "mgr",
            "export DEBIAN_FRONTEND=noninteractive && "
            f"apt-get install -y -q {' '.join(shlex.quote(name) for name in names)}",
        )
        _, after = run.on("mgr", "systemctl show haprion-worker -p MainPID --value")
        _, active = run.on(
            "mgr", "systemctl is-active haprion-worker haprion-poller haprion-web.socket"
        )
        if active.split() != ["active"] * 3:
            raise Failed(f"after the update the services are {active.split()}")
        print(f"(worker pid {before} -> {after.strip()})", end=" ")

    step("the manager updated with apt while that job runs", updated)

    def ended() -> None:
        result = watch_job(run, header[0], job)
        print(f"{job_line(result)}", end=" ")
        _, journal = run.on(
            "mgr",
            "journalctl -u haprion-worker --no-pager -o cat | grep -E 'job [0-9]+' | tail -12",
            check=False,
        )
        print("\n      " + "\n      ".join(journal.strip().splitlines()[-8:]), end="\n      ")
        seen, lag = agree_soon(run, header[0])
        print(f"(readings agree after {lag:.0f} s: target {seen['cli']['target']}, "
              f"nodes {seen['nodes']}, {seen['cli']['state']})", end=" ")  # fmt: skip
        if result["state"] == "done" and seen["cli"]["state"] != "converged":
            raise Failed(f"the job says done and the cluster is {seen['cli']['state']}:\n{seen}")
        if result["state"] != "done":
            output = run.deploy()
            if "RESULT: OK" not in output:
                raise Failed(
                    f"a deploy after job {job} ended {result['state']} did not converge:\n{output}"
                )
            seen, _ = agree_soon(run, header[0])
            if seen["cli"]["state"] != "converged":
                raise Failed(f"still not current after a deploy:\n{seen}")

    step("the job ends, and the CLI, the interface and the nodes tell one story", ended)

    def nodes_updated() -> None:
        for role in NODES:
            files = [run.copy(role, path) for path in scenario.new_node]
            run.on(
                role,
                "export DEBIAN_FRONTEND=noninteractive && "
                f"apt-get install -y -q {' '.join(shlex.quote(name) for name in files)}",
            )
        output = run.deploy()
        if "RESULT: OK" not in output:
            raise Failed(f"a deploy to the updated nodes did not succeed:\n{output[-3000:]}")

    step("both nodes updated, and a deploy to them", nodes_updated)


def cut_after_the_first_node(
    scenario: Scenario, header: list[str], change_shop: Callable[[], None]
) -> None:
    """3b: a deploy cut when the first node is done and the second is in its reload, then a worker restart."""

    run = scenario.run
    step = scenario.step

    def cut() -> int:
        change_shop()
        job = run.api_write(header[0], "POST", f"/clusters/{CLUSTER}/deploy")
        slow_reload_begins(run)
        _, since = run.on("mgr", "date '+%Y-%m-%d %H:%M:%S'")
        run.on("mgr", "systemctl restart haprion-worker")
        scenario.cut_at = since.strip()
        return job

    job = step(
        f"a deploy cut: {NODES[0]} done, {NODES[1]} in its reload, the worker restarted", cut
    )

    def said_at_once() -> None:
        time.sleep(5)
        seen = picture(run, header[0])
        status, shown, _ = run.api(header[0], "GET", f"/jobs/{job}")
        print(f"\n      {job_line(shown.get('result') or {})}; CLI {seen['cli']}; UI {seen['ui']}; "
              f"nodes {seen['nodes']}", end="\n      ")  # fmt: skip

    step("what the job, the CLI, the interface and the nodes say five seconds after", said_at_once)

    def settled() -> None:
        result = watch_job(run, header[0], job)
        print(f"{job_line(result)}", end=" ")
        _, journal = run.on(
            "mgr",
            f"journalctl -u haprion-worker --no-pager -o cat --since '{scenario.cut_at}' "
            "| grep -E 'job [0-9]+|lease' | tail -12",
            check=False,
        )
        print("\n      " + "\n      ".join(journal.strip().splitlines()[-8:]), end="\n      ")
        seen, lag = agree_soon(run, header[0])
        print(f"(readings agree after {lag:.0f} s: target {seen['cli']['target']}, "
              f"nodes {seen['nodes']}, {seen['cli']['state']})", end=" ")  # fmt: skip
        if result["state"] == "done" and seen["cli"]["state"] != "converged":
            raise Failed(f"the job says done and the cluster is {seen['cli']['state']}:\n{seen}")

    step("the job ends, and the readings agree", settled)

    def again() -> None:
        output = run.deploy()
        if "RESULT: OK" not in output:
            raise Failed(f"running the deploy again did not succeed:\n{output[-3000:]}")
        seen, _ = agree_soon(run, header[0])
        if seen["cli"]["state"] != "converged" or set(seen["nodes"].values()) != {
            seen["cli"]["target"]
        }:
            raise Failed(f"the cluster did not converge:\n{seen}")
        run.answers_on_the_vip()

    step("running the deploy again converges, and the object answers", again)


def lost_identity_provider(scenario: Scenario, web: Web) -> None:
    """3c: sign-in through a provider that no longer answers; the break-glass admin gets in and turns it off."""

    run = scenario.run
    step = scenario.step
    password = f"itest-{hashlib.sha256(str(time.time()).encode()).hexdigest()[:24]}"
    secret = hashlib.sha256(password.encode()).hexdigest()

    def accounts() -> None:
        run.on(
            "mgr",
            "haprion-user add itest-glass --role admin --password-stdin",
            stdin=password + "\n",
        )
        run.on(
            "mgr",
            "haprion-user add itest-plain --role admin --no-break-glass --password-stdin",
            stdin=password + "\n",
        )
        _, listed = run.on("mgr", "haprion-user list")
        glass = next((line for line in listed.splitlines() if "itest-glass" in line), "")
        plain = next((line for line in listed.splitlines() if "itest-plain" in line), "")
        if "break-glass" not in glass or "break-glass" in plain:
            raise Failed(f"the accounts are not a break-glass and a plain one:\n{listed}")

    step("a break-glass admin and a plain local admin", accounts)

    def provider_up() -> None:
        with tempfile.TemporaryDirectory() as raw:
            work = Path(raw)

            def openssl(*arguments: str) -> str:
                return subprocess.run(  # noqa: S603 - the host's openssl, arguments built here
                    ["/usr/bin/openssl", *arguments],
                    cwd=work,
                    check=True,
                    capture_output=True,
                    text=True,
                ).stdout

            openssl("req", "-x509", "-newkey", "rsa:2048", "-nodes", "-keyout", "ca.key",
                    "-out", "ca.pem", "-days", "2", "-subj", "/CN=Install Test IdP CA",
                    "-addext", "basicConstraints=critical,CA:TRUE",
                    "-addext", "keyUsage=critical,keyCertSign,cRLSign")  # fmt: skip
            openssl("req", "-newkey", "rsa:2048", "-nodes", "-keyout", "tls.key", "-out", "tls.csr",
                    "-subj", "/CN=mgr")  # fmt: skip
            (work / "tls.ext").write_text("subjectAltName=DNS:mgr\nbasicConstraints=CA:FALSE\n")
            openssl("x509", "-req", "-in", "tls.csr", "-CA", "ca.pem", "-CAkey", "ca.key",
                    "-CAcreateserial", "-days", "2", "-extfile", "tls.ext", "-out", "tls.pem")  # fmt: skip
            modulus = (
                openssl("x509", "-in", "tls.pem", "-noout", "-modulus").strip().partition("=")[2]
            )
            number = bytes.fromhex(modulus)
            (work / "jwks.json").write_text(
                json.dumps({"keys": [{"kty": "RSA", "use": "sig", "alg": "RS256", "kid": "itest",
                                      "n": b64url(number), "e": b64url(bytes([1, 0, 1]))}]})
            )  # fmt: skip
            (work / "serve.py").write_text(FAKE_IDP)
            run.on("mgr", "mkdir -p /root/idp-fake")
            for name in ("jwks.json", "tls.pem", "tls.key", "serve.py"):
                run.podman("cp", str(work / name), f"{run.container('mgr')}:/root/idp-fake/{name}")
            run.podman(
                "cp",
                str(work / "ca.pem"),
                f"{run.container('mgr')}:/usr/local/share/ca-certificates/install-test-idp.crt",
            )
        run.on(
            "mgr",
            "update-ca-certificates >/dev/null && systemd-run --unit=install-test-idp "
            "python3 /root/idp-fake/serve.py && sleep 2 "
            f"&& curl -fsS https://mgr:{IDP_PORT}/.well-known/openid-configuration >/dev/null",
        )

    step("an identity provider that answers (discovery, keys, a token endpoint)", provider_up)

    def turned_on() -> None:
        settings = (
            "oidc:\n"
            f"  issuer: {IDP_ISSUER}\n  client_id: haprion\n  client_secret: {secret}\n"
            "  auth_method: client_secret_basic\n  scopes: openid profile\n"
            "  username_claim: preferred_username\n  groups_claim: groups\n"
            "  admin_group: haprion-admins\n  reader_group: haprion-readers\n"
            "  local_login: break_glass_only\n  enabled: true\n  interface_url: https://mgr\n"
        )
        run.on(
            "mgr",
            "umask 077 && cat > /root/oidc-settings.yaml && haprion-settings apply /root/oidc-settings.yaml --json",
            stdin=settings,
        )
        _, shown = run.on("mgr", "haprion-settings show --json")
        if '"enabled": true' not in shown.replace('":true', '": true'):
            raise Failed(f"sign-in through the provider is not on:\n{shown}")

    step("sign-in through the provider turned on (Verify passes)", turned_on)

    def provider_lost() -> None:
        run.on("mgr", "systemctl stop install-test-idp")
        code, _ = run.on("mgr", f"curl -sS --max-time 3 https://mgr:{IDP_PORT}/", check=False)
        if code == 0:
            raise Failed("the provider still answers")
        status, _ = web.get("anon", "/login")
        if status != "200":
            raise Failed(f"the sign-in page answered {status} with the provider gone")
        # What the button does now is not promised anywhere; it is said.
        _, answer = run.on(
            "mgr",
            "curl -sSk --max-time 60 -o /dev/null -w '%{http_code} %{redirect_url}' "
            "https://127.0.0.1/login/oidc",
            check=False,
        )
        print(f"(the provider's button answers {answer.strip()[:120]})", end=" ")

    step("the provider is stopped; the sign-in page still answers", provider_lost)

    def break_glass_signs_in() -> None:
        status, redirect = web.sign_in("glass", "itest-glass", password)
        if status != "303" or redirect.rstrip("/") not in ("https://127.0.0.1", ""):
            raise Failed(
                f"the break-glass admin was answered {status} {redirect}, not a redirect home"
            )
        status, page = web.get("glass", "/settings/oidc")
        if status != "200" or "OIDC" not in page and "provider" not in page:
            raise Failed(
                f"the break-glass admin's session cannot open the provider's settings ({status})"
            )
        status, _ = web.sign_in("plain", "itest-plain", password)
        if status == "303":
            raise Failed(
                "a local admin without the break-glass mark signed in while the provider is on"
            )

    step(
        "the break-glass admin signs in through nginx; a plain local admin does not",
        break_glass_signs_in,
    )

    def turned_off() -> None:
        status, redirect = web.post("glass", "/settings/oidc", "/settings/oidc", {"action": "off"})
        if status != "303" or "done=off" not in redirect:
            raise Failed(f"turning sign-in through the provider off answered {status} {redirect}")
        _, shown = run.on("mgr", "haprion-settings show --json")
        if '"enabled": false' not in shown.replace('":false', '": false'):
            raise Failed(f"sign-in through the provider is still on:\n{shown}")
        status, _ = web.sign_in("plain", "itest-plain", password)
        if status != "303":
            raise Failed(
                f"the plain local admin cannot sign in now that the provider is off ({status})"
            )

    step("the break-glass admin turns it off; local sign-in is back for all", turned_off)


