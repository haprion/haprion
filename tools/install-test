                "export DEBIAN_FRONTEND=noninteractive SUDO_FORCE_REMOVE=yes && "
                f"apt-get purge -y -q --allow-remove-essential {' '.join(brought)}",
            )
        after = self.footprint(role)
        found = [
            path
            for path in sorted(after["paths"] - before["paths"])
            if not any(re.search(pattern, path) for pattern in LEFT_BY_SHARED_PACKAGES)
        ]
        for kind in ("users", "groups"):
            found += [
                f"{kind[:-1]} {name}"
                for name in sorted(after.get(kind, set()) - before.get(kind, set()))
                if "haprion" in name or name.startswith("crx-")
            ]
        return found

