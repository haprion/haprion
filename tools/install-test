    def one_rsyslogd_per_node(self) -> None:
        """Exactly one rsyslogd on each node, the one rsyslog.service runs.

        Another one reads the same socket and may take a record the traffic rule
        was written for; it is there when systemd cannot stop a unit's process
        (see CONTAINERFILE). Checked here so that fails every time, not as a
        record missing now and then.
        """

        for role in NODES:
            _, found = self.on(
                role, "pgrep -a -f '^/usr/(local/)?sbin/[r]syslogd' || true", check=False
            )
            _, main = self.on(role, "systemctl show rsyslog -p MainPID --value")
            processes = [line.split()[0] for line in found.splitlines() if line.strip()]
            if processes != [main.strip()]:
                _, journal = self.on(
                    role,
                    "journalctl -u rsyslog --no-pager -o cat | grep -E 'left-over|Failed to kill' | tail -5",
                    check=False,
                )
                raise Failed(
                    f"{role} runs rsyslogd {processes} and rsyslog.service's main process is "
                    f"{main.strip()}:\n{found}{journal}"
                )

