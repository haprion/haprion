#
# One entry of `pg_dump --schema-only`: its header names it and says its kind.
# A day's or a month's partition, and what belongs to it, carries the date in
# its name.
#
DUMP_ENTRY = re.compile(
    r"^-- Name: (?P<name>.*?); Type: (?P<kind>.*?); Schema: .*?; Owner: .*$", re.M
)
DATED = re.compile(r"_\d{6}(?:\d{2})?(?:_[a-z_]+)?\b")


def schema_entries(dump: str) -> dict[str, str]:
    """`{"<kind>: <name>": statement}` for every entry but the dated partitions (B436).

    pg_dump's frame is left out with the comment lines and its random
    `\\restrict` token, so two dumps of one schema are equal.
    """

    marks = list(DUMP_ENTRY.finditer(dump))
    found = {}
    for index, mark in enumerate(marks):
        if DATED.search(mark["name"]):
            continue
        end = marks[index + 1].start() if index + 1 < len(marks) else len(dump)
        body = "\n".join(
            line
            for line in dump[mark.end() : end].splitlines()
            if line.strip() and not line.startswith("--") and not line.startswith("\\")
        )
        found[f"{mark['kind']}: {mark['name']}"] = body
    return found


def schema_difference(updated: dict[str, str], new: dict[str, str]) -> list[str]:
    """What one schema has and the other has not, or has otherwise, one line per entry."""

    said = []
    for key in sorted(set(updated) | set(new)):
        if key not in new:
            said.append(f"  only after the update: {key}")
        elif key not in updated:
            said.append(f"  only in a new installation: {key}")
        elif updated[key] != new[key]:
            said.append(f"  not the same: {key}")
    return said


