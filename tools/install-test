def database(run: Run, sql: str) -> str:
    """One query to the interface's database as its superuser, the rows as `psql -tA` prints them."""

    _, answer = run.on(
        "mgr",
        "cd /tmp && name=$(sed -n 's/^DB_NAME=//p' /etc/haprion/ui-admin.conf | tail -1) "
        f'&& runuser -u postgres -- psql -qtAX -d "$name" -c {shlex.quote(sql)} 2>/dev/null',
    )
    return answer.strip()


def job_row(run: Run, job: int) -> tuple[str, int]:
    """The job's state and how many times a worker has taken it (`job.attempts`, db/jobs.py)."""

    state, _, attempts = database(
        run,
        f"select state, attempts from job where id = {int(job)}",  # noqa: S608 - an integer
    ).partition("|")
    if not attempts.isdigit():
        raise Failed(f"job {job} is not in the database: {state!r}")
    return state, int(attempts)


def releases_on_nodes(run: Run) -> dict[str, int | None]:
    """The version in each node's own RELEASE file, the reading `picture` calls `nodes`."""

    own: dict[str, int | None] = {}
    for role in NODES:
        _, version = run.on(
            role, "sed -n 's/^version=//p' /etc/haproxy/current/RELEASE", check=False
        )
        own[role] = int(version) if version.strip().isdigit() else None
    return own


def older_manager_backup(
    scenario: Scenario, header: list[str], change_shop: Callable[[], None], web: Web
) -> None:
    """7a: the manager put back to an older backup. Its jobs are held; nothing reaches a node until Run.

    The backup is what Veeam would give back: the interface's database (the product's own
    `haprion-backup dump`) and the files of the manager the database does not hold,
    `/srv/haprion` (the published releases the CLI reads as "published"). Put back with
    `haprion-backup restore`, which holds every waiting job (`after-restore`,
    haprion-backup:do_after_restore) and ends every session.

    Two rounds, because a cluster has at most one active job (`job_one_active_per_cluster`,
    db/jobs.py:queue_job) and a held job is one:
    - a node backup, which keeps a receipt of its helper's answer (recovery.KEEPS_ANSWER):
      the job was queued in the backup, ran after it, and is queued again by the restore.
      Run must end it on the kept answer and not take a second archive (worker.py:run_one_job);
    - a deploy, which keeps none: Discard ends it `blocked` / `held_discarded`, and the nodes keep
      the version deployed after the backup.
    """

    run = scenario.run
    step = scenario.step
    password = f"itest-{hashlib.sha256(str(time.time()).encode()).hexdigest()[:24]}"

    def account() -> None:
        run.on(
            "mgr",
            "haprion-user add itest-held --role admin --password-stdin",
            stdin=password + "\n",
        )
        #
        # Node backups is off on a new installation (measured 26-11-06: the
        # route answered 404), and turned on as an administrator does it.
        # From a new installation no schedule is remembered, so turning it on
        # queues no job that would hold the cluster.
        #
        status, redirect = web.sign_in("held-setup", "itest-held", password)
        if status != "303":
            raise Failed(f"the administrator cannot sign in ({status} {redirect})")
        status, redirect = web.post(
            "held-setup", "/settings/features/node_backups", "/settings", {"enabled": "on"}
        )
        if status != "303":
            raise Failed(f"turning on Node backups answered {status} {redirect}, not a redirect")
        #
        # A node archive needs the node's Netplan (the manual's requirement:
        # the cloud images of both distributions have it). The containers'
        # network is podman's, so each node gets the file a cloud image would
        # carry, describing its address; nothing applies it here.
        #
        for role in NODES:
            run.on(
                role,
                "install -d -m 755 /etc/netplan && "
                "install -m 600 /dev/stdin /etc/netplan/50-cloud-init.yaml",
                stdin=(
                    "network:\n  version: 2\n  ethernets:\n    eth0:\n"
                    f"      addresses:\n        - {run.address(role)}/24\n"
                ),
            )

    step(
        "an administrator for the Jobs page (Run and Discard are the web's, not the API's), "
        "Node backups turned on, and each node given the Netplan file a cloud image has",
        account,
    )

    def round_(kind: str, decision: str) -> None:
        seen: dict[str, Any] = {}
        label = f"{kind}, {decision}"

        def backed_up() -> None:
            run.on("mgr", "systemctl stop haprion-worker")
            if kind == "deploy":
                change_shop()
            status, redirect = web.sign_in("held-old", "itest-held", password)
            if status != "303":
                raise Failed(f"the administrator cannot sign in ({status} {redirect})")
            if kind == "backup":
                status, redirect = web.post(
                    "held-old",
                    "/operations",
                    "/backups",
                    {"operation": "backup_run", "cluster": CLUSTER,
                     "idempotency_key": str(uuid.uuid4())},
                )  # fmt: skip
                if status != "303":
                    raise Failed(f"Back up now answered {status} {redirect}, not a redirect")
                seen["job"] = int(
                    database(
                        run,
                        "select id from job where operation = 'backup_run' and state = 'pending' "
                        "order by id desc limit 1",
                    )
                )
                _, seen["archives_queued"] = run.on(
                    "mgr", f"haprion-list-backups -c {CLUSTER}", check=False
                )
            else:
                seen["job"] = run.api_write(header[0], "POST", f"/clusters/{CLUSTER}/deploy")
            run.on("mgr", "haprion-backup dump")
            run.on(
                "mgr",
                "dir=$(sed -n 's/^DUMP_DIR=//p' /etc/haprion/ui-admin.conf | tail -1) "
                '&& newest=$(ls -t "$dir"/*.dump | head -1) && test -n "$newest" '
                f'&& install -m 600 "$newest" /root/older-manager-{kind}.dump '
                f"&& tar --numeric-owner -C /srv -cpf /root/older-srv-haprion-{kind}.tar haprion",
            )
            seen["published_then"] = picture(run, header[0])["cli"]["target"]

        step(f"({label}) the worker stopped, a job queued, and the manager backed up", backed_up)

        def done_after_the_backup() -> None:
            run.on("mgr", "systemctl start haprion-worker")
            result = watch_job(run, header[0], seen["job"])
            if result["state"] != "done":
                raise Failed(f"the job queued before the backup did not run: {job_line(result)}")
            if kind == "backup":
                _, seen["archives_ran"] = run.on(
                    "mgr", f"haprion-list-backups -c {CLUSTER}", check=False
                )
                if seen["archives_ran"] == seen["archives_queued"]:
                    raise Failed(
                        "the node backup left no new archive in `haprion-list-backups`; "
                        f"there is nothing to tell a second run from:\n{seen['archives_ran']}"
                    )
            change_shop()
            output = run.deploy()
            if "RESULT: OK" not in output:
                raise Failed(f"the work after the backup did not deploy:\n{output[-3000:]}")
            now, _ = agree_soon(run, header[0])
            seen["ahead"] = now["nodes"]
            seen["published_now"] = now["cli"]["target"]
            if seen["published_now"] == seen["published_then"]:
                raise Failed(f"the work after the backup published nothing new:\n{now}")

        step(
            f"({label}) the job runs, then more work: published and deployed", done_after_the_backup
        )

        #
        # The two ways a manager goes back (26-11-06). The backup round restores
        # the database alone, as `haprion-backup restore` does: the helper's
        # saved answer (/var/lib/haprion/answers) and the archives under /srv
        # stay, which is the older backup with a saved answer. The deploy round
        # puts back an image, the database and /srv together, as Veeam does:
        # the nodes then run a version the manager has no record of (F18). A
        # deploy keeps no answer, so nothing newer is left beside it.
        #
        image = kind == "deploy"

        def put_back() -> None:
            units = "haprion-worker haprion-poller haprion-web.socket haprion-web"
            run.on("mgr", f"systemctl stop {units}")
            if image:
                run.on(
                    "mgr",
                    "rm -rf /srv/haprion.newer && mv /srv/haprion /srv/haprion.newer "
                    f"&& tar --numeric-owner -C /srv -xpf /root/older-srv-haprion-{kind}.tar",
                )
            _, output = run.on("mgr", f"haprion-backup restore /root/older-manager-{kind}.dump")
            held = re.search(r"held for an admin on Jobs: \[([^\]]*)\]", output)
            if held is None or str(seen["job"]) not in held.group(1).replace(" ", "").split(","):
                raise Failed(f"the restore did not hold job {seen['job']}:\n{output[-3000:]}")
            run.on("mgr", "systemctl start haprion-poller haprion-web.socket")
            run.on("mgr", "systemctl start haprion-worker")

        step(
            f"({label}) the older backup put back with haprion-backup restore"
            + (", and /srv with it as an image" if image else ", the database alone"),
            put_back,
        )

        def held() -> None:
            until = time.monotonic() + 120
            while True:
                status, document, _ = run.api(header[0], "GET", f"/jobs/{seen['job']}")
                result = document.get("result")
                if status == 200 and isinstance(result, dict):
                    break
                if time.monotonic() > until:
                    raise Failed(
                        f"the API does not answer after the restore ({status}):\n{document}"
                    )
                time.sleep(3)
            if result["state"] != "pending" or result["held"] is not True:
                raise Failed(f"the restored job is not held: {job_line(result)}\n{result}")
            opened, _ = web.get("held-old", "/jobs")
            if opened == "200":
                raise Failed("a session from before the restore still opens the Jobs page")
            #
            # Longer than the worker's idle wake-up: it has had the chance to claim the job and
            # a deploy would have moved a node. `held_since` keeps the claim query away
            # (db/jobs.py:claim_job).
            #
            time.sleep(WORKER_IDLE_SECONDS + 10)
            state, attempts = job_row(run, seen["job"])
            if state != "pending" or attempts != 0:
                raise Failed(f"the held job moved: {state}, taken {attempts} times")
            moved = releases_on_nodes(run)
            if moved != seen["ahead"]:
                raise Failed(f"a node changed with the job held: was {seen['ahead']}, is {moved}")
            if kind == "backup":
                _, archives = run.on("mgr", f"haprion-list-backups -c {CLUSTER}", check=False)
                if archives != seen["archives_ran"]:
                    raise Failed(f"a node backup was taken with the job held:\n{archives}")
            if not image:
                now, _ = agree_soon(run, header[0])
                if now["nodes"] != seen["ahead"]:
                    raise Failed(f"the readings after the restore:\n{now}")
                print(f"(held; nodes {now['nodes']}, {now['cli']['state']})", end=" ")
                return
            #
            # The nodes run a version this manager has no record of; the CLI says so
            # (cluster_status.ahead_words, cli/status.py:_release_line) and all readings agree
            # that the cluster is not converged (status_collect._release_state: "behind").
            #
            _, said = run.on("mgr", f"haprion-status -c {CLUSTER}", check=False)
            if "which this manager has no record of" not in said or "AHEAD" not in said:
                raise Failed(f"haprion-status does not say the nodes are ahead:\n{said}")
            now, _ = agree_soon(run, header[0])
            if now["cli"]["state"] != "behind" or now["nodes"] != seen["ahead"]:
                raise Failed(f"the readings after the restore:\n{now}")
            print(f"(held; nodes {now['nodes']}, published {now['cli']['target']})", end=" ")

        step(
            f"({label}) the job is held and no node moves"
            + (", and the readings say the nodes are ahead" if image else ""),
            held,
        )

        def decided() -> None:
            status, _ = web.sign_in("held-new", "itest-held", password)
            if status != "303":
                raise Failed(f"the administrator cannot sign in again ({status})")
            status, redirect = web.post(
                "held-new", f"/jobs/{seen['job']}/held", "/jobs", {"decision": decision}
            )
            if status != "303" or redirect.rstrip("/").endswith("not_held=" + str(seen["job"])):
                raise Failed(f"{decision} answered {status} {redirect}")
            result = watch_job(run, header[0], seen["job"])
            print(job_line(result), end=" ")
            if decision == "run":
                #
                # Its helper had answered this request before the restore: the job ends on that
                # answer and is not asked again (worker.py:run_one_job, `answer_kept`).
                #
                if result["state"] != "done" or "answer_kept" not in result["warning_codes"]:
                    raise Failed(f"Run did not end the job on its kept answer:\n{result}")
                _, archives = run.on("mgr", f"haprion-list-backups -c {CLUSTER}", check=False)
                if archives != seen["archives_ran"]:
                    raise Failed(f"Run took a second archive:\n{archives}")
            else:
                if result["state"] != "blocked" or result["error_code"] != "held_discarded":
                    raise Failed(f"Discard did not end the job as discarded:\n{result}")
            moved = releases_on_nodes(run)
            if moved != seen["ahead"]:
                raise Failed(f"a node changed on {decision}: was {seen['ahead']}, is {moved}")

        step(
            f"({label}) {decision} on the Jobs page: the job ends, the nodes stay as they were",
            decided,
        )

        def converged() -> None:
            output = run.deploy()
            if "RESULT: OK" not in output:
                raise Failed(
                    f"the deploy that brings the nodes to the manager failed:\n{output[-3000:]}"
                )
            now, _ = agree_soon(run, header[0])
            if now["cli"]["state"] != "converged":
                raise Failed(f"not converged after a deploy:\n{now}")

        step(f"({label}) a deploy puts the nodes on what the manager publishes", converged)

    round_("backup", "run")
    round_("deploy", "discard")


def pause_while_a_lease_runs_out(
    scenario: Scenario, header: list[str], change_shop: Callable[[], None]
) -> None:
    """7b: the queue paused (as an upgrade does) while a running job's lease runs out.

    `haprion-drain pause` is what update-platform-release (lines 372, 394), install-ui-release,
    haprion-rollback and `haprion-backup restore` call before they touch the worker. It counts a job
    as running only while its lease holds (haprion-drain `running()`), so a job whose worker was
    killed is waited for until the lease runs out and then declared quiet. Recovery judges the same
    job by the same lease (db.expired_leases): a deploy is put back in the queue, which a pause does
    not stop (db.requeue_expired), but it is not taken again while the pause lasts
    (db.claim_job reads `job_claim_gate`), and only an adoption of a kept answer is held off by it
    (db.adopt_expired) - that follow-up work is what must not start after drain said quiet.
    """

    run = scenario.run
    step = scenario.step
    seen: dict[str, Any] = {}

    def killed() -> None:
        change_shop()
        seen["job"] = run.api_write(header[0], "POST", f"/clusters/{CLUSTER}/deploy")
        slow_reload_begins(run)
        run.on("mgr", "systemctl kill -s KILL haprion-worker")
        seen["killed"] = time.monotonic()

    step(f"a deploy under way ({NODES[1]} in its reload), the worker killed hard", killed)

    def drained() -> None:
        code, output = run.on(
            "mgr", f"haprion-drain pause --wait {4 * WORKER_LEASE_SECONDS}", check=False
        )
        waited = time.monotonic() - seen["killed"]
        if code != 0 or "no job is running" not in output:
            run.on("mgr", "haprion-drain resume", check=False)
            raise Failed(f"haprion-drain pause exited {code}:\n{output}")
        if waited > WORKER_LEASE_SECONDS + 15:
            run.on("mgr", "haprion-drain resume", check=False)
            raise Failed(f"drain waited {waited:.0f} s for a lease of {WORKER_LEASE_SECONDS} s")
        seen["state"], seen["attempts"] = job_row(run, seen["job"])
        print(f"(drain said quiet {waited:.0f} s after the kill; job {seen['state']}, "
              f"taken {seen['attempts']} time)", end=" ")  # fmt: skip
        if seen["attempts"] != 1:
            run.on("mgr", "haprion-drain resume", check=False)
            raise Failed(f"the job was taken again before drain answered ({seen['attempts']})")

    step(
        "drain pauses the queue: it waits for the lease to run out, then says no job is running",
        drained,
    )

    def recovery_agrees() -> None:
        try:
            until = time.monotonic() + 2 * WORKER_IDLE_SECONDS + 30
            while job_row(run, seen["job"])[0] != "pending":
                if time.monotonic() > until:
                    raise Failed(
                        f"recovery did not put job {seen['job']} back in the queue: {job_row(run, seen['job'])}"
                    )
                time.sleep(3)
            requeued = database(
                run,
                "select count(*) from audit_event where action = 'job_requeued' "  # noqa: S608
                f"and detail->>'job' = '{int(seen['job'])}'",
            )
            if requeued != "1":
                raise Failed(
                    f"the audit record has {requeued} `job_requeued` for job {seen['job']}"
                )
            #
            # Longer than the worker's idle wake-up, so that it has looked for work under the pause.
            #
            time.sleep(WORKER_IDLE_SECONDS + 10)
            state, attempts = job_row(run, seen["job"])
            if (state, attempts) != ("pending", 1):
                raise Failed(
                    f"work started under the pause: job {seen['job']} is {state}, taken {attempts} times"
                )
            _, journal = run.on(
                "mgr",
                "journalctl -u haprion-worker --no-pager -o cat --since '-4 min' | tail -8",
                check=False,
            )
            print("\n      " + "\n      ".join(journal.strip().splitlines()[-6:]), end="\n      ")
        except Failed:
            run.on("mgr", "haprion-drain resume", check=False)
            raise

    step("under the pause recovery puts the job back and nothing takes it", recovery_agrees)

    def resumed() -> None:
        run.on("mgr", "haprion-drain resume")
        result = watch_job(run, header[0], seen["job"])
        state, attempts = job_row(run, seen["job"])
        print(f"({job_line(result)}; taken {attempts} times)", end=" ")
        if result["state"] != "done" or attempts != 2:
            raise Failed(
                f"after the pause the job did not run once more to its end: {result}, taken {attempts}"
            )
        now, lag = agree_soon(run, header[0])
        if now["cli"]["state"] != "converged":
            raise Failed(f"the job is done and the cluster is {now['cli']['state']}:\n{now}")
        run.answers_on_the_vip()

    step("the pause lifted: the job runs once more to its end and the readings agree", resumed)


def failed_activation_then_failed_restore(
    scenario: Scenario, header: list[str], change_shop: Callable[[], None]
) -> None:
    """7c: node-b cannot reload HAProxy on the new release, nor on the old one it falls back to.

    haprion-pull-deploy: the reload after the switch fails (line ~1186), `current` is put back on the
    old release, the reload of that fails too (`restored=0`), so the INCOMPLETE marker is kept
    (settle_incomplete does nothing then) and the node exits 1. The old release was never touched.
    """

    run = scenario.run
    step = scenario.step
    seen: dict[str, Any] = {}

    def node(command: str) -> str:
        return run.on(NODES[1], command, check=False)[1].strip()

    def broken() -> None:
        seen["link"] = node("readlink -f /etc/haproxy/current")
        seen["release_file"] = node("cat /etc/haproxy/current/RELEASE")
        seen["versions"] = releases_on_nodes(run)
        change_shop()
        run.on(
            NODES[1],
            f"mkdir -p {FAULT_RELOAD.parent} && cat > {FAULT_RELOAD} && systemctl daemon-reload",
            stdin=FAULT_RELOAD_UNIT,
        )

    step(f"a change published, and {NODES[1]}'s HAProxy reload made to fail", broken)

    def deployed_into_it() -> None:
        code, output = run.on("mgr", f"haprion-deploy -c {CLUSTER}", check=False)
        if code == 0 or "RESULT: OK" in output:
            raise Failed(
                f"the deploy says it succeeded with a node that cannot reload:\n{output[-3000:]}"
            )
        failed = re.search(rf"the deploy trigger failed on {NODES[1]} with exit \d+", output)
        if f"=== Deploy: {NODES[1]} ===" not in output or failed is None:
            raise Failed(f"the deploy does not say which node failed:\n{output[-3000:]}")
        print(f"(exit {code}; {failed.group(0)})", end=" ")
        result = [line for line in output.splitlines() if line.startswith("RESULT")]
        print("\n      " + "\n      ".join(result), end="\n      ")

    step("a deploy: the activation fails on that node, and says which", deployed_into_it)

    def node_is_whole() -> None:
        if node("readlink -f /etc/haproxy/current") != seen["link"]:
            raise Failed(
                f"{NODES[1]}'s current release changed: {node('readlink -f /etc/haproxy/current')}"
            )
        if node("cat /etc/haproxy/current/RELEASE") != seen["release_file"]:
            raise Failed(f"{NODES[1]}'s RELEASE file changed")
        if node("systemctl is-active haproxy") != "active":
            raise Failed(f"HAProxy on {NODES[1]} is {node('systemctl is-active haproxy')}")
        if node("test -e /var/lib/haprion/pull-deploy.incomplete && echo yes") != "yes":
            raise Failed(f"{NODES[1]} kept no incomplete marker after a restore that failed")
        if node("test -e /run/haprion-pull-deploy.pending && echo yes") == "yes":
            raise Failed(
                f"{NODES[1]} says a release is waiting for a reload, but `current` is the old one"
            )
        _, said = run.on("mgr", f"haprion-status -c {CLUSTER}", check=False)
        if "INCOMPLETE" not in said:
            raise Failed(f"haprion-status does not say the node is incomplete:\n{said}")
        now, lag = agree_soon(run, header[0])
        if now["nodes"][NODES[1]] != seen["versions"][NODES[1]] or now["cli"]["state"] != "behind":
            raise Failed(f"the readings after the failed activation:\n{now}")
        print(f"(readings agree after {lag:.0f} s: {now['nodes']}, {now['cli']['state']})", end=" ")

    step(
        f"{NODES[1]} still has its previous release and manifest, and every reading says it is behind",
        node_is_whole,
    )

    def retried() -> None:
        run.on(NODES[1], f"rm -f {FAULT_RELOAD} && systemctl daemon-reload")
        output = run.deploy()
        if "RESULT: OK" not in output:
            raise Failed(f"the deploy after removing the fault failed:\n{output[-3000:]}")
        now, _ = agree_soon(run, header[0])
        if now["cli"]["state"] != "converged" or set(now["nodes"].values()) != {
            now["cli"]["target"]
        }:
            raise Failed(f"the cluster did not converge:\n{now}")
        if node("test -e /var/lib/haprion/pull-deploy.incomplete && echo yes") == "yes":
            raise Failed(f"{NODES[1]} is converged and still marked incomplete")
        run.answers_on_the_vip()

    step("the fault removed: a plain deploy converges both nodes", retried)


SCENARIOS: dict[str, Callable[[Scenario], None]] = {
    "scale": scale_steps,
    "readdress": readdress_steps,
    "faults": faults_steps,
}


def run_scenario(
    name: str,
    distribution: Distribution,
    packages: Path,
    previous: Path | None,
    logs: Path,
    keep: bool,
    scale: Scale | None = None,
) -> bool:
    """One opt-in scenario on a fresh installation of these packages (B481)."""

    new_manager, new_node = release_files(packages, distribution)
    manager_files, node_files = new_manager, new_node
    if name == "faults" and previous is not None:
        manager_files, node_files = release_files(previous, distribution, previous=True)
    logs.mkdir(parents=True, exist_ok=True)
    run = Run(distribution, logs)
    steps: list[str] = []

    def step(title: str, action: Callable[[], T]) -> T:
        run.step += 1
        print(f"  [{distribution.name} {name} {run.step:2d}] {title} ... ", end="", flush=True)
        started = time.monotonic()
        result = action()
        print(f"ok ({time.monotonic() - started:.0f} s)")
        steps.append(title)
        return result

    scenario = Scenario(run, step)
    scenario.previous = previous
    scenario.scale = scale or Scale()
    scenario.new_manager, scenario.new_node = new_manager, new_node
    try:
        scenario.bring_up(manager_files, node_files, sized=name == "scale")
        SCENARIOS[name](scenario)
    except Failed as failure:
        print("FAILED")
        print()
        print(str(failure))
        if scenario.measurements:
            print("\n" + scenario.table())
        run.save_logs()
        print(f"\n  The whole output of every machine is in {logs}")
        if keep:
            print(f"  The machines are left running: podman exec -it {run.container('mgr')} bash")
        else:
            run.remove()
        return False
    run.save_logs()
    if not keep:
        run.remove()
    if scenario.measurements:
        print("\n" + scenario.table() + "\n")
    print(f"  [{distribution.name} {name}] passed: {len(steps)} steps")
    return True


#
# Where the update's marker is while it is under way (update-platform-release),
# the drop-in that makes the web refuse every release but one, and the one that
# makes it refuse them all.
#
UPDATE_MARKER = "/var/lib/haprion-ui/platform-update/update"
FAULT = Path("/etc/systemd/system/haprion-web.service.d/install-test-fault.conf")
FAULT_UNIT = """[Service]
ExecStartPre=/bin/sh -c 'case "$$(readlink -f /opt/haprion-ui/current)" in */{release}) exit 0;; esac; exit 1'
"""
FAULT_EVERY = """[Service]
ExecStartPre=/bin/false
"""


def run_upgrade(
    distribution: Distribution, previous: Path, packages: Path, logs: Path, keep: bool
) -> bool:
    """The previous release installed and serving, then this one over it with apt.

    0.99.3 passed every step above and could not be installed over 0.99.2
    (26-10-28): its migration was declared unsafe for the running release, and
    the UI package's postinst stopped where docs/install.md says to run
    `apt upgrade`. Only an update from the release before shows that.
    """

    old_manager, old_node = release_files(previous, distribution, previous=True)
    new_manager, new_node = release_files(packages, distribution)
    logs.mkdir(parents=True, exist_ok=True)
    run = Run(distribution, logs)
    steps: list[str] = []
    label = f"{distribution.name} upgrade"
    # The version the package files carry, as `haprion-cli_0.99.2+git..._all.deb` names it.
    before = old_manager[0].name.split("_")[1].split("+")[0]

    def step(title: str, action: Callable[[], T]) -> T:
        run.step += 1
        print(f"  [{label} {run.step:2d}] {title} ... ", end="", flush=True)
        started = time.monotonic()
        result = action()
        print(f"ok ({time.monotonic() - started:.0f} s)")
        steps.append(title)
        return result

    def upgraded(role: str, files: list[Path]) -> None:
        names = [run.copy(role, path) for path in files]
        run.on(
            role,
            "export DEBIAN_FRONTEND=noninteractive && "
            f"apt-get install -y -q {' '.join(shlex.quote(name) for name in names)}",
        )
        all_configured(role, files)

    def all_configured(role: str, files: list[Path]) -> None:
        _, states = run.on(role, "dpkg-query -W -f='${db:Status-Abbrev} ${Package}\\n' 'haprion*'")
        unfinished = [line for line in states.splitlines() if line.split()[0] not in ("ii", "un")]
        if unfinished:
            raise Failed(f"{role}: packages left unconfigured:\n" + "\n".join(unfinished))
        for path in files:
            _, wanted = run.on(role, f"dpkg-deb -f /root/install/{path.name} Package Version")
            fields = dict(line.split(": ", 1) for line in wanted.splitlines() if ": " in line)
            _, have = run.on(role, f"dpkg-query -W -f='${{Version}}' {fields['Package']}")
            if have.strip() != fields["Version"]:
                raise Failed(
                    f"{role}: {fields['Package']} is {have.strip()}, not {fields['Version']}"
                )

    def the_web_answers(after: str) -> None:
        for unit in ("haprion-web.socket", "haprion-worker", "haprion-poller"):
            run.on("mgr", f"systemctl is-active --quiet {unit}")
        _, answer = run.on(
            "mgr", "curl -fsS --unix-socket /run/haprion-web.sock http://localhost/healthz"
        )
        if '"ok":true' not in answer.replace(" ", ""):
            raise Failed(f"the web does not answer after {after}:\n{answer}")

    def current_ui_release() -> str:
        _, link = run.on("mgr", "readlink /opt/haprion-ui/current")
        return link.strip().rsplit("/", 1)[-1]

    def compatible(after: str) -> None:
        """The manager's own check, as the manual says to run it (review 26-10-29, A04).

        After a rollback over a migration it said INCOMPATIBLE, and nothing
        here asked it (A01).
        """

        _, said = run.on(
            "mgr", "/usr/share/haprion-ui/install/platform/check-compatibility", check=False
        )
        if not any(line.startswith("COMPATIBLE:") for line in said.splitlines()):
            raise Failed(f"check-compatibility after {after} is not COMPATIBLE:\n{said[-6000:]}")

    def schema(release: str) -> str:
        """The database's revision, read by `release`'s own alembic, as where_it_stands reads it."""

        _, said = run.on(
            "mgr",
            "set -o pipefail; "
            "/usr/share/haprion-ui/install/platform/migrate "
            f"--release {shlex.quote(release)} current 2>/dev/null "
            "| grep -Eo '^[0-9A-Za-z_]+' | tail -1",
        )
        return said.strip()

    def packaged_release() -> str:
        _, said = run.on("mgr", "sed -n 's/^RELEASE_ID=//p' /usr/lib/haprion/ui/PAYLOAD")
        return said.strip()

    def a_failed_update_is_undone_and_run_again() -> str:
        """The update stopped after its activation, undone, failed again unrestored, and finished.

        Every step above took the way that works; the way back had never run
        (review 26-10-29, A04). First the web refuses to start on any release
        but the previous one: the activation fails and the update restores
        the previous release. Then it refuses every release: run again, the
        update cannot restore the previous release either, and the candidate
        runs unproved with the marker kept (AA05). `dpkg --configure -a`, the
        manual's next step, finishes the update once the cause is gone.

        Whether a migration ran before the activation depends on the two
        releases; the schema before and after is read and said.
        """

        previous = released[0]
        schema_before = schema(previous)
        names = [run.copy("mgr", path) for path in new_manager]
        run.on(
            "mgr",
            f"mkdir -p {FAULT.parent} && cat > {FAULT} && systemctl daemon-reload",
            stdin=FAULT_UNIT.format(release=previous),
        )
        code, said = run.on(
            "mgr",
            "export DEBIAN_FRONTEND=noninteractive && "
            f"apt-get install -y -q {' '.join(shlex.quote(name) for name in names)}",
            check=False,
        )
        if code == 0:
            raise Failed(f"the update went through with the web refusing to start:\n{said[-6000:]}")
        if current_ui_release() != previous:
            raise Failed(f"a failed update left {current_ui_release()} current, not {previous}")
        _, state = run.on("mgr", "dpkg-query -W -f='${db:Status-Abbrev}' haprion-ui")
        if state.strip() != "iF":
            raise Failed(f"haprion-ui is {state.strip()!r} after a failed update, not 'iF'")
        _, marker = run.on("mgr", f"test ! -e {UPDATE_MARKER} && echo gone", check=False)
        if "gone" not in marker:
            raise Failed(f"a restored update left {UPDATE_MARKER} behind")
        the_web_answers("a failed update")
        compatible("a failed update was restored")
        packaged = packaged_release()
        schema_after = schema(packaged)

        run.on(
            "mgr",
            f"cat > {FAULT} && systemctl daemon-reload",
            stdin=FAULT_EVERY,
        )
        code, said = run.on(
            "mgr", "export DEBIAN_FRONTEND=noninteractive && dpkg --configure -a", check=False
        )
        if code == 0:
            raise Failed(f"the update went through with no release starting:\n{said[-6000:]}")
        if current_ui_release() != packaged:
            raise Failed(
                f"an update whose restore failed left {current_ui_release()} current, "
                f"not {packaged}"
            )
        _, state = run.on("mgr", "dpkg-query -W -f='${db:Status-Abbrev}' haprion-ui")
        if state.strip() != "iF":
            raise Failed(f"haprion-ui is {state.strip()!r} after a failed restore, not 'iF'")
        code, _ = run.on("mgr", f"test -e {UPDATE_MARKER}", check=False)
        if code != 0:
            raise Failed(f"an update whose restore failed left no {UPDATE_MARKER}")
        if "could not be restored" not in said:
            raise Failed(f"the update did not say the restore failed:\n{said[-6000:]}")

        run.on("mgr", f"rm -f {FAULT} && systemctl daemon-reload")
        run.on("mgr", "export DEBIAN_FRONTEND=noninteractive && dpkg --configure -a")
        all_configured("mgr", new_manager)
        if current_ui_release() != packaged:
            raise Failed(f"dpkg --configure -a left {current_ui_release()} current")
        _, marker = run.on("mgr", f"test ! -e {UPDATE_MARKER} && echo gone", check=False)
        if "gone" not in marker:
            raise Failed(f"a finished update left {UPDATE_MARKER} behind")
        if schema_before == schema_after:
            return f"no migration ran: the schema stayed at {schema_before}"
        return f"the schema moved from {schema_before} to {schema_after}"

    def the_manager_serves_after_it() -> None:
        the_web_answers("the update")
        compatible("the update")
        output = run.deploy()
        if "RESULT: OK" not in output:
            raise Failed(f"a deploy after the update did not succeed:\n{output}")
        run.wait_for_one_holder()
        run.answers_on_the_vip()

    def published_and_deployed() -> None:
        run.publish()
        run.deploy()

    released: list[str] = []

    def rolled_back_and_forward() -> None:
        """What the update prints as its way back, taken, and then the way forward again.

        26-10-28: the rollback to 0.99.2 was refused on the word of a release
        it no longer ran on; nothing had rolled back after an update before.
        """

        updated = current_ui_release()
        for to in (released[0], updated):
            run.on("mgr", f"/usr/sbin/haprion-rollback --to {shlex.quote(to)}")
            if current_ui_release() != to:
                raise Failed(f"haprion-rollback --to {to} left {current_ui_release()} current")
            the_web_answers(f"the rollback to {to}")
            compatible(f"the rollback to {to}")

    def the_schema_is_a_new_installations() -> str:
        """The schema the update leaves is the one a new installation gets (B436).

        A baseline replaces the migrations before it and keeps the last one's
        number, so an update from the release before runs none of them, only
        the migrations after the baseline: the database keeps the schema they
        made. What says the baseline makes the
        same is this. A database of its own on the same server is migrated from
        nothing by this release, and the two are dumped and compared, entry by
        entry: tables, indexes, constraints, functions, triggers, grants. The
        day partitions are left out, which the retention makes ahead on its
        own clock, and so are the owners: the migration role may reach only the
        installation's own database, so the second is migrated as postgres.
        """

        release = packaged_release()
        _, made = run.on("mgr", "mktemp -d")
        bundle = f"{made.strip()}/migration"
        url = "postgresql+psycopg://postgres@/schema_check?host=/var/run/postgresql"
        as_postgres = "runuser -u postgres -- "
        run.on(
            "mgr",
            f"cp -a /opt/haprion-ui/releases/{shlex.quote(release)}/migration {bundle}"
            f" && chmod -R a+rX {made.strip()}",
        )
        run.on("mgr", as_postgres + "psql -qtAX -c 'create database schema_check'")
        try:
            run.on("mgr", as_postgres + "psql -d schema_check -qtAX -c 'create extension pg_trgm'")
            _, owner = run.on(
                "mgr",
                as_postgres  # noqa: S608 - a constant query, no input in it
                + 'psql -d haprion -qtAX -c "select pg_get_userbyid(nspowner) from pg_namespace'
                " where nspname = 'public'\" 2>/dev/null",
            )
            statements = " ".join(public_schema_statements(owner.strip()))
            run.on(
                "mgr",
                as_postgres
                + f"psql -d schema_check -qtAX -v ON_ERROR_STOP=1 -c {shlex.quote(statements)}",
            )
            python = (
                f"$(readlink -f /opt/haprion-ui/releases/{shlex.quote(release)}/venv/bin/python)"
            )
            run.on(
                "mgr",
                f"cd {bundle} && {as_postgres}env PYTHONPATH={bundle}/lib"
                f" HAPRION_UI_DATABASE_URL='{url}' {python} -B -m alembic -c alembic.ini"
                " upgrade head",
            )
            _, upgraded = run.on("mgr", as_postgres + "pg_dump --schema-only --no-owner -d haprion")
            _, new = run.on("mgr", as_postgres + "pg_dump --schema-only --no-owner -d schema_check")
        finally:
            run.on(
                "mgr",
                as_postgres + "psql -qtAX -c 'drop database if exists schema_check'"
                f"; rm -rf {made.strip()}",
                check=False,
            )
        different = schema_difference(schema_entries(upgraded), schema_entries(new))
        if different:
            raise Failed(
                "the updated database's schema is not a new installation's:\n"
                + "\n".join(different[:40])
            )
        return f"{len(schema_entries(new))} schema entries, the same after the update as new"

    try:
        image = step("an empty server image", run.image)
        step("a manager and two nodes booted", lambda: run.start(image))
        step(
            f"the manager: {before}'s packages, haprion-setup",
            lambda: run.install_manager(old_manager),
        )
        blocks = [
            step(
                f"{role}: {before}'s package",
                functools.partial(run.prepare_node, role, old_node),
            )
            for role in NODES
        ]
        step("the cluster with both nodes", lambda: run.create_cluster(blocks[0]))
        step("the first deploy rolls out version 1", run.first_deploy_is_version_one)
        step(f"{NODES[1]} added", lambda: run.add_node(NODES[1], blocks[1]))
        step("an object published and deployed", published_and_deployed)
        released.append(current_ui_release())
        said = step(
            "the manager's update failed after its activation, undone, and run again",
            a_failed_update_is_undone_and_run_again,
        )
        print(f"      {said}")
        for role in NODES:
            step(
                f"{role} updated to this release with apt",
                functools.partial(upgraded, role, new_node),
            )
        step("the manager serves, deploys, and the object answers", the_manager_serves_after_it)
        step(f"haprion-rollback to {before}'s interface and forward again", rolled_back_and_forward)
        said = step(
            "the updated database's schema is a new installation's",
            the_schema_is_a_new_installations,
        )
        print(f"      {said}")
    except Failed as failure:
        print("FAILED")
        print()
        print(str(failure))
        run.save_logs()
        print(f"\n  The whole output of every machine is in {logs}")
        if keep:
            print(f"  The machines are left running: podman exec -it {run.container('mgr')} bash")
        else:
            run.remove()
        return False
    run.save_logs()
    if not keep:
        run.remove()
    print(f"  [{label}] updated from {before} and serving: {len(steps)} steps")
    return True


def main() -> int:
    parser = argparse.ArgumentParser(prog="install-test")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--packages", type=Path, help="a release's package files")
    source.add_argument("--apt-repo", type=Path, help="a site tools/build-apt-repo assembled")
    source.add_argument(
        "--url", help="the published repository, e.g. https://haprion.github.io/haprion/"
    )
    parser.add_argument("--distribution", choices=[*DISTRIBUTIONS, "all"], default="all")
    parser.add_argument("--logs", type=Path)
    parser.add_argument("--keep", action="store_true")
    parser.add_argument(
        "--scenario",
        choices=sorted(SCENARIOS),
        help="instead of the release run: one opt-in scenario (B481), with --packages",
    )
    #
    # A release's files are tested as an update as well, or it is said that
    # they are not: the chain is written per release, and an update left out
    # by omission is how 0.99.3 went out (26-10-28).
    #
    #
    # The scale scenario's measure (B482): the manager's spec is given in tiers
    # of objects, each from a run. The release run and the other scenarios keep
    # the product's own sizes.
    #
    sizing = parser.add_argument_group("the scale scenario (B482)")
    sizing.add_argument("--objects", type=int, default=SCALE_OBJECTS)
    sizing.add_argument("--object-kind", choices=("light", "heavy"), default="light")
    sizing.add_argument("--manager-cpus", default=MANAGER_SIZE[1])
    sizing.add_argument("--manager-memory", default=MANAGER_SIZE[3])
    sizing.add_argument("--node-cpus", default=NODE_SIZE[1])
    sizing.add_argument("--node-memory", default=NODE_SIZE[3])
    update = parser.add_mutually_exclusive_group()
    update.add_argument(
        "--upgrade-from", type=Path, help="the previous release's package files, updated from"
    )
    update.add_argument("--no-upgrade", action="store_true", help="test a new installation only")
    args = parser.parse_args()
    if args.packages and not (args.upgrade_from or args.no_upgrade):
        parser.error("--packages needs --upgrade-from <previous release's files> or --no-upgrade")
    if args.upgrade_from and not args.packages:
        parser.error("--upgrade-from updates to --packages")
    if args.scenario and not args.packages:
        parser.error("--scenario installs --packages")
    scale = Scale(
        args.objects,
        args.object_kind,
        args.manager_cpus,
        args.manager_memory,
        args.node_cpus,
        args.node_memory,
    )
    if scale != Scale() and args.scenario != "scale":
        parser.error("--objects, --object-kind, --manager-* and --node-* are for --scenario scale")
    if scale.objects < 100:
        parser.error("--objects is 100 or more")
    for cpus, memory in ((scale.cpus, scale.memory), (scale.node_cpus, scale.node_memory)):
        if not re.fullmatch(r"[1-9][0-9]*", cpus) or not re.fullmatch(r"[1-9][0-9]*g", memory):
            parser.error("--*-cpus is a whole number, --*-memory one with g (8g)")
    logs = args.logs or Path(tempfile.mkdtemp(prefix="haprion-install-test-"))
    chosen = list(DISTRIBUTIONS) if args.distribution == "all" else [args.distribution]
    if args.scenario:
        outcomes = {
            f"{name} {args.scenario}": run_scenario(
                args.scenario,
                DISTRIBUTIONS[name],
                args.packages.resolve(),
                args.upgrade_from.resolve() if args.upgrade_from else None,
                logs / f"{name}-{args.scenario}",
                args.keep,
                scale,
            )
            for name in chosen
        }
        print()
        for name, passed in outcomes.items():
            print(f"  {name}: {'PASSED' if passed else 'FAILED'}")
        return 0 if all(outcomes.values()) else 1
    results = {
        name: run_one(
            DISTRIBUTIONS[name],
            args.packages.resolve() if args.packages else None,
            args.apt_repo.resolve() if args.apt_repo else None,
            logs / name,
            args.keep,
            args.url if args.url is None or args.url.endswith("/") else args.url + "/",
        )
        for name in chosen
    }
    if args.upgrade_from:
        results |= {
            f"{name} upgrade": run_upgrade(
                DISTRIBUTIONS[name],
                args.upgrade_from.resolve(),
                args.packages.resolve(),
                logs / f"{name}-upgrade",
                args.keep,
            )
            for name in chosen
        }
    print()
    for name, passed in results.items():
        print(f"  {name}: {'PASSED' if passed else 'FAILED'}")
    return 0 if all(results.values()) else 1


if __name__ == "__main__":
    sys.exit(main())
