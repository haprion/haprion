#!/usr/bin/env python3
"""A whole installation on empty machines, in containers: the release's acceptance.

    tools/install-test --packages <dir> | --apt-repo <site> | --url <published site>
                       --distribution debian13|ubuntu26.04|all [--keep] [--logs <dir>]

Every new installation found its faults one at a time on a lab VM (Fas 18:
a missing dependency, a step that could not be rerun, a check that refused a
new installation) because nothing ran the installation the way an operator
does before a release. This does, on machines that have nothing but systemd
and sshd - so a package that leans on something a test machine happened to
have fails here, not on a person's first node:

  * a manager and two nodes per distribution, rootless podman, systemd as PID 1,
    on a network of their own (RFC 5737 addresses)
  * the manager: the CLI and UI packages with apt, then `haprion-setup` as the
    UI package installs it - no source tree on the machine
  * each node: the node package with apt and nothing else - its postinst
    prints the block, with the node's one-time key (B317)
  * `haprion-cluster add` with both blocks, which joins both nodes over SSH,
    an object published with `haprion-objects apply`, `haprion-deploy`
  * then what an operator checks: keepalived running on both, the virtual
    address on exactly one, the object answering there, the address moving
    when its holder's keepalived stops and staying where it went when that
    comes back, and a second deploy that changes nothing

The packages are the ones a release ships. With `--packages`, the files in one
directory, as a person installs them from a release: `haprion-cli`, each
distribution's `haprion-ui` and `haprion-certbot`, the WAF engine's
`haprion-coraza-spoa` and `haprion-crs` and `haprion-archive-keyring` on the
manager, and the node package with the engine and the key on each node. With
`--apt-repo`, a site `tools/build-apt-repo` assembled, as the public
instructions install it: the key and the source, then `apt install
haprion-ui` and `apt install haprion-node` - so a dependency the repository
does not resolve fails here (B325). With `--url`, the published repository,
added word for word as docs/install.md does it: curl, the real key fetched
from the site (refused unless it is the key in this tree), the source over
https - and afterwards the key file belongs to haprion-archive-keyring.

Not here: syslog objects' IPVS (a rootless container may not load the kernel
table; measured 26-10-15), certbot's dry-run renewal (it asks Let's Encrypt's
staging server; with no lineage it renews nothing), and the web interface's
pages - the CLI drives the same root helpers.
"""

from __future__ import annotations

import argparse
import functools
import json
import re
import shlex
import subprocess
import sys
import tempfile
import time
from collections.abc import Callable
from dataclasses import dataclass
from pathlib import Path
from typing import Any, ClassVar, TypeVar

T = TypeVar("T")
PODMAN = "podman"
REPO_DIR = "/srv/haprion-repo"
SITE_KEY = "haprion-archive-keyring.asc"
#
# A site built here is signed with a key of the test's own, not the
# repository's (which only CI holds), so its key goes where
# haprion-archive-keyring - installed with the rest - does not replace it.
#
KEYRING = "/etc/apt/keyrings/haprion-install-test.asc"
#
# Where docs/install.md has a person put the published repository's key; the
# keyring package then owns the same path.
#
PUBLISHED_KEYRING = "/usr/share/keyrings/haprion-archive-keyring.asc"
TREE_KEY = Path(__file__).resolve().parents[1] / "keys/haprion-archive.asc"
CLUSTER = "alpha"
OBJECT = """\
schema: 1
name: shop
hostnames: [shop.example.com]
listen:
  protocol: http
routes:
  - path: /
    backend: web
backends:
  web:
    balance: roundrobin
    health:
      type: disabled
    servers:
      - host: {backend}
        port: 9080
"""
BACKEND_BODY = "install-test backend"
#
# Two units a container cannot run, and the kernel filesystems it cannot
# mount: masked, so that a failed unit after boot is the product's.
#
CONTAINER_UNITS = (
    "sys-kernel-config.mount",
    "sys-kernel-debug.mount",
    "sys-kernel-tracing.mount",
    "proc-sys-fs-binfmt_misc.automount",
    "systemd-modules-load.service",
)
#
# A server as a distribution installs it, and nothing more: systemd and sshd.
# Docker's images forbid starting services from a package's scripts
# (policy-rc.d) and carry one set of host keys for every container; a real
# machine does neither, so both are undone.
#
CONTAINERFILE = """\
FROM {image}
RUN apt-get update -q \\
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends \\
      systemd systemd-sysv openssh-server \\
 && apt-get clean && rm -rf /var/lib/apt/lists/* \\
 && rm -f /usr/sbin/policy-rc.d /etc/ssh/ssh_host_* \\
 && systemctl mask {masked} \\
 && printf '%s\\n' '[Unit]' 'Description=This machine'"'"'s SSH host keys' \\
      'Before=ssh.service ssh.socket' 'ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key' \\
      '[Service]' 'Type=oneshot' 'ExecStart=/usr/bin/ssh-keygen -A' \\
      '[Install]' 'WantedBy=multi-user.target' > /etc/systemd/system/ssh-host-keys.service \\
 && systemctl enable ssh-host-keys.service
CMD ["/sbin/init"]
"""


@dataclass(frozen=True)
class Distribution:
    name: str
    image: str
    ui_suffix: str
    subnet: str


DISTRIBUTIONS = {
    "debian13": Distribution("debian13", "docker.io/library/debian:13", "~deb13", "198.51.100"),
    "ubuntu26.04": Distribution(
        "ubuntu26.04", "docker.io/library/ubuntu:26.04", "~ubuntu26.04", "203.0.113"
    ),
}
NODES = ("node-a", "node-b")


class Failed(Exception):
    """A step that did not do what it says; the message is what it printed."""


class Run:
    def __init__(self, distribution: Distribution, logs: Path) -> None:
        self.distribution = distribution
        self.logs = logs
        self.prefix = f"haprion-it-{distribution.name.replace('.', '')}"
        self.network = self.prefix
        self.step = 0

    # --- the machines -------------------------------------------------------

    def container(self, role: str) -> str:
        return f"{self.prefix}-{role}"

    def address(self, role: str) -> str:
        last = {"mgr": 10, "node-a": 11, "node-b": 12, "vip": 20}[role]
        return f"{self.distribution.subnet}.{last}"

    def podman(self, *arguments: str, check: bool = True, stdin: str | None = None) -> str:
        done = subprocess.run(  # noqa: S603 - podman with arguments built here
            [PODMAN, *arguments], input=stdin, capture_output=True, text=True, check=False
        )
        if check and done.returncode != 0:
            raise Failed(f"podman {' '.join(arguments[:3])}: {done.stderr.strip()}")
        return done.stdout

    def on(
        self, role: str, command: str, *, stdin: str | None = None, check: bool = True
    ) -> tuple[int, str]:
        """A shell command on one machine, as root; its output goes to the log too."""

        done = subprocess.run(  # noqa: S603 - podman exec of a command built here
            [PODMAN, "exec", "-i", self.container(role), "/bin/bash", "-c", command],
            input=stdin,
            capture_output=True,
            text=True,
            check=False,
        )
        output = done.stdout + done.stderr
        with (self.logs / f"{role}.log").open("a") as log:
            log.write(f"\n### {command}\n{output}")
        if check and done.returncode != 0:
            raise Failed(f"{role}: `{command}` exited {done.returncode}\n{output[-6000:]}")
        return done.returncode, output

    def heading(self, title: str) -> None:
        self.step += 1
        print(f"  [{self.distribution.name} {self.step:2d}] {title} ... ", end="", flush=True)

    def remove(self) -> None:
        for role in ("mgr", *NODES):
            self.podman("rm", "-f", "-t", "1", self.container(role), check=False)
        self.podman("network", "rm", "-f", self.network, check=False)

    def image(self) -> str:
        tag = f"localhost/haprion-install-test:{self.distribution.name}"
        containerfile = CONTAINERFILE.format(
            image=self.distribution.image, masked=" ".join(CONTAINER_UNITS)
        )
        with tempfile.TemporaryDirectory() as context:
            (Path(context) / "Containerfile").write_text(containerfile)
            self.podman("build", "-q", "--pull=newer", "-t", tag, context)
        return tag

    def start(self, image: str) -> None:
        self.remove()
        self.podman(
            "network", "create", "--subnet", f"{self.distribution.subnet}.0/24", self.network
        )
        for role in ("mgr", *NODES):
            self.podman(
                "run",
                "-d",
                "--name",
                self.container(role),
                "--hostname",
                role,
                "--network",
                self.network,
                "--network-alias",
                role,
                "--ip",
                self.address(role),
                "--privileged",
                "--systemd=always",
                image,
            )
        for role in ("mgr", *NODES):
            _, state = self.on(role, "systemctl is-system-running --wait", check=False)
            if state.strip() == "running":
                continue
            #
            # Degraded with no failed unit is systemd's taint, not a fault:
            # Ubuntu's image keeps /usr/sbin apart from /usr/bin
            # (`unmerged-bin`, measured 26-10-15).
            #
            _, failed = self.on(role, "systemctl --failed --no-legend", check=False)
            if failed.strip():
                raise Failed(f"{role} booted {state.strip()}:\n{failed}")
        #
        # A real machine has its host keys from its installation. The image's
        # unit makes them at boot, and on 26-10-16 one container of three came
        # up without it ever starting (twice, Ubuntu 26.04, node-b): the
        # package then rightly refused to print a block. Made here when
        # missing, and said so in the log.
        #
        for role in ("mgr", *NODES):
            self.on(
                role,
                "test -s /etc/ssh/ssh_host_ed25519_key.pub "
                "|| { echo 'host keys missing after boot; made with ssh-keygen -A'; ssh-keygen -A; }",
            )

    # --- the installation ---------------------------------------------------

    def copy(self, role: str, path: Path) -> str:
        self.on(role, "mkdir -p /root/install")
        self.podman("cp", str(path), f"{self.container(role)}:/root/install/{path.name}")
        return f"/root/install/{path.name}"

    def add_repository(self, role: str, site: Path) -> None:
        """The source and its key, as docs/install.md has a person write them."""

        self.podman("cp", str(site), f"{self.container(role)}:{REPO_DIR}")
        suite = self.distribution.ui_suffix.removeprefix("~")
        source = (
            f"Types: deb\nURIs: file:{REPO_DIR}\nSuites: {suite}\nComponents: main\n"
            f"Signed-By: {KEYRING}\n"
        )
        self.on(
            role,
            f"chmod -R a+rX {REPO_DIR} && install -D -m 0644 {REPO_DIR}/{SITE_KEY} {KEYRING} "
            f"&& printf %s {shlex.quote(source)} > /etc/apt/sources.list.d/haprion.sources",
        )

    def add_published_repository(self, role: str, url: str) -> None:
        """The published source and its key, word for word as docs/install.md has them."""

        suite = self.distribution.ui_suffix.removeprefix("~")
        source = (
            f"Types: deb\nURIs: {url}\nSuites: {suite}\nComponents: main\n"
            f"Signed-By: {PUBLISHED_KEYRING}\n"
        )
        self.on(
            role,
            "export DEBIAN_FRONTEND=noninteractive && apt-get update -q && apt-get install -y -q curl "
            f"&& curl -fsSLo {PUBLISHED_KEYRING} {shlex.quote(url + SITE_KEY)} "
            f"&& printf %s {shlex.quote(source)} > /etc/apt/sources.list.d/haprion.sources",
        )
        _, key = self.on(role, f"cat {PUBLISHED_KEYRING}")
        if key != TREE_KEY.read_text():
            raise Failed(f"{url}{SITE_KEY} is not the key in this tree ({TREE_KEY.name})")

    def key_belongs_to_the_package(self, role: str) -> None:
        _, owner = self.on(role, f"dpkg -S {PUBLISHED_KEYRING}")
        if not owner.startswith("haprion-archive-keyring:"):
            raise Failed(f"{PUBLISHED_KEYRING} is not haprion-archive-keyring's: {owner}")

    def names(
        self,
        role: str,
        packages: list[Path] | None,
        site: Path | None,
        package: str,
        url: str | None = None,
    ) -> list[str]:
        if url is not None:
            self.add_published_repository(role, url)
            return [package]
        if site is not None:
            self.add_repository(role, site)
            return [package]
        if packages is None:
            raise Failed("neither package files nor a repository")
        return [self.copy(role, path) for path in packages]

    def install_manager(
        self, packages: list[Path] | None, site: Path | None = None, url: str | None = None
    ) -> None:
        names = self.names("mgr", packages, site, "haprion-ui", url)
        self.on(
            "mgr",
            "export DEBIAN_FRONTEND=noninteractive && apt-get update -q "
            f"&& apt-get install -y -q {' '.join(shlex.quote(name) for name in names)}",
        )
        if url is not None:
            self.key_belongs_to_the_package("mgr")
        #
        # The probe's socket on, which the defaults leave off: the probe helper's
        # unit is asked through it below, on a real manager (5-15).
        #
        _, output = self.on("mgr", "PROBE_SOCKET=yes haprion-setup")
        if "The manager is installed" not in output:
            raise Failed(f"haprion-setup ended without saying the manager is installed:\n{output}")

    def prepare_node(
        self,
        role: str,
        packages: list[Path] | None,
        site: Path | None = None,
        url: str | None = None,
    ) -> str:
        """The node package with what it depends on, installed as a person would, and the block printed."""

        names = self.names(role, packages, site, "haprion-node", url)
        _, output = self.on(
            role,
            "export DEBIAN_FRONTEND=noninteractive && apt-get update -q "
            f"&& apt-get install -y -q {' '.join(shlex.quote(name) for name in names)}",
        )
        block = re.search(r"^((?:haprion|haproxy)-node-v2:\S+)$", output, re.M)
        if not block:
            raise Failed(f"the node package printed no enrollment block:\n{output[-3000:]}")
        if url is not None:
            self.key_belongs_to_the_package(role)
        return block.group(1)

    def joined_quietly(self) -> None:
        """Step 4, run by the join, warned of nothing on an empty node."""

        for role in NODES:
            _, log = self.on(role, "cat /var/log/haprion-node/join.log")
            warnings = [line for line in log.splitlines() if line.startswith("WARNING")]
            if warnings:
                raise Failed(f"{role}: the join warned on an empty node:\n" + "\n".join(warnings))

    def create_cluster(self, block: str) -> None:
        """The cluster with its first node: its first version is published with it (B318)."""

        _, output = self.on(
            "mgr",
            f"haprion-cluster add -c {CLUSTER} --display-name Alpha --vip {self.address('vip')} "
            f"--node-path {CLUSTER} --host {NODES[0]}",
            stdin=block + "\n",
        )
        if "Published as version 1;" not in output:
            raise Failed(f"the new cluster's first version was not published:\n{output}")

    def first_deploy_is_version_one(self) -> None:
        self.deploy()
        target = (self.status().get("result") or {}).get("summary", {}).get("target") or {}
        if target.get("version") != 1:
            raise Failed(f"the first deploy did not roll out version 1: {target}")

    def add_node(self, role: str, block: str) -> None:
        """A node added to a cluster that is serving: the node list is the next version."""

        _, output = self.on(
            "mgr", f"haprion-node add -c {CLUSTER} --host {role}", stdin=block + "\n"
        )
        if "Published as version 2;" not in output:
            raise Failed(f"adding {role} published no new version:\n{output}")

    def a_node_reads_its_own_cluster_alone(self) -> None:
        """B358: each fetch key reads its own cluster's files, from its own address.

        Another cluster's tree and certificate directory are made beside this
        one's, as a second cluster would have them, and each node fetches
        through real sshd and rrsync with its own keys.
        """

        _, policy = self.on("mgr", "cat /etc/haprion/runtime-policy.yaml")
        roots = dict(re.findall(r"^(publish_root|certificate_root): (\S+)$", policy, re.M))
        publish, certificates = roots["publish_root"], roots["certificate_root"]
        for account, purpose, root in (
            ("_haprion-pull", "config pull", publish),
            ("_haprion-cert-pull", "certificate pull", certificates),
        ):
            _, keys = self.on("mgr", f"cat /home/{account}/.ssh/authorized_keys")
            for role in NODES:
                line = next(
                    (line for line in keys.splitlines() if line.endswith(f" {role} {purpose}")),
                    "",
                )
                if not line.startswith('from="') or f'-ro {root}/{CLUSTER}"' not in line:
                    raise Failed(f"{role}'s {purpose} line is not its cluster's alone:\n{keys}")
        self.on(
            "mgr",
            "set -e; "
            f"group=$(stat -c %G {certificates}); "
            f"install -d -o root -g _haprion-pull -m 750 {publish}/other; "
            f"install -o root -g _haprion-pull -m 640 /dev/stdin {publish}/other/other.cfg <<< x; "
            f'install -d -o root -g "$group" -m 750 {certificates}/other {certificates}/{CLUSTER}; '
            f'install -o root -g "$group" -m 640 /dev/stdin {certificates}/other/other.pem <<< x; '
            f'install -o root -g "$group" -m 640 /dev/stdin {certificates}/{CLUSTER}/own.pem <<< x',
        )
        script = (
            "set -u; . /etc/haprion/node.conf; rm -rf /tmp/fetched; mkdir /tmp/fetched; "
            'fetch() { rsync -r --timeout=30 -e "ssh -i $1 -o BatchMode=yes '
            '-o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=10" '
            '"$2@${MANAGER}:$3" /tmp/fetched/ >/dev/null 2>&1; }; '
            'fetch "$CONFIG_PULL_KEY" "$CONFIG_PULL_USER" "$CONFIG_REMOTE_PATH" '
            "|| echo 'MISSING own tree'; "
            'fetch "$CERT_PULL_KEY" "$CERT_PULL_USER" own.pem || echo "MISSING own.pem"; '
            "for path in other/ ../other/ /etc/; do "
            'fetch "$CONFIG_PULL_KEY" "$CONFIG_PULL_USER" "$path" && echo "LEAK config $path"; '
            "done; "
            "for path in other/other.pem ../other/other.pem /etc/hostname; do "
            'fetch "$CERT_PULL_KEY" "$CERT_PULL_USER" "$path" && echo "LEAK certificate $path"; '
            "done; "
            "find /tmp/fetched -name 'other.*' -printf 'LEAK %p\\n'; true"
        )
        try:
            for role in NODES:
                _, output = self.on(role, script)
                wrong = [
                    line for line in output.splitlines() if line.startswith(("LEAK", "MISSING"))
                ]
                if wrong:
                    raise Failed(f"{role}'s fetch keys:\n" + "\n".join(wrong))
        finally:
            self.on(
                "mgr",
                f"rm -rf {publish}/other {certificates}/other {certificates}/{CLUSTER}/own.pem",
            )

    def publish(self) -> None:
        self.on(
            "mgr",
            "mkdir -p /srv/install-test && printf '%s\\n' "
            f"{shlex.quote(BACKEND_BODY)} > /srv/install-test/index.html "
            "&& systemd-run --unit install-test-backend --property=Restart=always "
            "/usr/bin/python3 -m http.server 9080 --directory /srv/install-test",
        )
        self.on(
            "mgr",
            "mkdir -p /root/install/objects && cat > /root/install/objects/shop.yaml",
            stdin=OBJECT.format(backend=self.address("mgr")),
        )
        self.on(
            "mgr", f"haprion-objects apply -c {CLUSTER} /root/install/objects -m 'install test'"
        )

    def deploy(self) -> str:
        _, output = self.on("mgr", f"haprion-deploy -c {CLUSTER}")
        return output

    # --- what an operator checks --------------------------------------------

    def holders(self) -> list[str]:
        vip = self.address("vip")
        found = []
        for role in NODES:
            _, addresses = self.on(role, "ip -4 -o addr show")
            if f" {vip}/" in addresses:
                found.append(role)
        return found

    def wait_for_one_holder(self, seconds: int = 20) -> str:
        deadline = time.monotonic() + seconds
        holders: list[str] = []
        while time.monotonic() < deadline:
            holders = self.holders()
            if len(holders) == 1:
                return holders[0]
            time.sleep(1)
        raise Failed(f"the virtual address is held by {holders or 'no node'} after {seconds} s")

    def answers_on_the_vip(self) -> None:
        _, body = self.on(
            "mgr",
            f"curl -fsS --max-time 5 -H 'Host: shop.example.com' http://{self.address('vip')}/",
        )
        if BACKEND_BODY not in body:
            raise Failed(f"the virtual address answered something else:\n{body}")

    def traffic_log_reaches_the_manager(self, holder: str) -> None:
        """A base function (Fas 18, 26-10-16): on from setup and the join, nothing by hand."""

        _, config = self.on("mgr", "cat /etc/haprion/ui.toml")
        if not re.search(r"^\[traffic_logs\]\nenabled = true$", config, re.M):
            raise Failed(f"setup left the traffic log page off:\n{config}")
        self.answers_on_the_vip()
        _, lines = self.on(
            holder, "cat /var/log/haprion/traffic-*.jsonl 2>/dev/null || true", check=False
        )
        if "shop.example.com" not in lines:
            raise Failed(f"{holder} wrote no traffic record for the request:\n{lines[-2000:]}")
        self.on("mgr", "systemctl start haprion-traffic-collector.service")
        _, count = self.on(
            "mgr",
            "sudo -u postgres psql -d haprion -tAc "
            "\"select count(*) from traffic_log where host = 'shop.example.com'\"",
        )
        if int(count.strip() or 0) < 1:
            raise Failed("the collector imported no record from the nodes")

    def a_probe_answers_through_the_helper_socket(self) -> None:
        """The probe helper's unit as the interface reaches it, holding no capability (5-15).

        Root, but with an empty capability set: it reads root's own files and
        opens ssh connections, neither of which needs one. Asked over its
        socket, as the web asks it, so the unit's sandbox is what is proved.
        """

        target = {
            "host": self.address("mgr"),
            "port": 9080,
            "type": "tcp",
            "tls": False,
            "verify": False,
            "min_version": "",
            "path": "/",
            "host_header": "",
        }
        script = (
            "import sys, uuid; sys.path.insert(0, '/opt/haprion/current/lib'); "
            "from haprion.probe_socket import ask, build_request; "
            f"print(ask(build_request({CLUSTER!r}, str(uuid.uuid4()), [{target!r}])))"
        )
        _, answer = self.on("mgr", f"/usr/bin/python3 -I -c {shlex.quote(script)}")
        document = json.loads(answer)
        results = [
            result
            for node in (document.get("result") or {}).get("nodes", [])
            for result in node.get("results", [])
        ]
        if document.get("outcome") != "done" or not results or not all(r["ok"] for r in results):
            raise Failed(f"the probe through its socket did not reach the backend:\n{answer}")

    #
    # What each function the product offers needs on each machine, and the
    # command that proves it is there (B322, Fas 18 26-10-17). The WAF engine,
    # certbot and the Location database were never in the packages, and every
    # lab round passed without them: the gate asked whether what the packages
    # carry works, never whether every function does.
    #
    NEEDS: ClassVar[dict[str, tuple[tuple[str, str], ...]]] = {
        "mgr": (
            ("the WAF engine", "test -x /usr/sbin/coraza-spoa"),
            (
                "the WAF rule set",
                "dpkg-query -W -f='${Status}' haprion-crs | grep -q 'ok installed'",
            ),
            ("certbot", "/opt/haprion-certbot/current/venv/bin/certbot --version"),
            (
                "the hook that publishes a renewed certificate",
                "test -x /etc/letsencrypt/renewal-hooks/deploy/50-haprion",
            ),
            (
                "the Location database",
                "python3 -c 'import location' && test -r /var/lib/location/database.db",
            ),
            ("PostgreSQL 18", "pg_lsclusters --no-header | awk '{print $1}' | grep -qx 18"),
        ),
        "node": (("the WAF engine", "test -x /usr/sbin/coraza-spoa"),),
    }

    def every_function_has_what_it_needs(self) -> None:
        missing = [
            f"{role}: {what}"
            for role in ("mgr", *NODES)
            for what, command in self.NEEDS["mgr" if role == "mgr" else "node"]
            if self.on(role, command, check=False)[0] != 0
        ]
        if missing:
            raise Failed("missing after installation:\n  " + "\n  ".join(missing))

    def services_running(self) -> None:
        for role in NODES:
            self.on(role, "systemctl is-active haproxy keepalived")

    def status(self) -> dict[str, Any]:
        _, output = self.on("mgr", f"haprion-status -c {CLUSTER} --json", check=False)
        return dict(json.loads(output))

    def statistics_reported(self) -> None:
        """Every node reads its HAProxy's statistics: the dashboard's numbers.

        A new cluster's core once opened no status socket, and every node of
        it read *Stats unavailable* while serving (Fas 18 finding 53).
        """

        nodes = self.status()["result"]["nodes"]
        silent = [
            node["name"]
            for node in nodes
            if not (isinstance(node.get("status"), dict) and node["status"].get("stats_ok"))
        ]
        if silent or len(nodes) != len(NODES):
            raise Failed(f"no statistics from {silent or 'the missing nodes'}")

    def save_logs(self) -> None:
        for role in ("mgr", *NODES):
            self.on(role, "journalctl -b --no-pager -p warning", check=False)
        self.on("mgr", "cat /var/log/haprion/setup.log", check=False)
        for role in NODES:
            self.on(role, "cat /var/log/haprion-node/*.log", check=False)


def package(directory: Path, pattern: str) -> Path:
    found = sorted(directory.glob(pattern))
    if len(found) != 1:
        raise SystemExit(f"install-test: expected one {pattern} in {directory}, found {len(found)}")
    return found[0]


def run_one(
    distribution: Distribution,
    packages: Path | None,
    site: Path | None,
    logs: Path,
    keep: bool,
    url: str | None = None,
) -> bool:
    manager_files = node_files = None
    if packages is not None:
        key = package(packages, "haprion-archive-keyring_*_all.deb")
        engine = package(packages, "haprion-coraza-spoa_*_amd64.deb")
        manager_files = [
            package(packages, "haprion-cli_*_all.deb"),
            package(packages, f"haprion-ui_*{distribution.ui_suffix}_amd64.deb"),
            package(packages, f"haprion-certbot_*{distribution.ui_suffix}_amd64.deb"),
            engine,
            package(packages, "haprion-crs_*_all.deb"),
            key,
        ]
        node_files = [engine, key, package(packages, "haprion-node_*_all.deb")]
    logs.mkdir(parents=True, exist_ok=True)
    run = Run(distribution, logs)
    steps: list[str] = []

    def step(title: str, action: Callable[[], T]) -> T:
        run.heading(title)
        started = time.monotonic()
        result = action()
        print(f"ok ({time.monotonic() - started:.0f} s)")
        steps.append(title)
        return result

    try:
        image = step("an empty server image", run.image)
        step("a manager and two nodes booted", lambda: run.start(image))
        step(
            "the manager: packages, haprion-setup",
            lambda: run.install_manager(manager_files, site, url),
        )
        blocks = [
            step(
                f"{role}: the package, and the block it printed",
                functools.partial(run.prepare_node, role, node_files, site, url),
            )
            for role in NODES
        ]
        step(
            f"haprion-cluster add with {NODES[0]}: joined, version 1 published",
            lambda: run.create_cluster(blocks[0]),
        )
        step("the first deploy rolls out version 1", run.first_deploy_is_version_one)
        step(
            f"haprion-node add {NODES[1]}: joined, version 2 published",
            lambda: run.add_node(NODES[1], blocks[1]),
        )
        step("the joins warned of nothing", run.joined_quietly)
        step(
            "each node's keys read its own cluster alone, from its own address",
            run.a_node_reads_its_own_cluster_alone,
        )
        step("every function has what it needs", run.every_function_has_what_it_needs)
        step("an object published", run.publish)

        def added_node_starts_as_standby() -> None:
            """B320, Fas 18 finding 75: the added node deploys after the owner and never leads.

            Deployed first, it started keepalived before the owner had it as a
            peer and became MASTER beside it when the owner's deploy was slow.
            The order is what is held to; the journal says it held.
            """

            output = run.deploy()
            order = re.findall(r"^=== Deploy: (\S+) ===$", output, re.MULTILINE)
            if order != [NODES[0], NODES[1]]:
                raise Failed(
                    f"the deploy went {order}, not the owner before the added node:\n{output}"
                )
            _, log = run.on(NODES[1], "journalctl -u keepalived --no-pager -o cat", check=False)
            if "Entering BACKUP STATE" not in log:
                raise Failed(f"{NODES[1]}'s keepalived did not start as a standby:\n{log}")
            if "Entering MASTER STATE" in log:
                raise Failed(f"{NODES[1]} took the address when it was added:\n{log}")

        step(
            f"haprion-deploy: {NODES[1]}, added to a serving cluster, after the owner and as a standby",
            added_node_starts_as_standby,
        )
        step("haproxy and keepalived running on both nodes", run.services_running)
        step("both nodes report HAProxy's statistics", run.statistics_reported)
        holder = step("the virtual address on exactly one node", run.wait_for_one_holder)
        step("the object answers on the virtual address", run.answers_on_the_vip)
        step(
            "a probe answers through the helper's socket",
            run.a_probe_answers_through_the_helper_socket,
        )
        step(
            "the traffic log reaches the manager",
            lambda: run.traffic_log_reaches_the_manager(holder),
        )

        def failover() -> None:
            run.on(holder, "systemctl stop keepalived")
            other = run.wait_for_one_holder()
            if other == holder:
                raise Failed(f"the address stayed on {holder} with its keepalived stopped")
            run.answers_on_the_vip()
            run.on(holder, "systemctl start keepalived")
            time.sleep(5)
            if run.wait_for_one_holder() != other:
                raise Failed(f"the address went back to {holder}; nopreempt should keep it")

        step("the address moves when its holder stops, and stays", failover)

        def converged() -> None:
            output = run.deploy()
            if output.count("already runs this version; nothing to do") != len(NODES):
                raise Failed(f"a second deploy did not skip the current nodes:\n{output}")

        step("a second deploy changes nothing", converged)

        def removed_steps_down() -> tuple[str, str]:
            """B319, Fas 18 finding 73: a removed node left running took the address."""

            holder = run.wait_for_one_holder()
            leaving = next(role for role in NODES if role != holder)
            _, output = run.on("mgr", f"haprion-node remove -c {CLUSTER} {leaving} --deploy")
            if "stopped keepalived and HAProxy" not in output:
                raise Failed(f"removing {leaving} did not say it stepped down:\n{output}")
            #
            # B321: converged before, so the removal is deployed with it.
            #
            if f"=== Deploy: {holder} ===" not in output or "RESULT: OK" not in output:
                raise Failed(f"the removal was not deployed with it:\n{output}")
            _, active = run.on(leaving, "systemctl is-active haproxy keepalived", check=False)
            _, enabled = run.on(leaving, "systemctl is-enabled haproxy keepalived", check=False)
            if active.split() != ["inactive", "inactive"] or enabled.split() != [
                "disabled",
                "disabled",
            ]:
                raise Failed(f"{leaving} still runs or starts at boot:\n{active}\n{enabled}")
            time.sleep(8)
            if run.holders() != [holder]:
                raise Failed(f"after the removal the address is on {run.holders()}")
            run.answers_on_the_vip()
            return holder, leaving

        holder, leaving = step(
            "haprion-node remove --deploy: the node steps down, the rest is deployed, "
            "the address stays on one node",
            removed_steps_down,
        )

        def added_back_and_deployed() -> None:
            """B321 and B320: added back with --deploy, after the owner, as a standby."""

            _, since = run.on(leaving, "date +%s")
            _, printed = run.on(leaving, "haprion-node-key --again")
            block = re.search(r"^((?:haprion|haproxy)-node-v2:\S+)$", printed, re.M)
            if not block:
                raise Failed(f"haprion-node-key --again printed no block:\n{printed}")
            _, output = run.on(
                "mgr",
                f"haprion-node add -c {CLUSTER} --host {leaving} --deploy",
                stdin=block.group(1) + "\n",
            )
            order = re.findall(r"^=== Deploy: (\S+) ===$", output, re.MULTILINE)
            if order[-2:] != [holder, leaving] or "RESULT: OK" not in output:
                raise Failed(f"the addition was not deployed after the owner:\n{output}")
            _, log = run.on(
                leaving,
                f"journalctl -u keepalived --no-pager -o cat --since @{since.strip()}",
                check=False,
            )
            if "Entering BACKUP STATE" not in log or "Entering MASTER STATE" in log:
                raise Failed(f"{leaving} did not start as a standby:\n{log}")
            if run.holders() != [holder]:
                raise Failed(f"after the addition the address is on {run.holders()}")
            run.answers_on_the_vip()

        step(
            "haprion-node add --deploy: certificates and configuration, the node a standby",
            added_back_and_deployed,
        )
    except Failed as failure:
        print("FAILED")
        print()
        print(str(failure))
        run.save_logs()
        print(f"\n  The whole output of every machine is in {logs}")
        if keep:
            print(f"  The machines are left running: podman exec -it {run.container('mgr')} bash")
        else:
            run.remove()
        return False
    run.save_logs()
    if not keep:
        run.remove()
    print(f"  [{distribution.name}] installed and serving: {len(steps)} steps")
    return True


def main() -> int:
    parser = argparse.ArgumentParser(prog="install-test")
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--packages", type=Path, help="a release's package files")
    source.add_argument("--apt-repo", type=Path, help="a site tools/build-apt-repo assembled")
    source.add_argument(
        "--url", help="the published repository, e.g. https://haprion.github.io/haprion/"
    )
    parser.add_argument("--distribution", choices=[*DISTRIBUTIONS, "all"], default="all")
    parser.add_argument("--logs", type=Path)
    parser.add_argument("--keep", action="store_true")
    args = parser.parse_args()
    logs = args.logs or Path(tempfile.mkdtemp(prefix="haprion-install-test-"))
    chosen = list(DISTRIBUTIONS) if args.distribution == "all" else [args.distribution]
    results = {
        name: run_one(
            DISTRIBUTIONS[name],
            args.packages.resolve() if args.packages else None,
            args.apt_repo.resolve() if args.apt_repo else None,
            logs / name,
            args.keep,
            args.url if args.url is None or args.url.endswith("/") else args.url + "/",
        )
        for name in chosen
    }
    print()
    for name, passed in results.items():
        print(f"  {name}: {'PASSED' if passed else 'FAILED'}")
    return 0 if all(results.values()) else 1


if __name__ == "__main__":
    sys.exit(main())
