    # --- the API ------------------------------------------------------------

    def api_token(self, name: str, *flags: str) -> str:
        """A token made on the manager; its secret stays in root-only files there.

        Returns the path of the header file `curl -H @` reads, so that neither
        the command nor the log of this run ever holds the secret.
        """

        header = f"/root/api-{name}.header"
        self.on(
            "mgr",
            f"umask 077 && haprion-api-token add {name} {' '.join(flags)} --days 1 "
            f"> /root/api-{name}.secret 2>/dev/null "
            f"&& printf 'Authorization: Bearer %s\\n' \"$(cat /root/api-{name}.secret)\" > {header}",
        )
        return header

    def api(
        self,
        header: str,
        method: str,
        path: str,
        body: str | None = None,
        *,
        key: bool = False,
    ) -> tuple[int, dict[str, Any], int]:
        """One call through nginx: the status, the answer's JSON and its Retry-After (0 for none)."""

        extra = '-H "Idempotency-Key: $(cat /proc/sys/kernel/random/uuid)" ' if key else ""
        json_body = body is not None and body.lstrip().startswith("{")
        data = "--data-binary @- " if body else ""
        data = "-H 'Content-Type: application/json' " + data if json_body else data
        _, output = self.on(
            "mgr",
            f"h=$(mktemp); b=$(curl -sSk -X {method} -H @{header} {extra}{data}-D $h "
            f"-w '\\n%{{http_code}}' https://127.0.0.1/api/v1{path}); "
            "printf '%s\\n' \"$b\"; grep -i '^retry-after:' $h || true; rm -f $h",
            stdin=body,
        )
        lines = [line.strip() for line in output.splitlines() if line.strip()]
        wait = 0
        if lines and lines[-1].lower().startswith("retry-after:"):
            wait = int(lines.pop().partition(":")[2])
        try:
            document = json.loads("\n".join(lines[:-1]))
        except ValueError:
            document = {}
        return int(lines[-1]), document if isinstance(document, dict) else {}, wait

    def api_write(
        self, header: str, method: str, path: str, body: str | None = None, deadline: float = 300
    ) -> int:
        """A change queued as a client does: a 409 is asked again after its Retry-After.

        Returns the job's id. Any other answer than 202 is a failure.
        """

        until = time.monotonic() + deadline
        while True:
            status, document, wait = self.api(header, method, path, body, key=True)
            if status == 409 and wait and time.monotonic() + wait < until:
                time.sleep(wait)
                continue
            result = document.get("result")
            if status != 202 or not isinstance(result, dict):
                raise Failed(f"{method} {path} answered {status}, not 202:\n{document}")
            return int(result["job"]["id"])

    def api_job(self, header: str, job: int, seconds: float = 180) -> dict[str, Any]:
        """The job as the API shows it once it has finished; a failure names its state and error."""

        until = time.monotonic() + seconds
        while True:
            status, document, _ = self.api(header, "GET", f"/jobs/{job}")
            result = document.get("result")
            if status != 200 or not isinstance(result, dict):
                raise Failed(f"GET /jobs/{job} answered {status}:\n{document}")
            if result.get("finished"):
                if result.get("state") != "done":
                    raise Failed(
                        f"job {job} ended {result.get('state')}: {result.get('error_code')} "
                        f"{result.get('error_message')}"
                    )
                return result
            if time.monotonic() > until:
                raise Failed(f"job {job} is still {result.get('state')} after {seconds:.0f} s")
            time.sleep(1)

    def table_holds(self, role: str, address: str) -> bool:
        """Whether the node's HAProxy holds the address in the shop's blocked table.

        The table must be there at all: a key asked of a table that is not
        there is answered with nothing, as one that holds no such key is.
        """

        ask = (
            "import socket\n"
            "def ask(command):\n"
            "    s = socket.socket(socket.AF_UNIX); s.connect('/run/haproxy/manager.sock')\n"
            "    s.sendall(command.encode() + b'\\n'); s.shutdown(socket.SHUT_WR)\n"
            "    return s.makefile().read()\n"
            "print(ask('show table'))\n"
            f"print('KEY' if 'key=' in ask('show table mgd-shop-dynblock key {address}') else 'NONE')\n"
        )
        _, answer = self.on(role, f"/usr/bin/python3 -I -c {shlex.quote(ask)}")
        if "# table: mgd-shop-dynblock," not in answer:
            raise Failed(f"{role} runs no blocking table for the shop:\n{answer}")
        return answer.rstrip().endswith("KEY")

    # --- what an operator checks --------------------------------------------

    def holders(self) -> list[str]:
        vip = self.address("vip")
        found = []
        for role in NODES:
            _, addresses = self.on(role, "ip -4 -o addr show")
            if f" {vip}/" in addresses:
                found.append(role)
        return found

    def wait_for_one_holder(self, seconds: int = 20) -> str:
        deadline = time.monotonic() + seconds
        holders: list[str] = []
        while time.monotonic() < deadline:
            holders = self.holders()
            if len(holders) == 1:
                return holders[0]
            time.sleep(1)
        raise Failed(f"the virtual address is held by {holders or 'no node'} after {seconds} s")

    def answers_on_the_vip(self) -> None:
        _, body = self.on(
            "mgr",
            f"curl -fsS --max-time 5 -H 'Host: shop.example.com' http://{self.address('vip')}/",
        )
        if BACKEND_BODY not in body:
            raise Failed(f"the virtual address answered something else:\n{body}")

    def traffic_log_reaches_the_manager(self, holder: str) -> None:
        """A base function (Fas 18, 26-10-16): on from setup and the join, nothing by hand."""

        _, config = self.on("mgr", "cat /etc/haprion/ui.toml")
        if not re.search(r"^\[traffic_logs\]\nenabled = true$", config, re.M):
            raise Failed(f"setup left the traffic log page off:\n{config}")
        self.answers_on_the_vip()
        #
        # rsyslog writes the record a moment after HAProxy hands it over; read
        # once and a slow write is a failure (1 of 4 runs on 2026-10-31, the
        # three runs after it passed). A record that never comes still fails.
        #
        deadline = time.monotonic() + 10
        while True:
            _, lines = self.on(
                holder, "cat /var/log/haprion/traffic-*.jsonl 2>/dev/null || true", check=False
            )
            if any(record.get("host") == "shop.example.com" for record in _records(lines)):
                break
            if time.monotonic() > deadline:
                raise Failed(f"{holder} wrote no traffic record for the request:\n{lines[-2000:]}")
            time.sleep(1)
        self.on("mgr", "systemctl start haprion-traffic-collector.service")
        _, count = self.on(
            "mgr",
            "sudo -u postgres psql -d haprion -tAc "
            "\"select count(*) from traffic_log where host = 'shop.example.com'\"",
        )
        if int(count.strip() or 0) < 1:
            raise Failed("the collector imported no record from the nodes")

    def a_probe_answers_through_the_helper_socket(self) -> None:
        """The probe helper's unit as the interface reaches it, holding no capability (5-15).

        Root, but with an empty capability set: it reads root's own files and
        opens ssh connections, neither of which needs one. Asked over its
        socket, as the web asks it, so the unit's sandbox is what is proved.
        """

        target = {
            "host": self.address("mgr"),
            "port": 9080,
            "type": "tcp",
            "tls": False,
            "verify": False,
            "min_version": "",
            "path": "/",
            "host_header": "",
        }
        script = (
            "import sys, uuid; sys.path.insert(0, '/opt/haprion/current/lib'); "
            "from haprion.probe_socket import ask, build_request; "
            f"print(ask(build_request({CLUSTER!r}, str(uuid.uuid4()), [{target!r}])))"
        )
        _, answer = self.on("mgr", f"/usr/bin/python3 -I -c {shlex.quote(script)}")
        document = json.loads(answer)
        results = [
            result
            for node in (document.get("result") or {}).get("nodes", [])
            for result in node.get("results", [])
        ]
        if document.get("outcome") != "done" or not results or not all(r["ok"] for r in results):
            raise Failed(f"the probe through its socket did not reach the backend:\n{answer}")

