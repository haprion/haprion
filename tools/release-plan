#!/usr/bin/env python3
"""Whether the dependency fixes on main are released now, and as which version (B355, B505, B506).

    tools/release-plan decide --source <tree> --pulls <json> [--now <iso>] [--app <login>]
        [--last-release present|missing] [--released-at <iso>] [--published <file>]
    tools/release-plan bump --source <tree> --version <x.y.z>

The upstream watch proposes, and the merge workflow merges, the fixes the
locks and the WAF pins need (B353, B354). `decide` reads main since the last
`v*` tag and answers what auto-release.yml does next:

    nothing  nothing a package carries has changed since the tag
    blocked  a commit since the tag is not one the watch or Dependabot made:
             a person's change waits for a release made by hand, and an
             automatic one would ship it unreviewed
    wait     something is waiting, and its time has not come (`due_at`)
    release  propose the next patch version now
    rebuild  the last tag is an automatic one and has no GitHub release: build
             the tagged commit again, twice, and make the release (no new tag)
    tag      the version proposal is merged: tag its merge (`tag_commit`) and
             release it. What landed on main after the merge is not in the
             tree that was tested and goes in the next release

A tag that carries no release (the build failed after the tag was pushed) and
a repository that serves no `haprion-cli` of the last tag three hours after
its release (apt-repo.yml's run was replaced or failed) are what the workflow
tells the plan with `--last-release`, `--released-at` and `--published` (the
versions the published `Packages` lists, one per line); the second is the
plan's `repository` text, which the workflow turns into an issue.

A security fix is what the watch knows to be one: the locks' proposal, which
only ever moves a package an advisory names (B353), and a WAF proposal made
while govulncheck finds something the pinned engine reaches. The first one
merged after the tag starts a day; everything merged by then goes in the same
release (B355). Anything else a package carries - new rules, an engine or Go
update without a finding - waits for the first of the next month (B506). An
update of the actions is no change to a package and never releases (B505).

The answer is read from git and from what GitHub says about the pull requests
(`--pulls`: for each one the workflow found in the log, its number, who
opened it and the commit it was merged as). A commit's author name is only a
name: what lets a change in is that every commit on main's first-parent line
since the tag is the merge of a pull request the app or Dependabot opened,
that GitHub merged as exactly that commit (B507). Without the file no merge
can be verified, and anything since the tag is `blocked`. Whatever a merge
commit carries itself (a conflict resolved on the branch, or content added to
the merge on main) is no commit of the watch's, and the tree since the tag is
held to the files the watch, Dependabot and the version proposal change.
`bump` writes a version into the three files that hold it; the workflow
refreshes the two locks after it.
"""

from __future__ import annotations

import argparse
import json
import re
import subprocess
import sys
from collections.abc import Mapping, Sequence
from dataclasses import asdict, dataclass, field
from datetime import UTC, datetime, timedelta
from pathlib import Path

#
# The subjects the watch's own commits carry (upstream-watch.yml). Read
# exactly: a person who writes the same words is still not the watch, since
# the author is checked as well.
#
LOCKS_SUBJECT = "Update the locked dependencies with known vulnerabilities"
WAF_SUBJECT = "Update the WAF packages' upstream pins"
WAF_SECURITY_SUBJECT = "Update the WAF packages' upstream pins for a known vulnerability"
VERSION_SUBJECT = re.compile(r"Version (\d{1,4}\.\d{1,4}\.\d{1,4})")

LOCK_FILES = frozenset({"uv.lock", "ui/uv.lock", "certbot/uv.lock"})
WAF_FILES = frozenset(
    {"tools/build-coraza-package.py", "tools/build-release-packages", "tools/build-scep-package.py"}
)
VERSION_FILES = frozenset(
    {"pyproject.toml", "ui/pyproject.toml", "src/haprion/__init__.py", "uv.lock", "ui/uv.lock"}
)
DEPENDABOT = "dependabot[bot]"
DEFAULT_APP = "haprion-upstream-watch[bot]"

TAG = re.compile(r"v(\d{1,4})\.(\d{1,4})\.(\d{1,4})")
SECURITY_WAIT = timedelta(hours=24)
PUBLISH_WAIT = timedelta(hours=3)

#
# Where the version is written, and the line that holds it in each.
#
VERSION_LINES = (
    ("pyproject.toml", re.compile(r'^version = "[0-9.]+"$', re.MULTILINE), 'version = "{}"'),
    ("ui/pyproject.toml", re.compile(r'^version = "[0-9.]+"$', re.MULTILINE), 'version = "{}"'),
    (
        "src/haprion/__init__.py",
        re.compile(r'^__version__ = "[0-9.]+"$', re.MULTILINE),
        '__version__ = "{}"',
    ),
)


class PlanError(Exception):
    """The tree cannot be read as the plan needs it."""


@dataclass(frozen=True, slots=True)
class Pull:
    """What GitHub says about a merged pull request."""

    number: int
    author: str
    merge_commit_sha: str


def read_pulls(path: Path) -> dict[int, Pull]:
    """The pull requests file: a list of `{number, author, merge_commit_sha}`."""

    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        pulls = [Pull(int(p["number"]), str(p["author"]), str(p["merge_commit_sha"])) for p in data]
    except (ValueError, KeyError, TypeError) as exc:
        raise PlanError(f"{path} is not a list of pull requests: {exc!r}") from exc
    return {pull.number: pull for pull in pulls}


@dataclass(frozen=True, slots=True)
class Known:
    """What the workflow asked GitHub and the published repository about the last tag."""

    release: str = ""
    """`present`, `missing`, or empty when it was not asked."""
    released_at: datetime | None = None
    published: tuple[str, ...] | None = None
    """The `haprion-cli` versions the repository lists; None when it was not read."""


@dataclass(frozen=True, slots=True)
class Change:
    commit: str
    subject: str
    author: str
    kind: str
    """`locks`, `waf`, `actions`, `version` or `other`."""
    security: bool
    shipped: bool
    merged_at: str
    pull_request: int | None
    why: str = ""
    """For `other`: what is wrong with it."""
    merge_commit: str = ""
    """The commit on main's first-parent line that brought it in."""


@dataclass(slots=True)
class Plan:
    outcome: str
    reason: str
    last: str
    next: str | None = None
    security: bool = False
    due_at: str | None = None
    tag_commit: str | None = None
    """`tag`: the version proposal's merge, the commit the tag goes on."""
    pull_head: str | None = None
    """`tag`: the version proposal's head, the commit the checks ran on."""
    repository: str = ""
    """Not empty: the published repository does not serve the last tag's package."""
    changes: list[Change] = field(default_factory=list)


def _git(source: Path, *args: str) -> str:
    try:
        return subprocess.run(  # noqa: S603 - fixed executable, the arguments are revisions
            ["/usr/bin/git", "-C", str(source), *args], check=True, capture_output=True, text=True
        ).stdout
    except subprocess.CalledProcessError as exc:
        raise PlanError(f"git {' '.join(args)}: {exc.stderr.strip()}") from exc


def _paths(source: Path, *args: str) -> list[str]:
    """The file names a git command lists with `-z`: NUL ends a name, so a blank or a newline stays in it."""

    return [path for path in _git(source, *args, "-z").split("\0") if path]


def last_tag(source: Path) -> str:
    """The newest release tag main's head descends from."""

    tag = _git(source, "describe", "--tags", "--abbrev=0", "--match", "v*", "HEAD").strip()
    if not TAG.fullmatch(tag):
        raise PlanError(f"the last tag {tag!r} is not vX.Y.Z")
    return tag


def next_patch(tag: str) -> str:
    match = TAG.fullmatch(tag)
    if match is None:
        raise PlanError(f"{tag!r} is not vX.Y.Z")
    major, minor, patch = (int(part) for part in match.groups())
    return f"{major}.{minor}.{patch + 1}"


def _classify(subject: str, author: str, files: frozenset[str], app: str) -> tuple[str, bool, bool]:
    """`(kind, security, shipped)` for one commit."""

    if author == app:
        if subject == LOCKS_SUBJECT and files <= LOCK_FILES:
            return "locks", True, True
        if subject in (WAF_SUBJECT, WAF_SECURITY_SUBJECT) and files <= WAF_FILES:
            return "waf", subject == WAF_SECURITY_SUBJECT, True
        if VERSION_SUBJECT.fullmatch(subject) and files <= VERSION_FILES:
            return "version", False, False
    if author == DEPENDABOT and files and all(path.startswith(".github/") for path in files):
        return "actions", False, False
    return "other", False, False


def _pull_request(subject: str) -> int | None:
    match = re.match(r"Merge pull request #(\d+) ", subject)
    return int(match.group(1)) if match else None


def _unverified(head: str, subject: str, pulls: Mapping[int, Pull] | None, app: str) -> str:
    """Why a merge on main's first-parent line is not a verified pull request merge; empty if it is."""

    number = _pull_request(subject)
    if number is None:
        return "a merge that is not a pull request's"
    if pulls is None:
        return "no pull request data to verify it against"
    pull = pulls.get(number)
    if pull is None:
        return f"pull request #{number} is not among those read"
    if pull.author not in (app, DEPENDABOT):
        return f"pull request #{number} was opened by {pull.author}"
    if pull.merge_commit_sha != head:
        return f"pull request #{number} was merged as {pull.merge_commit_sha[:8]}"
    return ""


def changes_since(
    source: Path,
    tag: str,
    app: str,
    pulls: Mapping[int, Pull] | None = None,
    revision: str = "HEAD",
) -> list[Change]:
    """Every commit since the tag, with the time the merge that brought it to main landed.

    Main's first-parent line must be pull request merges and nothing else; the
    commits a merge brought in must be plain commits, no merges among them.
    """

    changes: list[Change] = []
    first_parent = _git(
        source,
        "log",
        "--first-parent",
        "--reverse",
        "--format=%H%x00%cI%x00%P%x00%an%x00%s",
        f"{tag}..{revision}",
    )
    for line in first_parent.splitlines():
        head, landed, parents, committer, subject = line.split("\x00", 4)
        parent_list = parents.split()
        number = _pull_request(subject) if len(parent_list) > 1 else None
        if len(parent_list) != 2:
            why = "a commit on main that no pull request merged"
        else:
            why = _unverified(head, subject, pulls, app)
        if why:
            changes.append(
                Change(head, subject, committer, "other", False, False, landed, number, why, head)
            )
            continue
        for commit in _git(
            source, "log", "--reverse", "--format=%H%x00%P", f"{parent_list[0]}..{parent_list[1]}"
        ).splitlines():
            sha, commit_parents = commit.split("\x00")
            author, commit_subject = (
                _git(source, "log", "-1", "--format=%an%x00%s", sha).rstrip("\n").split("\x00", 1)
            )
            if len(commit_parents.split()) > 1:
                changes.append(
                    Change(
                        sha,
                        commit_subject,
                        author,
                        "other",
                        False,
                        False,
                        landed,
                        number,
                        "a merge on the pull request's branch",
                        head,
                    )
                )
                continue
            files = frozenset(
                _paths(source, "diff-tree", "--no-commit-id", "--name-only", "-r", sha)
            )
            kind, security, shipped = _classify(commit_subject, author, files, app)
            changes.append(
                Change(
                    sha, commit_subject, author, kind, security, shipped, landed, number, "", head
                )
            )
    return changes


def outside_the_watch(source: Path, tag: str, revision: str = "HEAD") -> str:
    """The first file that changed since the tag and is not one the watch, Dependabot or the version changes."""

    allowed = LOCK_FILES | WAF_FILES | VERSION_FILES
    for path in _paths(source, "diff", "--name-only", tag, revision):
        if path not in allowed and not path.startswith(".github/"):
            return path
    return ""


def _first_of_next_month(when: datetime) -> datetime:
    year, month = (when.year + 1, 1) if when.month == 12 else (when.year, when.month + 1)
    return datetime(year, month, 1, tzinfo=UTC)


def plan(
    changes: Sequence[Change],
    tag: str,
    now: datetime,
    *,
    head_version: str,
    outside: str = "",
) -> Plan:
    """What the workflow does next."""

    result = Plan(outcome="nothing", reason="", last=tag, changes=list(changes))
    others = [change for change in changes if change.kind == "other"]
    if others:
        first = others[0]
        result.outcome = "blocked"
        result.reason = (
            f"{first.commit[:8]} ({first.subject}) is not the watch's or Dependabot's "
            f"({first.why}); it waits for a release made by hand"
        )
        result.security = any(change.security for change in changes)
        return result
    if outside:
        result.outcome = "blocked"
        result.reason = (
            f"{outside} changed since {tag} and is no file the watch or Dependabot changes; "
            "it waits for a release made by hand"
        )
        result.security = any(change.security for change in changes)
        return result
    shipped = [change for change in changes if change.shipped]
    security = [change for change in shipped if change.security]
    result.security = bool(security)
    versions = [change for change in changes if change.kind == "version"]
    if versions:
        #
        # The proposal this workflow made, merged. It names the next patch,
        # and the tree it was merged into says the same; anything else is not
        # this workflow's doing and is left for a person.
        #
        named = VERSION_SUBJECT.fullmatch(versions[-1].subject)
        expected = next_patch(tag)
        if (
            len(versions) > 1
            or named is None
            or named.group(1) != expected
            or head_version != expected
        ):
            result.outcome = "blocked"
            result.reason = (
                f"main says version {head_version} after {tag}; only {expected} is this workflow's"
            )
            return result
        result.outcome = "tag"
        result.next = expected
        result.tag_commit = versions[0].merge_commit
        result.reason = f"version {expected} is merged; tag its merge and release it"
        return result
    if not shipped:
        result.reason = "nothing a package carries has changed since the tag"
        return result
    result.next = next_patch(tag)
    monthly = _first_of_next_month(min(_landed(change) for change in shipped))
    urgent = min(_landed(change) for change in security) + SECURITY_WAIT if security else None
    due = monthly if urgent is None else min(monthly, urgent)
    result.due_at = due.isoformat()
    if now < due:
        result.outcome = "wait"
        waiting = "1 change waits" if len(shipped) == 1 else f"{len(shipped)} changes wait"
        result.reason = f"{waiting} until {result.due_at}"
    else:
        result.outcome = "release"
        result.reason = (
            "a security fix has waited a day"
            if urgent is not None and due == urgent
            else "the month's fixes are due"
        )
    return result


def _landed(change: Change) -> datetime:
    return datetime.fromisoformat(change.merged_at).astimezone(UTC)


def tree_problem(source: Path, merge: str) -> tuple[str, str]:
    """`(problem, pull_head)` for the merge of the version proposal.

    The installation test ran on the proposal's head. The tag stands on the
    merge, so its tree must be that head's: GitHub makes it so when the head
    holds main, and a merge that brought anything else along is not what was
    tested.
    """

    parents = _git(source, "rev-list", "--parents", "-n", "1", merge).split()[1:]
    if len(parents) != 2:
        return f"{merge[:8]} is not a merge of a pull request", ""
    tree = _git(source, "rev-parse", f"{merge}^{{tree}}").strip()
    tested = _git(source, "rev-parse", f"{parents[1]}^{{tree}}").strip()
    if tree != tested:
        return (
            f"the merge {merge[:8]} holds a tree other than its pull request's head "
            f"{parents[1][:8]}, which is the one the checks ran on",
            parents[1],
        )
    return "", parents[1]


def automatic_tag(source: Path, tag: str, app: str, pulls: Mapping[int, Pull] | None) -> str:
    """The commit the tag stands on when this workflow made it; empty otherwise.

    It is the merge of a version proposal GitHub says the app opened and merged
    as exactly that commit, whose one commit says `Version` and the tag's own
    number, and which changed the version files and nothing else. What came
    before it since the tag before must pass what `tag` asks of it: every
    commit verified, no file outside the watch's, the merge's tree the tested
    head's.
    """

    merge = _git(source, "rev-parse", f"{tag}^{{commit}}").strip()
    line = _git(source, "log", "-1", "--format=%P%x00%s", merge).rstrip("\n")
    parents, subject = line.split("\x00", 1)
    parent_list = parents.split()
    number = _pull_request(subject)
    if len(parent_list) != 2 or number is None or _unverified(merge, subject, pulls, app):
        return ""
    if pulls is None or pulls[number].author != app:
        return ""
    proposal, proposal_subject = (
        _git(source, "log", "-1", "--format=%an%x00%s", parent_list[1])
        .rstrip("\n")
        .split("\x00", 1)
    )
    files = set(_paths(source, "diff", "--name-only", parent_list[0], merge))
    if proposal != app or proposal_subject != f"Version {tag[1:]}" or not files <= VERSION_FILES:
        return ""
    #
    # The same bars `tag` holds the merge to, against the tag before this one:
    # a person's change, or a tree other than the tested head's, is no tag of
    # the watch's alone, and building it again would release it.
    #
    try:
        previous = _git(
            source, "describe", "--tags", "--abbrev=0", "--match", "v*", parent_list[0]
        ).strip()
    except PlanError:
        return ""
    if any(c.kind == "other" for c in changes_since(source, previous, app, pulls, merge)):
        return ""
    if outside_the_watch(source, previous, merge) or tree_problem(source, merge)[0]:
        return ""
    return merge


def unpublished(tag: str, known: Known, now: datetime) -> str:
    """Why the published repository is not serving the tag's `haprion-cli`; empty if it is or was not read."""

    if known.release != "present" or known.published is None or known.released_at is None:
        return ""
    if now < known.released_at + PUBLISH_WAIT:
        return ""
    wanted = re.compile(rf"{re.escape(tag[1:])}\+git\d{{14}}\.[0-9a-f]{{12}}")
    if any(wanted.fullmatch(version) for version in known.published):
        return ""
    return (
        f"the repository serves no haprion-cli {tag[1:]} {PUBLISH_WAIT // timedelta(hours=1)} "
        f"hours after {tag} was released"
    )


def decide(
    source: Path,
    tag: str,
    app: str,
    pulls: Mapping[int, Pull] | None,
    now: datetime,
    known: Known | None = None,
) -> Plan:
    """The plan for what main holds since the tag.

    A merged version proposal is the end of this release: what landed on main
    after it is not in the tree that was tested, and goes in the next release
    (the next run reads it from the new tag).
    """

    known = known or Known()
    if known.release == "missing":
        commit = automatic_tag(source, tag, app, pulls)
        if commit:
            return Plan(
                outcome="rebuild",
                reason=f"{tag} is an automatic tag without a release; build it again and release it",
                last=tag,
                next=tag[1:],
                tag_commit=commit,
            )
    changes = changes_since(source, tag, app, pulls)
    version = next((change for change in changes if change.kind == "version"), None)
    merge = version.merge_commit if version else ""
    if version:
        order = list(dict.fromkeys(change.merge_commit for change in changes))
        changes = [c for c in changes if order.index(c.merge_commit) <= order.index(merge)]
    result = plan(
        changes,
        tag,
        now,
        head_version=head_version(source, merge or "HEAD"),
        outside=outside_the_watch(source, tag, merge or "HEAD"),
    )
    if result.outcome == "tag":
        problem, result.pull_head = tree_problem(source, merge)
        if problem:
            result.outcome = "blocked"
            result.reason = problem
            result.next = result.tag_commit = result.pull_head = None
    result.repository = unpublished(tag, known, now)
    return result


def notes(result: Plan) -> str:
    """The release's note: what came in, in the order it was merged."""

    lines = [
        f"An automatic patch release (B505): the dependency fixes merged on main since {result.last}.",
        "No function changed. Update with `sudo apt update && sudo apt upgrade`, the manager first.",
        "",
    ]
    for change in result.changes:
        if not change.shipped:
            continue
        mark = " (security)" if change.security else ""
        number = f"#{change.pull_request} " if change.pull_request else ""
        lines.append(f"- {number}{change.subject}{mark}")
    return "\n".join(lines) + "\n"


def head_version(source: Path, revision: str = "HEAD") -> str:
    text = _git(source, "show", f"{revision}:pyproject.toml")
    match = re.search(r'^version = "([0-9.]+)"$', text, re.MULTILINE)
    if match is None:
        raise PlanError("pyproject.toml names no version")
    return match.group(1)


def bump(source: Path, version: str) -> None:
    if not re.fullmatch(r"\d{1,4}\.\d{1,4}\.\d{1,4}", version):
        raise PlanError(f"{version!r} is not X.Y.Z")
    for relative, pattern, line in VERSION_LINES:
        path = source / relative
        text = path.read_text(encoding="utf-8")
        new, count = pattern.subn(line.format(version), text, count=1)
        if count != 1:
            raise PlanError(f"{relative} has no version line")
        path.write_text(new, encoding="utf-8")


def pull_numbers(source: Path) -> list[int]:
    """The pull requests whose merges `decide` verifies, in the order main has them.

    Every merge on main's first-parent line since the tag before the last one:
    the plan reads from the last tag, and a tag without a release is checked
    from the one before it (review 2026-11-13, PK01). With one tag only, from
    that tag's own merge.
    """

    tag = last_tag(source)
    try:
        parent = _git(source, "rev-parse", "--verify", "--quiet", f"{tag}^").strip()
    except PlanError:
        parent = ""
    before = ""
    if parent:
        try:
            before = _git(
                source, "describe", "--tags", "--abbrev=0", "--match", "v*", parent
            ).strip()
        except PlanError:
            before = ""
    if TAG.fullmatch(before):
        span = f"{before}..HEAD"
    elif parent:
        span = f"{parent}..HEAD"
    else:
        span = "HEAD"
    numbers = []
    subjects = _git(source, "log", "--first-parent", "--reverse", "--format=%s", span)
    for subject in subjects.splitlines():
        number = _pull_request(subject)
        if number is not None:
            numbers.append(number)
    return numbers


def main(argv: Sequence[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="release-plan", description=__doc__.split("\n", 1)[0])
    commands = parser.add_subparsers(dest="command", required=True)
    deciding = commands.add_parser("decide")
    deciding.add_argument("--source", type=Path, required=True)
    deciding.add_argument(
        "--pulls", type=Path, help="the pull requests merged since the tag, as JSON"
    )
    deciding.add_argument("--now", type=datetime.fromisoformat)
    deciding.add_argument("--app", default=DEFAULT_APP)
    deciding.add_argument("--notes", type=Path, help="write the release note here")
    deciding.add_argument("--last-release", choices=("present", "missing"), default="")
    deciding.add_argument("--released-at", type=datetime.fromisoformat)
    deciding.add_argument(
        "--published", type=Path, help="the haprion-cli versions the repository lists, one a line"
    )
    numbers = commands.add_parser("pulls")
    numbers.add_argument("--source", type=Path, required=True)
    version = commands.add_parser("bump")
    version.add_argument("--source", type=Path, required=True)
    version.add_argument("--version", required=True)
    args = parser.parse_args(argv)
    try:
        if args.command == "bump":
            bump(args.source, args.version)
            return 0
        if args.command == "pulls":
            print("\n".join(str(number) for number in pull_numbers(args.source)))
            return 0
        now = args.now or datetime.now(UTC)
        if now.tzinfo is None:
            raise PlanError("--now needs a time zone")
        tag = last_tag(args.source)
        pulls = read_pulls(args.pulls) if args.pulls else None
        published = (
            tuple(args.published.read_text(encoding="utf-8").split()) if args.published else None
        )
        released_at = args.released_at
        if released_at is not None and released_at.tzinfo is None:
            raise PlanError("--released-at needs a time zone")
        known = Known(args.last_release, released_at, published)
        result = decide(args.source, tag, args.app, pulls, now, known)
    except (PlanError, OSError) as exc:
        print(f"release-plan: {exc}", file=sys.stderr)
        return 2
    if args.notes is not None:
        args.notes.write_text(notes(result), encoding="utf-8")
    print(json.dumps(asdict(result), indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
