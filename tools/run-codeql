#!/bin/sh
set -eu

base=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
codeql_bin=${CODEQL_BIN:-codeql}

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
    echo "Usage: run-codeql <new-output-directory-outside-repository>" >&2
    exit 64
fi
if ! command -v "$codeql_bin" >/dev/null 2>&1; then
    echo "run-codeql: required CodeQL binary is missing: $codeql_bin" >&2
    exit 2
fi

output=$1
case "$output" in
    "$base"|"$base"/*)
        echo "run-codeql: output directory must be outside the repository" >&2
        exit 64
        ;;
esac
if [ -e "$output" ]; then
    echo "run-codeql: output directory already exists: $output" >&2
    exit 2
fi

mkdir -p "$output"

# The databases are a step, not a result: 170-270 MB per run, read by nothing
# once the SARIF is written, and rebuilt from the commit if a question ever
# needs one again. Left behind they grew to 38 GB over 222 runs (2026-10-07).
# Removed on every exit, the failed and the interrupted run as well.
trap 'rm -rf -- "$output/database"' EXIT

# Two languages, one run. The engine is Python and the interface ships four
# hand-written scripts under ui/src/haproxy_ui/static - no build step, no
# dependencies, and until now nothing looking at them at all. They are the only
# code in the repository that runs inside somebody else's browser, which is the
# one place where "who can reach this value" is not a question the tests answer.
#
# --db-cluster writes one database per language under $output/database. The
# suites are the extended security ones for each, so the standard is the same
# on both halves of the same application.
"$codeql_bin" database create "$output/database" \
    --db-cluster \
    --language=python,javascript \
    --source-root="$base" \
    --threads=0
"$codeql_bin" database analyze "$output/database/python" \
    codeql/python-queries:codeql-suites/python-security-extended.qls \
    --format=sarif-latest \
    --output="$output/python.sarif" \
    --sarif-add-baseline-file-info \
    --threads=0
"$codeql_bin" database analyze "$output/database/javascript" \
    codeql/javascript-queries:codeql-suites/javascript-security-extended.qls \
    --format=sarif-latest \
    --output="$output/javascript.sarif" \
    --sarif-add-baseline-file-info \
    --threads=0

# Both results in one call, because an acceptance that matches nothing is a
# failure: checked one file at a time, every Python acceptance would go stale
# against the JavaScript results and the gate would fail on its own bookkeeping.
python3 "$base/tools/check-codeql-sarif.py" "$output/python.sarif" "$output/javascript.sarif"
