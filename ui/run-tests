#!/bin/sh
#
# The interface's own gate. Separate from the engine's because it needs the
# environment holding the interface's dependencies, and a gate that skips what
# it cannot import is a gate that passes by not looking.
#
set -eu

base=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

if [ -z "${HAPROXY_UI_PYTHON:-}" ]; then
    echo "run-tests: set HAPROXY_UI_PYTHON to the python of the interface environment" >&2
    exit 2
fi
if [ ! -x "${HAPROXY_UI_PYTHON}" ]; then
    echo "run-tests: not executable: ${HAPROXY_UI_PYTHON}" >&2
    exit 2
fi

#
# The browser suite drives the chart in a real browser, and where that browser
# lives is a property of the machine rather than of the repository. Named here
# rather than defaulted inside the tests: a default is a path that is right on
# one host and quietly wrong on the next.
#
if [ -z "${PLAYWRIGHT_BROWSERS_PATH:-}" ]; then
    echo "run-tests: set PLAYWRIGHT_BROWSERS_PATH to the Playwright browser directory" >&2
    echo "run-tests: install with: playwright install chromium" >&2
    exit 2
fi
export PLAYWRIGHT_BROWSERS_PATH

cd "$base"
python3 "$base/../tools/run_test_modules.py" \
    --durations "${XDG_CACHE_HOME:-$HOME/.cache}/haprion/test-durations-ui.json" \
    --suite ui "$base/tests" "$HAPROXY_UI_PYTHON -m unittest discover -s tests -t . -v"
"$(dirname -- "$HAPROXY_UI_PYTHON")/mypy"
