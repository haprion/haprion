#!/bin/bash
# Run migrations and database integration tests in a disposable PostgreSQL cluster.
set -Eeuo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
python_bin="${HAPRION_UI_PYTHON:-}"
[[ -n "$python_bin" && -x "$python_bin" ]] || {
    echo "set HAPRION_UI_PYTHON to the locked UI environment's Python" >&2
    exit 1
}
[[ "$(id -u)" -ne 0 ]] || {
    echo "run this as the developer, not as root" >&2
    exit 1
}

# HAPRION_PG_BINDIR names the server's programs where more than one major
# version is installed; otherwise `pg_config` says where they are.
pg_bindir="${HAPRION_PG_BINDIR:-$(pg_config --bindir 2>/dev/null || true)}"
[[ -n "$pg_bindir" ]] || {
    echo "PostgreSQL is not installed here (no pg_config); the database gate needs its server" >&2
    exit 1
}
for program in initdb pg_ctl psql createdb; do
    [[ -x "${pg_bindir}/${program}" ]] || {
        echo "PostgreSQL program is missing: ${pg_bindir}/${program}" >&2
        exit 1
    }
done

test_root="$(mktemp -d "${TMPDIR:-/tmp}/haprion-test-db.XXXXXX")"
# PostgreSQL's socket file goes inside, and a Unix socket path holds about 107
# bytes: a deep TMPDIR otherwise fails as a server that would not start.
socket_file="${test_root}/socket/.s.PGSQL.5432"
(( ${#socket_file} < 107 )) || {
    rm -rf -- "$test_root"
    echo "TMPDIR is too deep for PostgreSQL's socket (${socket_file}); use a shorter one" >&2
    exit 1
}
data_dir="${test_root}/data"
socket_dir="${test_root}/socket"
database="haprion_ui_test"
started=false

cleanup() {
    if [[ "$started" == true ]]; then
        "${pg_bindir}/pg_ctl" -D "$data_dir" -m fast -w stop >/dev/null
    fi
    rm -rf -- "$test_root"
}
trap cleanup EXIT INT TERM

mkdir -m 700 "$socket_dir"
"${pg_bindir}/initdb" -D "$data_dir" --no-locale --encoding=UTF8 --auth=trust >/dev/null
"${pg_bindir}/pg_ctl" -D "$data_dir" -o "-h '' -k ${socket_dir}" -w start >/dev/null
started=true

psql=("${pg_bindir}/psql" -h "$socket_dir" -d postgres -v ON_ERROR_STOP=1 -qtAX)
"${psql[@]}" <<'SQL'
create role app_web nologin noinherit;
create role app_worker nologin noinherit;
create role app_poller nologin noinherit;
create role app_collector nologin noinherit;
create role hm_test_migrate login inherit nosuperuser nocreatedb nocreaterole;
create role hm_test_web login inherit nosuperuser nocreatedb nocreaterole;
create role hm_test_worker login inherit nosuperuser nocreatedb nocreaterole;
create role hm_test_poller login inherit nosuperuser nocreatedb nocreaterole;
create role hm_test_collector login inherit nosuperuser nocreatedb nocreaterole;
grant app_web to hm_test_web with inherit true;
grant app_worker to hm_test_worker with inherit true;
grant app_poller to hm_test_poller with inherit true;
grant app_collector to hm_test_collector with inherit true;
SQL
"${pg_bindir}/createdb" -h "$socket_dir" -O hm_test_migrate "$database"
"${pg_bindir}/psql" -h "$socket_dir" -d "$database" -v ON_ERROR_STOP=1 -qtAX \
    -c 'create extension pg_trgm'
#
# The installation's per-role limits (install/platform/02-platform-database),
# so a query the web would lose to its 5 s is lost here too; a test holds the
# two lists equal.
#
while read -r role timeout; do
    "${pg_bindir}/psql" -h "$socket_dir" -d "$database" -v ON_ERROR_STOP=1 -qtAX \
        -c "alter role ${role} in database ${database} set statement_timeout = '${timeout}'" \
        -c "alter role ${role} in database ${database} set idle_in_transaction_session_timeout = '10s'"
done <<'LIMITS'
hm_test_web 5s
hm_test_worker 15s
hm_test_poller 10s
hm_test_collector 15s
LIMITS

export HAPRION_UI_DATABASE_URL="postgresql+psycopg://hm_test_migrate@/${database}?host=${socket_dir}"
export HAPRION_UI_TEST_DATABASE_DSN="dbname=${database} host=${socket_dir}"
# Given separately as well: the collector connects by name and socket rather
# than by DSN, so a check of its behaviour needs the same two values it uses.
export HAPRION_UI_TEST_DATABASE_NAME="${database}"
export HAPRION_UI_TEST_DATABASE_SOCKET="${socket_dir}"
export HAPRION_UI_TEST_MIGRATION_ROLE=hm_test_migrate
export HAPRION_UI_TEST_WEB_ROLE=hm_test_web
export HAPRION_UI_TEST_WORKER_ROLE=hm_test_worker
export HAPRION_UI_TEST_POLLER_ROLE=hm_test_poller
export HAPRION_UI_TEST_COLLECTOR_ROLE=hm_test_collector

(cd "${root}/ui" && "${python_bin%/python}/alembic" upgrade head)
#
# Through the gate's runner, as every other test module: a file, socket or
# connection left open, or a reach under /etc/haprion, fails it here too.
#
(cd "${root}/ui" && "$python_bin" "${root}/tools/unittest_left_open.py" -v tests.test_database_integration)

echo "database integration: OK (disposable cluster removed)"
